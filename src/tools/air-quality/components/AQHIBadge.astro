---
import { getAQHIRiskMeta } from '../services/airQualityService';

interface Props {
  aqhi: number;
  size?: 'sm' | 'md' | 'lg';
}

const { aqhi, size = 'md' } = Astro.props;
const meta = getAQHIRiskMeta(aqhi);

const sizeClasses = {
  sm: 'px-2 py-0.5 text-xs',
  md: 'px-2.5 py-1 text-xs sm:text-sm font-bold',
  lg: 'px-4 py-2 text-sm sm:text-base font-extrabold',
}[size];
---

<span
  class={`inline-flex items-center gap-1.5 rounded-full border ${meta.badgeBg} ${sizeClasses}`}
>
  <span class={`w-2 h-2 rounded-full ${meta.dotColor} animate-pulse`}></span>
  <span>AQHI {meta.aqhiText}</span>
</span>
