---
import type { CleanAirFacility } from '../types';

interface Props {
  shelters: CleanAirFacility[];
}

const { shelters } = Astro.props;
---

<div id="clean-air-shelters-section" class="space-y-4 pt-2">
  <div class="border-b border-slate-200 dark:border-slate-800 pb-2">
    <h2 class="text-base font-bold text-slate-900 dark:text-white flex items-center gap-2">
      <span>❄️</span>
      <span>Public Clean-Air Shelters & Air-Conditioned Facilities</span>
    </h2>
    <p class="text-xs text-slate-500 dark:text-slate-400">
      Free, publicly accessible municipal facilities equipped with central air conditioning and commercial HEPA filtration systems.
    </p>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
    {shelters.map((s) => (
      <div class="p-4 sm:p-5 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 shadow-xs hover:border-sky-500 transition-all flex flex-col justify-between">
        <div>
          <div class="flex items-start justify-between gap-2 mb-2">
            <h3 class="text-sm sm:text-base font-bold text-slate-900 dark:text-white">
              {s.name}
            </h3>
            <span class="px-2 py-0.5 rounded-full text-[11px] font-extrabold bg-emerald-500/15 text-emerald-700 dark:text-emerald-300 border border-emerald-500/30 shrink-0">
              Open Today
            </span>
          </div>

          <p class="text-xs text-slate-500 dark:text-slate-400 mb-3">
            📍 {s.address}
          </p>

          <div class="grid grid-cols-2 gap-2 text-xs mb-3">
            <div class="p-2 rounded-lg bg-slate-50 dark:bg-slate-800/60 border border-slate-100 dark:border-slate-700/60">
              <span class="text-slate-500 dark:text-slate-400 block text-[11px]">Filtration:</span>
              <span class="font-bold text-slate-900 dark:text-white">✓ HEPA + Central A/C</span>
            </div>
            <div class="p-2 rounded-lg bg-slate-50 dark:bg-slate-800/60 border border-slate-100 dark:border-slate-700/60">
              <span class="text-slate-500 dark:text-slate-400 block text-[11px]">Hours Today:</span>
              <span class="font-bold text-slate-900 dark:text-white">{s.hoursToday}</span>
            </div>
          </div>
        </div>

        <div class="flex items-center justify-between pt-2 border-t border-slate-100 dark:border-slate-800/60 text-xs">
          <span class="text-slate-500 dark:text-slate-400">
            🚇 {s.transitAccess}
          </span>
          <a
            href={`https://maps.google.com/?q=${s.latitude},${s.longitude}`}
            target="_blank"
            rel="noopener noreferrer"
            class="text-sky-600 dark:text-sky-400 hover:underline font-bold"
          >
            Google Maps →
          </a>
        </div>
      </div>
    ))}
  </div>
</div>
