---
import type { AirMonitoringStation } from '../types';
import AQHIBadge from './AQHIBadge.astro';

interface Props {
  station: AirMonitoringStation;
}

const { station } = Astro.props;
---

<div
  class="station-card block p-4 sm:p-5 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 shadow-xs hover:border-sky-500 transition-all flex flex-col justify-between"
  data-station-id={station.id}
  data-region={station.region}
  data-lat={station.latitude}
  data-lng={station.longitude}
>
  <div>
    <!-- Top Header: Title, AQHI Pill & Star Pin -->
    <div class="flex items-start justify-between gap-2 mb-3">
      <div>
        <div class="flex items-center gap-2">
          <a href={`/air/${station.id}`} class="hover:text-sky-500 transition-colors">
            <h3 class="text-base sm:text-lg font-bold text-slate-900 dark:text-white">
              {station.name}
            </h3>
          </a>
        </div>
        <p class="text-xs text-slate-500 dark:text-slate-400 mt-0.5">
          {station.region === 'vancouver_core' && '🏙️ Vancouver Urban Core'}
          {station.region === 'north_shore' && '🌲 North Shore & Coastal'}
          {station.region === 'burrard_inland' && '🏞️ Burrard Peninsula Inland'}
          {station.region === 'fraser_valley' && '🌾 Fraser Valley Basin'}
        </p>
      </div>

      <div class="flex items-center gap-2 shrink-0">
        <AQHIBadge aqhi={station.currentAQHI} size="sm" />
        <button
          type="button"
          class="star-btn p-1.5 rounded-lg text-slate-300 hover:text-amber-400 dark:text-slate-600 dark:hover:text-amber-400 transition-colors"
          data-station-star-id={station.id}
          title="Pin to Dashboard"
        >
          <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24">
            <path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/>
          </svg>
        </button>
      </div>
    </div>

    <!-- Live PM2.5 & Pollutants Breakdown -->
    <div class="grid grid-cols-2 gap-2 text-xs mb-3">
      <div class="p-2.5 rounded-xl bg-slate-50 dark:bg-slate-800/60 border border-slate-100 dark:border-slate-700/60">
        <span class="text-slate-500 dark:text-slate-400 block text-[11px]">Fine Particles (PM2.5):</span>
        <span class="text-sm font-black text-slate-900 dark:text-white">
          {station.currentPM25} µg/m³
        </span>
      </div>
      <div class="p-2.5 rounded-xl bg-slate-50 dark:bg-slate-800/60 border border-slate-100 dark:border-slate-700/60">
        <span class="text-slate-500 dark:text-slate-400 block text-[11px]">Active Pollutants:</span>
        <span class="text-xs font-bold text-slate-700 dark:text-slate-300">
          {station.pollutants.map((p) => p.pollutantCode).join(' • ')}
        </span>
      </div>
    </div>

    <!-- Health Advice Snapshot -->
    <p class="text-xs text-slate-600 dark:text-slate-300 leading-relaxed mb-3">
      {station.healthAdvice.generalPopulation}
    </p>
  </div>

  <!-- Bottom Link -->
  <div class="flex items-center justify-between pt-2 border-t border-slate-100 dark:border-slate-800/60 text-xs font-semibold">
    <span class="station-distance-label text-slate-500 dark:text-slate-400">
      BAM-1020 Sensor
    </span>
    <a
      href={`/air/${station.id}`}
      class="text-sky-600 dark:text-sky-400 hover:underline flex items-center gap-1"
    >
      <span>24h Trend Curve</span>
      <span>→</span>
    </a>
  </div>
</div>
