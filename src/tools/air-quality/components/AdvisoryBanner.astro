---
interface Props {
  hasAdvisory?: boolean;
}

const { hasAdvisory = false } = Astro.props;
---

{hasAdvisory ? (
  <div class="p-4 sm:p-5 rounded-2xl bg-amber-500/10 dark:bg-amber-950/40 border-2 border-amber-500/40 text-amber-900 dark:text-amber-200 shadow-sm flex items-start gap-3">
    <span class="text-2xl shrink-0 mt-0.5">💨</span>
    <div class="space-y-1 text-xs sm:text-sm">
      <div class="font-extrabold text-amber-700 dark:text-amber-300 uppercase tracking-wide text-xs">
        Metro Vancouver Wildfire Smoke Advisory Active
      </div>
      <p class="leading-relaxed font-medium">
        Elevated fine particulate matter ($PM_{2.5}$) concentrations due to regional wildfire smoke. People with pre-existing conditions, infants, and seniors should reduce strenuous outdoor activities.
      </p>
      <p class="text-[11px] text-amber-700/80 dark:text-amber-300/80">
        Issued by Metro Vancouver in collaboration with Vancouver Coastal Health & Fraser Health.
      </p>
    </div>
  </div>
) : (
  <div class="p-3.5 rounded-xl bg-emerald-500/10 dark:bg-emerald-950/30 border border-emerald-500/20 text-emerald-800 dark:text-emerald-300 text-xs font-medium flex items-center justify-between">
    <div class="flex items-center gap-2">
      <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
      <span>No active wildfire smoke advisories in Metro Vancouver. Air quality is currently within healthy seasonal standards.</span>
    </div>
    <span class="text-[11px] text-emerald-600 dark:text-emerald-400 font-bold shrink-0">Metro Van AirMap</span>
  </div>
)}
