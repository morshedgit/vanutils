---
interface Props {
  activeTab?: string;
}

const { activeTab = 'all' } = Astro.props;

const tabs = [
  { id: 'all', label: 'All Stations', icon: '📍' },
  { id: 'vancouver_core', label: 'Vancouver Core', icon: '🏙️' },
  { id: 'north_shore', label: 'North Shore & Coastal', icon: '🌲' },
  { id: 'burrard_inland', label: 'Burrard Peninsula', icon: '🏞️' },
  { id: 'fraser_valley', label: 'Fraser Valley', icon: '🌾' },
  { id: 'shelters', label: 'Clean-Air Shelters', icon: '❄️' },
];
---

<div class="flex items-center gap-1.5 overflow-x-auto pb-2 scrollbar-none text-xs font-semibold">
  {tabs.map((t) => (
    <button
      type="button"
      data-air-tab={t.id}
      class={`air-filter-btn px-3 py-1.5 rounded-xl border transition-all whitespace-nowrap flex items-center gap-1.5 ${
        t.id === activeTab
          ? 'bg-slate-900 text-white border-slate-900 dark:bg-white dark:text-slate-900 dark:border-white shadow-xs'
          : 'bg-white dark:bg-slate-900 text-slate-600 dark:text-slate-400 border-slate-200 dark:border-slate-800 hover:border-slate-300 dark:hover:border-slate-700'
      }`}
    >
      <span>{t.icon}</span>
      <span>{t.label}</span>
    </button>
  ))}
</div>

<script>
  function setupAirFilterTabs() {
    const buttons = document.querySelectorAll('.air-filter-btn');
    const cards = document.querySelectorAll('.station-card');
    const sheltersSection = document.getElementById('clean-air-shelters-section');

    buttons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const tabId = btn.getAttribute('data-air-tab');

        // Update button states
        buttons.forEach((b) => {
          b.classList.remove('bg-slate-900', 'text-white', 'border-slate-900', 'dark:bg-white', 'dark:text-slate-900', 'dark:border-white', 'shadow-xs');
          b.classList.add('bg-white', 'dark:bg-slate-900', 'text-slate-600', 'dark:text-slate-400', 'border-slate-200', 'dark:border-slate-800');
        });
        btn.classList.remove('bg-white', 'dark:bg-slate-900', 'text-slate-600', 'dark:text-slate-400', 'border-slate-200', 'dark:border-slate-800');
        btn.classList.add('bg-slate-900', 'text-white', 'border-slate-900', 'dark:bg-white', 'dark:text-slate-900', 'dark:border-white', 'shadow-xs');

        if (tabId === 'shelters') {
          if (sheltersSection) sheltersSection.classList.remove('hidden');
          cards.forEach((c) => (c as HTMLElement).classList.add('hidden'));
        } else {
          if (sheltersSection) sheltersSection.classList.remove('hidden'); // keep available or toggle
          cards.forEach((card) => {
            const region = card.getAttribute('data-region');
            if (tabId === 'all' || region === tabId) {
              (card as HTMLElement).classList.remove('hidden');
            } else {
              (card as HTMLElement).classList.add('hidden');
            }
          });
        }
      });
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupAirFilterTabs);
  } else {
    setupAirFilterTabs();
  }
</script>
