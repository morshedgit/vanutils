<div class="p-4 sm:p-5 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 shadow-xs space-y-3">
  <div class="flex items-center justify-between border-b border-slate-100 dark:border-slate-800 pb-2">
    <h3 class="text-xs sm:text-sm font-bold text-slate-900 dark:text-white flex items-center gap-1.5">
      <span>🩺</span>
      <span>Where Should I Go? (ER vs. Urgent Care UPCC)</span>
    </h3>
    <span class="text-[11px] text-slate-400">Clinical Triage Guideline</span>
  </div>

  <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 text-xs">
    <!-- ER Guidance -->
    <div class="p-3 rounded-xl bg-rose-500/10 dark:bg-rose-950/30 border border-rose-500/20 space-y-1.5">
      <div class="font-bold text-rose-700 dark:text-rose-300 flex items-center gap-1.5">
        <span>🏥 Go to Hospital ER for:</span>
      </div>
      <ul class="space-y-1 text-slate-700 dark:text-slate-300 pl-1 text-[11px] leading-relaxed">
        <li>• Chest pain or pressure, suspected heart attack</li>
        <li>• Stroke signs (facial droop, arm weakness, speech difficulty)</li>
        <li>• Severe breathing difficulty or severe trauma</li>
        <li>• Heavy bleeding that won't stop</li>
        <li>• Newborn fever (under 3 months old)</li>
        <li>• Overdose or acute mental health crisis</li>
      </ul>
    </div>

    <!-- UPCC Guidance -->
    <div class="p-3 rounded-xl bg-sky-500/10 dark:bg-sky-950/30 border border-sky-500/20 space-y-1.5">
      <div class="font-bold text-sky-700 dark:text-sky-300 flex items-center gap-1.5">
        <span>🩺 Go to Urgent Care (UPCC) for:</span>
      </div>
      <ul class="space-y-1 text-slate-700 dark:text-slate-300 pl-1 text-[11px] leading-relaxed">
        <li>• Minor cuts needing stitches or wound care</li>
        <li>• Sprains, strains, simple bone fractures</li>
        <li>• High fevers, earaches, sore throats</li>
        <li>• Urinary tract infections (UTIs) & sudden infections</li>
        <li>• Mild to moderate asthma flare-ups</li>
        <li>• Same-day medical prescription renewals</li>
      </ul>
    </div>
  </div>
</div>
