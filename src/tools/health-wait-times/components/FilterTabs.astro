---
interface Props {
  activeTab?: string;
}

const { activeTab = 'all' } = Astro.props;

const tabs = [
  { id: 'all', label: 'All Facilities', icon: '🏥' },
  { id: 'emergency_department', label: 'Hospital ERs', icon: '🚨' },
  { id: 'urgent_primary_care_centre', label: 'Urgent Care (UPCC)', icon: '🩺' },
  { id: 'pediatric', label: 'Pediatric Emergency', icon: '👶' },
];
---

<div class="flex items-center gap-1.5 overflow-x-auto pb-2 scrollbar-none text-xs font-semibold">
  {tabs.map((t) => (
    <button
      type="button"
      data-health-tab={t.id}
      class={`health-filter-btn px-3 py-1.5 rounded-xl border transition-all whitespace-nowrap flex items-center gap-1.5 ${
        t.id === activeTab
          ? 'bg-slate-900 text-white border-slate-900 dark:bg-white dark:text-slate-900 dark:border-white shadow-xs'
          : 'bg-white dark:bg-slate-900 text-slate-600 dark:text-slate-400 border-slate-200 dark:border-slate-800 hover:border-slate-300 dark:hover:border-slate-700'
      }`}
    >
      <span>{t.icon}</span>
      <span>{t.label}</span>
    </button>
  ))}
</div>

<script>
  function setupHealthFilterTabs() {
    const buttons = document.querySelectorAll('.health-filter-btn');
    const cards = document.querySelectorAll('.facility-card');

    buttons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const tabId = btn.getAttribute('data-health-tab');

        // Update button states
        buttons.forEach((b) => {
          b.classList.remove('bg-slate-900', 'text-white', 'border-slate-900', 'dark:bg-white', 'dark:text-slate-900', 'dark:border-white', 'shadow-xs');
          b.classList.add('bg-white', 'dark:bg-slate-900', 'text-slate-600', 'dark:text-slate-400', 'border-slate-200', 'dark:border-slate-800');
        });
        btn.classList.remove('bg-white', 'dark:bg-slate-900', 'text-slate-600', 'dark:text-slate-400', 'border-slate-200', 'dark:border-slate-800');
        btn.classList.add('bg-slate-900', 'text-white', 'border-slate-900', 'dark:bg-white', 'dark:text-slate-900', 'dark:border-white', 'shadow-xs');

        // Filter cards
        cards.forEach((card) => {
          const type = card.getAttribute('data-facility-type');
          const isPediatric = card.querySelector('p')?.textContent?.includes('Pediatric');

          if (tabId === 'all') {
            (card as HTMLElement).classList.remove('hidden');
          } else if (tabId === 'pediatric') {
            if (isPediatric || type === 'pediatric_emergency') {
              (card as HTMLElement).classList.remove('hidden');
            } else {
              (card as HTMLElement).classList.add('hidden');
            }
          } else if (type === tabId) {
            (card as HTMLElement).classList.remove('hidden');
          } else {
            (card as HTMLElement).classList.add('hidden');
          }
        });
      });
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupHealthFilterTabs);
  } else {
    setupHealthFilterTabs();
  }
</script>
