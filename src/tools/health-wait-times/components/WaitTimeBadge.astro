---
import type { WaitIntensity } from '../types';
import { formatWaitTime, getWaitIntensityMeta } from '../services/healthService';

interface Props {
  waitTimeMinutes?: number;
  intensity?: WaitIntensity;
  isOpen?: boolean;
  size?: 'sm' | 'md' | 'lg';
}

const { waitTimeMinutes, intensity = 'unavailable', isOpen = true, size = 'md' } = Astro.props;

let effectiveIntensity: WaitIntensity = intensity;
if (!isOpen) {
  effectiveIntensity = 'unavailable';
} else if (waitTimeMinutes !== undefined) {
  if (waitTimeMinutes < 90) effectiveIntensity = 'low';
  else if (waitTimeMinutes <= 210) effectiveIntensity = 'moderate';
  else effectiveIntensity = 'high';
}

const meta = getWaitIntensityMeta(effectiveIntensity);
const formattedTime = isOpen ? formatWaitTime(waitTimeMinutes) : 'Closed';

const sizeClasses = {
  sm: 'px-2 py-0.5 text-xs',
  md: 'px-2.5 py-1 text-xs sm:text-sm font-bold',
  lg: 'px-4 py-2 text-sm sm:text-base font-extrabold',
}[size];
---

<span
  class={`inline-flex items-center gap-1.5 rounded-full border ${meta.badgeBg} ${sizeClasses}`}
>
  <span class={`w-2 h-2 rounded-full ${meta.dotColor} ${isOpen ? 'animate-pulse' : ''}`}></span>
  <span>{isOpen ? `${formattedTime} Est. Wait` : 'Closed'}</span>
</span>
