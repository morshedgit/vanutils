---
import type { SportsTeam } from '../types';
import FormBadge from './FormBadge.astro';

interface Props {
  team: SportsTeam;
}

const { team } = Astro.props;
---

<div
  class="group relative rounded-2xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 hover:border-sky-500/50 dark:hover:border-sky-500/50 p-5 sm:p-6 transition-all duration-200 shadow-xs hover:shadow-md flex flex-col justify-between space-y-4"
  data-league={team.league}
  data-team-id={team.id}
>
  <!-- Card Top: Team Identity & League Badge -->
  <div class="space-y-3">
    <div class="flex items-start justify-between gap-3">
      <div class="flex items-center gap-3">
        <span class="text-3xl sm:text-4xl shrink-0 drop-shadow-xs">{team.emoji}</span>
        <div>
          <div class="flex items-center gap-2">
            <h3 class="text-base sm:text-lg font-black text-slate-900 dark:text-white tracking-tight group-hover:text-sky-500 transition-colors">
              {team.name}
            </h3>
            <span class="px-2 py-0.5 rounded text-[10px] font-black uppercase tracking-wider bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 border border-slate-200 dark:border-slate-700">
              {team.league}
            </span>
          </div>
          <p class="text-xs text-slate-500 dark:text-slate-400">
            {team.standings.divisionOrConf} • <span class="font-bold text-slate-700 dark:text-slate-300">#{team.standings.rank} Seed</span>
          </p>
        </div>
      </div>

      <!-- Star / Pin Action -->
      <button
        type="button"
        class="pin-team-btn p-1.5 rounded-lg text-slate-400 hover:text-amber-500 hover:bg-amber-50 dark:hover:bg-amber-950/30 transition-colors"
        data-team-pin={team.id}
        title="Pin team to home radar"
      >
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z" />
        </svg>
      </button>
    </div>

    <!-- Standings Bar & 5-Game Form -->
    <div class="grid grid-cols-2 gap-3 p-3 rounded-xl bg-slate-50 dark:bg-slate-950/60 border border-slate-200/80 dark:border-slate-800 text-xs">
      <div>
        <div class="text-[10px] uppercase font-bold text-slate-500 dark:text-slate-400">Record &amp; Points</div>
        <div class="font-black text-slate-900 dark:text-white text-sm">
          {team.standings.record} <span class="text-xs font-normal text-slate-500">({team.standings.points} pts)</span>
        </div>
        <div class="text-[10px] text-emerald-600 dark:text-emerald-400 font-bold">
          Streak: {team.standings.streak} {team.standings.goalDiffOrMargin !== undefined ? `• DIFF: ${team.standings.goalDiffOrMargin > 0 ? '+' : ''}${team.standings.goalDiffOrMargin}` : ''}
        </div>
      </div>

      <div>
        <div class="text-[10px] uppercase font-bold text-slate-500 dark:text-slate-400 mb-1">Recent Form (Last 5)</div>
        <div class="flex items-center gap-1">
          {team.standings.formLast5.map((res) => (
            <FormBadge result={res} size="sm" />
          ))}
        </div>
      </div>
    </div>

    <!-- Next Game Alert Box -->
    <div class="p-3.5 rounded-xl bg-sky-50/60 dark:bg-sky-950/20 border border-sky-200/80 dark:border-sky-900/40 space-y-2">
      <div class="flex items-center justify-between text-xs">
        <span class="font-black uppercase tracking-wider text-sky-700 dark:text-sky-300 flex items-center gap-1 text-[11px]">
          <span>⚡ Next Matchup</span>
          {team.nextGame.rivalryMatchup && (
            <span class="px-1.5 py-0.2 rounded bg-amber-500/20 text-amber-700 dark:text-amber-300 text-[9px] font-bold">RIVALRY</span>
          )}
        </span>
        <span class="text-[11px] font-bold text-slate-600 dark:text-slate-400">{team.nextGame.startTimePST}</span>
      </div>

      <div class="flex items-center justify-between">
        <div class="text-xs font-bold text-slate-900 dark:text-white flex items-center gap-1.5">
          <span>vs</span>
          <span class="text-sm">{team.nextGame.opponent.name}</span>
          {team.nextGame.opponent.record && (
            <span class="text-[11px] font-normal text-slate-500">({team.nextGame.opponent.record})</span>
          )}
        </div>
        <span class="text-[11px] px-2 py-0.5 rounded-full font-bold bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 text-slate-700 dark:text-slate-300">
          {team.nextGame.isHome ? 'Home' : 'Away'}
        </span>
      </div>

      <div class="flex items-center justify-between text-[11px] text-slate-500 dark:text-slate-400 pt-1 border-t border-sky-100 dark:border-sky-900/30">
        <span>📺 {team.nextGame.broadcast.tv}</span>
        <span>📻 {team.nextGame.broadcast.radio}</span>
      </div>
    </div>

    <!-- Last Result Micro Pill -->
    <div class="flex items-center justify-between text-xs text-slate-600 dark:text-slate-400 px-1">
      <div class="flex items-center gap-1.5">
        <span class="text-[10px] uppercase font-bold text-slate-400">Last Game:</span>
        <span class="font-bold text-slate-900 dark:text-white">
          {team.lastGame.score ? `${team.lastGame.score.team}-${team.lastGame.score.opponent} ${team.lastGame.score.decisionPeriod || ''}` : 'Final'}
        </span>
        <FormBadge result={team.lastGame.result || 'W'} size="sm" />
        <span class="text-[11px]">vs {team.lastGame.opponent.shortName}</span>
      </div>
      <span class="text-[10px] text-slate-400">📍 {team.venue.name}</span>
    </div>
  </div>

  <!-- Card Action Footer -->
  <div class="pt-3 border-t border-slate-100 dark:border-slate-800 flex items-center justify-between">
    <span class="text-xs font-semibold text-slate-500 dark:text-slate-400 flex items-center gap-1">
      <span>🚇</span>
      <span class="truncate max-w-[170px]">{team.venue.skytrainStation.split('(')[0]}</span>
    </span>

    <a
      href={`/sports-teams/${team.id}`}
      class="inline-flex items-center gap-1 text-xs font-bold text-sky-600 dark:text-sky-400 hover:text-sky-500 hover:underline"
    >
      <span>Schedule &amp; Roster</span>
      <span>→</span>
    </a>
  </div>
</div>
