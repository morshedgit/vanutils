---
// FilterTabs.astro
---

<div class="rounded-2xl bg-white dark:bg-slate-900 border border-slate-200/80 dark:border-slate-800 p-4 shadow-xs space-y-3">
  <div class="flex flex-col sm:flex-row gap-2.5 items-stretch sm:items-center justify-between">
    <!-- Search Bar -->
    <div class="relative flex-1">
      <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-400">
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
        </svg>
      </div>
      <input
        type="search"
        id="ferry-search-input"
        placeholder="Search route or terminal (e.g. Swartz Bay, Nanaimo, Langdale, SeaBus)..."
        class="w-full pl-10 pr-9 py-2 bg-slate-50 dark:bg-slate-800/80 border border-slate-200 dark:border-slate-700 rounded-xl text-sm text-slate-900 dark:text-white placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-sky-500 transition-all"
      />
    </div>

    <!-- Category Pills -->
    <div class="flex flex-wrap gap-1.5" id="ferry-category-group">
      <button type="button" data-category="all" class="ferry-cat-chip px-3 py-1.5 rounded-full text-xs font-semibold bg-slate-900 dark:bg-white text-white dark:text-slate-900 transition-all">
        All Marine (11)
      </button>
      <button type="button" data-category="vehicle" class="ferry-cat-chip px-3 py-1.5 rounded-full text-xs font-medium bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300 hover:bg-slate-200 dark:hover:bg-slate-700 transition-all">
        🚗 Vehicle
      </button>
      <button type="button" data-category="passenger" class="ferry-cat-chip px-3 py-1.5 rounded-full text-xs font-medium bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300 hover:bg-slate-200 dark:hover:bg-slate-700 transition-all">
        ⚡ Fast Passenger
      </button>
      <button type="button" data-category="local" class="ferry-cat-chip px-3 py-1.5 rounded-full text-xs font-medium bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300 hover:bg-slate-200 dark:hover:bg-slate-700 transition-all">
        🏝️ Islands & Local
      </button>
    </div>
  </div>
</div>

<script>
  function initFerryFilters() {
    const searchInput = document.getElementById('ferry-search-input') as HTMLInputElement | null;
    const catChips = document.querySelectorAll('.ferry-cat-chip');
    const cards = Array.from(document.querySelectorAll('.ferry-route-card')) as HTMLElement[];
    const countDisplay = document.getElementById('ferry-count-display');

    let currentCategory = 'all';

    function applyFilters() {
      const query = (searchInput?.value || '').toLowerCase().trim();
      let visibleCount = 0;

      cards.forEach((card) => {
        const name = (card.dataset.routeName || '').toLowerCase();
        const cat = card.dataset.routeCategory || '';
        const provider = card.dataset.routeProvider || '';

        const matchesSearch = !query || name.includes(query) || provider.includes(query);
        const matchesCategory = currentCategory === 'all' || cat === currentCategory;

        const isVisible = matchesSearch && matchesCategory;
        card.style.display = isVisible ? '' : 'none';
        if (isVisible) visibleCount++;
      });

      if (countDisplay) {
        countDisplay.textContent = `Showing ${visibleCount} route${visibleCount === 1 ? '' : 's'}`;
      }
    }

    searchInput?.addEventListener('input', applyFilters);

    catChips.forEach((chip) => {
      chip.addEventListener('click', () => {
        catChips.forEach((c) => {
          c.classList.remove('bg-slate-900', 'dark:bg-white', 'text-white', 'dark:text-slate-900', 'font-semibold');
          c.classList.add('bg-slate-100', 'dark:bg-slate-800', 'text-slate-600', 'dark:text-slate-300');
        });
        chip.classList.remove('bg-slate-100', 'dark:bg-slate-800', 'text-slate-600', 'dark:text-slate-300');
        chip.classList.add('bg-slate-900', 'dark:bg-white', 'text-white', 'dark:text-slate-900', 'font-semibold');

        currentCategory = (chip as HTMLElement).dataset.category || 'all';
        applyFilters();
      });
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initFerryFilters);
  } else {
    initFerryFilters();
  }
</script>
