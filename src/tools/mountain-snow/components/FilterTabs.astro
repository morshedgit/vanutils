---
// FilterTabs.astro
---

<div class="rounded-2xl bg-white dark:bg-slate-900 border border-slate-200/80 dark:border-slate-800 p-4 shadow-xs space-y-3">
  <div class="flex flex-col sm:flex-row gap-2.5 items-stretch sm:items-center justify-between">
    <!-- Search Bar -->
    <div class="relative flex-1">
      <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-400">
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
        </svg>
      </div>
      <input
        type="search"
        id="snow-search-input"
        aria-label="Search mountain resort"
        placeholder="Search mountain (e.g. Cypress, Grouse, Seymour, Whistler)..."
        class="w-full pl-10 pr-9 py-2 bg-slate-50 dark:bg-slate-800/80 border border-slate-200 dark:border-slate-700 rounded-xl text-sm text-slate-900 dark:text-white placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-sky-500 transition-all"
      />
    </div>

    <!-- Category Pills -->
    <div class="flex flex-wrap gap-1.5" id="snow-category-group">
      <button type="button" data-region="all" class="snow-cat-chip px-3 py-1.5 rounded-full text-xs font-semibold bg-slate-900 dark:bg-white text-white dark:text-slate-900 transition-all">
        All Mountains (4)
      </button>
      <button type="button" data-region="north_shore" class="snow-cat-chip px-3 py-1.5 rounded-full text-xs font-medium bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300 hover:bg-slate-200 dark:hover:bg-slate-700 transition-all">
        🌲 North Shore
      </button>
      <button type="button" data-region="sea_to_sky" class="snow-cat-chip px-3 py-1.5 rounded-full text-xs font-medium bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300 hover:bg-slate-200 dark:hover:bg-slate-700 transition-all">
        🏔️ Sea-to-Sky
      </button>
    </div>
  </div>
</div>

<script>
  function initSnowFilters() {
    const searchInput = document.getElementById('snow-search-input') as HTMLInputElement | null;
    const catChips = document.querySelectorAll('.snow-cat-chip');
    const cards = Array.from(document.querySelectorAll('.mountain-card')) as HTMLElement[];
    const countDisplay = document.getElementById('mountain-count-display');

    let currentRegion = 'all';

    function applyFilters() {
      const query = (searchInput?.value || '').toLowerCase().trim();
      let visibleCount = 0;

      cards.forEach((card) => {
        const name = (card.dataset.mountainName || '').toLowerCase();
        const region = card.dataset.mountainRegion || '';

        const matchesSearch = !query || name.includes(query);
        const matchesRegion = currentRegion === 'all' || region === currentRegion;

        const isVisible = matchesSearch && matchesRegion;
        card.style.display = isVisible ? '' : 'none';
        if (isVisible) visibleCount++;
      });

      if (countDisplay) {
        countDisplay.textContent = `Showing ${visibleCount} mountain resort${visibleCount === 1 ? '' : 's'}`;
      }
    }

    searchInput?.addEventListener('input', applyFilters);

    catChips.forEach((chip) => {
      chip.addEventListener('click', () => {
        catChips.forEach((c) => {
          c.classList.remove('bg-slate-900', 'dark:bg-white', 'text-white', 'dark:text-slate-900', 'font-semibold');
          c.classList.add('bg-slate-100', 'dark:bg-slate-800', 'text-slate-600', 'dark:text-slate-300');
        });
        chip.classList.remove('bg-slate-100', 'dark:bg-slate-800', 'text-slate-600', 'dark:text-slate-300');
        chip.classList.add('bg-slate-900', 'dark:bg-white', 'text-white', 'dark:text-slate-900', 'font-semibold');

        currentRegion = (chip as HTMLElement).dataset.region || 'all';
        applyFilters();
      });
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initSnowFilters);
  } else {
    initSnowFilters();
  }
</script>
