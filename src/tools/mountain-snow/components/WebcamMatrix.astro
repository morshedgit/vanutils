---
import type { MountainWebcam } from '../types';

interface Props {
  webcams: MountainWebcam[];
  mountainName?: string;
}

const { webcams, mountainName } = Astro.props;
---

{webcams.length > 0 && (
  <div class="space-y-3">
    <div class="flex items-center justify-between text-xs text-slate-500 dark:text-slate-400 font-semibold">
      <span class="flex items-center gap-1.5">
        <span>📷</span> {mountainName ? `${mountainName} Live Webcams` : 'Live Mountain Cams'}
      </span>
      <span class="text-[11px] text-slate-400">Updated every 5m</span>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
      {webcams.map((cam) => (
        <div class="overflow-hidden rounded-2xl bg-slate-900 border border-slate-800 space-y-1.5">
          <div class="relative aspect-video bg-slate-950">
            <img
              src={cam.imageUrl}
              alt={cam.name}
              width="640"
              height="360"
              loading="lazy"
              class="w-full h-full object-cover"
            />
            <span class="absolute bottom-2 left-2 px-2 py-0.5 rounded bg-black/75 text-white text-[10px] font-mono">
              {cam.elevationMeters}m Elevation
            </span>
          </div>
          <div class="p-2.5 text-xs font-semibold text-slate-200 truncate">
            {cam.name}
          </div>
        </div>
      ))}
    </div>
  </div>
)}
