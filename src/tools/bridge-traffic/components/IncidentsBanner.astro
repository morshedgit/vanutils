---
import type { CrossingIncident } from '../types';

interface Props {
  incidents: CrossingIncident[];
}

const { incidents = [] } = Astro.props;
---

{incidents.length > 0 ? (
  <div class="p-4 rounded-2xl bg-rose-500/10 dark:bg-rose-950/40 border-2 border-rose-500/40 text-rose-900 dark:text-rose-200 space-y-2">
    <div class="flex items-center gap-2 font-bold text-xs uppercase tracking-wide text-rose-600 dark:text-rose-400">
      <span>🚨</span>
      <span>Active Traffic Incidents / Stalls</span>
    </div>
    <div class="space-y-1.5 text-xs font-medium">
      {incidents.map((inc) => (
        <div class="flex items-start gap-2">
          <span class="text-rose-500">•</span>
          <div>
            <span>{inc.description}</span>
            <span class="text-[11px] text-rose-400/80 ml-1">({inc.lanesAffected})</span>
          </div>
        </div>
      ))}
    </div>
  </div>
) : (
  <div class="p-3 rounded-xl bg-emerald-500/10 dark:bg-emerald-950/30 border border-emerald-500/20 text-emerald-800 dark:text-emerald-300 text-xs font-medium flex items-center gap-2">
    <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
    <span>No major stalls or lane closures reported on Metro Vancouver bridges currently.</span>
  </div>
)}
