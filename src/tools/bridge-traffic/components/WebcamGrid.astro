---
import type { CrossingWebcam } from '../types';

interface Props {
  webcams: CrossingWebcam[];
  crossingName: string;
}

const { webcams, crossingName } = Astro.props;
---

<div class="space-y-3">
  <div class="flex items-center justify-between border-b border-slate-200 dark:border-slate-800 pb-2">
    <h3 class="text-xs sm:text-sm font-bold text-slate-900 dark:text-white flex items-center gap-1.5">
      <span>📷</span>
      <span>Live Approach Cameras ({crossingName})</span>
    </h3>
    <span class="text-[11px] text-slate-400">DriveBC & CoV CCTV</span>
  </div>

  <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-3">
    {webcams.map((cam) => (
      <div class="rounded-xl overflow-hidden bg-slate-900 border border-slate-800 flex flex-col justify-between shadow-xs">
        <div class="relative aspect-video bg-slate-950 flex items-center justify-center">
          <img
            src={cam.imageUrl}
            alt={cam.name}
            class="w-full h-full object-cover"
            loading="lazy"
          />
          <div class="absolute top-2 right-2 px-2 py-0.5 rounded bg-black/70 text-[10px] font-bold text-emerald-400 backdrop-blur-xs flex items-center gap-1">
            <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
            <span>LIVE</span>
          </div>
        </div>
        <div class="p-2.5 bg-slate-900 text-xs">
          <span class="font-bold text-white block">{cam.name}</span>
          <span class="text-[11px] text-slate-400">{cam.viewLocation}</span>
        </div>
      </div>
    ))}
  </div>
</div>
