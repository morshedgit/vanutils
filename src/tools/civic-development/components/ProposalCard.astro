---
import type { DevelopmentProposal } from '../types';
import { getStatusMeta } from '../services/civicService';

interface Props {
  proposal: DevelopmentProposal;
}

const { proposal } = Astro.props;
const statusMeta = getStatusMeta(proposal.status);
---

<div
  class="proposal-card block p-4 sm:p-5 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 shadow-xs hover:border-sky-500 transition-all flex flex-col justify-between"
  data-proposal-id={proposal.id}
  data-neighbourhood={proposal.neighbourhood}
  data-status={proposal.status}
  data-lat={proposal.latitude}
  data-lng={proposal.longitude}
>
  <div>
    <!-- Top Header: ID, Status Badge & Star Pin -->
    <div class="flex items-start justify-between gap-2 mb-2">
      <div>
        <div class="flex items-center gap-2">
          <span class="text-xs font-mono font-bold text-sky-600 dark:text-sky-400">
            {proposal.id}
          </span>
          <span class={`inline-flex items-center gap-1.5 px-2 py-0.5 rounded-full text-xs font-bold border ${statusMeta.badgeBg}`}>
            <span class={`w-1.5 h-1.5 rounded-full ${statusMeta.dotColor}`}></span>
            <span>{statusMeta.label}</span>
          </span>
        </div>
        <a href={`/civic/${proposal.id}`} class="hover:text-sky-500 transition-colors">
          <h3 class="text-base sm:text-lg font-bold text-slate-900 dark:text-white mt-1">
            {proposal.address}
          </h3>
        </a>
        <p class="text-xs text-slate-500 dark:text-slate-400">
          📍 {proposal.neighbourhood}
        </p>
      </div>

      <button
        type="button"
        class="star-btn p-1.5 rounded-lg text-slate-300 hover:text-amber-400 dark:text-slate-600 dark:hover:text-amber-400 transition-colors shrink-0"
        data-proposal-star-id={proposal.id}
        title="Pin to Dashboard"
      >
        <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24">
          <path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/>
        </svg>
      </button>
    </div>

    <!-- Scale & Density Grid -->
    <div class="grid grid-cols-3 gap-2 text-xs mb-3">
      <div class="p-2 rounded-xl bg-slate-50 dark:bg-slate-800/60 border border-slate-100 dark:border-slate-700/60">
        <span class="text-slate-500 dark:text-slate-400 block text-[11px]">Height / Scale:</span>
        <span class="font-bold text-slate-900 dark:text-white">{proposal.storeys} Storeys ({proposal.heightMeters}m)</span>
      </div>
      <div class="p-2 rounded-xl bg-slate-50 dark:bg-slate-800/60 border border-slate-100 dark:border-slate-700/60">
        <span class="text-slate-500 dark:text-slate-400 block text-[11px]">Proposed FSR:</span>
        <span class="font-bold text-slate-900 dark:text-white">{proposal.proposedFSR} FSR {proposal.existingFSR ? `(was ${proposal.existingFSR})` : ''}</span>
      </div>
      <div class="p-2 rounded-xl bg-slate-50 dark:bg-slate-800/60 border border-slate-100 dark:border-slate-700/60">
        <span class="text-slate-500 dark:text-slate-400 block text-[11px]">Homes Created:</span>
        <span class="font-bold text-emerald-600 dark:text-emerald-400">{proposal.units.totalUnits} Units</span>
      </div>
    </div>

    <!-- Unit Mix Breakdown -->
    <div class="p-2.5 rounded-xl bg-slate-50 dark:bg-slate-800/40 border border-slate-100 dark:border-slate-700/40 text-xs mb-3 space-y-1">
      <div class="flex items-center justify-between text-slate-600 dark:text-slate-300">
        <span>🏢 Market Rental: <strong>{proposal.units.marketRental}</strong></span>
        <span>🔑 Below-Market (Secured): <strong>{proposal.units.belowMarketRental}</strong></span>
        {proposal.units.strataCondo > 0 && (
          <span>🏙️ Strata: <strong>{proposal.units.strataCondo}</strong></span>
        )}
      </div>
    </div>

    <!-- Status Description -->
    <p class="text-xs text-slate-600 dark:text-slate-300 leading-relaxed mb-3">
      {proposal.statusDescription}
    </p>
  </div>

  <!-- Bottom Link & Action -->
  <div class="flex items-center justify-between pt-2 border-t border-slate-100 dark:border-slate-800/60 text-xs font-semibold">
    <span class="proposal-distance-label text-slate-500 dark:text-slate-400">
      {proposal.applicantName}
    </span>
    <a
      href={`/civic/${proposal.id}`}
      class="text-sky-600 dark:text-sky-400 hover:underline flex items-center gap-1"
    >
      <span>Application Details & Plans</span>
      <span>→</span>
    </a>
  </div>
</div>
