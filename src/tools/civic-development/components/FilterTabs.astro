---
interface Props {
  activeTab?: string;
}

const { activeTab = 'all' } = Astro.props;

const tabs = [
  { id: 'all', label: 'All Proposals', icon: '📍' },
  { id: 'broadway', label: 'Broadway Plan', icon: '🚇' },
  { id: 'downtown', label: 'Downtown & West End', icon: '🏙️' },
  { id: 'mount_pleasant', label: 'Mount Pleasant', icon: '🎨' },
  { id: 'kitsilano', label: 'Kitsilano', icon: '🌊' },
  { id: 'cambie', label: 'Cambie / Marine TOD', icon: '🚆' },
  { id: 'hearings', label: 'Hearings Scheduled', icon: '🗳️' },
];
---

<div class="flex items-center gap-1.5 overflow-x-auto pb-2 scrollbar-none text-xs font-semibold">
  {tabs.map((t) => (
    <button
      type="button"
      data-civic-tab={t.id}
      class={`civic-filter-btn px-3 py-1.5 rounded-xl border transition-all whitespace-nowrap flex items-center gap-1.5 ${
        t.id === activeTab
          ? 'bg-slate-900 text-white border-slate-900 dark:bg-white dark:text-slate-900 dark:border-white shadow-xs'
          : 'bg-white dark:bg-slate-900 text-slate-600 dark:text-slate-400 border-slate-200 dark:border-slate-800 hover:border-slate-300 dark:hover:border-slate-700'
      }`}
    >
      <span>{t.icon}</span>
      <span>{t.label}</span>
    </button>
  ))}
</div>

<script>
  function setupCivicFilterTabs() {
    const buttons = document.querySelectorAll('.civic-filter-btn');
    const cards = document.querySelectorAll('.proposal-card');

    buttons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const tabId = btn.getAttribute('data-civic-tab');

        // Update button states
        buttons.forEach((b) => {
          b.classList.remove('bg-slate-900', 'text-white', 'border-slate-900', 'dark:bg-white', 'dark:text-slate-900', 'dark:border-white', 'shadow-xs');
          b.classList.add('bg-white', 'dark:bg-slate-900', 'text-slate-600', 'dark:text-slate-400', 'border-slate-200', 'dark:border-slate-800');
        });
        btn.classList.remove('bg-white', 'dark:bg-slate-900', 'text-slate-600', 'dark:text-slate-400', 'border-slate-200', 'dark:border-slate-800');
        btn.classList.add('bg-slate-900', 'text-white', 'border-slate-900', 'dark:bg-white', 'dark:text-slate-900', 'dark:border-white', 'shadow-xs');

        cards.forEach((card) => {
          const hood = (card.getAttribute('data-neighbourhood') || '').toLowerCase();
          const status = (card.getAttribute('data-status') || '').toLowerCase();

          let match = false;
          if (tabId === 'all') match = true;
          else if (tabId === 'broadway' && hood.includes('broadway')) match = true;
          else if (tabId === 'downtown' && (hood.includes('downtown') || hood.includes('west end'))) match = true;
          else if (tabId === 'mount_pleasant' && hood.includes('mount pleasant')) match = true;
          else if (tabId === 'kitsilano' && hood.includes('kitsilano')) match = true;
          else if (tabId === 'cambie' && (hood.includes('cambie') || hood.includes('marine'))) match = true;
          else if (tabId === 'hearings' && status === 'public_hearing_scheduled') match = true;

          if (match) {
            (card as HTMLElement).classList.remove('hidden');
          } else {
            (card as HTMLElement).classList.add('hidden');
          }
        });
      });
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupCivicFilterTabs);
  } else {
    setupCivicFilterTabs();
  }
</script>
