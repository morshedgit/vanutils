---
import type { DevelopmentProposal } from '../types';

interface Props {
  proposals: DevelopmentProposal[];
}

const { proposals } = Astro.props;
const now = Date.now();
const hearings = proposals.filter((p) =>
  p.status === 'public_hearing_scheduled' &&
  p.publicHearing?.hearingDate &&
  new Date(p.publicHearing.hearingDate).getTime() > now
);
---

{hearings.length > 0 && (
  <div class="p-4 sm:p-5 rounded-2xl bg-amber-500/10 dark:bg-amber-950/40 border-2 border-amber-500/40 text-amber-900 dark:text-amber-200 shadow-sm space-y-3">
    <div class="flex items-center justify-between">
      <div class="flex items-center gap-2">
        <span class="text-xl">🗳️</span>
        <h3 class="font-black text-xs sm:text-sm uppercase tracking-wide text-amber-800 dark:text-amber-300">
          Upcoming City Council Public Hearings ({hearings.length} Projects on Agenda)
        </h3>
      </div>
      <span class="text-[11px] px-2 py-0.5 rounded-full bg-amber-500/20 text-amber-800 dark:text-amber-200 font-bold">
        Public Comments Open
      </span>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
      {hearings.map((h) => (
        <div class="p-3 rounded-xl bg-white dark:bg-slate-900 border border-amber-500/30 text-xs space-y-1.5">
          <div class="flex items-center justify-between font-bold text-slate-900 dark:text-white">
            <a href={`/civic/${h.id}`} class="hover:text-amber-600 dark:hover:text-amber-400">
              {h.address} ({h.storeys} Storeys)
            </a>
            <span class="text-[11px] text-amber-600 dark:text-amber-400 font-mono">
              {new Date(h.publicHearing!.hearingDate!).toLocaleDateString([], { month: 'short', day: 'numeric', timeZone: 'America/Vancouver' })} @ {new Date(h.publicHearing!.hearingDate!).toLocaleTimeString([], { hour: 'numeric', minute: '2-digit', timeZone: 'America/Vancouver' })}
            </span>
          </div>
          <p class="text-slate-600 dark:text-slate-400 text-[11px]">
            {h.neighbourhood} • {h.units.totalUnits} homes ({h.units.belowMarketRental} below-market)
          </p>
          <div class="flex items-center justify-between pt-1 border-t border-slate-100 dark:border-slate-800 text-[11px]">
            <a
              href={h.publicHearing!.submitCommentUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="text-amber-700 dark:text-amber-300 font-bold hover:underline"
            >
              Submit Council Comment →
            </a>
            <a
              href={h.publicHearing!.councilMeetingUrl || '#'}
              target="_blank"
              rel="noopener noreferrer"
              class="text-slate-500 hover:underline"
            >
              View Agenda
            </a>
          </div>
        </div>
      ))}
    </div>
  </div>
)}
