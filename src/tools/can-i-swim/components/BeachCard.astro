---
import type { Beach } from '../types';

interface Props {
  beach: Beach;
  distanceKm?: number;
}

const { beach, distanceKm } = Astro.props;
---

<div
  class="beach-card relative flex items-center justify-between p-3.5 sm:p-4 rounded-xl bg-white dark:bg-slate-900 border border-slate-200/80 dark:border-slate-800 hover:border-sky-500/60 hover:shadow-xs transition-all duration-150"
  data-beach-id={beach.id}
  data-beach-name={beach.name}
  data-beach-municipality={beach.municipality}
  data-beach-watertype={beach.waterType}
  data-beach-status={beach.currentStatus}
  data-beach-ecoli={beach.latestSample.eColiCount}
  data-beach-dog={beach.dogFriendly ? 'true' : 'false'}
  data-beach-lifeguards={beach.lifeguards ? 'true' : 'false'}
  data-beach-wheelchair={beach.wheelchairAccessible ? 'true' : 'false'}
  data-beach-washrooms={beach.washrooms ? 'true' : 'false'}
  data-beach-lat={beach.latitude}
  data-beach-lng={beach.longitude}
>
  <!-- Left Side: Beach Name, Municipality & Distance (Clickable) -->
  <a href={`/swim/${beach.id}`} class="flex-1 pr-3 focus:outline-none min-w-0">
    <div class="flex items-center gap-1.5 mb-0.5">
      <span class="text-xs font-bold text-slate-900 dark:text-white hover:text-sky-500 transition-colors truncate">
        {beach.name.replace(/ \(.*\)/, '')}
      </span>
      {beach.dogFriendly && <span class="text-[10px]" title="Dog friendly">🐾</span>}
      {beach.lifeguards && <span class="text-[10px]" title="Lifeguard on duty">🏊</span>}
    </div>
    <div class="text-[11px] text-slate-500 dark:text-slate-400 flex items-center gap-2">
      <span>{beach.municipality}</span>
      <span>•</span>
      <span class="distance-text">{distanceKm ? `${distanceKm.toFixed(1)} km` : 'Calculating...'}</span>
      <span>•</span>
      <span>{beach.latestSample.eColiCount} CFU</span>
    </div>
  </a>

  <!-- Right Side: Status Indicator + Star Toggle -->
  <div class="flex items-center gap-2.5 shrink-0">
    <a href={`/swim/${beach.id}`} class="focus:outline-none">
      {beach.currentStatus === 'safe' && (
        <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-xs font-semibold bg-emerald-500/10 text-emerald-700 dark:text-emerald-300 border border-emerald-500/20">
          <span class="w-2 h-2 rounded-full bg-emerald-500"></span> Safe
        </span>
      )}
      {beach.currentStatus === 'caution' && (
        <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-xs font-semibold bg-amber-500/10 text-amber-700 dark:text-amber-300 border border-amber-500/20">
          <span class="w-2 h-2 rounded-full bg-amber-500"></span> Caution
        </span>
      )}
      {beach.currentStatus === 'advisory' && (
        <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-xs font-semibold bg-rose-500/10 text-rose-700 dark:text-rose-300 border border-rose-500/20">
          <span class="w-2 h-2 rounded-full bg-rose-500"></span> Advisory
        </span>
      )}
    </a>

    <!-- Pin to Main Dashboard Toggle Button -->
    <button
      type="button"
      class="pin-beach-toggle p-1 rounded-lg text-slate-300 dark:text-slate-600 hover:text-amber-400 dark:hover:text-amber-400 hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors"
      data-beach-id={beach.id}
      title="Pin/Unpin from Main Dashboard"
      aria-label={`Pin ${beach.name}`}
    >
      <svg class="w-4 h-4 fill-current star-icon" viewBox="0 0 24 24">
        <path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/>
      </svg>
    </button>
  </div>
</div>
