---
import type { Beach } from '../types';
import StatusBadge from '../../../components/shared/StatusBadge.astro';

interface Props {
  beach: Beach;
  distanceKm?: number;
}

const { beach, distanceKm } = Astro.props;
---

<div
  class="beach-card group relative flex flex-col justify-between p-5 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200/80 dark:border-slate-800 hover:border-sky-500/60 dark:hover:border-sky-500/60 hover:shadow-lg transition-all duration-200"
  data-beach-id={beach.id}
  data-beach-name={beach.name}
  data-beach-municipality={beach.municipality}
  data-beach-watertype={beach.waterType}
  data-beach-status={beach.currentStatus}
  data-beach-ecoli={beach.latestSample.eColiCount}
  data-beach-dog={beach.dogFriendly ? 'true' : 'false'}
  data-beach-lifeguards={beach.lifeguards ? 'true' : 'false'}
  data-beach-wheelchair={beach.wheelchairAccessible ? 'true' : 'false'}
  data-beach-washrooms={beach.washrooms ? 'true' : 'false'}
  data-beach-lat={beach.latitude}
  data-beach-lng={beach.longitude}
>
  <div>
    <!-- Top Row: Municipality + Status Badge + Pin Button -->
    <div class="flex items-center justify-between gap-2 mb-2">
      <span class="text-xs font-semibold text-slate-500 dark:text-slate-400">
        {beach.municipality}
      </span>
      <div class="flex items-center gap-2">
        <StatusBadge status={beach.currentStatus} size="sm" />
        <button
          type="button"
          class="pin-beach-toggle p-1 rounded-lg text-slate-300 dark:text-slate-600 hover:text-amber-400 dark:hover:text-amber-400 hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors"
          data-beach-id={beach.id}
          title="Pin to Main Dashboard"
          aria-label={`Pin ${beach.name} to main dashboard`}
        >
          <svg class="w-4 h-4 fill-current star-icon" viewBox="0 0 24 24">
            <path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/>
          </svg>
        </button>
      </div>
    </div>

    <!-- Beach Title -->
    <h3 class="text-base font-bold text-slate-900 dark:text-white group-hover:text-sky-500 transition-colors line-clamp-1 mb-1">
      <a href={`/swim/${beach.id}`} class="focus:outline-none hover:underline">
        {beach.name}
      </a>
    </h3>

    <!-- Distance & Status Note -->
    <div class="flex items-center gap-2 text-xs text-slate-500 dark:text-slate-400 mb-3">
      <span class="inline-flex items-center gap-1 font-medium text-slate-700 dark:text-slate-300">
        <svg class="w-3.5 h-3.5 text-sky-500 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
          <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
        </svg>
        <span class="distance-text">{distanceKm ? `${distanceKm.toFixed(1)} km away` : 'Calculating...'}</span>
      </span>
      <span>•</span>
      <span>{beach.latestSample.eColiCount} CFU</span>
    </div>
  </div>

  <!-- Bottom Row: Clean Amenity Icons + Quick Arrow -->
  <div class="pt-3 border-t border-slate-100 dark:border-slate-800/80 flex items-center justify-between text-xs text-slate-400">
    <div class="flex items-center gap-2.5">
      {beach.dogFriendly && (
        <span class="inline-flex items-center gap-1 text-[11px] text-amber-700 dark:text-amber-300 font-medium" title="Dog-friendly / Off-leash">
          🐾 Dogs
        </span>
      )}
      {beach.lifeguards && (
        <span class="inline-flex items-center gap-1 text-[11px] text-sky-700 dark:text-sky-300 font-medium" title="Lifeguards on duty">
          🏊 Lifeguard
        </span>
      )}
      {beach.wheelchairAccessible && (
        <span class="inline-flex items-center gap-1 text-[11px] text-teal-700 dark:text-teal-300 font-medium" title="Accessible beach mat">
          ♿ Mat
        </span>
      )}
      {!beach.dogFriendly && !beach.lifeguards && !beach.wheelchairAccessible && (
        <span class="text-[11px] text-slate-400">Natural shoreline</span>
      )}
    </div>

    <a href={`/swim/${beach.id}`} class="text-xs font-semibold text-sky-600 dark:text-sky-400 group-hover:translate-x-0.5 transition-transform inline-flex items-center gap-0.5">
      Details →
    </a>
  </div>
</div>
