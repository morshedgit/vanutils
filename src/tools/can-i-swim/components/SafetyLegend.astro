---
// SafetyLegend.astro
---

<div class="rounded-2xl border border-slate-200/80 dark:border-slate-800 bg-white/90 dark:bg-slate-900/90 p-5 shadow-xs">
  <div class="flex items-center justify-between gap-4 mb-4">
    <div class="flex items-center gap-2">
      <div class="w-7 h-7 rounded-lg bg-sky-500/10 text-sky-600 dark:text-sky-400 flex items-center justify-center font-bold text-xs">
        ℹ️
      </div>
      <div>
        <h3 class="text-sm font-bold text-slate-900 dark:text-white">How Safety Status is Decided</h3>
        <p class="text-[11px] text-slate-500 dark:text-slate-400">Vancouver Coastal Health & Health Canada E. coli standards</p>
      </div>
    </div>
    <span class="text-[11px] font-semibold text-slate-400 dark:text-slate-500 bg-slate-100 dark:bg-slate-800 px-2.5 py-1 rounded-full">
      CFU / 100 mL
    </span>
  </div>

  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3">
    <!-- Green Safe -->
    <div class="p-3 rounded-xl border border-emerald-200 dark:border-emerald-900/50 bg-emerald-50/50 dark:bg-emerald-950/20">
      <div class="flex items-center gap-1.5 font-bold text-xs text-emerald-700 dark:text-emerald-400 mb-1">
        <span class="w-2.5 h-2.5 rounded-full bg-emerald-500"></span>
        <span>Safe to Swim (Green)</span>
      </div>
      <p class="text-[11px] text-slate-600 dark:text-slate-300 leading-snug">
        <strong>≤ 200</strong> geometric mean <br />
        <strong>≤ 235</strong> single sample.
      </p>
      <span class="inline-block mt-2 text-[10px] font-medium text-emerald-600 dark:text-emerald-400">
        Clean water, low health risk.
      </span>
    </div>

    <!-- Yellow Caution -->
    <div class="p-3 rounded-xl border border-amber-200 dark:border-amber-900/50 bg-amber-50/50 dark:bg-amber-950/20">
      <div class="flex items-center gap-1.5 font-bold text-xs text-amber-700 dark:text-amber-400 mb-1">
        <span class="w-2.5 h-2.5 rounded-full bg-amber-500"></span>
        <span>Caution (Yellow)</span>
      </div>
      <p class="text-[11px] text-slate-600 dark:text-slate-300 leading-snug">
        Single sample <strong>235 – 400</strong>. <br />
        Beach Action Value triggered.
      </p>
      <span class="inline-block mt-2 text-[10px] font-medium text-amber-600 dark:text-amber-400">
        Resampling in progress.
      </span>
    </div>

    <!-- Red Advisory -->
    <div class="p-3 rounded-xl border border-rose-200 dark:border-rose-900/50 bg-rose-50/50 dark:bg-rose-950/20">
      <div class="flex items-center gap-1.5 font-bold text-xs text-rose-700 dark:text-rose-400 mb-1">
        <span class="w-2.5 h-2.5 rounded-full bg-rose-500"></span>
        <span>Advisory (Red)</span>
      </div>
      <p class="text-[11px] text-slate-600 dark:text-slate-300 leading-snug">
        Geometric mean <strong>&gt; 200</strong> <br />
        or single sample <strong>&gt; 400</strong>.
      </p>
      <span class="inline-block mt-2 text-[10px] font-medium text-rose-600 dark:text-rose-400">
        Do not swim (high illness risk).
      </span>
    </div>

    <!-- Gray Unmonitored -->
    <div class="p-3 rounded-xl border border-slate-200 dark:border-slate-800 bg-slate-50/70 dark:bg-slate-800/40">
      <div class="flex items-center gap-1.5 font-bold text-xs text-slate-600 dark:text-slate-400 mb-1">
        <span class="w-2.5 h-2.5 rounded-full bg-slate-400"></span>
        <span>Unmonitored (Gray)</span>
      </div>
      <p class="text-[11px] text-slate-600 dark:text-slate-300 leading-snug">
        Off-season or no sample within 14 days.
      </p>
      <span class="inline-block mt-2 text-[10px] font-medium text-slate-500 dark:text-slate-400">
        Recreational season: May–Sept.
      </span>
    </div>
  </div>
</div>
