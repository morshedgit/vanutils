---
// Clean, minimal FilterBar component
---

<div class="rounded-2xl bg-white dark:bg-slate-900 border border-slate-200/80 dark:border-slate-800 p-4 sm:p-5 shadow-xs space-y-3.5">
  <!-- Search & Sort Row -->
  <div class="flex flex-col sm:flex-row gap-2.5 items-stretch sm:items-center justify-between">
    <!-- Search Bar -->
    <div class="relative flex-1">
      <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-400">
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
        </svg>
      </div>
      <input
        type="search"
        id="beach-search-input"
        placeholder="Search by beach or park name..."
        class="w-full pl-10 pr-9 py-2 bg-slate-50 dark:bg-slate-800/80 border border-slate-200 dark:border-slate-700 rounded-xl text-sm text-slate-900 dark:text-white placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-sky-500 transition-all"
      />
      <button
        id="beach-search-clear"
        type="button"
        class="absolute inset-y-0 right-0 pr-3 flex items-center text-slate-400 hover:text-slate-600 dark:hover:text-slate-200 hidden"
        aria-label="Clear search"
      >
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>

    <!-- Quick Sort Dropdown -->
    <div class="flex items-center gap-2">
      <select
        id="beach-sort-select"
        class="w-full sm:w-auto px-3 py-2 bg-slate-50 dark:bg-slate-800/80 border border-slate-200 dark:border-slate-700 rounded-xl text-xs font-medium text-slate-700 dark:text-slate-200 focus:outline-none focus:ring-2 focus:ring-sky-500"
      >
        <option value="distance" selected>📍 Nearest to Me</option>
        <option value="cleanest">✨ Cleanest Water</option>
        <option value="name">🔤 Beach Name (A-Z)</option>
      </select>
    </div>
  </div>

  <!-- Filter Pills Row -->
  <div class="flex flex-wrap items-center justify-between gap-2 pt-2 border-t border-slate-100 dark:border-slate-800/80">
    <!-- Region Pills -->
    <div class="flex flex-wrap gap-1.5" id="muni-filter-group">
      <button type="button" data-muni="all" class="muni-chip px-3 py-1 rounded-full text-xs font-semibold bg-slate-900 dark:bg-white text-white dark:text-slate-900 transition-all">
        All Metro
      </button>
      <button type="button" data-muni="Vancouver" class="muni-chip px-3 py-1 rounded-full text-xs font-medium bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300 hover:bg-slate-200 dark:hover:bg-slate-700 transition-all">
        Vancouver
      </button>
      <button type="button" data-muni="West Vancouver,North Vancouver" class="muni-chip px-3 py-1 rounded-full text-xs font-medium bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300 hover:bg-slate-200 dark:hover:bg-slate-700 transition-all">
        North Shore
      </button>
      <button type="button" data-muni="Burnaby,Belcarra" class="muni-chip px-3 py-1 rounded-full text-xs font-medium bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300 hover:bg-slate-200 dark:hover:bg-slate-700 transition-all">
        Burnaby & Belcarra
      </button>
      <button type="button" data-muni="Richmond,White Rock" class="muni-chip px-3 py-1 rounded-full text-xs font-medium bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300 hover:bg-slate-200 dark:hover:bg-slate-700 transition-all">
        Richmond & White Rock
      </button>
    </div>

    <!-- Quick Toggles -->
    <div class="flex items-center gap-1.5">
      <button
        type="button"
        id="toggle-safe-only"
        class="px-2.5 py-1 rounded-full text-xs font-medium border border-emerald-500/30 text-emerald-700 dark:text-emerald-300 bg-emerald-500/10 hover:bg-emerald-500/20 transition-all"
        data-active="false"
      >
        🟢 Safe Only
      </button>
      <button
        type="button"
        id="toggle-dog-friendly"
        class="px-2.5 py-1 rounded-full text-xs font-medium border border-amber-500/30 text-amber-700 dark:text-amber-300 bg-amber-500/10 hover:bg-amber-500/20 transition-all"
        data-active="false"
      >
        🐾 Dog Friendly
      </button>
    </div>
  </div>
</div>

<script>
  function initFilters() {
    const searchInput = document.getElementById('beach-search-input') as HTMLInputElement | null;
    const searchClear = document.getElementById('beach-search-clear') as HTMLButtonElement | null;
    const sortSelect = document.getElementById('beach-sort-select') as HTMLSelectElement | null;
    const muniChips = document.querySelectorAll('.muni-chip');
    const safeToggle = document.getElementById('toggle-safe-only') as HTMLButtonElement | null;
    const dogToggle = document.getElementById('toggle-dog-friendly') as HTMLButtonElement | null;
    const grid = document.getElementById('beaches-grid');
    const countDisplay = document.getElementById('beach-count-display');

    if (!grid) return;

    let currentMuni = 'all';
    let safeOnly = false;
    let dogOnly = false;

    function applyFilters() {
      const query = (searchInput?.value || '').toLowerCase().trim();
      const cards = Array.from(document.querySelectorAll('.beach-card')) as HTMLElement[];
      let visibleCount = 0;

      cards.forEach((card) => {
        const name = (card.dataset.beachName || '').toLowerCase();
        const muni = card.dataset.beachMunicipality || '';
        const status = card.dataset.beachStatus || '';
        const isDog = card.dataset.beachDog === 'true';

        const matchesSearch = !query || name.includes(query) || muni.toLowerCase().includes(query);
        const matchesMuni = currentMuni === 'all' || currentMuni.split(',').includes(muni);
        const matchesSafe = !safeOnly || status === 'safe';
        const matchesDog = !dogOnly || isDog;

        const isVisible = matchesSearch && matchesMuni && matchesSafe && matchesDog;
        card.style.display = isVisible ? '' : 'none';
        if (isVisible) visibleCount++;
      });

      if (countDisplay) {
        countDisplay.textContent = `Showing ${visibleCount} beach${visibleCount === 1 ? '' : 'es'}`;
      }

      const emptyState = document.getElementById('no-beaches-empty-state');
      if (emptyState) {
        emptyState.classList.toggle('hidden', visibleCount > 0);
      }
    }

    searchInput?.addEventListener('input', () => {
      searchClear?.classList.toggle('hidden', !searchInput.value);
      applyFilters();
    });

    searchClear?.addEventListener('click', () => {
      if (searchInput) searchInput.value = '';
      searchClear.classList.add('hidden');
      applyFilters();
    });

    muniChips.forEach((chip) => {
      chip.addEventListener('click', () => {
        muniChips.forEach((c) => {
          c.classList.remove('bg-slate-900', 'dark:bg-white', 'text-white', 'dark:text-slate-900', 'font-semibold');
          c.classList.add('bg-slate-100', 'dark:bg-slate-800', 'text-slate-600', 'dark:text-slate-300');
        });
        chip.classList.remove('bg-slate-100', 'dark:bg-slate-800', 'text-slate-600', 'dark:text-slate-300');
        chip.classList.add('bg-slate-900', 'dark:bg-white', 'text-white', 'dark:text-slate-900', 'font-semibold');

        currentMuni = (chip as HTMLElement).dataset.muni || 'all';
        applyFilters();
      });
    });

    safeToggle?.addEventListener('click', () => {
      safeOnly = !safeOnly;
      safeToggle.classList.toggle('bg-emerald-600', safeOnly);
      safeToggle.classList.toggle('text-white', safeOnly);
      applyFilters();
    });

    dogToggle?.addEventListener('click', () => {
      dogOnly = !dogOnly;
      dogToggle.classList.toggle('bg-amber-600', dogOnly);
      dogToggle.classList.toggle('text-white', dogOnly);
      applyFilters();
    });

    sortSelect?.addEventListener('change', () => {
      const mode = sortSelect.value;
      const cards = Array.from(document.querySelectorAll('.beach-card')) as HTMLElement[];

      cards.sort((a, b) => {
        if (mode === 'name') {
          return (a.dataset.beachName || '').localeCompare(b.dataset.beachName || '');
        }
        if (mode === 'cleanest') {
          const eA = parseInt(a.dataset.beachEcoli || '999', 10);
          const eB = parseInt(b.dataset.beachEcoli || '999', 10);
          return eA - eB;
        }
        // Distance sort
        const dA = parseFloat(a.dataset.distanceKm || '999');
        const dB = parseFloat(b.dataset.distanceKm || '999');
        return dA - dB;
      });

      cards.forEach((card) => grid.appendChild(card));
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initFilters);
  } else {
    initFilters();
  }
</script>
