---
import type { CommunityEvent } from '../types';
import { getCategoryMeta } from '../services/eventService';

interface Props {
  event: CommunityEvent;
}

const { event } = Astro.props;
const catMeta = getCategoryMeta(event.category);
const startDate = new Date(event.startDateTime);
---

<div
  class="event-card block p-4 sm:p-5 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 shadow-xs hover:border-sky-500 transition-all flex flex-col justify-between"
  data-event-id={event.id}
  data-category={event.category}
  data-lat={event.latitude}
  data-lng={event.longitude}
>
  <div>
    <!-- Header: Date Pill, Free Badge & Star Pin -->
    <div class="flex items-start justify-between gap-2 mb-2">
      <div>
        <div class="flex items-center gap-2">
          <span class={`inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-xs font-bold border ${catMeta.badgeBg}`}>
            <span>{catMeta.icon}</span>
            <span>{catMeta.label}</span>
          </span>
          <span class="px-2 py-0.5 rounded-full text-[11px] font-extrabold bg-emerald-500/15 text-emerald-700 dark:text-emerald-300 border border-emerald-500/30">
            100% Free
          </span>
        </div>
        <a href={`/events/${event.id}`} class="hover:text-sky-500 transition-colors">
          <h3 class="text-base sm:text-lg font-bold text-slate-900 dark:text-white mt-1.5">
            {event.title}
          </h3>
        </a>
        <p class="text-xs text-slate-500 dark:text-slate-400">
          📍 {event.venueName} • {event.neighbourhood}
        </p>
      </div>

      <button
        type="button"
        class="star-btn p-1.5 rounded-lg text-slate-300 hover:text-amber-400 dark:text-slate-600 dark:hover:text-amber-400 transition-colors shrink-0"
        data-event-star-id={event.id}
        title="Pin to Dashboard"
      >
        <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24">
          <path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/>
        </svg>
      </button>
    </div>

    <!-- Date & Schedule Box -->
    <div class="p-2.5 rounded-xl bg-slate-50 dark:bg-slate-800/60 border border-slate-100 dark:border-slate-700/60 text-xs mb-3 flex items-center justify-between">
      <div>
        <span class="text-slate-500 dark:text-slate-400 block text-[11px]">When:</span>
        <span class="font-bold text-slate-900 dark:text-white">
          {startDate.toLocaleDateString([], { weekday: 'short', month: 'short', day: 'numeric', timeZone: 'America/Vancouver' })} @ {startDate.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit', timeZone: 'America/Vancouver' })}
        </span>
      </div>
      <div class="text-right">
        <span class="text-slate-500 dark:text-slate-400 block text-[11px]">Weather:</span>
        <span class="font-bold text-sky-600 dark:text-sky-400">
          {event.rainOrShine ? '☔ Rain or Shine' : '☀️ Weather Permitting'}
        </span>
      </div>
    </div>

    <!-- Short Description -->
    <p class="text-xs text-slate-600 dark:text-slate-300 leading-relaxed mb-3">
      {event.shortDescription}
    </p>
  </div>

  <!-- Bottom Transit & Link -->
  <div class="flex items-center justify-between pt-2 border-t border-slate-100 dark:border-slate-800/60 text-xs font-semibold">
    <span class="event-distance-label text-slate-500 dark:text-slate-400">
      🚇 {event.transitAccess.nearestSkyTrainStation || event.transitAccess.busRoutes[0]}
    </span>
    <a
      href={`/events/${event.id}`}
      class="text-sky-600 dark:text-sky-400 hover:underline flex items-center gap-1"
    >
      <span>Event Details</span>
      <span>→</span>
    </a>
  </div>
</div>
