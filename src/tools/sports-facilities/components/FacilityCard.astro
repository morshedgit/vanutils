---
import type { SportsFacility } from '../types';
import { getCategoryMeta } from '../services/sportsService';

interface Props {
  facility: SportsFacility;
}

const { facility } = Astro.props;
const catMeta = getCategoryMeta(facility.category);
---

<div
  class="facility-card block p-4 sm:p-5 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 shadow-xs hover:border-sky-500 transition-all flex flex-col justify-between"
  data-facility-id={facility.id}
  data-category={facility.category}
  data-has-lights={facility.courtDetails?.hasLights ? 'true' : 'false'}
  data-lat={facility.latitude}
  data-lng={facility.longitude}
>
  <div>
    <!-- Top Header: Category, Specs & Star Pin -->
    <div class="flex items-start justify-between gap-2 mb-2">
      <div>
        <div class="flex items-center gap-2 flex-wrap">
          <span class={`inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-xs font-bold border ${catMeta.badgeBg}`}>
            <span>{catMeta.icon}</span>
            <span>{catMeta.label}</span>
          </span>

          {facility.courtDetails && (
            <span class="px-2 py-0.5 rounded-full text-[11px] font-extrabold bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 border border-slate-200 dark:border-slate-700">
              {facility.courtDetails.totalCourts} {facility.category.includes('court') ? 'Courts' : 'Pitches'}
            </span>
          )}

          {facility.poolDetails && (
            <span class="px-2 py-0.5 rounded-full text-[11px] font-extrabold bg-sky-500/15 text-sky-700 dark:text-sky-300 border border-sky-500/20">
              {facility.poolDetails.poolLengthMeters}m Pool
            </span>
          )}

          {facility.courtDetails?.hasLights && (
            <span class="px-2 py-0.5 rounded-full text-[10px] font-black bg-amber-500/15 text-amber-700 dark:text-amber-300 border border-amber-500/30 flex items-center gap-1">
              <span>💡</span>
              <span>Lights to {facility.courtDetails.lightsCurfewTime || '10 PM'}</span>
            </span>
          )}
        </div>

        <a href={`/sports/${facility.id}`} class="hover:text-sky-500 transition-colors block mt-1.5">
          <h3 class="text-base sm:text-lg font-bold text-slate-900 dark:text-white leading-snug">
            {facility.name}
          </h3>
        </a>
        <p class="text-xs text-slate-500 dark:text-slate-400">
          📍 {facility.address} • {facility.neighbourhood}
        </p>
      </div>

      <button
        type="button"
        class="star-btn p-1.5 rounded-lg text-slate-300 hover:text-amber-400 dark:text-slate-600 dark:hover:text-amber-400 transition-colors shrink-0"
        data-facility-star-id={facility.id}
        title="Pin to Dashboard"
      >
        <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24">
          <path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/>
        </svg>
      </button>
    </div>

    <!-- Active Session & Rules Box -->
    <div class="p-2.5 rounded-xl bg-slate-50 dark:bg-slate-800/60 border border-slate-100 dark:border-slate-700/60 text-xs mb-3 space-y-1.5">
      <div class="flex items-center justify-between font-bold">
        <span class="text-slate-500 dark:text-slate-400 flex items-center gap-1">
          <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
          <span>Live Session:</span>
        </span>
        <span class="text-slate-900 dark:text-white">
          {facility.session.currentMode}
        </span>
      </div>

      {facility.session.endsAt && (
        <div class="flex items-center justify-between text-[11px] text-slate-500 dark:text-slate-400">
          <span>Session Ends:</span>
          <span class="font-bold text-amber-600 dark:text-amber-400">{facility.session.endsAt} (Next: {facility.session.nextMode})</span>
        </div>
      )}

      {facility.courtDetails?.surfaceType && (
        <div class="flex items-center justify-between pt-1 border-t border-slate-200/60 dark:border-slate-700/40 text-[11px]">
          <span class="text-slate-500 dark:text-slate-400">Surface / Specs:</span>
          <span class="font-semibold text-slate-700 dark:text-slate-300">{facility.courtDetails.surfaceType}</span>
        </div>
      )}
    </div>
  </div>

  <!-- Bottom Phone & Link -->
  <div class="flex items-center justify-between pt-2 border-t border-slate-100 dark:border-slate-800/60 text-xs font-semibold">
    <span class="facility-distance-label text-slate-500 dark:text-slate-400">
      📞 {facility.phone || 'Park Board Drop-in'}
    </span>
    <a
      href={`/sports/${facility.id}`}
      class="text-sky-600 dark:text-sky-400 hover:underline flex items-center gap-1"
    >
      <span>Facility & Schedule</span>
      <span>→</span>
    </a>
  </div>
</div>
