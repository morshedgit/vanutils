---
import type { StreetSweepingSchedule } from '../types';

interface Props {
  schedule: StreetSweepingSchedule;
  neighbourhoodName: string;
}

const { schedule, neighbourhoodName } = Astro.props;
---

<div class={`p-3 sm:p-4 rounded-xl border ${schedule.isWithin12Hours ? 'bg-amber-500/10 border-amber-500/30' : 'bg-slate-50 dark:bg-slate-800/60 border-slate-200 dark:border-slate-700/60'}`}>
  <div class="flex items-center justify-between gap-2 mb-2">
    <div class="flex items-center gap-2">
      <span class="text-lg">🧹</span>
      <span class="text-xs sm:text-sm font-bold text-slate-900 dark:text-white">
        Street Sweeping Radar
      </span>
    </div>
    {schedule.isCurrentlyActive ? (
      <span class="px-2 py-0.5 rounded-full text-[11px] font-bold bg-rose-500/20 text-rose-700 dark:text-rose-300 border border-rose-500/30">
        Active Sweeping Now
      </span>
    ) : schedule.isWithin12Hours ? (
      <span class="px-2 py-0.5 rounded-full text-[11px] font-bold bg-amber-500/20 text-amber-700 dark:text-amber-300 border border-amber-500/30">
        Starts Within 12h
      </span>
    ) : (
      <span class="px-2 py-0.5 rounded-full text-[11px] font-semibold bg-emerald-500/10 text-emerald-700 dark:text-emerald-300 border border-emerald-500/20">
        Clear Next 24h
      </span>
    )}
  </div>

  <div class="space-y-1 text-xs text-slate-600 dark:text-slate-300">
    <div class="flex justify-between">
      <span class="text-slate-500 dark:text-slate-400">Schedule Cadence:</span>
      <span class="font-medium">{schedule.frequency}</span>
    </div>
    <div class="flex justify-between">
      <span class="text-slate-500 dark:text-slate-400">Sweep Window:</span>
      <span class="font-medium">{schedule.nextSweepStart} – {schedule.nextSweepEnd}</span>
    </div>
  </div>

  {schedule.seasonalLeafCleaningActive && (
    <div class="mt-2.5 p-2 rounded-lg bg-amber-500/15 border border-amber-500/30 text-[11px] text-amber-800 dark:text-amber-200 flex items-center gap-1.5">
      <span>🍂</span>
      <span><strong>Autumn Leaf Removal Zone:</strong> Temporary no-parking signs take precedence over regular rules.</span>
    </div>
  )}
</div>
