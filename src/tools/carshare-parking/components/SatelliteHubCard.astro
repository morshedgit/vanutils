---
import type { SatelliteLot } from '../types';

interface Props {
  lot: SatelliteLot;
}

const { lot } = Astro.props;

const categoryIcons = {
  airport: '✈️',
  university: '🎓',
  mountain: '🏔️',
  ferry: '⛴️',
};
---

<div class="p-4 sm:p-5 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 shadow-xs hover:border-sky-500 transition-all flex flex-col justify-between">
  <div>
    <!-- Header -->
    <div class="flex items-start justify-between gap-2 mb-3">
      <div class="flex items-center gap-2">
        <span class="text-xl">{categoryIcons[lot.category] || '🅿️'}</span>
        <div>
          <h3 class="text-sm sm:text-base font-bold text-slate-900 dark:text-white">
            {lot.name}
          </h3>
          <p class="text-xs text-slate-500 dark:text-slate-400">
            {lot.locationName}
          </p>
        </div>
      </div>
      <span class="px-2.5 py-1 rounded-full text-xs font-extrabold bg-sky-500/10 text-sky-700 dark:text-sky-300 border border-sky-500/20 shrink-0">
        {lot.availableStallsEstimate || lot.totalStalls} / {lot.totalStalls} Stalls
      </span>
    </div>

    <!-- Instructions & Fee Details -->
    <div class="space-y-2 text-xs text-slate-600 dark:text-slate-300 mb-4">
      <div class="p-2.5 rounded-xl bg-slate-50 dark:bg-slate-800/60 border border-slate-100 dark:border-slate-700/60">
        <span class="text-slate-500 dark:text-slate-400 font-semibold block mb-0.5">Access Instructions:</span>
        <p class="leading-relaxed">{lot.accessInstructions}</p>
      </div>
      <div class="flex items-center justify-between text-[11px] text-slate-500 dark:text-slate-400 pt-1">
        <span>💰 Fee: <strong class="text-slate-700 dark:text-slate-300">{lot.feeDetails}</strong></span>
        <span>⏱️ {lot.operatingHours}</span>
      </div>
    </div>
  </div>

  <!-- Action Button -->
  <a
    href={lot.directionsUrl}
    target="_blank"
    rel="noopener noreferrer"
    class="w-full inline-flex items-center justify-center gap-2 py-2 px-3 rounded-xl bg-slate-100 hover:bg-sky-500 hover:text-white dark:bg-slate-800 dark:hover:bg-sky-500 text-slate-700 dark:text-slate-200 text-xs font-bold transition-colors"
  >
    <span>📍 Google Maps Navigation</span>
  </a>
</div>
