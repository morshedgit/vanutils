---
import type { WeatherStation } from '../types';
import WeatherBadge from './WeatherBadge.astro';
import PrecipitationSparkline from './PrecipitationSparkline.astro';

interface Props {
  station: WeatherStation;
}

const { station } = Astro.props;
---

<a
  href={`/weather/${station.id}`}
  data-station-card
  data-region={station.region}
  data-lat={station.latitude}
  data-lng={station.longitude}
  data-name={station.name.toLowerCase()}
  class="group flex flex-col justify-between rounded-2xl border border-slate-200/80 dark:border-slate-800/80 bg-white dark:bg-slate-900 p-5 shadow-sm hover:shadow-md hover:border-sky-500/50 dark:hover:border-sky-500/50 transition-all duration-200"
>
  <div class="space-y-4">
    <!-- Header: Title, Region, Weather Badge -->
    <div class="flex items-start justify-between gap-3">
      <div>
        <div class="flex items-center gap-2">
          <h3 class="font-bold text-base text-slate-900 dark:text-white group-hover:text-sky-600 dark:group-hover:text-sky-400 transition-colors">
            {station.name}
          </h3>
          <span
            data-pin-btn
            data-tool="weather-forecast"
            data-item-id={station.id}
            class="text-slate-300 dark:text-slate-700 hover:text-amber-500 text-sm cursor-pointer p-0.5"
            title="Pin to top"
          >
            ★
          </span>
        </div>
        <div class="flex items-center gap-2 text-xs text-slate-500 dark:text-slate-400 mt-0.5">
          <span class="capitalize">{station.region.replace(/_/g, ' ')}</span>
          <span>•</span>
          <span>Elev: {station.elevationMeters}m</span>
          {station.officialStationCode && (
            <>
              <span>•</span>
              <span class="font-mono text-[10px] bg-slate-100 dark:bg-slate-800 px-1.5 py-0.2 rounded">ECCC {station.officialStationCode}</span>
            </>
          )}
        </div>
      </div>
      <WeatherBadge condition={station.current.condition} size="sm" />
    </div>

    <!-- Live Telemetry Grid -->
    <div class="grid grid-cols-3 gap-2 py-3 px-3 rounded-xl bg-slate-50 dark:bg-slate-800/50 border border-slate-100 dark:border-slate-800">
      <!-- Temp & Feels Like -->
      <div class="flex flex-col">
        <span class="text-[10px] font-medium text-slate-500 dark:text-slate-400 uppercase tracking-wider">Temp</span>
        <span class="text-xl font-extrabold text-slate-900 dark:text-white tracking-tight">
          {station.current.temperatureCelsius}°C
        </span>
        <span class="text-[10px] text-slate-500 dark:text-slate-400">
          Feels: {station.current.feelsLikeCelsius}°C
        </span>
      </div>

      <!-- Wind & Direction -->
      <div class="flex flex-col border-x border-slate-200/60 dark:border-slate-700/60 px-2">
        <span class="text-[10px] font-medium text-slate-500 dark:text-slate-400 uppercase tracking-wider">Wind</span>
        <span class="text-xs font-bold text-slate-800 dark:text-slate-200 mt-1">
          {station.current.windDirection} {station.current.windSpeedKmh} km/h
        </span>
        {station.current.windGustKmh && station.current.windGustKmh > station.current.windSpeedKmh && (
          <span class="text-[10px] text-slate-500 dark:text-slate-400">
            Gusts: {station.current.windGustKmh} km/h
          </span>
        )}
      </div>

      <!-- Humidity & UV Index -->
      <div class="flex flex-col pl-1">
        <span class="text-[10px] font-medium text-slate-500 dark:text-slate-400 uppercase tracking-wider">Atmosphere</span>
        <span class="text-xs font-semibold text-slate-800 dark:text-slate-200 mt-1">
          {station.current.humidityPercent}% RH
        </span>
        <span class="text-[10px] text-slate-500 dark:text-slate-400">
          UV: {station.current.uvIndex} • {station.current.pressureKpa} kPa
        </span>
      </div>
    </div>

    <!-- 24h Hourly Precipitation Sparkline -->
    <div class="pt-1">
      <PrecipitationSparkline hourly={station.hourly} />
    </div>
  </div>

  <!-- Footer Action / Details -->
  <div class="mt-4 pt-3 border-t border-slate-100 dark:border-slate-800/80 flex items-center justify-between text-xs">
    <span class="text-slate-500 dark:text-slate-400 flex items-center gap-1">
      <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
      <span>Live Model Telemetry</span>
    </span>
    <span class="font-bold text-sky-600 dark:text-sky-400 group-hover:translate-x-0.5 transition-transform flex items-center gap-1">
      <span>24h Sounding & 7-Day</span>
      <span>→</span>
    </span>
  </div>
</a>
