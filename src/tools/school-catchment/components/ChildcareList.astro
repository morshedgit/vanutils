---
import type { LicensedChildcareCenter } from '../types';

interface Props {
  childcares: LicensedChildcareCenter[];
}

const { childcares } = Astro.props;

const facilityLabels = {
  infant_toddler: '🍼 Infant & Toddler (0–36 mos)',
  group_3_5: '🎨 Group 3–5 Years',
  preschool: '✏️ Preschool',
  school_age: '🎒 School-Age Out of School Care',
};
---

<div id="childcares-section" class="space-y-4 pt-2">
  <div class="border-b border-slate-200 dark:border-slate-800 pb-2">
    <h3 class="text-base font-bold text-slate-900 dark:text-white flex items-center gap-2">
      <span>🧸</span>
      <span>Licensed Childcare Centres & Daycares (VCH Inspected)</span>
    </h3>
    <p class="text-xs text-slate-500 dark:text-slate-400">
      Verified licensed childcare facilities monitored under Vancouver Coastal Health Community Care Licensing regulations.
    </p>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
    {childcares.map((c) => (
      <div class="p-4 sm:p-5 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 shadow-xs flex flex-col justify-between">
        <div>
          <div class="flex items-start justify-between gap-2 mb-2">
            <div>
              <span class="text-xs font-bold text-sky-600 dark:text-sky-400">
                {facilityLabels[c.facilityType]}
              </span>
              <h4 class="text-sm sm:text-base font-bold text-slate-900 dark:text-white mt-0.5">
                {c.name}
              </h4>
            </div>
            <span class="px-2 py-0.5 rounded-full text-[11px] font-extrabold bg-emerald-500/15 text-emerald-700 dark:text-emerald-300 border border-emerald-500/30 shrink-0">
              {c.licensedCapacity} Licensed Spots
            </span>
          </div>

          <p class="text-xs text-slate-500 dark:text-slate-400 mb-3">
            📍 {c.address} • {c.neighbourhood}
          </p>

          <!-- VCH Inspection Box -->
          <div class="p-2.5 rounded-xl bg-emerald-500/10 dark:bg-emerald-950/30 border border-emerald-500/30 text-xs mb-3 space-y-1">
            <div class="flex items-center justify-between font-bold text-emerald-700 dark:text-emerald-300 text-[11px]">
              <span>✓ VCH Inspection: {c.lastInspection.status.toUpperCase()}</span>
              <span>{new Date(c.lastInspection.inspectionDate).toLocaleDateString([], { month: 'short', year: 'numeric' })}</span>
            </div>
            <p class="text-[11px] text-slate-600 dark:text-slate-300">
              {c.lastInspection.summary}
            </p>
          </div>
        </div>

        <div class="flex items-center justify-between pt-2 border-t border-slate-100 dark:border-slate-800/60 text-xs font-semibold">
          <span class="text-slate-500 dark:text-slate-400">
            📞 {c.phone}
          </span>
          <a
            href={c.lastInspection.reportUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="text-sky-600 dark:text-sky-400 hover:underline"
          >
            VCH Inspection Report →
          </a>
        </div>
      </div>
    ))}
  </div>
</div>
