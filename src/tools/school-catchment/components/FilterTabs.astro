---
interface Props {
  activeTab?: string;
}

const { activeTab = 'all' } = Astro.props;

const tabs = [
  { id: 'all', label: 'All Schools', icon: '🏫' },
  { id: 'elementary', label: 'Elementary (K–7)', icon: '🎒' },
  { id: 'secondary', label: 'Secondary (8–12)', icon: '🏛️' },
  { id: 'annex', label: 'Annexes (K–3)', icon: '🧒' },
  { id: 'french', label: 'French Immersion', icon: '🇫🇷' },
  { id: 'childcare', label: 'Licensed Childcare', icon: '🧸' },
];
---

<div class="flex items-center gap-1.5 overflow-x-auto pb-2 scrollbar-none text-xs font-semibold">
  {tabs.map((t) => (
    <button
      type="button"
      data-school-tab={t.id}
      class={`school-filter-btn px-3 py-1.5 rounded-xl border transition-all whitespace-nowrap flex items-center gap-1.5 ${
        t.id === activeTab
          ? 'bg-slate-900 text-white border-slate-900 dark:bg-white dark:text-slate-900 dark:border-white shadow-xs'
          : 'bg-white dark:bg-slate-900 text-slate-600 dark:text-slate-400 border-slate-200 dark:border-slate-800 hover:border-slate-300 dark:hover:border-slate-700'
      }`}
    >
      <span>{t.icon}</span>
      <span>{t.label}</span>
    </button>
  ))}
</div>

<script>
  function setupSchoolFilterTabs() {
    const buttons = document.querySelectorAll('.school-filter-btn');
    const cards = document.querySelectorAll('.school-card');
    const childcaresSection = document.getElementById('childcares-section');

    buttons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const tabId = btn.getAttribute('data-school-tab');

        // Update button states
        buttons.forEach((b) => {
          b.classList.remove('bg-slate-900', 'text-white', 'border-slate-900', 'dark:bg-white', 'dark:text-slate-900', 'dark:border-white', 'shadow-xs');
          b.classList.add('bg-white', 'dark:bg-slate-900', 'text-slate-600', 'dark:text-slate-400', 'border-slate-200', 'dark:border-slate-800');
        });
        btn.classList.remove('bg-white', 'dark:bg-slate-900', 'text-slate-600', 'dark:text-slate-400', 'border-slate-200', 'dark:border-slate-800');
        btn.classList.add('bg-slate-900', 'text-white', 'border-slate-900', 'dark:bg-white', 'dark:text-slate-900', 'dark:border-white', 'shadow-xs');

        if (tabId === 'childcare') {
          if (childcaresSection) childcaresSection.classList.remove('hidden');
          cards.forEach((c) => (c as HTMLElement).classList.add('hidden'));
        } else {
          if (childcaresSection) childcaresSection.classList.remove('hidden');
          cards.forEach((card) => {
            const cat = card.getAttribute('data-category');
            const hasFrench = card.getAttribute('data-has-french') === 'true';

            let match = false;
            if (tabId === 'all') match = true;
            else if (tabId === 'elementary' && cat === 'elementary') match = true;
            else if (tabId === 'secondary' && cat === 'secondary') match = true;
            else if (tabId === 'annex' && cat === 'elementary_annex') match = true;
            else if (tabId === 'french' && hasFrench) match = true;

            if (match) {
              (card as HTMLElement).classList.remove('hidden');
            } else {
              (card as HTMLElement).classList.add('hidden');
            }
          });
        }
      });
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupSchoolFilterTabs);
  } else {
    setupSchoolFilterTabs();
  }
</script>
