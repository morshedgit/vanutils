---
import type { SchoolInfo } from '../types';

interface Props {
  school: SchoolInfo;
}

const { school } = Astro.props;

const categoryLabels = {
  elementary: '🎒 Elementary School',
  elementary_annex: '🧒 Elementary Annex',
  secondary: '🏫 Secondary High School',
};
---

<div
  class="school-card block p-4 sm:p-5 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 shadow-xs hover:border-sky-500 transition-all flex flex-col justify-between"
  data-school-id={school.id}
  data-category={school.category}
  data-has-french={school.programs.includes('early_french_immersion') || school.programs.includes('late_french_immersion')}
  data-lat={school.latitude}
  data-lng={school.longitude}
>
  <div>
    <!-- Header: Category, Grade Span & Star Pin -->
    <div class="flex items-start justify-between gap-2 mb-2">
      <div>
        <div class="flex items-center gap-2">
          <span class="text-xs font-bold text-sky-600 dark:text-sky-400">
            {categoryLabels[school.category]}
          </span>
          <span class="px-2 py-0.5 rounded-full text-[11px] font-extrabold bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 border border-slate-200 dark:border-slate-700">
            Grades {school.gradeSpan}
          </span>
        </div>
        <a href={`/schools/${school.id}`} class="hover:text-sky-500 transition-colors">
          <h3 class="text-base sm:text-lg font-bold text-slate-900 dark:text-white mt-1">
            {school.name}
          </h3>
        </a>
        <p class="text-xs text-slate-500 dark:text-slate-400">
          📍 {school.address} • {school.neighbourhood}
        </p>
      </div>

      <button
        type="button"
        class="star-btn p-1.5 rounded-lg text-slate-300 hover:text-amber-400 dark:text-slate-600 dark:hover:text-amber-400 transition-colors shrink-0"
        data-school-star-id={school.id}
        title="Pin to Dashboard"
      >
        <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24">
          <path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/>
        </svg>
      </button>
    </div>

    <!-- Programs & Feeder Box -->
    <div class="p-2.5 rounded-xl bg-slate-50 dark:bg-slate-800/60 border border-slate-100 dark:border-slate-700/60 text-xs mb-3 space-y-1.5">
      <div class="flex items-center justify-between">
        <span class="text-slate-500 dark:text-slate-400">Programs Offered:</span>
        <span class="font-bold text-slate-800 dark:text-slate-200">
          {school.programs.map((p) => {
            if (p === 'early_french_immersion') return '🇫🇷 Early French';
            if (p === 'late_french_immersion') return '🇫🇷 Late French';
            if (p === 'ib') return '🎓 IB Diploma';
            return '📘 English Regular';
          }).join(' • ')}
        </span>
      </div>

      {school.feederSecondary && (
        <div class="flex items-center justify-between pt-1 border-t border-slate-200/60 dark:border-slate-700/40 text-[11px]">
          <span class="text-slate-500 dark:text-slate-400">Secondary Feeder Track:</span>
          <span class="font-bold text-sky-600 dark:text-sky-400">→ {school.feederSecondary}</span>
        </div>
      )}
      {school.feederElementary && (
        <div class="flex items-center justify-between pt-1 border-t border-slate-200/60 dark:border-slate-700/40 text-[11px]">
          <span class="text-slate-500 dark:text-slate-400">Feeds into Main School:</span>
          <span class="font-bold text-sky-600 dark:text-sky-400">→ {school.feederElementary}</span>
        </div>
      )}
    </div>
  </div>

  <!-- Bottom Phone & Link -->
  <div class="flex items-center justify-between pt-2 border-t border-slate-100 dark:border-slate-800/60 text-xs font-semibold">
    <span class="school-distance-label text-slate-500 dark:text-slate-400">
      📞 {school.phone}
    </span>
    <a
      href={`/schools/${school.id}`}
      class="text-sky-600 dark:text-sky-400 hover:underline flex items-center gap-1"
    >
      <span>Catchment Profile</span>
      <span>→</span>
    </a>
  </div>
</div>
