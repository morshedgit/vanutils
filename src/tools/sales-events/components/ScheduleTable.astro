---
import type { SaleDateSchedule } from '../types';

interface Props {
  schedule: SaleDateSchedule[];
}

const { schedule } = Astro.props;
---

<div class="p-4 sm:p-5 rounded-2xl bg-white dark:bg-slate-900/90 border border-slate-200/90 dark:border-slate-800 space-y-3">
  <div class="flex items-center justify-between">
    <div class="flex items-center gap-2">
      <span class="text-lg">🕒</span>
      <h3 class="text-sm sm:text-base font-bold text-slate-900 dark:text-white">
        Operating Hours &amp; Daily Schedule
      </h3>
    </div>
    <span class="text-[10px] font-bold px-2 py-0.5 rounded-full bg-sky-500/10 text-sky-600 dark:text-sky-400 border border-sky-500/20">
      {schedule.length} Sale Days
    </span>
  </div>

  <div class="overflow-x-auto">
    <table class="w-full text-xs text-left border-collapse">
      <thead>
        <tr class="border-b border-slate-200 dark:border-slate-800 text-slate-400 font-semibold text-[11px]">
          <th class="py-2.5 px-3">Date</th>
          <th class="py-2.5 px-3">Day</th>
          <th class="py-2.5 px-3">Hours</th>
          <th class="py-2.5 px-3">Restock &amp; Special Focus</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-slate-100 dark:divide-slate-800/60">
        {schedule.map((slot) => (
          <tr class="hover:bg-slate-50 dark:hover:bg-slate-800/40 transition-colors">
            <td class="py-2.5 px-3 font-mono font-bold text-slate-900 dark:text-white whitespace-nowrap">
              {slot.date}
            </td>
            <td class="py-2.5 px-3 font-medium text-slate-700 dark:text-slate-300 whitespace-nowrap">
              {slot.dayOfWeek}
            </td>
            <td class="py-2.5 px-3 font-semibold text-sky-600 dark:text-sky-400 whitespace-nowrap">
              {slot.openTime} — {slot.closeTime}
            </td>
            <td class="py-2.5 px-3 text-slate-600 dark:text-slate-400">
              {slot.notes || 'Standard inventory flow'}
            </td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
</div>
