---
import type { SalesEvent } from '../types';

interface Props {
  sale: SalesEvent;
}

const { sale } = Astro.props;

// Format Google Calendar URL
const firstSlot = sale.schedule[0];
const lastSlot = sale.schedule[sale.schedule.length - 1];

const startIso = firstSlot ? `${firstSlot.date.replace(/-/g, '')}T${firstSlot.openTime.replace(':', '')}00` : '20260827T070000';
const endIso = lastSlot ? `${lastSlot.date.replace(/-/g, '')}T${lastSlot.closeTime.replace(':', '')}00` : '20260901T180000';

const gcalUrl = `https://calendar.google.com/calendar/render?action=TEMPLATE&text=${encodeURIComponent(
  sale.name
)}&dates=${startIso}/${endIso}&details=${encodeURIComponent(
  `${sale.discountRange} • ${sale.brand}\nLineup Advice: ${sale.lineupAdvice}\n\nVerified on VanHeartbeat Sales Radar.`
)}&location=${encodeURIComponent(`${sale.venueName}, ${sale.venueAddress}`)}`;

// Generate data URI for .ics file download
const icsContent = [
  'BEGIN:VCALENDAR',
  'VERSION:2.0',
  'PRODID:-//VanHeartbeat//Sales Events Radar//EN',
  'BEGIN:VEVENT',
  `SUMMARY:${sale.name}`,
  `DESCRIPTION:${sale.discountRange} - ${sale.brand}\\n${sale.lineupAdvice}`,
  `LOCATION:${sale.venueName}, ${sale.venueAddress}`,
  `DTSTART:${startIso}`,
  `DTEND:${endIso}`,
  'STATUS:CONFIRMED',
  'END:VEVENT',
  'END:VCALENDAR',
].join('\r\n');

const icsDataUri = `data:text/calendar;charset=utf8,${encodeURIComponent(icsContent)}`;
---

<div class="flex flex-wrap items-center gap-2">
  <a
    href={gcalUrl}
    target="_blank"
    rel="noopener noreferrer"
    class="inline-flex items-center gap-1.5 px-3 py-2 rounded-xl text-xs font-semibold bg-sky-600 hover:bg-sky-500 text-white shadow-xs transition-colors"
  >
    <span>📅</span>
    <span>Add to Google Calendar</span>
  </a>

  <a
    href={icsDataUri}
    download={`${sale.id}.ics`}
    class="inline-flex items-center gap-1.5 px-3 py-2 rounded-xl text-xs font-semibold bg-slate-100 dark:bg-slate-800 hover:bg-slate-200 dark:hover:bg-slate-700 text-slate-700 dark:text-slate-200 border border-slate-200 dark:border-slate-700 transition-colors"
  >
    <span>📥</span>
    <span>Download .ICS (Apple/Outlook)</span>
  </a>
</div>
