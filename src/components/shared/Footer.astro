---
import { TOOLS_REGISTRY } from '../../config/tools';
---

<footer class="border-t border-slate-200/80 dark:border-slate-800/80 bg-slate-50 dark:bg-slate-950/60 transition-colors mt-16">
  <div class="max-w-[1600px] mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-8 mb-10">
      <!-- Brand column -->
      <div class="md:col-span-2 space-y-4">
        <div class="flex items-center gap-2">
          <div class="w-7 h-7 rounded-lg bg-gradient-to-tr from-sky-600 to-teal-500 flex items-center justify-center text-white font-bold text-xs">
            VU
          </div>
          <span class="font-black text-slate-900 dark:text-white tracking-tight">Van<span class="text-sky-500">Utils</span></span>
          <span class="text-[10px] uppercase font-bold tracking-wider px-2 py-0.5 rounded bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border border-emerald-500/20">v1.0 MVP</span>
        </div>
        <p class="text-xs text-slate-600 dark:text-slate-400 max-w-md leading-relaxed">
          Ultra-lightweight, sub-second hyper-local micro-utilities designed specifically for Metro Vancouver residents.
          No ads, no tracking, no bloated apps — just the instant answers you need for outdoor & city living.
        </p>
        <div class="flex flex-wrap gap-2 text-[11px] text-slate-500 dark:text-slate-400">
          <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-md bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800">
            <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span> 0 Telemetry / Privacy First
          </span>
          <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-md bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800">
            <span class="w-1.5 h-1.5 rounded-full bg-sky-500"></span> &lt; 25KB Client JS Budget
          </span>
          <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-md bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800">
            <span class="w-1.5 h-1.5 rounded-full bg-amber-500"></span> Cloudflare Edge CDN
          </span>
        </div>
      </div>

      <!-- Utilities List -->
      <div>
        <h4 class="text-xs font-bold text-slate-900 dark:text-white uppercase tracking-wider mb-3">Micro-Utilities</h4>
        <ul class="space-y-2 text-xs">
          {TOOLS_REGISTRY.map((tool) => (
            <li>
              <a
                href={tool.path}
                class="text-slate-600 dark:text-slate-400 hover:text-sky-600 dark:hover:text-sky-400 transition-colors flex items-center justify-between"
              >
                <span>{tool.name}</span>
                {tool.status === 'active' ? (
                  <span class="text-[10px] text-emerald-500 font-semibold">Live</span>
                ) : (
                  <span class="text-[10px] text-slate-400">{tool.badgeText || 'Roadmap'}</span>
                )}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Official Data Sources -->
      <div>
        <h4 class="text-xs font-bold text-slate-900 dark:text-white uppercase tracking-wider mb-3">Official Data Sources</h4>
        <ul class="space-y-2 text-xs text-slate-600 dark:text-slate-400">
          <li>
            <a
              href="https://www.vch.ca/en/health-topics/public-health/environmental-health/beach-water-quality"
              target="_blank"
              rel="noopener noreferrer"
              class="hover:text-sky-500 transition-colors inline-flex items-center gap-1"
            >
              Vancouver Coastal Health (VCH)
              <svg class="w-3 h-3 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" /></svg>
            </a>
          </li>
          <li>
            <a
              href="https://www.fraserhealth.ca/health-topics-a-to-z/recreational-water/beach-water-quality"
              target="_blank"
              rel="noopener noreferrer"
              class="hover:text-sky-500 transition-colors inline-flex items-center gap-1"
            >
              Fraser Health Authority
              <svg class="w-3 h-3 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" /></svg>
            </a>
          </li>
          <li>
            <a
              href="https://vancouver.ca/parks-recreation-culture/beaches.aspx"
              target="_blank"
              rel="noopener noreferrer"
              class="hover:text-sky-500 transition-colors inline-flex items-center gap-1"
            >
              City of Vancouver Parks Board
              <svg class="w-3 h-3 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" /></svg>
            </a>
          </li>
          <li>
            <a
              href="https://weather.gc.ca/city/pages/bc-74_metric_e.html"
              target="_blank"
              rel="noopener noreferrer"
              class="hover:text-sky-500 transition-colors inline-flex items-center gap-1"
            >
              Environment and Climate Change Canada
              <svg class="w-3 h-3 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" /></svg>
            </a>
          </li>
        </ul>
      </div>
    </div>

    <div class="pt-8 border-t border-slate-200/80 dark:border-slate-800/80 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-slate-500 dark:text-slate-400">
      <p>© {new Date().getFullYear()} VanUtils. Handcrafted with precision in Metro Vancouver, BC 🌲🌊</p>
      <div class="flex items-center gap-4">
        <a href="/swim" class="hover:text-slate-900 dark:hover:text-white transition-colors">Can I Swim</a>
        <a href="/ferries" class="hover:text-slate-900 dark:hover:text-white transition-colors">Ferries</a>
        <a href="/snow" class="hover:text-slate-900 dark:hover:text-white transition-colors">Snow Line</a>
        <a href="https://github.com/morshedgit/vanutils" target="_blank" rel="noopener noreferrer" class="hover:text-slate-900 dark:hover:text-white transition-colors">GitHub</a>
      </div>
    </div>
  </div>
</footer>
