---
import { TOOLS_REGISTRY } from '../../config/tools';
---

<footer class="border-t border-slate-200/80 dark:border-slate-800/80 bg-slate-50 dark:bg-slate-950/80 transition-colors mt-16">
  <div class="max-w-[1600px] mx-auto px-4 sm:px-6 lg:px-8 py-12 sm:py-16">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8 lg:gap-10 mb-12">
      <!-- Column 1: Brand & Mission -->
      <div class="space-y-4">
        <div class="flex items-center gap-2">
          <div class="w-8 h-8 rounded-xl bg-gradient-to-tr from-sky-600 to-teal-500 flex items-center justify-center text-white font-bold text-xs shadow-md shadow-sky-500/20">
            VH
          </div>
          <span class="font-extrabold text-lg text-slate-900 dark:text-white tracking-tight">Van<span class="text-sky-600 dark:text-sky-400">Heartbeat</span></span>
          <span class="text-[11px] uppercase font-bold px-2 py-0.5 rounded-full bg-emerald-500/10 text-emerald-700 dark:text-emerald-300 border border-emerald-500/20">Live Pulse</span>
        </div>
        <p class="text-xs text-slate-600 dark:text-slate-400 leading-relaxed">
          Metro Vancouver's real-time civic pulse and public telemetry network. Ultra-fast, single-purpose micro-utilities with 100% verified public data, zero ads, and zero third-party tracking.
        </p>
        <div class="space-y-1.5 text-[11px] text-slate-500 dark:text-slate-400 pt-1">
          <div class="flex items-center gap-2">
            <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
            <span>Cloudflare Edge SSR • YVR Regional Edge</span>
          </div>
          <div class="flex items-center gap-2">
            <span class="w-2 h-2 rounded-full bg-sky-500"></span>
            <span>&lt; 25KB Client JS • 0 Tracker Guarantee</span>
          </div>
        </div>
      </div>

      <!-- Column 2: Utilities Directory -->
      <div>
        <div class="text-xs font-bold text-slate-900 dark:text-white uppercase tracking-wider mb-3">Micro-Utilities</div>
        <ul class="space-y-1 text-xs">
          {TOOLS_REGISTRY.slice(0, 8).map((tool) => (
            <li>
              <a
                href={tool.path}
                class="text-slate-600 dark:text-slate-400 hover:text-sky-600 dark:hover:text-sky-400 transition-colors flex items-center justify-between py-1 min-h-[24px]"
              >
                <span>{tool.name}</span>
                <span class="text-[10px] text-emerald-600 dark:text-emerald-400 font-semibold">Live</span>
              </a>
            </li>
          ))}
          <li>
            <a href="/" class="text-sky-600 dark:text-sky-400 font-bold hover:underline inline-flex items-center gap-1 py-1 min-h-[24px]">
              <span>View all {TOOLS_REGISTRY.length} tools</span>
              <span>→</span>
            </a>
          </li>
        </ul>
      </div>

      <!-- Column 3: Official Public Feeds & Provenance -->
      <div>
        <div class="text-xs font-bold text-slate-900 dark:text-white uppercase tracking-wider mb-3">Official Data Feeds</div>
        <ul class="space-y-1 text-xs text-slate-600 dark:text-slate-400">
          <li>
            <a
              href="https://www.vch.ca/en/health-topics/public-health/environmental-health/beach-water-quality"
              target="_blank"
              rel="noopener noreferrer"
              class="hover:text-sky-600 dark:hover:text-sky-400 transition-colors inline-flex items-center gap-1 py-1 min-h-[24px]"
            >
              <span>Vancouver Coastal Health (VCH)</span>
              <svg class="w-3 h-3 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" /></svg>
            </a>
          </li>
          <li>
            <a
              href="https://www.bcferries.com"
              target="_blank"
              rel="noopener noreferrer"
              class="hover:text-sky-600 dark:hover:text-sky-400 transition-colors inline-flex items-center gap-1 py-1 min-h-[24px]"
            >
              <span>BC Ferries Real-Time API</span>
              <svg class="w-3 h-3 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" /></svg>
            </a>
          </li>
          <li>
            <a
              href="https://www.drivebc.ca"
              target="_blank"
              rel="noopener noreferrer"
              class="hover:text-sky-600 dark:hover:text-sky-400 transition-colors inline-flex items-center gap-1 py-1 min-h-[24px]"
            >
              <span>DriveBC Open511 Telemetry</span>
              <svg class="w-3 h-3 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" /></svg>
            </a>
          </li>
          <li>
            <a
              href="https://opendata.vancouver.ca"
              target="_blank"
              rel="noopener noreferrer"
              class="hover:text-sky-600 dark:hover:text-sky-400 transition-colors inline-flex items-center gap-1 py-1 min-h-[24px]"
            >
              <span>City of Vancouver Open Data</span>
              <svg class="w-3 h-3 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" /></svg>
            </a>
          </li>
          <li>
            <a
              href="https://www.bankofcanada.ca/valet/docs"
              target="_blank"
              rel="noopener noreferrer"
              class="hover:text-sky-600 dark:hover:text-sky-400 transition-colors inline-flex items-center gap-1 py-1 min-h-[24px]"
            >
              <span>Bank of Canada Valet</span>
              <svg class="w-3 h-3 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" /></svg>
            </a>
          </li>
        </ul>
      </div>

      <!-- Column 4: Platform, Trust & Legal (Clean Text-Only, Zero Emojis) -->
      <div>
        <div class="text-xs font-bold text-slate-900 dark:text-white uppercase tracking-wider mb-3">Platform &amp; Legal</div>
        <ul class="space-y-1 text-xs text-slate-600 dark:text-slate-400">
          <li>
            <a href="/about" class="hover:text-sky-600 dark:hover:text-sky-400 transition-colors inline-flex items-center py-1 min-h-[24px]">
              About VanHeartbeat
            </a>
          </li>
          <li>
            <a href="/contact" class="hover:text-sky-600 dark:hover:text-sky-400 transition-colors inline-flex items-center py-1 min-h-[24px]">
              Contact Us &amp; Data Corrections
            </a>
          </li>
          <li>
            <a href="/privacy" class="hover:text-sky-600 dark:hover:text-sky-400 transition-colors inline-flex items-center py-1 min-h-[24px]">
              Privacy Policy
            </a>
          </li>
          <li>
            <a href="/terms" class="hover:text-sky-600 dark:hover:text-sky-400 transition-colors inline-flex items-center py-1 min-h-[24px]">
              Terms of Service
            </a>
          </li>
          <li>
            <a href="/cookies" class="hover:text-sky-600 dark:hover:text-sky-400 transition-colors inline-flex items-center py-1 min-h-[24px]">
              Cookie Policy
            </a>
          </li>
          <li>
            <a href="/sitemap.xml" target="_blank" class="hover:text-sky-600 dark:hover:text-sky-400 transition-colors inline-flex items-center py-1 min-h-[24px]">
              XML Sitemap
            </a>
          </li>
        </ul>
      </div>
    </div>

    <!-- Informational Disclaimer -->
    <div class="py-3 px-4 rounded-xl bg-slate-100/80 dark:bg-slate-900/60 border border-slate-200/60 dark:border-slate-800/60 text-[11px] text-slate-500 dark:text-slate-400 leading-relaxed mb-8">
      <strong class="text-slate-700 dark:text-slate-300">Public Safety Notice:</strong> VanHeartbeat aggregates real-time public telemetry for informational convenience. Metrics and wait estimates are calculated from live feeds. For medical emergencies or immediate life safety threats, dial <strong>911</strong> immediately. Always adhere to posted physical beach closure signage and emergency advisories.
    </div>

    <!-- Bottom Bar -->
    <div class="pt-6 border-t border-slate-200/80 dark:border-slate-800/80 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-slate-500 dark:text-slate-400">
      <p>© {new Date().getFullYear()} VanHeartbeat. Handcrafted in Vancouver, British Columbia.</p>
      <div class="flex flex-wrap items-center gap-4 text-xs">
        <a href="/about" class="hover:text-slate-900 dark:hover:text-white transition-colors inline-flex items-center py-1 px-1 min-h-[24px]">About</a>
        <a href="/contact" class="hover:text-slate-900 dark:hover:text-white transition-colors inline-flex items-center py-1 px-1 min-h-[24px]">Contact</a>
        <a href="/privacy" class="hover:text-slate-900 dark:hover:text-white transition-colors inline-flex items-center py-1 px-1 min-h-[24px]">Privacy</a>
        <a href="/terms" class="hover:text-slate-900 dark:hover:text-white transition-colors inline-flex items-center py-1 px-1 min-h-[24px]">Terms</a>
        <a href="/cookies" class="hover:text-slate-900 dark:hover:text-white transition-colors inline-flex items-center py-1 px-1 min-h-[24px]">Cookies</a>
      </div>
    </div>
  </div>
</footer>


