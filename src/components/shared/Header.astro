---
import ThemeToggle from './ThemeToggle.astro';
import GeoPicker from './GeoPicker.astro';
import { TOOLS_REGISTRY } from '../../config/tools';

interface Props {
  currentPath?: string;
}

const { currentPath = '/' } = Astro.props;

const outdoorsTools = TOOLS_REGISTRY.filter((t) => ['can-i-swim', 'mountain-snow', 'air-quality', 'sports-courts'].includes(t.id));
const transitTools = TOOLS_REGISTRY.filter((t) => ['bc-ferries', 'bridge-traffic', 'evo-parking'].includes(t.id));
const healthTools = TOOLS_REGISTRY.filter((t) => ['health-wait-times', 'community-events', 'school-catchment'].includes(t.id));
const civicTools = TOOLS_REGISTRY.filter((t) => ['civic-development', 'housing-market', 'local-news'].includes(t.id));
---

<header class="sticky top-0 z-40 w-full border-b border-slate-200/80 dark:border-slate-800/80 bg-white/90 dark:bg-slate-900/90 backdrop-blur-md transition-colors">
  <div class="max-w-[1600px] mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between gap-4">
    <!-- Brand Logo -->
    <div class="flex items-center gap-6 lg:gap-8">
      <a href="/" class="flex items-center gap-2.5 group focus:outline-none focus:ring-2 focus:ring-sky-500 rounded-lg p-1">
        <div class="w-9 h-9 rounded-xl bg-gradient-to-tr from-sky-600 to-teal-500 flex items-center justify-center text-white shadow-md shadow-sky-500/20 group-hover:scale-105 transition-transform shrink-0">
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3 15c4-3 7-3 10 0 3 3 7 3 10 0" />
            <path stroke-linecap="round" stroke-linejoin="round" d="M3 9c4-3 7-3 10 0 3 3 7 3 10 0" />
          </svg>
        </div>
        <div class="flex flex-col">
          <div class="flex items-center gap-1.5">
            <span class="font-extrabold text-lg tracking-tight text-slate-900 dark:text-white">Van<span class="text-sky-500">Utils</span></span>
            <span class="inline-flex items-center gap-1 text-[9px] font-bold uppercase px-1.5 py-0.5 rounded-full bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border border-emerald-500/20">
              <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
              Live
            </span>
          </div>
          <span class="text-[10px] font-medium text-slate-500 dark:text-slate-400 -mt-1 hidden sm:block">Metro Vancouver Civic Telemetry</span>
        </div>
      </a>

      <!-- Desktop Navigation Links (Categorized with Clean Hover Flyouts) -->
      <nav class="hidden lg:flex items-center gap-1">
        <a
          href="/"
          class={`px-3 py-1.5 rounded-lg text-xs font-semibold transition-colors ${
            currentPath === '/'
              ? 'bg-slate-100 dark:bg-slate-800 text-slate-900 dark:text-white'
              : 'text-slate-600 dark:text-slate-300 hover:bg-slate-50 dark:hover:bg-slate-800/50 hover:text-slate-900 dark:hover:text-white'
          }`}
        >
          Overview
        </a>

        <!-- Outdoors Category Dropdown -->
        <div class="relative group">
          <button
            type="button"
            class="px-3 py-1.5 rounded-lg text-xs font-semibold text-slate-600 dark:text-slate-300 hover:text-slate-900 dark:hover:text-white hover:bg-slate-50 dark:hover:bg-slate-800/50 flex items-center gap-1 transition-colors"
          >
            <span>🌊 Outdoors</span>
            <svg class="w-3 h-3 text-slate-400 group-hover:rotate-180 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
            </svg>
          </button>
          <div class="absolute left-0 top-full mt-1 w-56 p-2 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 shadow-xl opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-150 z-50">
            {outdoorsTools.map((t) => (
              <a href={t.path} class="flex items-center gap-2.5 px-3 py-2 rounded-xl text-xs font-medium text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors">
                <span class="text-sm">{t.id === 'can-i-swim' ? '🌊' : t.id === 'mountain-snow' ? '🏔️' : t.id === 'air-quality' ? '💨' : '🎾'}</span>
                <span>{t.name}</span>
              </a>
            ))}
          </div>
        </div>

        <!-- Transit Category Dropdown -->
        <div class="relative group">
          <button
            type="button"
            class="px-3 py-1.5 rounded-lg text-xs font-semibold text-slate-600 dark:text-slate-300 hover:text-slate-900 dark:hover:text-white hover:bg-slate-50 dark:hover:bg-slate-800/50 flex items-center gap-1 transition-colors"
          >
            <span>⛴️ Transit</span>
            <svg class="w-3 h-3 text-slate-400 group-hover:rotate-180 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
            </svg>
          </button>
          <div class="absolute left-0 top-full mt-1 w-56 p-2 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 shadow-xl opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-150 z-50">
            {transitTools.map((t) => (
              <a href={t.path} class="flex items-center gap-2.5 px-3 py-2 rounded-xl text-xs font-medium text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors">
                <span class="text-sm">{t.id === 'bc-ferries' ? '⛴️' : t.id === 'bridge-traffic' ? '🌉' : '🚗'}</span>
                <span>{t.name}</span>
              </a>
            ))}
          </div>
        </div>

        <!-- Health & Daily Category Dropdown -->
        <div class="relative group">
          <button
            type="button"
            class="px-3 py-1.5 rounded-lg text-xs font-semibold text-slate-600 dark:text-slate-300 hover:text-slate-900 dark:hover:text-white hover:bg-slate-50 dark:hover:bg-slate-800/50 flex items-center gap-1 transition-colors"
          >
            <span>🏥 Health & Daily</span>
            <svg class="w-3 h-3 text-slate-400 group-hover:rotate-180 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
            </svg>
          </button>
          <div class="absolute left-0 top-full mt-1 w-56 p-2 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 shadow-xl opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-150 z-50">
            {healthTools.map((t) => (
              <a href={t.path} class="flex items-center gap-2.5 px-3 py-2 rounded-xl text-xs font-medium text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors">
                <span class="text-sm">{t.id === 'health-wait-times' ? '🏥' : t.id === 'community-events' ? '🎈' : '🏫'}</span>
                <span>{t.name}</span>
              </a>
            ))}
          </div>
        </div>

        <!-- Civic & News Category Dropdown -->
        <div class="relative group">
          <button
            type="button"
            class="px-3 py-1.5 rounded-lg text-xs font-semibold text-slate-600 dark:text-slate-300 hover:text-slate-900 dark:hover:text-white hover:bg-slate-50 dark:hover:bg-slate-800/50 flex items-center gap-1 transition-colors"
          >
            <span>🏛️ Civic</span>
            <svg class="w-3 h-3 text-slate-400 group-hover:rotate-180 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
            </svg>
          </button>
          <div class="absolute left-0 top-full mt-1 w-56 p-2 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 shadow-xl opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-150 z-50">
            {civicTools.map((t) => (
              <a href={t.path} class="flex items-center gap-2.5 px-3 py-2 rounded-xl text-xs font-medium text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors">
                <span class="text-sm">{t.id === 'civic-development' ? '🏗️' : t.id === 'housing-market' ? '📈' : '📰'}</span>
                <span>{t.name}</span>
              </a>
            ))}
          </div>
        </div>

        <!-- Direct About & Contact Links -->
        <a
          href="/about"
          class={`px-3 py-1.5 rounded-lg text-xs font-semibold transition-colors ${
            currentPath === '/about'
              ? 'bg-slate-100 dark:bg-slate-800 text-slate-900 dark:text-white'
              : 'text-slate-600 dark:text-slate-300 hover:bg-slate-50 dark:hover:bg-slate-800/50 hover:text-slate-900 dark:hover:text-white'
          }`}
        >
          About
        </a>
        <a
          href="/contact"
          class={`px-3 py-1.5 rounded-lg text-xs font-semibold transition-colors ${
            currentPath === '/contact'
              ? 'bg-slate-100 dark:bg-slate-800 text-slate-900 dark:text-white'
              : 'text-slate-600 dark:text-slate-300 hover:bg-slate-50 dark:hover:bg-slate-800/50 hover:text-slate-900 dark:hover:text-white'
          }`}
        >
          Contact
        </a>
      </nav>
    </div>

    <!-- Right Controls: Location, Theme Toggle, Mobile Menu -->
    <div class="flex items-center gap-2 sm:gap-3">
      <!-- Geolocation Selector -->
      <GeoPicker />

      <!-- Dark Mode Toggle -->
      <ThemeToggle />

      <!-- Mobile Menu Button -->
      <button
        id="mobile-menu-btn"
        type="button"
        class="lg:hidden p-2 text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 rounded-lg focus:outline-none focus:ring-2 focus:ring-sky-500"
        aria-label="Open mobile menu"
        aria-expanded="false"
      >
        <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Drawer Menu -->
  <div id="mobile-menu-drawer" class="hidden lg:hidden border-t border-slate-200 dark:border-slate-800 bg-white/95 dark:bg-slate-900/95 backdrop-blur-md px-4 pt-3 pb-6 space-y-4 max-h-[85vh] overflow-y-auto">
    <div class="grid grid-cols-2 gap-2 pb-2 border-b border-slate-200 dark:border-slate-800">
      <a href="/about" class="px-3 py-2 rounded-xl text-xs font-bold text-center bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-200">
        About VanUtils
      </a>
      <a href="/contact" class="px-3 py-2 rounded-xl text-xs font-bold text-center bg-sky-500/10 text-sky-600 dark:text-sky-400 border border-sky-500/20">
        Contact & Feedback
      </a>
    </div>

    <div class="space-y-3">
      <div class="text-[11px] font-bold uppercase tracking-wider text-slate-400 px-2">Micro-Utilities Directory</div>
      <div class="grid grid-cols-1 gap-1">
        {TOOLS_REGISTRY.map((tool) => (
          <a
            href={tool.path}
            class={`flex items-center justify-between px-3 py-2.5 rounded-xl text-sm font-medium transition-colors ${
              currentPath.startsWith(tool.path) && tool.path !== '/'
                ? 'bg-sky-50 dark:bg-sky-950/60 text-sky-600 dark:text-sky-400'
                : 'text-slate-700 dark:text-slate-200 hover:bg-slate-100 dark:hover:bg-slate-800'
            }`}
          >
            <div class="flex items-center gap-3">
              <span class="text-base">
                {tool.id === 'can-i-swim' && '🌊'}
                {tool.id === 'bc-ferries' && '⛴️'}
                {tool.id === 'mountain-snow' && '🏔️'}
                {tool.id === 'evo-parking' && '🚗'}
                {tool.id === 'health-wait-times' && '🏥'}
                {tool.id === 'bridge-traffic' && '🌉'}
                {tool.id === 'air-quality' && '💨'}
                {tool.id === 'civic-development' && '🏗️'}
                {tool.id === 'community-events' && '🎈'}
                {tool.id === 'school-catchment' && '🏫'}
                {tool.id === 'local-news' && '📰'}
                {tool.id === 'housing-market' && '📈'}
                {tool.id === 'sports-courts' && '🎾'}
              </span>
              <span>{tool.name}</span>
            </div>
            <span class="text-[10px] px-2 py-0.5 rounded-full font-semibold bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border border-emerald-500/20">
              Live
            </span>
          </a>
        ))}
      </div>
    </div>
  </div>
</header>

<script>
  function setupMobileMenu() {
    const menuBtn = document.getElementById('mobile-menu-btn');
    const menuDrawer = document.getElementById('mobile-menu-drawer');
    if (!menuBtn || !menuDrawer) return;

    menuBtn.addEventListener('click', () => {
      const isExpanded = menuDrawer.classList.toggle('hidden');
      menuBtn.setAttribute('aria-expanded', isExpanded ? 'false' : 'true');
    });
  }

  setupMobileMenu();
  document.addEventListener('astro:page-load', setupMobileMenu);
</script>

