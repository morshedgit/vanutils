---
import ThemeToggle from './ThemeToggle.astro';
import GeoPicker from './GeoPicker.astro';
import { TOOLS_REGISTRY } from '../../config/tools';

interface Props {
  currentPath?: string;
}

const { currentPath = '/' } = Astro.props;

const outdoorsTools = TOOLS_REGISTRY.filter((t) => ['can-i-swim', 'mountain-snow', 'air-quality', 'sports-facilities', 'weather-forecast'].includes(t.id));
const transitTools = TOOLS_REGISTRY.filter((t) => ['bc-ferries', 'bridge-traffic', 'carshare-parking'].includes(t.id));
const healthTools = TOOLS_REGISTRY.filter((t) => ['health-wait-times'].includes(t.id));
const civicTools = TOOLS_REGISTRY.filter((t) => ['housing-market', 'local-news', 'sales-events', 'sports-teams'].includes(t.id));
---

<header class="sticky top-0 z-40 w-full border-b border-slate-200/80 dark:border-slate-800/80 bg-white/95 dark:bg-slate-900/95 backdrop-blur-md transition-colors">
  <div class="max-w-[1600px] mx-auto px-3 sm:px-6 lg:px-8 h-11 sm:h-12 flex items-center justify-between gap-3">
    <!-- Brand Logo -->
    <div class="flex items-center gap-4 lg:gap-6">
      <a href="/" class="flex items-center gap-2 group focus:outline-none focus:ring-2 focus:ring-sky-500 rounded-lg py-0.5">
        <div class="w-6 h-6 sm:w-7 sm:h-7 rounded-lg bg-gradient-to-tr from-sky-600 to-teal-500 flex items-center justify-center text-white shadow-xs group-hover:scale-105 transition-transform shrink-0">
          <svg class="w-3.5 h-3.5 sm:w-4 sm:h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3 15c4-3 7-3 10 0 3 3 7 3 10 0" />
            <path stroke-linecap="round" stroke-linejoin="round" d="M3 9c4-3 7-3 10 0 3 3 7 3 10 0" />
          </svg>
        </div>
        <div class="flex items-center gap-1.5">
          <span class="font-black text-sm sm:text-base tracking-tight text-slate-900 dark:text-white">Van<span class="text-sky-600 dark:text-sky-400">Heartbeat</span></span>
          <span class="inline-flex items-center gap-1 text-[10px] sm:text-[11px] font-bold uppercase px-1.5 py-0.5 rounded-full bg-emerald-500/10 text-emerald-700 dark:text-emerald-300 border border-emerald-500/20">
            <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
            Live
          </span>
        </div>
      </a>

      <!-- Desktop Navigation Links (Clean Text Typography, Zero Icons) -->
      <nav class="hidden lg:flex items-center gap-0.5">
        <a
          href="/"
          class={`px-2.5 py-1 rounded-md text-xs font-semibold transition-colors ${
            currentPath === '/'
              ? 'bg-slate-100 dark:bg-slate-800 text-slate-900 dark:text-white'
              : 'text-slate-600 dark:text-slate-300 hover:bg-slate-50 dark:hover:bg-slate-800/50 hover:text-slate-900 dark:hover:text-white'
          }`}
        >
          Overview
        </a>

        <!-- Outdoors Category Dropdown -->
        <div class="relative group">
          <button
            type="button"
            aria-haspopup="true"
            aria-expanded="false"
            class="px-2.5 py-1 rounded-md text-xs font-semibold text-slate-600 dark:text-slate-300 hover:text-slate-900 dark:hover:text-white hover:bg-slate-50 dark:hover:bg-slate-800/50 flex items-center gap-1 transition-colors"
          >
            <span>Outdoors</span>
            <svg class="w-2.5 h-2.5 text-slate-400 group-hover:rotate-180 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7" />
            </svg>
          </button>
          <div class="absolute left-0 top-full mt-1 w-52 p-1.5 rounded-xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 shadow-xl opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-150 z-50">
            {outdoorsTools.map((t) => (
              <a href={t.path} class="block px-3 py-1.5 rounded-lg text-xs font-medium text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors">
                {t.name}
              </a>
            ))}
          </div>
        </div>

        <!-- Transit Category Dropdown -->
        <div class="relative group">
          <button
            type="button"
            aria-haspopup="true"
            aria-expanded="false"
            class="px-2.5 py-1 rounded-md text-xs font-semibold text-slate-600 dark:text-slate-300 hover:text-slate-900 dark:hover:text-white hover:bg-slate-50 dark:hover:bg-slate-800/50 flex items-center gap-1 transition-colors"
          >
            <span>Transit</span>
            <svg class="w-2.5 h-2.5 text-slate-400 group-hover:rotate-180 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7" />
            </svg>
          </button>
          <div class="absolute left-0 top-full mt-1 w-52 p-1.5 rounded-xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 shadow-xl opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-150 z-50">
            {transitTools.map((t) => (
              <a href={t.path} class="block px-3 py-1.5 rounded-lg text-xs font-medium text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors">
                {t.name}
              </a>
            ))}
          </div>
        </div>

        <!-- Health & Daily Category Dropdown -->
        <div class="relative group">
          <button
            type="button"
            aria-haspopup="true"
            aria-expanded="false"
            class="px-2.5 py-1 rounded-md text-xs font-semibold text-slate-600 dark:text-slate-300 hover:text-slate-900 dark:hover:text-white hover:bg-slate-50 dark:hover:bg-slate-800/50 flex items-center gap-1 transition-colors"
          >
            <span>Health & Daily</span>
            <svg class="w-2.5 h-2.5 text-slate-400 group-hover:rotate-180 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7" />
            </svg>
          </button>
          <div class="absolute left-0 top-full mt-1 w-52 p-1.5 rounded-xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 shadow-xl opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-150 z-50">
            {healthTools.map((t) => (
              <a href={t.path} class="block px-3 py-1.5 rounded-lg text-xs font-medium text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors">
                {t.name}
              </a>
            ))}
          </div>
        </div>

        <!-- Civic & Deals Category Dropdown -->
        <div class="relative group">
          <button
            type="button"
            aria-haspopup="true"
            aria-expanded="false"
            class="px-2.5 py-1 rounded-md text-xs font-semibold text-slate-600 dark:text-slate-300 hover:text-slate-900 dark:hover:text-white hover:bg-slate-50 dark:hover:bg-slate-800/50 flex items-center gap-1 transition-colors"
          >
            <span>Civic & Deals</span>
            <svg class="w-2.5 h-2.5 text-slate-400 group-hover:rotate-180 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7" />
            </svg>
          </button>
          <div class="absolute left-0 top-full mt-1 w-56 p-1.5 rounded-xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 shadow-xl opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-150 z-50">
            {civicTools.map((t) => (
              <a href={t.path} class="block px-3 py-1.5 rounded-lg text-xs font-medium text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors">
                {t.name}
              </a>
            ))}
          </div>
        </div>

        <!-- Direct About & Contact Links -->
        <a
          href="/about"
          class={`px-2.5 py-1 rounded-md text-xs font-semibold transition-colors ${
            currentPath === '/about'
              ? 'bg-slate-100 dark:bg-slate-800 text-slate-900 dark:text-white'
              : 'text-slate-600 dark:text-slate-300 hover:bg-slate-50 dark:hover:bg-slate-800/50 hover:text-slate-900 dark:hover:text-white'
          }`}
        >
          About
        </a>
        <a
          href="/contact"
          class={`px-2.5 py-1 rounded-md text-xs font-semibold transition-colors ${
            currentPath === '/contact'
              ? 'bg-slate-100 dark:bg-slate-800 text-slate-900 dark:text-white'
              : 'text-slate-600 dark:text-slate-300 hover:bg-slate-50 dark:hover:bg-slate-800/50 hover:text-slate-900 dark:hover:text-white'
          }`}
        >
          Contact
        </a>
      </nav>
    </div>

    <!-- Right Controls: Location, Theme Toggle, Mobile Menu -->
    <div class="flex items-center gap-1.5 sm:gap-2">
      <!-- Geolocation Selector -->
      <GeoPicker />

      <!-- Dark Mode Toggle -->
      <ThemeToggle />

      <!-- Mobile Menu Button -->
      <button
        id="mobile-menu-btn"
        type="button"
        class="lg:hidden p-1.5 text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 rounded-lg focus:outline-none focus:ring-2 focus:ring-sky-500"
        aria-label="Open mobile menu"
        aria-expanded="false"
      >
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Drawer Menu (Text Only, Zero Emojis) -->
  <div id="mobile-menu-drawer" class="hidden lg:hidden border-t border-slate-200 dark:border-slate-800 bg-white/95 dark:bg-slate-900/95 backdrop-blur-md px-3 pt-2.5 pb-5 space-y-3 max-h-[85vh] overflow-y-auto">
    <div class="grid grid-cols-2 gap-2 pb-2 border-b border-slate-200 dark:border-slate-800">
      <a href="/about" class="px-3 py-1.5 rounded-lg text-xs font-bold text-center bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-200">
        About
      </a>
      <a href="/contact" class="px-3 py-1.5 rounded-lg text-xs font-bold text-center bg-sky-500/10 text-sky-600 dark:text-sky-400 border border-sky-500/20">
        Contact & Feedback
      </a>
    </div>

    <div class="space-y-2">
      <div class="text-[10px] font-bold uppercase tracking-wider text-slate-500 dark:text-slate-400 px-1">Utilities Directory</div>
      <div class="grid grid-cols-1 gap-0.5">
        {TOOLS_REGISTRY.map((tool) => (
          <a
            href={tool.path}
            class={`flex items-center justify-between px-2.5 py-1.5 rounded-lg text-xs font-medium transition-colors ${
              currentPath.startsWith(tool.path) && tool.path !== '/'
                ? 'bg-sky-50 dark:bg-sky-950/60 text-sky-600 dark:text-sky-400'
                : 'text-slate-700 dark:text-slate-200 hover:bg-slate-100 dark:hover:bg-slate-800'
            }`}
          >
            <span>{tool.name}</span>
            <span class="text-[10px] px-1.5 py-0.5 rounded-full font-semibold bg-emerald-500/10 text-emerald-700 dark:text-emerald-300 border border-emerald-500/20">
              Live
            </span>
          </a>
        ))}
      </div>
    </div>
  </div>
</header>

<script>
  function setupMobileMenu() {
    const menuBtn = document.getElementById('mobile-menu-btn');
    const menuDrawer = document.getElementById('mobile-menu-drawer');
    if (!menuBtn || !menuDrawer) return;

    menuBtn.addEventListener('click', () => {
      const isExpanded = menuDrawer.classList.toggle('hidden');
      menuBtn.setAttribute('aria-expanded', isExpanded ? 'false' : 'true');
    });
  }

  setupMobileMenu();
  document.addEventListener('astro:page-load', setupMobileMenu);
</script>
