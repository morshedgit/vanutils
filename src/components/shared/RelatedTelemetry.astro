---
export interface RelatedItem {
  title: string;
  subtitle: string;
  href: string;
  badge: string;
  icon: string;
  statusColor?: 'emerald' | 'sky' | 'amber' | 'indigo';
}

interface Props {
  title?: string;
  items: RelatedItem[];
}

const { title = 'Connected Live City Telemetry', items } = Astro.props;
---

<section class="p-4 sm:p-5 rounded-2xl bg-slate-50 dark:bg-slate-900 border border-slate-200/80 dark:border-slate-800 space-y-3">
  <div class="flex items-center justify-between">
    <div class="flex items-center gap-2">
      <span class="text-base">🔗</span>
      <h3 class="text-xs sm:text-sm font-black text-slate-900 dark:text-white uppercase tracking-wider">
        {title}
      </h3>
    </div>
    <span class="text-[10px] text-slate-500 dark:text-slate-400 font-medium">Cross-Utility Pulse</span>
  </div>

  <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-3">
    {items.map((item) => (
      <a
        href={item.href}
        class="group flex items-start gap-3 p-3 rounded-xl bg-white dark:bg-slate-800/80 border border-slate-200 dark:border-slate-700/60 hover:border-sky-500 dark:hover:border-sky-400 shadow-2xs hover:shadow-xs transition-all"
      >
        <span class="text-xl shrink-0 group-hover:scale-110 transition-transform">
          {item.icon}
        </span>
        <div class="min-w-0 flex-1 space-y-0.5">
          <div class="flex items-center justify-between gap-1">
            <span class="text-xs font-bold text-slate-900 dark:text-white truncate group-hover:text-sky-600 dark:group-hover:text-sky-400">
              {item.title}
            </span>
            <span class="text-[10px] font-bold px-1.5 py-0.5 rounded-md bg-slate-100 dark:bg-slate-700 text-slate-600 dark:text-slate-300 shrink-0">
              {item.badge}
            </span>
          </div>
          <p class="text-[11px] text-slate-500 dark:text-slate-400 truncate">
            {item.subtitle}
          </p>
        </div>
      </a>
    ))}
  </div>
</section>
