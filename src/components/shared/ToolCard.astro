---
import type { ToolMeta } from '../../types/shared';
import { getAllBeaches } from '../../tools/can-i-swim/services/vchScraper';
import { getLiveRoutes } from '../../tools/bc-ferries/services/ferryService';
import { getLiveMountains } from '../../tools/mountain-snow/services/snowService';
import { getAllNeighbourhoods, evaluateNeighbourhoodSpot } from '../../tools/carshare-parking/services/parkingEvaluator';

interface Props {
  tool: ToolMeta;
}

const { tool } = Astro.props;

// Fetch live data for high-density listings at the edge
const allBeaches = tool.id === 'can-i-swim' ? getAllBeaches() : [];
const initialBeaches = allBeaches.slice(0, 10);

const allFerryRoutes = tool.id === 'bc-ferries' ? await getLiveRoutes() : [];
const initialFerryRoutes = allFerryRoutes.slice(0, 6);

const allMountains = tool.id === 'mountain-snow' ? await getLiveMountains() : [];
const initialMountains = allMountains.slice(0, 4);

const allNeighbourhoods = tool.id === 'evo-parking' ? getAllNeighbourhoods() : [];
const initialNeighbourhoods = allNeighbourhoods.slice(0, 6);

const safeBeachesCount = allBeaches.filter((b) => b.currentStatus === 'safe').length;
const avgFreezingLevel = allMountains.length > 0
  ? Math.round(allMountains.reduce((acc, m) => acc + m.currentFreezingLevelMeters, 0) / allMountains.length)
  : 4000;
const snowBadgeText = avgFreezingLevel > 3000 ? `0°C @ ${avgFreezingLevel}m (Summer)` : `${avgFreezingLevel}m FZ`;
---

<a
  href={tool.path}
  class="tool-card block p-4 sm:p-5 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 hover:border-sky-500 hover:shadow-md transition-all duration-150"
  data-tool-id={tool.id}
>
  <!-- Card Header: Title + Status Pill -->
  <div class="flex items-center justify-between gap-2 mb-3">
    <h2 class="text-base sm:text-lg font-bold text-slate-900 dark:text-white group-hover:text-sky-500 transition-colors">
      {tool.name}
    </h2>
    <span class="text-xs font-semibold px-2 py-0.5 rounded-full bg-emerald-500/10 text-emerald-700 dark:text-emerald-400 border border-emerald-500/20 shrink-0">
      {tool.id === 'can-i-swim' && `${safeBeachesCount}/${allBeaches.length} Safe`}
      {tool.id === 'bc-ferries' && 'Live Deck %'}
      {tool.id === 'mountain-snow' && snowBadgeText}
      {tool.id === 'evo-parking' && '8/8 Home Zones'}
      {tool.id !== 'can-i-swim' && tool.id !== 'bc-ferries' && tool.id !== 'mountain-snow' && tool.id !== 'evo-parking' && (tool.previewStat?.value || 'Beta')}
    </span>
  </div>

  <!-- CAN I SWIM: High-Density Beach List (2 Columns on medium screens) -->
  {tool.id === 'can-i-swim' && (
    <div id="main-card-beaches-grid" class="grid grid-cols-1 sm:grid-cols-2 gap-x-4 gap-y-1.5 text-xs text-slate-700 dark:text-slate-300">
      {initialBeaches.map((b) => (
        <div class="flex items-center justify-between py-0.5 border-b border-slate-100 dark:border-slate-800/60" data-beach-slug={b.id}>
          <span class="truncate pr-2 font-medium">
            {b.name.replace(/ \(.*\)/, '')}
          </span>
          <span class="shrink-0 flex items-center gap-1 font-semibold text-[11px]">
            {b.currentStatus === 'safe' && (
              <span class="text-emerald-600 dark:text-emerald-400 flex items-center gap-1">
                <span class="w-2 h-2 rounded-full bg-emerald-500"></span> Safe
              </span>
            )}
            {b.currentStatus === 'caution' && (
              <span class="text-amber-600 dark:text-amber-400 flex items-center gap-1">
                <span class="w-2 h-2 rounded-full bg-amber-500"></span> Caution
              </span>
            )}
            {b.currentStatus === 'advisory' && (
              <span class="text-rose-600 dark:text-rose-400 flex items-center gap-1">
                <span class="w-2 h-2 rounded-full bg-rose-500"></span> Advisory
              </span>
            )}
            {b.currentStatus === 'unmonitored' && (
              <span class="text-slate-500 dark:text-slate-400 flex items-center gap-1">
                <span class="w-2 h-2 rounded-full bg-slate-400"></span> Off-Season
              </span>
            )}
          </span>
        </div>
      ))}
    </div>
  )}

  <!-- BC FERRIES: High-Density Marine Routes List -->
  {tool.id === 'bc-ferries' && (
    <div id="main-card-ferries-grid" class="space-y-1.5 text-xs text-slate-700 dark:text-slate-300">
      {initialFerryRoutes.map((r) => {
        const next = r.nextSailings[0];
        return (
          <div class="flex items-center justify-between py-1 border-b border-slate-100 dark:border-slate-800/60" data-route-id={r.id}>
            <div class="truncate pr-2 font-medium">
              <span>{r.shortName}</span>
            </div>
            <div class="shrink-0 flex items-center gap-2 text-[11px] font-semibold">
              {next && next.deckSpacePercent !== undefined ? (
                <span class="text-slate-700 dark:text-slate-300">
                  {next.departureTime} ({next.deckSpacePercent}% deck)
                </span>
              ) : (
                <span class="text-slate-500 dark:text-slate-400">
                  {next ? next.departureTime : 'Scheduled'}
                </span>
              )}

              {next && next.standbyRisk === 'low' && (
                <span class="text-emerald-600 dark:text-emerald-400 flex items-center gap-1">
                  <span class="w-2 h-2 rounded-full bg-emerald-500"></span> Standby OK
                </span>
              )}
              {next && next.standbyRisk === 'moderate' && (
                <span class="text-amber-600 dark:text-amber-400 flex items-center gap-1">
                  <span class="w-2 h-2 rounded-full bg-amber-500"></span> Filling
                </span>
              )}
              {next && next.standbyRisk === 'high' && (
                <span class="text-rose-600 dark:text-rose-400 flex items-center gap-1">
                  <span class="w-2 h-2 rounded-full bg-rose-500"></span> Full
                </span>
              )}
              {(!next || next.standbyRisk === 'not_applicable') && (
                <span class="text-sky-600 dark:text-sky-400 flex items-center gap-1">
                  <span class="w-2 h-2 rounded-full bg-sky-500"></span> Fast Transit
                </span>
              )}
            </div>
          </div>
        );
      })}
    </div>
  )}

  <!-- MOUNTAIN SNOW: High-Density Mountain List -->
  {tool.id === 'mountain-snow' && (
    <div id="main-card-snow-grid" class="space-y-1.5 text-xs text-slate-700 dark:text-slate-300">
      {initialMountains.map((m) => {
        const topBand = m.elevationBands[m.elevationBands.length - 1];
        const hasSnow = m.snowfall.last24HoursCm > 0;
        return (
          <div class="flex items-center justify-between py-1 border-b border-slate-100 dark:border-slate-800/60" data-mountain-id={m.id}>
            <div class="truncate pr-2 font-medium">
              <span>{m.name}</span>
              <span class="text-[11px] text-slate-400 ml-1">({topBand.elevationMeters}m)</span>
            </div>
            <div class="shrink-0 flex items-center gap-2 text-[11px] font-semibold">
              <span class={hasSnow ? 'text-sky-600 dark:text-sky-400 font-bold' : 'text-amber-600 dark:text-amber-400 font-bold'}>
                {hasSnow ? `${m.snowfall.last24HoursCm}cm 24h` : `+${topBand.temperatureCelsius}°C Summit`}
              </span>
              <span class="text-slate-500 dark:text-slate-400">
                0°C @ {m.currentFreezingLevelMeters}m
              </span>
              <span class={`inline-flex items-center gap-1 px-1.5 py-0.5 rounded text-[10px] font-bold ${hasSnow ? 'bg-sky-500/15 text-sky-700 dark:text-sky-300' : 'bg-emerald-500/15 text-emerald-700 dark:text-emerald-300'}`}>
                {hasSnow ? '❄️ Snow' : '☀️ Hiking'}
              </span>
            </div>
          </div>
        );
      })}
    </div>
  )}

  <!-- CAR-SHARE PARKING: High-Density Neighbourhoods List -->
  {tool.id === 'evo-parking' && (
    <div id="main-card-parking-grid" class="space-y-1.5 text-xs text-slate-700 dark:text-slate-300">
      {initialNeighbourhoods.map((n) => {
        const evaluation = evaluateNeighbourhoodSpot(n);
        return (
          <div class="flex items-center justify-between py-1 border-b border-slate-100 dark:border-slate-800/60" data-parking-id={n.id}>
            <div class="truncate pr-2 font-medium">
              <span>{n.name}</span>
              <span class="text-[11px] text-slate-400 ml-1">({n.residentialPermitRules.permitZoneCode})</span>
            </div>
            <div class="shrink-0 flex items-center gap-2 text-[11px] font-semibold">
              <span class="text-slate-500 dark:text-slate-400">
                {n.id === 'ubc' ? 'Parkades Only' : 'Permit Exempt'}
              </span>
              {evaluation.clearanceStatus === 'safe' && (
                <span class="text-emerald-600 dark:text-emerald-400 flex items-center gap-1">
                  <span class="w-2 h-2 rounded-full bg-emerald-500"></span> Safe to Park
                </span>
              )}
              {evaluation.clearanceStatus === 'caution' && (
                <span class="text-amber-600 dark:text-amber-400 flex items-center gap-1">
                  <span class="w-2 h-2 rounded-full bg-amber-500"></span> Caution
                </span>
              )}
              {evaluation.clearanceStatus === 'prohibited' && (
                <span class="text-rose-600 dark:text-rose-400 flex items-center gap-1">
                  <span class="w-2 h-2 rounded-full bg-rose-500"></span> Tow Risk
                </span>
              )}
            </div>
          </div>
        );
      })}
    </div>
  )}

  <!-- Other Roadmap Tools: Compact Feature Readout -->
  {tool.id !== 'can-i-swim' && tool.id !== 'bc-ferries' && tool.id !== 'mountain-snow' && tool.id !== 'evo-parking' && (
    <div class="space-y-1.5 text-xs text-slate-600 dark:text-slate-400">
      {tool.features?.map((f) => (
        <div class="flex items-center gap-1.5">
          <span class="text-slate-400">•</span>
          <span>{f}</span>
        </div>
      ))}
    </div>
  )}
</a>

{tool.id === 'can-i-swim' && (
  <script is:inline define:vars={{ allBeachesJson: JSON.stringify(allBeaches) }}>
    function syncMainCardBeaches() {
      const grid = document.getElementById('main-card-beaches-grid');
      if (!grid) return;

      const saved = localStorage.getItem('vanutils_pinned_beaches');
      const allBeaches = JSON.parse(allBeachesJson || '[]');
      
      let displayList = [];
      if (saved) {
        try {
          const pinnedSlugs = JSON.parse(saved);
          const pinnedBeaches = allBeaches.filter((b) => pinnedSlugs.includes(b.id));
          const unpinnedBeaches = allBeaches.filter((b) => !pinnedSlugs.includes(b.id));
          displayList = [...pinnedBeaches, ...unpinnedBeaches].slice(0, 10);
        } catch (e) {
          displayList = allBeaches.slice(0, 10);
        }
      } else {
        displayList = allBeaches.slice(0, 10);
      }

      if (displayList.length === 0) return;

      grid.innerHTML = displayList.map((b) => {
        const statusHtml = b.currentStatus === 'safe'
          ? '<span class="text-emerald-600 dark:text-emerald-400 flex items-center gap-1"><span class="w-2 h-2 rounded-full bg-emerald-500"></span> Safe</span>'
          : b.currentStatus === 'caution'
          ? '<span class="text-amber-600 dark:text-amber-400 flex items-center gap-1"><span class="w-2 h-2 rounded-full bg-amber-500"></span> Caution</span>'
          : b.currentStatus === 'advisory'
          ? '<span class="text-rose-600 dark:text-rose-400 flex items-center gap-1"><span class="w-2 h-2 rounded-full bg-rose-500"></span> Advisory</span>'
          : '<span class="text-slate-500 dark:text-slate-400 flex items-center gap-1"><span class="w-2 h-2 rounded-full bg-slate-400"></span> Off-Season</span>';

        return `
          <div class="flex items-center justify-between py-0.5 border-b border-slate-100 dark:border-slate-800/60">
            <span class="truncate pr-2 font-medium">
              ${b.name.replace(/ \(.*\)/, '')}
            </span>
            <span class="shrink-0 flex items-center gap-1 font-semibold text-[11px]">
              ${statusHtml}
            </span>
          </div>
        `;
      }).join('');
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', syncMainCardBeaches);
    } else {
      syncMainCardBeaches();
    }

    window.addEventListener('vanutils:pinned-beaches-changed', syncMainCardBeaches);
  </script>
)}

{tool.id === 'bc-ferries' && (
  <script is:inline define:vars={{ allFerryRoutesJson: JSON.stringify(allFerryRoutes) }}>
    function syncMainCardFerries() {
      const grid = document.getElementById('main-card-ferries-grid');
      if (!grid) return;

      const saved = localStorage.getItem('vanutils_pinned_ferries');
      const allRoutes = JSON.parse(allFerryRoutesJson || '[]');
      
      let displayList = [];
      if (saved) {
        try {
          const pinnedIds = JSON.parse(saved);
          const pinnedRoutes = allRoutes.filter((r) => pinnedIds.includes(r.id));
          const unpinnedRoutes = allRoutes.filter((r) => !pinnedIds.includes(r.id));
          displayList = [...pinnedRoutes, ...unpinnedRoutes].slice(0, 6);
        } catch (e) {
          displayList = allRoutes.slice(0, 6);
        }
      } else {
        displayList = allRoutes.slice(0, 6);
      }

      if (displayList.length === 0) return;

      grid.innerHTML = displayList.map((r) => {
        const next = r.nextSailings?.[0];
        let statusBadge = '';
        if (next) {
          if (next.standbyRisk === 'low') {
            statusBadge = '<span class="text-emerald-600 dark:text-emerald-400 flex items-center gap-1"><span class="w-2 h-2 rounded-full bg-emerald-500"></span> Standby OK</span>';
          } else if (next.standbyRisk === 'moderate') {
            statusBadge = '<span class="text-amber-600 dark:text-amber-400 flex items-center gap-1"><span class="w-2 h-2 rounded-full bg-amber-500"></span> Filling</span>';
          } else if (next.standbyRisk === 'high') {
            statusBadge = '<span class="text-rose-600 dark:text-rose-400 flex items-center gap-1"><span class="w-2 h-2 rounded-full bg-rose-500"></span> Full</span>';
          } else {
            statusBadge = '<span class="text-sky-600 dark:text-sky-400 flex items-center gap-1"><span class="w-2 h-2 rounded-full bg-sky-500"></span> Fast Transit</span>';
          }
        }

        const deckText = next && next.deckSpacePercent !== undefined
          ? `${next.departureTime} (${next.deckSpacePercent}% deck)`
          : (next ? next.departureTime : 'Scheduled');

        return `
          <div class="flex items-center justify-between py-1 border-b border-slate-100 dark:border-slate-800/60" data-route-id="${r.id}">
            <div class="truncate pr-2 font-medium">
              <span>${r.shortName}</span>
            </div>
            <div class="shrink-0 flex items-center gap-2 text-[11px] font-semibold">
              <span class="text-slate-700 dark:text-slate-300">${deckText}</span>
              ${statusBadge}
            </div>
          </div>
        `;
      }).join('');
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', syncMainCardFerries);
    } else {
      syncMainCardFerries();
    }

    window.addEventListener('vanutils:pinned-ferries-changed', syncMainCardFerries);
  </script>
)}

{tool.id === 'mountain-snow' && (
  <script is:inline define:vars={{ allMountainsJson: JSON.stringify(allMountains) }}>
    function syncMainCardSnow() {
      const grid = document.getElementById('main-card-snow-grid');
      if (!grid) return;

      const saved = localStorage.getItem('vanutils_pinned_snow');
      const allMountains = JSON.parse(allMountainsJson || '[]');
      
      let displayList = [];
      if (saved) {
        try {
          const pinnedIds = JSON.parse(saved);
          const pinnedMountains = allMountains.filter((m) => pinnedIds.includes(m.id));
          const unpinnedMountains = allMountains.filter((m) => !pinnedIds.includes(m.id));
          displayList = [...pinnedMountains, ...unpinnedMountains].slice(0, 4);
        } catch (e) {
          displayList = allMountains.slice(0, 4);
        }
      } else {
        displayList = allMountains.slice(0, 4);
      }

      if (displayList.length === 0) return;

      grid.innerHTML = displayList.map((m) => {
        const topBand = m.elevationBands[m.elevationBands.length - 1];
        const hasSnow = m.snowfall.last24HoursCm > 0;
        const tempText = hasSnow
          ? `<span class="text-sky-600 dark:text-sky-400 font-bold">${m.snowfall.last24HoursCm}cm 24h</span>`
          : `<span class="text-amber-600 dark:text-amber-400 font-bold">+${topBand.temperatureCelsius}°C Summit</span>`;
        const badgeText = hasSnow
          ? '<span class="inline-flex items-center gap-1 px-1.5 py-0.5 rounded text-[10px] font-bold bg-sky-500/15 text-sky-700 dark:text-sky-300">❄️ Snow</span>'
          : '<span class="inline-flex items-center gap-1 px-1.5 py-0.5 rounded text-[10px] font-bold bg-emerald-500/15 text-emerald-700 dark:text-emerald-300">☀️ Hiking</span>';

        return `
          <div class="flex items-center justify-between py-1 border-b border-slate-100 dark:border-slate-800/60" data-mountain-id="${m.id}">
            <div class="truncate pr-2 font-medium">
              <span>${m.name}</span>
              <span class="text-[11px] text-slate-400 ml-1">(${topBand.elevationMeters}m)</span>
            </div>
            <div class="shrink-0 flex items-center gap-2 text-[11px] font-semibold">
              ${tempText}
              <span class="text-slate-500 dark:text-slate-400">
                0°C @ ${m.currentFreezingLevelMeters}m
              </span>
              ${badgeText}
            </div>
          </div>
        `;
      }).join('');
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', syncMainCardSnow);
    } else {
      syncMainCardSnow();
    }

    window.addEventListener('vanutils:pinned-snow-changed', syncMainCardSnow);
  </script>
)}

{tool.id === 'evo-parking' && (
  <script is:inline define:vars={{ allNeighbourhoodsJson: JSON.stringify(allNeighbourhoods) }}>
    function syncMainCardParking() {
      const grid = document.getElementById('main-card-parking-grid');
      if (!grid) return;

      const saved = localStorage.getItem('vanutils_pinned_parking');
      const allNeighbourhoods = JSON.parse(allNeighbourhoodsJson || '[]');
      
      let displayList = [];
      if (saved) {
        try {
          const pinnedIds = JSON.parse(saved);
          const pinnedNeighbourhoods = allNeighbourhoods.filter((n) => pinnedIds.includes(n.id));
          const unpinnedNeighbourhoods = allNeighbourhoods.filter((n) => !pinnedIds.includes(n.id));
          displayList = [...pinnedNeighbourhoods, ...unpinnedNeighbourhoods].slice(0, 6);
        } catch (e) {
          displayList = allNeighbourhoods.slice(0, 6);
        }
      } else {
        displayList = allNeighbourhoods.slice(0, 6);
      }

      if (displayList.length === 0) return;

      grid.innerHTML = displayList.map((n) => {
        return `
          <div class="flex items-center justify-between py-1 border-b border-slate-100 dark:border-slate-800/60" data-parking-id="${n.id}">
            <div class="truncate pr-2 font-medium">
              <span>${n.name}</span>
              <span class="text-[11px] text-slate-400 ml-1">(${n.residentialPermitRules.permitZoneCode})</span>
            </div>
            <div class="shrink-0 flex items-center gap-2 text-[11px] font-semibold">
              <span class="text-slate-500 dark:text-slate-400">
                ${n.id === 'ubc' ? 'Parkades Only' : 'Permit Exempt'}
              </span>
              <span class="text-emerald-600 dark:text-emerald-400 flex items-center gap-1">
                <span class="w-2 h-2 rounded-full bg-emerald-500"></span> Safe to Park
              </span>
            </div>
          </div>
        `;
      }).join('');
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', syncMainCardParking);
    } else {
      syncMainCardParking();
    }

    window.addEventListener('vanutils:pinned-parking-changed', syncMainCardParking);
  </script>
)}
