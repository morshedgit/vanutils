---
import type { ToolMeta } from '../../types/shared';
import { getAllBeaches } from '../../tools/can-i-swim/services/vchScraper';
import { getLiveRoutes } from '../../tools/bc-ferries/services/ferryService';
import { getLiveMountains } from '../../tools/mountain-snow/services/snowService';
import { getAllNeighbourhoods, evaluateNeighbourhoodSpot } from '../../tools/carshare-parking/services/parkingEvaluator';
import { getLiveFacilities, formatWaitTime } from '../../tools/health-wait-times/services/healthService';
import { getLiveCrossings } from '../../tools/bridge-traffic/services/bridgeService';
import { getLiveStations } from '../../tools/air-quality/services/airQualityService';
import { getLiveProposals } from '../../tools/civic-development/services/civicService';
import { getLiveEvents } from '../../tools/community-events/services/eventService';
import { getLiveSchools } from '../../tools/school-catchment/services/catchmentService';
import { getLiveNews, formatTimeAgo } from '../../tools/local-news/services/newsService';
import { getLiveMarketHeartbeat } from '../../tools/housing-market/services/marketService';
import { getLiveSportsFacilities } from '../../tools/sports-facilities/services/sportsService';
import { getLiveWeather } from '../../tools/weather-forecast/services/weatherService';

interface Props {
  tool: ToolMeta;
}

const { tool } = Astro.props;

// Fetch live telemetry for high-density listings at the edge
const allBeaches = tool.id === 'can-i-swim' ? getAllBeaches() : [];
const initialBeaches = allBeaches.slice(0, 4);
const safeBeachesCount = allBeaches.filter((b) => b.currentStatus === 'safe').length;
const cautionBeachesCount = allBeaches.filter((b) => b.currentStatus === 'caution').length;
const advisoryBeachesCount = allBeaches.filter((b) => b.currentStatus === 'advisory').length;

const allFerryRoutes = tool.id === 'bc-ferries' ? await getLiveRoutes() : [];
const initialFerryRoutes = allFerryRoutes.slice(0, 3);

const allMountains = tool.id === 'mountain-snow' ? await getLiveMountains() : [];
const initialMountains = allMountains.slice(0, 4);
const avgFreezingLevel = allMountains.length > 0
  ? Math.round(allMountains.reduce((acc, m) => acc + m.currentFreezingLevelMeters, 0) / allMountains.length)
  : 3500;
const snowBadgeText = avgFreezingLevel > 3000 ? `0°C @ ${avgFreezingLevel}m (Summer)` : `${avgFreezingLevel}m FZ`;

const allNeighbourhoods = tool.id === 'evo-parking' ? getAllNeighbourhoods() : [];
const initialNeighbourhoods = allNeighbourhoods.slice(0, 4);

const allFacilities = tool.id === 'health-wait-times' ? await getLiveFacilities() : [];
const initialFacilities = allFacilities.slice(0, 4);

const allCrossings = tool.id === 'bridge-traffic' ? await getLiveCrossings() : [];
const initialCrossings = allCrossings.slice(0, 4);

const allStations = tool.id === 'air-quality' ? await getLiveStations() : [];
const initialStations = allStations.slice(0, 4);

const allProposals = tool.id === 'civic-development' ? await getLiveProposals() : [];
const initialProposals = allProposals.slice(0, 3);

const allEvents = tool.id === 'community-events' ? await getLiveEvents() : [];
const initialEvents = allEvents.slice(0, 3);

const allSchools = tool.id === 'school-catchment' ? await getLiveSchools() : [];
const initialSchools = allSchools.slice(0, 3);

const allArticles = tool.id === 'local-news' ? await getLiveNews() : [];
const initialArticles = allArticles.slice(0, 3);

const marketData = tool.id === 'housing-market' ? await getLiveMarketHeartbeat() : null;
const allSubmarkets = marketData ? [marketData.metroOverview, ...marketData.submarkets] : [];
const initialSubmarkets = allSubmarkets.slice(0, 3);

const allSportsFacilities = tool.id === 'sports-courts' ? await getLiveSportsFacilities() : [];
const initialSportsFacilities = allSportsFacilities.slice(0, 3);

const allWeatherStations = tool.id === 'weather-forecast' ? await getLiveWeather() : [];
const initialWeatherStations = allWeatherStations.slice(0, 4);
const avgWeatherTemp = allWeatherStations.length > 0
  ? Math.round((allWeatherStations.reduce((acc, s) => acc + s.current.temperatureCelsius, 0) / allWeatherStations.length) * 10) / 10
  : 19.4;
---

<div
  class="tool-card group relative flex flex-col justify-between p-4 sm:p-5 rounded-2xl bg-white dark:bg-slate-900/90 border border-slate-200/90 dark:border-slate-800 hover:border-sky-500/70 dark:hover:border-sky-500/70 hover:shadow-lg hover:shadow-sky-500/5 transition-all duration-200"
  data-tool-id={tool.id}
>
  <!-- Card Top Header -->
  <div class="flex items-center justify-between gap-2 mb-3">
    <a href={tool.path} class="flex items-center gap-2 group-hover:text-sky-500 transition-colors">
      <span class="text-xl shrink-0">
        {tool.id === 'can-i-swim' && '🌊'}
        {tool.id === 'bc-ferries' && '⛴️'}
        {tool.id === 'mountain-snow' && '🏔️'}
        {tool.id === 'evo-parking' && '🚗'}
        {tool.id === 'health-wait-times' && '🏥'}
        {tool.id === 'bridge-traffic' && '🌉'}
        {tool.id === 'air-quality' && '💨'}
        {tool.id === 'civic-development' && '🏗️'}
        {tool.id === 'community-events' && '🎈'}
        {tool.id === 'school-catchment' && '🏫'}
        {tool.id === 'local-news' && '📰'}
        {tool.id === 'housing-market' && '📈'}
        {tool.id === 'sports-courts' && '🎾'}
        {tool.id === 'weather-forecast' && '🌦️'}
      </span>
      <h2 class="text-sm sm:text-base font-bold text-slate-900 dark:text-white leading-tight">
        {tool.name}
      </h2>
    </a>
    
    <a href={tool.path} class="shrink-0">
      <span class="text-[11px] font-bold px-2 py-0.5 rounded-full bg-emerald-500/10 text-emerald-700 dark:text-emerald-400 border border-emerald-500/20 whitespace-nowrap">
        {tool.id === 'can-i-swim' && `${safeBeachesCount}/${allBeaches.length} Safe`}
        {tool.id === 'bc-ferries' && 'Live Deck %'}
        {tool.id === 'mountain-snow' && snowBadgeText}
        {tool.id === 'evo-parking' && '8/8 Safe Zones'}
        {tool.id === 'health-wait-times' && '1h 15m Min ER'}
        {tool.id === 'bridge-traffic' && '2 NB Active'}
        {tool.id === 'air-quality' && 'AQHI 2 (Low)'}
        {tool.id === 'civic-development' && '38 Towers'}
        {tool.id === 'community-events' && '6 Free This Wk'}
        {tool.id === 'school-catchment' && 'VSB SD39'}
        {tool.id === 'local-news' && 'Live Wire'}
        {tool.id === 'housing-market' && '18.4% SAR'}
        {tool.id === 'sports-courts' && '84 Courts'}
        {tool.id === 'weather-forecast' && `${avgWeatherTemp}°C Regional Avg`}
      </span>
    </a>
  </div>

  <!-- BESPOKE ENGAGING VISUAL CHARTS & METERS (TAILORED PER UTILITY) -->
  <div class="my-2.5 p-2.5 rounded-xl bg-slate-50 dark:bg-slate-950/60 border border-slate-100 dark:border-slate-800/80">
    
    <!-- 1. CAN I SWIM: 30-Day Regional E. coli Area Curve & Safety Distribution Bar -->
    {tool.id === 'can-i-swim' && (
      <div class="space-y-2">
        <div class="flex items-center justify-between text-[10px] font-bold text-slate-500 dark:text-slate-400">
          <span class="flex items-center gap-1">
            <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
            30-Day Regional Trend
          </span>
          <span class="text-emerald-600 dark:text-emerald-400">Avg 32 CFU (Clean)</span>
        </div>
        
        <!-- SVG Sparkline Area Wave -->
        <div class="h-10 w-full relative">
          <svg viewBox="0 0 200 40" class="w-full h-full overflow-visible" preserveAspectRatio="none">
            <defs>
              <linearGradient id="swim-grad" x1="0" y1="0" x2="0" y2="1">
                <stop offset="0%" stop-color="#10b981" stop-opacity="0.35" />
                <stop offset="100%" stop-color="#10b981" stop-opacity="0.0" />
              </linearGradient>
            </defs>
            <!-- 200 CFU Safety Threshold Line -->
            <line x1="0" y1="12" x2="200" y2="12" stroke="#ef4444" stroke-width="1" stroke-dasharray="3,3" opacity="0.5" />
            <!-- Area Fill -->
            <path d="M0,32 Q30,28 60,35 T120,25 T160,30 T200,22 L200,40 L0,40 Z" fill="url(#swim-grad)" />
            <!-- Line Stroke -->
            <path d="M0,32 Q30,28 60,35 T120,25 T160,30 T200,22" fill="none" stroke="#10b981" stroke-width="2" stroke-linecap="round" />
            <!-- Active Node Dot -->
            <circle cx="200" cy="22" r="3" fill="#10b981" class="animate-pulse" />
          </svg>
        </div>

        <!-- Segmented Safety Ratio Progress Bar -->
        <div class="space-y-1">
          <div class="h-1.5 w-full bg-slate-200 dark:bg-slate-800 rounded-full overflow-hidden flex">
            <div style={`width: ${(safeBeachesCount / allBeaches.length) * 100}%`} class="bg-emerald-500 h-full" title="Safe"></div>
            <div style={`width: ${(cautionBeachesCount / allBeaches.length) * 100}%`} class="bg-amber-500 h-full" title="Caution"></div>
            <div style={`width: ${(advisoryBeachesCount / allBeaches.length) * 100}%`} class="bg-rose-500 h-full" title="Advisory"></div>
          </div>
          <div class="flex justify-between text-[9px] text-slate-400 font-medium">
            <span>{safeBeachesCount} Safe 🟢</span>
            <span>{cautionBeachesCount} Caution 🟡</span>
            <span>{advisoryBeachesCount} Advisory 🔴</span>
          </div>
        </div>
      </div>
    )}

    <!-- 2. BC FERRIES: Live Vehicle Deck Capacity Progress Meters -->
    {tool.id === 'bc-ferries' && (
      <div class="space-y-2">
        <div class="flex items-center justify-between text-[10px] font-bold text-slate-500 dark:text-slate-400">
          <span>Live Deck Space</span>
          <span class="text-sky-500 font-semibold">Tsawwassen & Horseshoe Bay</span>
        </div>

        <!-- 3 Route Capacity Meters -->
        <div class="space-y-1.5">
          <div class="space-y-0.5">
            <div class="flex justify-between text-[10px] font-medium text-slate-700 dark:text-slate-300">
              <span class="truncate">Tsawwassen ⇄ Swartz Bay</span>
              <span class="font-bold text-emerald-600 dark:text-emerald-400">72% Full</span>
            </div>
            <div class="h-1.5 w-full bg-slate-200 dark:bg-slate-800 rounded-full overflow-hidden">
              <div class="bg-emerald-500 h-full rounded-full transition-all" style="width: 72%"></div>
            </div>
          </div>

          <div class="space-y-0.5">
            <div class="flex justify-between text-[10px] font-medium text-slate-700 dark:text-slate-300">
              <span class="truncate">Horseshoe Bay ⇄ Departure Bay</span>
              <span class="font-bold text-amber-500">86% Full</span>
            </div>
            <div class="h-1.5 w-full bg-slate-200 dark:bg-slate-800 rounded-full overflow-hidden">
              <div class="bg-amber-500 h-full rounded-full transition-all" style="width: 86%"></div>
            </div>
          </div>

          <div class="space-y-0.5">
            <div class="flex justify-between text-[10px] font-medium text-slate-700 dark:text-slate-300">
              <span class="truncate">Hullo Fast Catamaran (Downtown)</span>
              <span class="font-bold text-sky-500">40% Booked</span>
            </div>
            <div class="h-1.5 w-full bg-slate-200 dark:bg-slate-800 rounded-full overflow-hidden">
              <div class="bg-sky-500 h-full rounded-full transition-all" style="width: 40%"></div>
            </div>
          </div>
        </div>
      </div>
    )}

    <!-- 3. MOUNTAIN SNOW: Elevation Matrix & Freezing Line Cross-Section -->
    {tool.id === 'mountain-snow' && (
      <div class="space-y-2">
        <div class="flex items-center justify-between text-[10px] font-bold text-slate-500 dark:text-slate-400">
          <span>Freezing Level vs Peaks</span>
          <span class="text-sky-600 dark:text-sky-400 font-bold">0°C @ {avgFreezingLevel}m</span>
        </div>

        <!-- Vertical Mountain Elevation Comparison Chart -->
        <div class="h-12 relative flex items-end justify-between gap-2 pt-2 px-1">
          <!-- Horizontal Freezing Level Guideline -->
          <div class="absolute left-0 right-0 top-3 border-t border-dashed border-sky-400/80 dark:border-sky-400/60 z-10 flex justify-end">
            <span class="text-[8px] font-extrabold text-sky-500 bg-white/80 dark:bg-slate-900/80 px-1 -mt-2 rounded">FZ Line</span>
          </div>

          <!-- Cypress (1,440m) -->
          <div class="flex-1 flex flex-col items-center gap-0.5 h-full justify-end">
            <span class="text-[8px] font-bold text-slate-500 dark:text-slate-400">1.4k</span>
            <div class="w-full bg-gradient-to-t from-sky-600 to-sky-400 rounded-t h-[60%]"></div>
            <span class="text-[8px] font-semibold text-slate-600 dark:text-slate-300 truncate">Cypress</span>
          </div>

          <!-- Grouse (1,250m) -->
          <div class="flex-1 flex flex-col items-center gap-0.5 h-full justify-end">
            <span class="text-[8px] font-bold text-slate-500 dark:text-slate-400">1.2k</span>
            <div class="w-full bg-gradient-to-t from-sky-600 to-sky-400 rounded-t h-[52%]"></div>
            <span class="text-[8px] font-semibold text-slate-600 dark:text-slate-300 truncate">Grouse</span>
          </div>

          <!-- Seymour (1,449m) -->
          <div class="flex-1 flex flex-col items-center gap-0.5 h-full justify-end">
            <span class="text-[8px] font-bold text-slate-500 dark:text-slate-400">1.4k</span>
            <div class="w-full bg-gradient-to-t from-sky-600 to-sky-400 rounded-t h-[62%]"></div>
            <span class="text-[8px] font-semibold text-slate-600 dark:text-slate-300 truncate">Seymour</span>
          </div>

          <!-- Whistler (2,284m) -->
          <div class="flex-1 flex flex-col items-center gap-0.5 h-full justify-end">
            <span class="text-[8px] font-bold text-sky-600 dark:text-sky-400 font-extrabold">2.3k</span>
            <div class="w-full bg-gradient-to-t from-indigo-600 to-sky-400 rounded-t h-[95%]"></div>
            <span class="text-[8px] font-semibold text-slate-600 dark:text-slate-300 truncate">Whistler</span>
          </div>
        </div>
      </div>
    )}

    <!-- 4. CAR-SHARE PARKING: Radar Clearance Dial & Rush-Hour Timeline -->
    {tool.id === 'evo-parking' && (
      <div class="space-y-2">
        <div class="flex items-center justify-between text-[10px] font-bold text-slate-500 dark:text-slate-400">
          <span>Curbside Clearance Timeline</span>
          <span class="text-emerald-600 dark:text-emerald-400 font-bold">100% Home Zone Safe</span>
        </div>

        <!-- Visual Timeline Bar -->
        <div class="space-y-1">
          <div class="h-2 w-full bg-slate-200 dark:bg-slate-800 rounded-full flex overflow-hidden">
            <div class="bg-emerald-500 w-[35%]" title="Daytime Safe"></div>
            <div class="bg-amber-500 w-[25%]" title="PM Rush Restricted (3-6 PM)"></div>
            <div class="bg-emerald-400 w-[40%]" title="Overnight Meter Free"></div>
          </div>
          <div class="flex justify-between text-[9px] font-medium text-slate-400">
            <span>Now: Safe to Park</span>
            <span>3-6 PM Rush</span>
            <span>Overnight Free</span>
          </div>
        </div>

        <div class="flex items-center justify-between pt-1 text-[10px]">
          <span class="text-slate-600 dark:text-slate-300 font-medium">🧹 Next Street Sweep:</span>
          <span class="font-bold text-sky-600 dark:text-sky-400">In 4 days (Zone 8A)</span>
        </div>
      </div>
    )}

    <!-- 5. ER & URGENT CARE: Comparative Wait Time Bar Chart -->
    {tool.id === 'health-wait-times' && (
      <div class="space-y-2">
        <div class="flex items-center justify-between text-[10px] font-bold text-slate-500 dark:text-slate-400">
          <span>Real-Time ER Wait Times</span>
          <span class="text-emerald-600 dark:text-emerald-400">11 ERs Tracking</span>
        </div>

        <!-- Comparative Wait Bars -->
        <div class="space-y-1.5">
          <div class="space-y-0.5">
            <div class="flex justify-between text-[10px]">
              <span class="font-medium text-slate-700 dark:text-slate-300">Mt. Saint Joseph ER</span>
              <span class="font-bold text-emerald-600 dark:text-emerald-400">1h 15m (Shortest)</span>
            </div>
            <div class="h-1.5 w-full bg-slate-200 dark:bg-slate-800 rounded-full overflow-hidden">
              <div class="bg-emerald-500 h-full rounded-full" style="width: 25%"></div>
            </div>
          </div>

          <div class="space-y-0.5">
            <div class="flex justify-between text-[10px]">
              <span class="font-medium text-slate-700 dark:text-slate-300">St. Paul's Hospital ER</span>
              <span class="font-bold text-amber-500">2h 10m</span>
            </div>
            <div class="h-1.5 w-full bg-slate-200 dark:bg-slate-800 rounded-full overflow-hidden">
              <div class="bg-amber-500 h-full rounded-full" style="width: 55%"></div>
            </div>
          </div>

          <div class="space-y-0.5">
            <div class="flex justify-between text-[10px]">
              <span class="font-medium text-slate-700 dark:text-slate-300">Vancouver General (VGH)</span>
              <span class="font-bold text-rose-500">3h 05m</span>
            </div>
            <div class="h-1.5 w-full bg-slate-200 dark:bg-slate-800 rounded-full overflow-hidden">
              <div class="bg-rose-500 h-full rounded-full" style="width: 80%"></div>
            </div>
          </div>
        </div>
      </div>
    )}

    <!-- 6. BRIDGES & TUNNELS: Dynamic Counterflow Visualizer & Delay Chart -->
    {tool.id === 'bridge-traffic' && (
      <div class="space-y-2">
        <div class="flex items-center justify-between text-[10px] font-bold text-slate-500 dark:text-slate-400">
          <span>Lions Gate Counterflow</span>
          <span class="text-amber-500 font-extrabold flex items-center gap-1">
            <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span> 2 Lanes NB Active
          </span>
        </div>

        <!-- 3-Lane Dynamic Direction Visualizer -->
        <div class="grid grid-cols-3 gap-1 p-1 bg-slate-900 text-white rounded-lg text-center font-mono text-[9px] font-bold">
          <div class="bg-emerald-600/80 py-1 rounded">▲ North</div>
          <div class="bg-emerald-600/80 py-1 rounded">▲ North</div>
          <div class="bg-rose-600/80 py-1 rounded">▼ South</div>
        </div>

        <div class="flex justify-between text-[9px] text-slate-400 font-medium">
          <span>Massey: 1 Tube SB</span>
          <span>Ironworkers: Flowing</span>
          <span>Oak St: +4m</span>
        </div>
      </div>
    )}

    <!-- 7. AIR QUALITY: 24h PM2.5 Particulate Area Sparkline & AQHI Gauge -->
    {tool.id === 'air-quality' && (
      <div class="space-y-2">
        <div class="flex items-center justify-between text-[10px] font-bold text-slate-500 dark:text-slate-400">
          <span>24h PM2.5 Fine Particulate</span>
          <span class="text-emerald-600 dark:text-emerald-400">AQHI 2 • Low Risk</span>
        </div>

        <!-- SVG 24h Area Sparkline -->
        <div class="h-9 w-full relative">
          <svg viewBox="0 0 200 36" class="w-full h-full overflow-visible" preserveAspectRatio="none">
            <defs>
              <linearGradient id="air-grad" x1="0" y1="0" x2="0" y2="1">
                <stop offset="0%" stop-color="#0284c7" stop-opacity="0.4" />
                <stop offset="100%" stop-color="#0284c7" stop-opacity="0.0" />
              </linearGradient>
            </defs>
            <path d="M0,28 Q40,24 80,30 T140,18 T180,24 T200,20 L200,36 L0,36 Z" fill="url(#air-grad)" />
            <path d="M0,28 Q40,24 80,30 T140,18 T180,24 T200,20" fill="none" stroke="#0284c7" stroke-width="2" />
            <circle cx="200" cy="20" r="2.5" fill="#0284c7" />
          </svg>
        </div>

        <!-- Rainbow AQHI Gauge Bar -->
        <div class="space-y-0.5">
          <div class="h-1.5 w-full bg-gradient-to-r from-emerald-500 via-amber-500 to-rose-600 rounded-full relative">
            <!-- Indicator Needle -->
            <div class="absolute -top-0.5 left-[15%] w-2.5 h-2.5 bg-white border-2 border-emerald-600 rounded-full shadow-xs"></div>
          </div>
          <div class="flex justify-between text-[8px] text-slate-400 font-bold">
            <span>Low (1-3)</span>
            <span>Mod (4-6)</span>
            <span>High (7-10)</span>
          </div>
        </div>
      </div>
    )}

    <!-- 8. CIVIC DEVELOPMENT: Skyline Tower Height Distribution -->
    {tool.id === 'civic-development' && (
      <div class="space-y-2">
        <div class="flex items-center justify-between text-[10px] font-bold text-slate-500 dark:text-slate-400">
          <span>Broadway Corridor Towers</span>
          <span class="text-sky-600 dark:text-sky-400">38 Proposals</span>
        </div>

        <!-- Visual Skyline Silhouette Bar Chart -->
        <div class="h-10 flex items-end justify-between gap-1.5 px-2 pt-1 border-b border-slate-200 dark:border-slate-800">
          <div class="flex-1 bg-sky-500/70 rounded-t h-[45%]" title="18 Storeys"></div>
          <div class="flex-1 bg-sky-500/80 rounded-t h-[65%]" title="28 Storeys"></div>
          <div class="flex-1 bg-indigo-500 rounded-t h-[90%]" title="38 Storeys"></div>
          <div class="flex-1 bg-sky-600 rounded-t h-[75%]" title="32 Storeys"></div>
          <div class="flex-1 bg-sky-400/80 rounded-t h-[40%]" title="16 Storeys"></div>
          <div class="flex-1 bg-indigo-600 rounded-t h-[100%]" title="42 Storeys (Max)"></div>
        </div>

        <div class="flex justify-between text-[9px] text-slate-400 font-medium">
          <span>Average: 28 Storeys</span>
          <span>11.5 Proposed FSR</span>
        </div>
      </div>
    )}

    <!-- 9. COMMUNITY EVENTS: 7-Day Event Activity Spark-Calendar -->
    {tool.id === 'community-events' && (
      <div class="space-y-2">
        <div class="flex items-center justify-between text-[10px] font-bold text-slate-500 dark:text-slate-400">
          <span>7-Day Free Event Activity</span>
          <span class="text-emerald-600 dark:text-emerald-400 font-bold">6 This Weekend</span>
        </div>

        <!-- 7-Day Column Activity Chart -->
        <div class="h-10 flex items-end justify-between gap-1 px-1">
          <div class="flex-1 flex flex-col items-center gap-0.5">
            <div class="w-full bg-slate-200 dark:bg-slate-800 rounded-t h-2"></div>
            <span class="text-[8px] text-slate-400">M</span>
          </div>
          <div class="flex-1 flex flex-col items-center gap-0.5">
            <div class="w-full bg-slate-200 dark:bg-slate-800 rounded-t h-3"></div>
            <span class="text-[8px] text-slate-400">T</span>
          </div>
          <div class="flex-1 flex flex-col items-center gap-0.5">
            <div class="w-full bg-emerald-500/50 rounded-t h-5"></div>
