---
import type { ToolMeta } from '../../types/shared';

interface Props {
  tool: ToolMeta;
}

const { tool } = Astro.props;

const categoryLabels: Record<string, string> = {
  outdoors: 'Outdoors & Nature',
  transit: 'Transit & Ferries',
  daily_living: 'Daily Living',
  civic: 'Civic & City',
};

const categoryGradients: Record<string, string> = {
  outdoors: 'from-emerald-500/10 to-teal-500/10 border-emerald-500/20 text-emerald-500',
  transit: 'from-sky-500/10 to-blue-500/10 border-sky-500/20 text-sky-500',
  daily_living: 'from-amber-500/10 to-orange-500/10 border-amber-500/20 text-amber-500',
  civic: 'from-purple-500/10 to-indigo-500/10 border-purple-500/20 text-purple-500',
};
---

<div
  class="tool-card group relative flex flex-col justify-between p-6 rounded-3xl bg-white dark:bg-slate-900/90 border border-slate-200/80 dark:border-slate-800 shadow-sm hover:shadow-xl hover:border-sky-500/40 dark:hover:border-sky-500/40 transition-all duration-300 transform hover:-translate-y-1"
  data-tool-id={tool.id}
  data-tool-category={tool.category}
  data-tool-status={tool.status}
  data-tool-name={tool.name}
>
  <div>
    <!-- Top Row: Icon + Category + Pin -->
    <div class="flex items-center justify-between gap-3 mb-4">
      <div class="flex items-center gap-3">
        <div class={`w-12 h-12 rounded-2xl flex items-center justify-center border text-2xl shadow-inner ${categoryGradients[tool.category]}`}>
          {tool.icon === 'waves' && '🌊'}
          {tool.icon === 'ship' && '⛴️'}
          {tool.icon === 'mountain-snow' && '🏔️'}
          {tool.icon === 'car' && '🚗'}
        </div>
        <div>
          <span class="text-[11px] font-bold uppercase tracking-wider text-slate-400 dark:text-slate-500">
            {categoryLabels[tool.category] || tool.category}
          </span>
          <div class="flex items-center gap-2 mt-0.5">
            {tool.status === 'active' ? (
              <span class="inline-flex items-center gap-1 text-[11px] font-bold text-emerald-600 dark:text-emerald-400">
                <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
                Active Utility
              </span>
            ) : (
              <span class="inline-flex items-center text-[10px] font-semibold text-slate-500 dark:text-slate-400 px-2 py-0.5 rounded bg-slate-100 dark:bg-slate-800 border border-slate-200 dark:border-slate-700">
                {tool.badgeText || 'Roadmap'}
              </span>
            )}
          </div>
        </div>
      </div>

      <!-- Pin / Favorite Button -->
      <button
        type="button"
        class="pin-tool-btn p-2 text-slate-300 hover:text-amber-400 dark:text-slate-600 dark:hover:text-amber-400 transition-colors rounded-xl hover:bg-slate-100 dark:hover:bg-slate-800"
        data-tool-id={tool.id}
        title="Pin this utility to top"
        aria-label={`Pin ${tool.name}`}
      >
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z" />
        </svg>
      </button>
    </div>

    <!-- Title & Description -->
    <h3 class="text-xl font-bold text-slate-900 dark:text-white tracking-tight mb-2 group-hover:text-sky-500 transition-colors">
      <a href={tool.path} class="focus:outline-none">
        {tool.name}
      </a>
    </h3>
    <p class="text-xs text-slate-600 dark:text-slate-400 leading-relaxed mb-5">
      {tool.shortDescription}
    </p>

    <!-- Preview Metric / Live Stat Card -->
    {tool.previewStat && (
      <div class="mb-5 p-3.5 rounded-2xl bg-slate-50 dark:bg-slate-800/60 border border-slate-100 dark:border-slate-700/50 flex items-center justify-between">
        <div>
          <div class="text-base font-extrabold text-slate-900 dark:text-white flex items-center gap-1.5">
            {tool.previewStat.statusType === 'safe' && <span class="w-2.5 h-2.5 rounded-full bg-emerald-500"></span>}
            {tool.previewStat.statusType === 'info' && <span class="w-2.5 h-2.5 rounded-full bg-sky-500"></span>}
            <span class="tool-preview-value" data-tool-id={tool.id}>{tool.previewStat.value}</span>
          </div>
          <div class="text-[11px] text-slate-500 dark:text-slate-400 font-medium">
            {tool.previewStat.label}
          </div>
        </div>
        <span class="text-xs font-semibold px-2.5 py-1 rounded-full bg-white dark:bg-slate-700/80 text-slate-700 dark:text-slate-200 border border-slate-200/80 dark:border-slate-600 shadow-xs">
          Instant
        </span>
      </div>
    )}

    <!-- Features Pill List -->
    {tool.features && (
      <ul class="space-y-1.5 mb-6">
        {tool.features.map((feature) => (
          <li class="flex items-center gap-2 text-xs text-slate-600 dark:text-slate-400">
            <svg class="w-3.5 h-3.5 text-emerald-500 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
            </svg>
            <span>{feature}</span>
          </li>
        ))}
      </ul>
    )}
  </div>

  <!-- Launch Link / Button -->
  <a
    href={tool.path}
    class={`w-full flex items-center justify-center gap-2 px-4 py-3 rounded-2xl text-xs font-bold transition-all ${
      tool.status === 'active'
        ? 'bg-sky-600 hover:bg-sky-500 text-white shadow-md shadow-sky-600/20 group-hover:shadow-lg group-hover:shadow-sky-500/30'
        : 'bg-slate-100 dark:bg-slate-800 hover:bg-slate-200 dark:hover:bg-slate-700 text-slate-800 dark:text-slate-200 border border-slate-200/80 dark:border-slate-700'
    }`}
  >
    <span>{tool.status === 'active' ? 'Launch Utility' : 'View Preview & Specs'}</span>
    <svg class="w-4 h-4 transition-transform group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
      <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
    </svg>
  </a>
</div>
