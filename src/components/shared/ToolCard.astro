{tool.id === 'local-news' && (
  <script is:inline define:vars={{ allArticlesJson: JSON.stringify(allArticles) }}>
    function syncMainCardNews() {
      const grid = document.getElementById('main-card-news-grid');
      if (!grid) return;

      const saved = localStorage.getItem('vanutils_pinned_local-news');
      const allArticles = JSON.parse(allArticlesJson || '[]');
      
      let displayList = [];
      if (saved) {
        try {
          const pinnedIds = JSON.parse(saved);
          const pinned = allArticles.filter((a) => pinnedIds.includes(a.id));
          const unpinned = allArticles.filter((a) => !pinnedIds.includes(a.id));
          displayList = [...pinned, ...unpinned].slice(0, 6);
        } catch (e) {
          displayList = allArticles.slice(0, 6);
        }
      } else {
        displayList = allArticles.slice(0, 6);
      }

      if (displayList.length === 0) return;

      grid.innerHTML = displayList.map((a) => {
        const breakingBadge = a.isBreaking
          ? '<span class="px-1.5 py-0.2 rounded text-[10px] font-extrabold bg-rose-500/20 text-rose-700 dark:text-rose-300">Breaking</span>'
          : '';

        return `
          <div class="flex items-center justify-between py-1 border-b border-slate-100 dark:border-slate-800/60" data-article-id="${a.id}">
            <div class="truncate pr-2 font-medium">
              <span class="font-bold text-slate-900 dark:text-white mr-1">[${a.outletName}]</span>
              <span>${a.title}</span>
            </div>
            <div class="shrink-0 flex items-center gap-1.5 text-[11px] font-semibold">
              <span class="text-slate-400">Recently</span>
              ${breakingBadge}
            </div>
          </div>
        `;
      }).join('');
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', syncMainCardNews);
    } else {
      syncMainCardNews();
    }

    window.addEventListener('vanutils:pinned-news-changed', syncMainCardNews);
  </script>
)}

