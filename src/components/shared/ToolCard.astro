---
import type { ToolMeta } from '../../types/shared';
import { getLiveBeaches } from '../../tools/can-i-swim/services/vchScraper';
import { getLiveRoutes } from '../../tools/bc-ferries/services/ferryService';
import { getLiveMountains } from '../../tools/mountain-snow/services/snowService';
import { getLiveNeighbourhoods, evaluateNeighbourhoodSpot } from '../../tools/carshare-parking/services/parkingEvaluator';
import { getLiveFacilities, formatWaitTime } from '../../tools/health-wait-times/services/healthService';
import { getLiveCrossings } from '../../tools/bridge-traffic/services/bridgeService';
import { getLiveStations } from '../../tools/air-quality/services/airQualityService';
import LiveDataUnavailable from './LiveDataUnavailable.astro';
import { getLiveNews, formatTimeAgo } from '../../tools/local-news/services/newsService';
import { getLiveMarketHeartbeat, formatCurrency, getConditionLabel } from '../../tools/housing-market/services/marketService';
import { getLiveSportsFacilities } from '../../tools/sports-facilities/services/sportsService';
import { getLiveWeather } from '../../tools/weather-forecast/services/weatherService';
import { getLiveSportsTeams } from '../../tools/sports-teams/services/sportsTeamsService';
import { getLiveSalesEvents } from '../../tools/sales-events/services/salesService';

interface Props {
  tool: ToolMeta;
}

const { tool } = Astro.props;

// Fetch live telemetry for high-density listings at the edge
const swimResult = tool.id === 'can-i-swim' ? await getLiveBeaches() : null;
const allBeaches = swimResult?.ok ? swimResult.data : [];
const initialBeaches = allBeaches.slice(0, 4);
const safeBeachesCount = allBeaches.filter((b) => b.currentStatus === 'safe').length;
const cautionBeachesCount = allBeaches.filter((b) => b.currentStatus === 'caution').length;
const advisoryBeachesCount = allBeaches.filter((b) => b.currentStatus === 'advisory').length;
const validBeaches = allBeaches.filter((b) => typeof b.latestSample?.eColiCount === 'number');
const avgEColi = validBeaches.length > 0
  ? Math.round(validBeaches.reduce((acc, b) => acc + b.latestSample.eColiCount, 0) / validBeaches.length)
  : 0;

const ferriesResult = tool.id === 'bc-ferries' ? await getLiveRoutes() : null;
const allFerryRoutes = ferriesResult?.ok ? ferriesResult.data : [];
const initialFerryRoutes = allFerryRoutes.slice(0, 3);

const snowResult = tool.id === 'mountain-snow' ? await getLiveMountains() : null;
const allMountains = snowResult?.ok ? snowResult.data : [];
const initialMountains = allMountains.slice(0, 4);
const avgFreezingLevel = allMountains.length > 0
  ? Math.round(allMountains.reduce((acc, m) => acc + m.currentFreezingLevelMeters, 0) / allMountains.length)
  : 0;
const snowBadgeText = avgFreezingLevel > 3000 ? `0°C @ ${avgFreezingLevel}m (Summer)` : `${avgFreezingLevel}m FZ`;

const parkingResult = tool.id === 'evo-parking' ? await getLiveNeighbourhoods() : null;
const allNeighbourhoods = parkingResult?.ok ? parkingResult.data : [];
const initialNeighbourhoods = allNeighbourhoods.slice(0, 4);
const safeNeighbourhoodsCount = allNeighbourhoods.filter((n) => evaluateNeighbourhoodSpot(n).clearanceStatus === 'safe').length;

const healthResult = tool.id === 'health-wait-times' ? await getLiveFacilities() : null;
const allFacilities = healthResult?.ok ? healthResult.data : [];
const facilitiesWithWait = allFacilities.filter((f) => f.triageData?.waitTimeMinutes !== undefined);
const barChartFacilities = facilitiesWithWait.slice(0, 3);
// Start the list below after the bar chart's own facilities so the homepage
// card never renders the same hospital twice.
const initialFacilities = allFacilities.filter((f) => !barChartFacilities.some((bf) => bf.id === f.id)).slice(0, 4);
const minWaitFacility = facilitiesWithWait.length > 0
  ? [...facilitiesWithWait].sort((a, b) => (a.triageData?.waitTimeMinutes || 0) - (b.triageData?.waitTimeMinutes || 0))[0]
  : null;
const minWaitText = minWaitFacility?.triageData?.waitTimeMinutes !== undefined
  ? `${formatWaitTime(minWaitFacility.triageData.waitTimeMinutes)} Min ER`
  : `${allFacilities.length} ERs Tracking`;

const crossingsResult = tool.id === 'bridge-traffic' ? await getLiveCrossings() : null;
const allCrossings = crossingsResult?.ok ? crossingsResult.data : [];
const initialCrossings = allCrossings.slice(0, 4);
const lionsGate = allCrossings.find((c) => c.id === 'lions-gate');
const lionsGateLanes = lionsGate?.counterflow?.activeConfiguration
  ? (lionsGate.counterflow.activeConfiguration.includes('2 Lanes Northbound') ? '2 NB Active' : '1 NB Active')
  : 'Flowing';

const airResult = tool.id === 'air-quality' ? await getLiveStations() : null;
const allStations = airResult?.ok ? airResult.data : [];
const initialStations = allStations.slice(0, 4);
const avgAqhi = allStations.length > 0
  ? Math.round(allStations.reduce((acc, s) => acc + s.currentAQHI, 0) / allStations.length)
  : 0;


const newsResult = tool.id === 'local-news' ? await getLiveNews() : null;
const allNews = newsResult?.ok ? newsResult.data : [];
const initialNews = allNews.slice(0, 4);

const marketResult = tool.id === 'housing-market' ? await getLiveMarketHeartbeat() : null;
const marketHeartbeat = marketResult?.ok ? marketResult.data : null;
const initialSubmarkets = marketHeartbeat ? marketHeartbeat.submarkets.slice(0, 4) : [];
const sarPercent = marketHeartbeat?.metroOverview?.salesToActiveRatio ?? 0;
const sarCondition = marketHeartbeat?.metroOverview?.marketCondition ? getConditionLabel(marketHeartbeat.metroOverview.marketCondition) : '';
const condoBenchmarkPrice = marketHeartbeat?.metroOverview?.benchmarks.find((b) => b.propertyType === 'condo')?.benchmarkPrice ?? 0;
const detachedBenchmarkPrice = marketHeartbeat?.metroOverview?.benchmarks.find((b) => b.propertyType === 'detached')?.benchmarkPrice ?? 0;

const sportsResult = tool.id === 'sports-courts' ? await getLiveSportsFacilities() : null;
const allSportsFacilities = sportsResult?.ok ? sportsResult.data : [];
const initialSportsFacilities = allSportsFacilities.slice(0, 3);
const totalCourtsCount = allSportsFacilities.reduce((sum, f) => sum + (f.courtDetails?.totalCourts || 1), 0);
const lightedCourtsCount = allSportsFacilities.filter((f) => f.courtDetails?.hasLights).reduce((sum, f) => sum + (f.courtDetails?.totalCourts || 1), 0);

const weatherResult = tool.id === 'weather-forecast' ? await getLiveWeather() : null;
const allWeatherStations = weatherResult?.ok ? weatherResult.data : [];
const initialWeatherStations = allWeatherStations.slice(0, 4);
const avgWeatherTemp = allWeatherStations.length > 0
  ? Math.round((allWeatherStations.reduce((acc, s) => acc + s.current.temperatureCelsius, 0) / allWeatherStations.length) * 10) / 10
  : 0;

const sportsTeamsResult = tool.id === 'sports-teams' ? await getLiveSportsTeams() : null;
const sportsTeamsData = sportsTeamsResult?.ok ? sportsTeamsResult.data : null;
const allSportsTeams = sportsTeamsData ? sportsTeamsData.teams : [];
const initialSportsTeams = allSportsTeams.slice(0, 4);

const salesResult = tool.id === 'sales-events' ? await getLiveSalesEvents() : null;
const allSalesEvents = salesResult?.ok ? salesResult.data : [];
const initialSalesEvents = allSalesEvents.slice(0, 4);
const nextMajorSale = allSalesEvents.find((s) => s.status !== 'concluded') || allSalesEvents[0];
---

<div
  class="tool-card group relative flex flex-col justify-between p-4 sm:p-5 rounded-2xl bg-white dark:bg-slate-900/90 border border-slate-200/90 dark:border-slate-800 hover:border-sky-500/70 dark:hover:border-sky-500/70 hover:shadow-lg hover:shadow-sky-500/5 transition-all duration-200 cursor-pointer"
  data-tool-id={tool.id}
  data-tool-path={tool.path}
>
  <!-- Full-Card Clickable Anchor -->
  <a href={tool.path} class="tool-card-main-link absolute inset-0 z-0 rounded-2xl" aria-label={`Open ${tool.name}`}></a>

  <!-- Card Top Header -->
  <div class="relative z-10 flex items-center justify-between gap-2 mb-2.5">
    <a href={tool.path} class="flex items-center gap-1.5 group-hover:text-sky-500 transition-colors">
      <h2 class="text-sm font-bold text-slate-900 dark:text-white leading-tight">
        {tool.name}
      </h2>
    </a>
    
    <a href={tool.path} class="shrink-0">
      <span class="text-[11px] font-bold px-2 py-0.5 rounded-full bg-emerald-500/10 text-emerald-700 dark:text-emerald-400 border border-emerald-500/20 whitespace-nowrap">
        {tool.id === 'can-i-swim' && (swimResult?.ok ? `${safeBeachesCount}/${allBeaches.length} Safe` : 'Unavailable')}
        {tool.id === 'bc-ferries' && (ferriesResult?.ok ? `${allFerryRoutes.length} Live Routes` : 'Unavailable')}
        {tool.id === 'mountain-snow' && (snowResult?.ok ? snowBadgeText : 'Unavailable')}
        {tool.id === 'evo-parking' && (parkingResult?.ok ? `${safeNeighbourhoodsCount}/${allNeighbourhoods.length} Safe Zones` : 'Unavailable')}
        {tool.id === 'health-wait-times' && (healthResult?.ok ? minWaitText : 'Unavailable')}
        {tool.id === 'bridge-traffic' && (crossingsResult?.ok ? lionsGateLanes : 'Unavailable')}
        {tool.id === 'air-quality' && (airResult?.ok ? `AQHI ${avgAqhi} (${avgAqhi <= 3 ? 'Low' : 'Mod'})` : 'Unavailable')}
        {tool.id === 'local-news' && (newsResult?.ok ? 'Live Wire' : 'Unavailable')}
        {tool.id === 'housing-market' && (marketResult?.ok ? `${sarPercent}% SAR` : 'Unavailable')}
        {tool.id === 'sports-courts' && (sportsResult?.ok ? `${totalCourtsCount} Courts` : 'Unavailable')}
        {tool.id === 'weather-forecast' && (weatherResult?.ok ? `${avgWeatherTemp}°C Regional Avg` : 'Unavailable')}
        {tool.id === 'sports-teams' && (sportsTeamsResult?.ok ? `${allSportsTeams.length} Pro Teams` : 'Unavailable')}
        {tool.id === 'sales-events' && (salesResult?.ok ? `${allSalesEvents.length} Verified Sales` : 'Unavailable')}
      </span>
    </a>
  </div>

  <!-- BESPOKE ENGAGING VISUAL CHARTS & METERS (TAILORED PER UTILITY) -->
  <div class="my-2.5 p-2.5 rounded-xl bg-slate-50 dark:bg-slate-950/60 border border-slate-100 dark:border-slate-800/80">
    
    <!-- 1. CAN I SWIM: 30-Day Regional E. coli Area Curve & Safety Distribution Bar -->
    {tool.id === 'can-i-swim' && !swimResult?.ok && (
      <LiveDataUnavailable toolName={tool.name} variant="card" />
    )}
    {tool.id === 'can-i-swim' && swimResult?.ok && (
      <div class="space-y-2">
        <div class="flex items-center justify-between text-[10px] font-bold text-slate-500 dark:text-slate-400">
          <span class="flex items-center gap-1">
            <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
            30-Day Regional Trend
          </span>
          <span class="text-emerald-600 dark:text-emerald-400">Avg {avgEColi} CFU ({avgEColi <= 200 ? 'Clean' : 'Elevated'})</span>
        </div>
        
        <!-- SVG Sparkline Area Wave -->
        <div class="h-10 w-full relative">
          <svg viewBox="0 0 200 40" class="w-full h-full overflow-visible" preserveAspectRatio="none">
            <defs>
              <linearGradient id="swim-grad" x1="0" y1="0" x2="0" y2="1">
                <stop offset="0%" stop-color="#10b981" stop-opacity="0.35" />
                <stop offset="100%" stop-color="#10b981" stop-opacity="0.0" />
              </linearGradient>
            </defs>
            <!-- 200 CFU Safety Threshold Line -->
            <line x1="0" y1="12" x2="200" y2="12" stroke="#ef4444" stroke-width="1" stroke-dasharray="3,3" opacity="0.5" />
            <!-- Area Fill -->
            <path d="M0,32 Q30,28 60,35 T120,25 T160,30 T200,22 L200,40 L0,40 Z" fill="url(#swim-grad)" />
            <!-- Line Stroke -->
            <path d="M0,32 Q30,28 60,35 T120,25 T160,30 T200,22" fill="none" stroke="#10b981" stroke-width="2" stroke-linecap="round" />
            <!-- Active Node Dot -->
            <circle cx="200" cy="22" r="3" fill="#10b981" class="animate-pulse" />
          </svg>
        </div>

        <!-- Segmented Safety Ratio Progress Bar -->
        <div class="space-y-1">
          <div class="h-1.5 w-full bg-slate-200 dark:bg-slate-800 rounded-full overflow-hidden flex">
            <div style={`width: ${(safeBeachesCount / Math.max(1, allBeaches.length)) * 100}%`} class="bg-emerald-500 h-full" title="Safe"></div>
            <div style={`width: ${(cautionBeachesCount / Math.max(1, allBeaches.length)) * 100}%`} class="bg-amber-500 h-full" title="Caution"></div>
            <div style={`width: ${(advisoryBeachesCount / Math.max(1, allBeaches.length)) * 100}%`} class="bg-rose-500 h-full" title="Advisory"></div>
          </div>
          <div class="flex justify-between text-[9px] text-slate-400 font-medium">
            <span>{safeBeachesCount} Safe 🟢</span>
            <span>{cautionBeachesCount} Caution 🟡</span>
            <span>{advisoryBeachesCount} Advisory 🔴</span>
          </div>
        </div>
      </div>
    )}

    <!-- 2. BC FERRIES: Live Vehicle Deck Capacity Progress Meters -->
    {tool.id === 'bc-ferries' && !ferriesResult?.ok && (
      <LiveDataUnavailable toolName={tool.name} variant="card" />
    )}
    {tool.id === 'bc-ferries' && ferriesResult?.ok && (
      <div class="space-y-2">
        <div class="flex items-center justify-between text-[10px] font-bold text-slate-500 dark:text-slate-400">
          <span>Live Deck Space</span>
          <span class="text-sky-500 font-semibold">Tsawwassen & Horseshoe Bay</span>
        </div>

        <!-- Dynamic Route Capacity Meters -->
        <div class="space-y-1.5">
          {initialFerryRoutes.map((r) => {
            const sailing = r.nextSailings && r.nextSailings[0];
            const pct: number = typeof sailing?.deckSpacePercent === 'number' ? sailing.deckSpacePercent : 50;
            const barColor = pct < 75 ? 'bg-emerald-500' : pct < 90 ? 'bg-amber-500' : 'bg-rose-500';
            const textColor = pct < 75 ? 'text-emerald-600 dark:text-emerald-400' : pct < 90 ? 'text-amber-500' : 'text-rose-500';
            return (
              <div class="space-y-0.5">
                <div class="flex justify-between text-[10px] font-medium text-slate-700 dark:text-slate-300">
                  <span class="truncate">{r.name}</span>
                  <span class={`font-bold ${textColor}`}>{pct}% Full</span>
                </div>
                <div class="h-1.5 w-full bg-slate-200 dark:bg-slate-800 rounded-full overflow-hidden">
                  <div class={`${barColor} h-full rounded-full transition-all`} style={`width: ${pct}%`}></div>
                </div>
              </div>
            );
          })}
        </div>
      </div>
    )}

    <!-- 3. MOUNTAIN SNOW: Elevation Matrix & Freezing Line Cross-Section -->
    {tool.id === 'mountain-snow' && !snowResult?.ok && (
      <LiveDataUnavailable toolName={tool.name} variant="card" />
    )}
    {tool.id === 'mountain-snow' && snowResult?.ok && (
      <div class="space-y-2">
        <div class="flex items-center justify-between text-[10px] font-bold text-slate-500 dark:text-slate-400">
          <span>Freezing Level vs Peaks</span>
          <span class="text-sky-600 dark:text-sky-400 font-bold">0°C @ {avgFreezingLevel}m</span>
        </div>

        <!-- Vertical Mountain Elevation Comparison Chart -->
        <div class="h-12 relative flex items-end justify-between gap-2 pt-2 px-1">
          <!-- Horizontal Freezing Level Guideline -->
          <div class="absolute left-0 right-0 top-3 border-t border-dashed border-sky-400/80 dark:border-sky-400/60 z-10 flex justify-end">
            <span class="text-[8px] font-extrabold text-sky-500 bg-white/80 dark:bg-slate-900/80 px-1 -mt-2 rounded">FZ Line</span>
          </div>

          <!-- Cypress (1,440m) -->
          <div class="flex-1 flex flex-col items-center gap-0.5 h-full justify-end">
            <span class="text-[8px] font-bold text-slate-500 dark:text-slate-400">1.4k</span>
            <div class="w-full bg-gradient-to-t from-sky-600 to-sky-400 rounded-t h-[60%]"></div>
            <span class="text-[8px] font-semibold text-slate-600 dark:text-slate-300 truncate">Cypress</span>
          </div>

          <!-- Grouse (1,250m) -->
          <div class="flex-1 flex flex-col items-center gap-0.5 h-full justify-end">
            <span class="text-[8px] font-bold text-slate-500 dark:text-slate-400">1.2k</span>
            <div class="w-full bg-gradient-to-t from-sky-600 to-sky-400 rounded-t h-[52%]"></div>
            <span class="text-[8px] font-semibold text-slate-600 dark:text-slate-300 truncate">Grouse</span>
          </div>

          <!-- Seymour (1,449m) -->
          <div class="flex-1 flex flex-col items-center gap-0.5 h-full justify-end">
            <span class="text-[8px] font-bold text-slate-500 dark:text-slate-400">1.4k</span>
            <div class="w-full bg-gradient-to-t from-sky-600 to-sky-400 rounded-t h-[62%]"></div>
            <span class="text-[8px] font-semibold text-slate-600 dark:text-slate-300 truncate">Seymour</span>
          </div>

          <!-- Whistler (2,284m) -->
          <div class="flex-1 flex flex-col items-center gap-0.5 h-full justify-end">
            <span class="text-[8px] font-bold text-sky-600 dark:text-sky-400 font-extrabold">2.3k</span>
            <div class="w-full bg-gradient-to-t from-indigo-600 to-sky-400 rounded-t h-[95%]"></div>
            <span class="text-[8px] font-semibold text-slate-600 dark:text-slate-300 truncate">Whistler</span>
          </div>
        </div>
      </div>
    )}

    <!-- 4. CAR-SHARE PARKING: Radar Clearance Dial & Rush-Hour Timeline -->
    {tool.id === 'evo-parking' && !parkingResult?.ok && (
      <LiveDataUnavailable toolName={tool.name} variant="card" />
    )}
    {tool.id === 'evo-parking' && parkingResult?.ok && (
      <div class="space-y-2">
        <div class="flex items-center justify-between text-[10px] font-bold text-slate-500 dark:text-slate-400">
          <span>Curbside Clearance Timeline</span>
          <span class="text-emerald-600 dark:text-emerald-400 font-bold">{safeNeighbourhoodsCount}/{allNeighbourhoods.length} Safe Zones</span>
        </div>

        <!-- Visual Timeline Bar -->
        <div class="space-y-1">
          <div class="h-2 w-full bg-slate-200 dark:bg-slate-800 rounded-full flex overflow-hidden">
            <div class="bg-emerald-500 w-[35%]" title="Daytime Safe"></div>
            <div class="bg-amber-500 w-[25%]" title="PM Rush Restricted (3-6 PM)"></div>
            <div class="bg-emerald-400 w-[40%]" title="Overnight Meter Free"></div>
          </div>
          <div class="flex justify-between text-[9px] font-medium text-slate-400">
            <span>Now: Safe to Park</span>
            <span>3-6 PM Rush</span>
            <span>Overnight Free</span>
          </div>
        </div>

        <div class="flex items-center justify-between pt-1 text-[10px]">
          <span class="text-slate-600 dark:text-slate-300 font-medium">🧹 Street Sweeping:</span>
          <span class="font-bold text-sky-600 dark:text-sky-400">{allNeighbourhoods[0]?.sweepingSchedule?.sweepHours || '02:00 - 06:00'} (Nightly)</span>
        </div>
      </div>
    )}

    <!-- 5. ER & URGENT CARE: Comparative Wait Time Bar Chart -->
    {tool.id === 'health-wait-times' && !healthResult?.ok && (
      <LiveDataUnavailable toolName={tool.name} variant="card" />
    )}
    {tool.id === 'health-wait-times' && healthResult?.ok && (
      <div class="space-y-2">
        <div class="flex items-center justify-between text-[10px] font-bold text-slate-500 dark:text-slate-400">
          <span>Real-Time ER Wait Times</span>
          <span class="text-emerald-600 dark:text-emerald-400">{allFacilities.length} Facilities Tracking</span>
        </div>

        <!-- Dynamic Comparative Wait Bars -->
        <div class="space-y-1.5">
          {barChartFacilities.map((f) => {
            const wait = f.triageData?.waitTimeMinutes || 0;
            const barWidth = Math.min(100, Math.max(12, Math.round((wait / 240) * 100)));
            const barColor = wait < 90 ? 'bg-emerald-500' : wait < 180 ? 'bg-amber-500' : 'bg-rose-500';
            const textColor = wait < 90 ? 'text-emerald-600 dark:text-emerald-400' : wait < 180 ? 'text-amber-500' : 'text-rose-500';
            return (
              <div class="space-y-0.5">
                <div class="flex justify-between text-[10px]">
                  <span class="font-medium text-slate-700 dark:text-slate-300 truncate">{f.shortName || f.name}</span>
                  <span class={`font-bold ${textColor} shrink-0 ml-1`}>{formatWaitTime(wait)}</span>
                </div>
                <div class="h-1.5 w-full bg-slate-200 dark:bg-slate-800 rounded-full overflow-hidden">
                  <div class={`${barColor} h-full rounded-full`} style={`width: ${barWidth}%`}></div>
                </div>
              </div>
            );
          })}
        </div>
      </div>
    )}

    <!-- 6. BRIDGES & TUNNELS: Dynamic Counterflow Visualizer & Delay Chart -->
    {tool.id === 'bridge-traffic' && !crossingsResult?.ok && (
      <LiveDataUnavailable toolName={tool.name} variant="card" />
    )}
    {tool.id === 'bridge-traffic' && crossingsResult?.ok && (
      <div class="space-y-2">
        <div class="flex items-center justify-between text-[10px] font-bold text-slate-500 dark:text-slate-400">
          <span>Lions Gate Counterflow</span>
          <span class="text-amber-500 font-extrabold flex items-center gap-1">
            <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span> {lionsGateLanes}
          </span>
        </div>

        <!-- 3-Lane Dynamic Direction Visualizer -->
        <div class="grid grid-cols-3 gap-1 p-1 bg-slate-900 text-white rounded-lg text-center font-mono text-[9px] font-bold">
          <div class="bg-emerald-600/80 py-1 rounded">▲ North</div>
          <div class={`${(lionsGate?.counterflow?.activeConfiguration || '').includes('2 Lanes Northbound') ? 'bg-emerald-600/80' : 'bg-rose-600/80'} py-1 rounded`}>
            {(lionsGate?.counterflow?.activeConfiguration || '').includes('2 Lanes Northbound') ? '▲ North' : '▼ South'}
          </div>
          <div class="bg-rose-600/80 py-1 rounded">▼ South</div>
        </div>

        <div class="flex justify-between text-[9px] text-slate-400 font-medium">
          {initialCrossings.slice(0, 3).map((c) => (
            <span class="truncate">{c.shortName}: {c.directions.primary.delayMinutes > 0 ? `+${c.directions.primary.delayMinutes}m` : 'Flowing'}</span>
          ))}
        </div>
      </div>
    )}

    <!-- 7. AIR QUALITY: 24h PM2.5 Particulate Area Sparkline & AQHI Gauge -->
    {tool.id === 'air-quality' && !airResult?.ok && (
      <LiveDataUnavailable toolName={tool.name} variant="card" />
    )}
    {tool.id === 'air-quality' && airResult?.ok && (
      <div class="space-y-2">
        <div class="flex items-center justify-between text-[10px] font-bold text-slate-500 dark:text-slate-400">
          <span>24h PM2.5 Fine Particulate</span>
          <span class="text-emerald-600 dark:text-emerald-400">AQHI {avgAqhi} • {avgAqhi <= 3 ? 'Low Risk' : avgAqhi <= 6 ? 'Moderate Risk' : 'High Risk'}</span>
        </div>

        <!-- SVG 24h Area Sparkline -->
        <div class="h-9 w-full relative">
          <svg viewBox="0 0 200 36" class="w-full h-full overflow-visible" preserveAspectRatio="none">
            <defs>
              <linearGradient id="air-grad" x1="0" y1="0" x2="0" y2="1">
                <stop offset="0%" stop-color="#0284c7" stop-opacity="0.4" />
                <stop offset="100%" stop-color="#0284c7" stop-opacity="0.0" />
              </linearGradient>
            </defs>
            <path d="M0,28 Q40,24 80,30 T140,18 T180,24 T200,20 L200,36 L0,36 Z" fill="url(#air-grad)" />
