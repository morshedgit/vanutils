            </div>
          </div>
        ))}
      </div>
    )}

    <!-- MAJOR SPORTS TEAMS -->
    {tool.id === 'sports-teams' && (
      <div class="space-y-1" id="main-card-sports-teams-grid">
        {initialSportsTeams.map((t) => (
          <div class="flex items-center justify-between py-0.5 border-b border-slate-100 dark:border-slate-800/60" data-team-id={t.id}>
            <a href={`/sports-teams/${t.id}`} class="truncate pr-2 font-medium hover:text-sky-500 transition-colors flex items-center gap-1.5">
              <span>{t.emoji}</span>
              <span class="font-bold">{t.shortName}</span>
              <span class="text-[10px] text-slate-400 font-normal">({t.league})</span>
            </a>
            <div class="shrink-0 flex items-center gap-1.5 text-[11px]">
              <span class="font-bold text-slate-700 dark:text-slate-300 text-[10px]">{t.standings.record}</span>
              <div class="flex items-center gap-0.5">
                {t.standings.formLast5.slice(0, 3).map((res) => (
                  <span class={`w-3.5 h-3.5 rounded-full flex items-center justify-center font-bold text-[8px] ${res === 'W' ? 'bg-emerald-500 text-white' : res === 'L' ? 'bg-rose-500 text-white' : 'bg-amber-500 text-white'}`}>
                    {res}
                  </span>
                ))}
              </div>
            </div>
          </div>
        ))}
      </div>
    )}

    <!-- WAREHOUSE & SAMPLE SALES -->
    {tool.id === 'sales-events' && (
      <div class="space-y-1" id="main-card-sales-grid">
        {initialSalesEvents.map((s) => (
          <div class="flex items-center justify-between py-0.5 border-b border-slate-100 dark:border-slate-800/60" data-sale-id={s.id}>
            <a href={`/sales/${s.id}`} class="truncate pr-2 font-medium hover:text-sky-500 transition-colors flex items-center gap-1.5">
              <span>{s.category === 'outdoor_gear' ? '🏔️' : s.category === 'home_garden' ? '🪴' : '👗'}</span>
              <span class="font-bold truncate">{s.brand}</span>
              <span class="text-[10px] text-slate-400 font-normal">({s.startDate.slice(5)})</span>
            </a>
            <div class="shrink-0 flex items-center gap-1.5 text-[11px]">
              <span class="font-extrabold text-rose-600 dark:text-rose-400 text-[10px] bg-rose-500/10 px-1.5 py-0.5 rounded border border-rose-500/20">
                {s.discountRange}
              </span>
            </div>
          </div>
        ))}
      </div>
    )}
  </div>

  <!-- Card Footer -->
  <div class="pt-3 mt-2 border-t border-slate-100 dark:border-slate-800/80 flex items-center justify-between text-xs">
    <a href={tool.path} class="text-[11px] text-slate-500 dark:text-slate-400 font-semibold group-hover:text-sky-600 dark:group-hover:text-sky-400 transition-colors flex items-center gap-1">
      <span>Open Tool</span>
      <span>→</span>
    </a>
    <span class="text-[10px] text-slate-400">
      ⭐ Star items to pin
    </span>
  </div>
</div>
