---
import type { ToolMeta } from '../../types/shared';
import { getAllBeaches } from '../../tools/can-i-swim/services/vchScraper';
import { getLiveRoutes } from '../../tools/bc-ferries/services/ferryService';
import { getLiveMountains } from '../../tools/mountain-snow/services/snowService';
import { getAllNeighbourhoods, evaluateNeighbourhoodSpot } from '../../tools/carshare-parking/services/parkingEvaluator';
import { getLiveFacilities, formatWaitTime } from '../../tools/health-wait-times/services/healthService';
import { getLiveCrossings } from '../../tools/bridge-traffic/services/bridgeService';
import { getLiveStations } from '../../tools/air-quality/services/airQualityService';
import { getLiveProposals } from '../../tools/civic-development/services/civicService';
import { getLiveEvents } from '../../tools/community-events/services/eventService';
import { getLiveSchools } from '../../tools/school-catchment/services/catchmentService';
import { getLiveNews, formatTimeAgo } from '../../tools/local-news/services/newsService';
import { getLiveMarketHeartbeat, formatCurrency } from '../../tools/housing-market/services/marketService';
import { getLiveSportsFacilities } from '../../tools/sports-facilities/services/sportsService';

interface Props {
  tool: ToolMeta;
}

const { tool } = Astro.props;

// Fetch live data for high-density listings at the edge
const allBeaches = tool.id === 'can-i-swim' ? getAllBeaches() : [];
const initialBeaches = allBeaches.slice(0, 10);

const allFerryRoutes = tool.id === 'bc-ferries' ? await getLiveRoutes() : [];
const initialFerryRoutes = allFerryRoutes.slice(0, 6);

const allMountains = tool.id === 'mountain-snow' ? await getLiveMountains() : [];
const initialMountains = allMountains.slice(0, 4);

const allNeighbourhoods = tool.id === 'evo-parking' ? getAllNeighbourhoods() : [];
const initialNeighbourhoods = allNeighbourhoods.slice(0, 6);

const allFacilities = tool.id === 'health-wait-times' ? await getLiveFacilities() : [];
const initialFacilities = allFacilities.slice(0, 6);

const allCrossings = tool.id === 'bridge-traffic' ? await getLiveCrossings() : [];
const initialCrossings = allCrossings.slice(0, 6);

const allStations = tool.id === 'air-quality' ? await getLiveStations() : [];
const initialStations = allStations.slice(0, 6);

const allProposals = tool.id === 'civic-development' ? await getLiveProposals() : [];
const initialProposals = allProposals.slice(0, 6);

const allEvents = tool.id === 'community-events' ? await getLiveEvents() : [];
const initialEvents = allEvents.slice(0, 6);

const allSchools = tool.id === 'school-catchment' ? await getLiveSchools() : [];
const initialSchools = allSchools.slice(0, 6);

const allArticles = tool.id === 'local-news' ? await getLiveNews() : [];
const initialArticles = allArticles.slice(0, 6);

const marketData = tool.id === 'housing-market' ? await getLiveMarketHeartbeat() : null;
const allSubmarkets = marketData ? [marketData.metroOverview, ...marketData.submarkets] : [];
const initialSubmarkets = allSubmarkets.slice(0, 6);

const allSportsFacilities = tool.id === 'sports-courts' ? await getLiveSportsFacilities() : [];
const initialSportsFacilities = allSportsFacilities.slice(0, 6);

const safeBeachesCount = allBeaches.filter((b) => b.currentStatus === 'safe').length;
const avgFreezingLevel = allMountains.length > 0
  ? Math.round(allMountains.reduce((acc, m) => acc + m.currentFreezingLevelMeters, 0) / allMountains.length)
  : 4000;
const snowBadgeText = avgFreezingLevel > 3000 ? `0°C @ ${avgFreezingLevel}m (Summer)` : `${avgFreezingLevel}m FZ`;
---

<a
  href={tool.path}
  class="tool-card block p-4 sm:p-5 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 hover:border-sky-500 hover:shadow-md transition-all duration-150"
  data-tool-id={tool.id}
>
  <!-- Card Header: Title + Status Pill -->
  <div class="flex items-center justify-between gap-2 mb-3">
    <h2 class="text-base sm:text-lg font-bold text-slate-900 dark:text-white group-hover:text-sky-500 transition-colors">
      {tool.name}
    </h2>
    <span class="text-xs font-semibold px-2 py-0.5 rounded-full bg-emerald-500/10 text-emerald-700 dark:text-emerald-400 border border-emerald-500/20 shrink-0">
      {tool.id === 'can-i-swim' && `${safeBeachesCount}/${allBeaches.length} Safe`}
      {tool.id === 'bc-ferries' && 'Live Deck %'}
      {tool.id === 'mountain-snow' && snowBadgeText}
      {tool.id === 'evo-parking' && '8/8 Home Zones'}
      {tool.id === 'health-wait-times' && '1h 15m Shortest ER'}
      {tool.id === 'bridge-traffic' && '2 Lanes NB Active'}
      {tool.id === 'air-quality' && 'AQHI 2 Low Risk'}
      {tool.id === 'civic-development' && '38 Broadway Towers'}
      {tool.id === 'community-events' && '6 Free This Week'}
      {tool.id === 'school-catchment' && 'VSB SD39 Catchments'}
      {tool.id === 'local-news' && 'Live News Wire'}
      {tool.id === 'housing-market' && '18.4% Balanced SAR'}
      {tool.id === 'sports-courts' && '84 Public Courts'}
      {tool.id !== 'can-i-swim' && tool.id !== 'bc-ferries' && tool.id !== 'mountain-snow' && tool.id !== 'evo-parking' && tool.id !== 'health-wait-times' && tool.id !== 'bridge-traffic' && tool.id !== 'air-quality' && tool.id !== 'civic-development' && tool.id !== 'community-events' && tool.id !== 'school-catchment' && tool.id !== 'local-news' && tool.id !== 'housing-market' && tool.id !== 'sports-courts' && (tool.previewStat?.value || 'Beta')}
    </span>
  </div>

  <!-- CAN I SWIM: High-Density Beach List (2 Columns on medium screens) -->
  {tool.id === 'can-i-swim' && (
    <div id="main-card-beaches-grid" class="grid grid-cols-1 sm:grid-cols-2 gap-x-4 gap-y-1.5 text-xs text-slate-700 dark:text-slate-300">
      {initialBeaches.map((b) => (
        <div class="flex items-center justify-between py-0.5 border-b border-slate-100 dark:border-slate-800/60" data-beach-slug={b.id}>
          <span class="truncate pr-2 font-medium">
            {b.name.replace(/ \(.*\)/, '')}
          </span>
          <span class="shrink-0 flex items-center gap-1 font-semibold text-[11px]">
            {b.currentStatus === 'safe' && (
              <span class="text-emerald-600 dark:text-emerald-400 flex items-center gap-1">
                <span class="w-2 h-2 rounded-full bg-emerald-500"></span> Safe
              </span>
            )}
            {b.currentStatus === 'caution' && (
              <span class="text-amber-600 dark:text-amber-400 flex items-center gap-1">
                <span class="w-2 h-2 rounded-full bg-amber-500"></span> Caution
              </span>
            )}
            {b.currentStatus === 'advisory' && (
              <span class="text-rose-600 dark:text-rose-400 flex items-center gap-1">
                <span class="w-2 h-2 rounded-full bg-rose-500"></span> Advisory
              </span>
            )}
            {b.currentStatus === 'unmonitored' && (
              <span class="text-slate-500 dark:text-slate-400 flex items-center gap-1">
                <span class="w-2 h-2 rounded-full bg-slate-400"></span> Off-Season
              </span>
            )}
          </span>
        </div>
      ))}
    </div>
  )}

  <!-- BC FERRIES: High-Density Marine Routes List -->
  {tool.id === 'bc-ferries' && (
    <div id="main-card-ferries-grid" class="space-y-1.5 text-xs text-slate-700 dark:text-slate-300">
      {initialFerryRoutes.map((r) => {
        const next = r.nextSailings[0];
        return (
          <div class="flex items-center justify-between py-1 border-b border-slate-100 dark:border-slate-800/60" data-route-id={r.id}>
            <div class="truncate pr-2 font-medium">
              <span>{r.shortName}</span>
            </div>
            <div class="shrink-0 flex items-center gap-2 text-[11px] font-semibold">
              {next && next.deckSpacePercent !== undefined ? (
                <span class="text-slate-700 dark:text-slate-300">
                  {next.departureTime} ({next.deckSpacePercent}% deck)
                </span>
              ) : (
                <span class="text-slate-500 dark:text-slate-400">
                  {next ? next.departureTime : 'Scheduled'}
                </span>
              )}

              {next && next.standbyRisk === 'low' && (
                <span class="text-emerald-600 dark:text-emerald-400 flex items-center gap-1">
                  <span class="w-2 h-2 rounded-full bg-emerald-500"></span> Standby OK
                </span>
              )}
              {next && next.standbyRisk === 'moderate' && (
                <span class="text-amber-600 dark:text-amber-400 flex items-center gap-1">
                  <span class="w-2 h-2 rounded-full bg-amber-500"></span> Filling
                </span>
              )}
              {next && next.standbyRisk === 'high' && (
                <span class="text-rose-600 dark:text-rose-400 flex items-center gap-1">
                  <span class="w-2 h-2 rounded-full bg-rose-500"></span> Full
                </span>
              )}
              {(!next || next.standbyRisk === 'not_applicable') && (
                <span class="text-sky-600 dark:text-sky-400 flex items-center gap-1">
                  <span class="w-2 h-2 rounded-full bg-sky-500"></span> Fast Transit
                </span>
              )}
            </div>
          </div>
        );
      })}
    </div>
  )}

  <!-- MOUNTAIN SNOW: High-Density Mountain List -->
  {tool.id === 'mountain-snow' && (
    <div id="main-card-snow-grid" class="space-y-1.5 text-xs text-slate-700 dark:text-slate-300">
      {initialMountains.map((m) => {
        const topBand = m.elevationBands[m.elevationBands.length - 1];
        const hasSnow = m.snowfall.last24HoursCm > 0;
        return (
          <div class="flex items-center justify-between py-1 border-b border-slate-100 dark:border-slate-800/60" data-mountain-id={m.id}>
            <div class="truncate pr-2 font-medium">
              <span>{m.name}</span>
              <span class="text-[11px] text-slate-400 ml-1">({topBand.elevationMeters}m)</span>
            </div>
            <div class="shrink-0 flex items-center gap-2 text-[11px] font-semibold">
              <span class={hasSnow ? 'text-sky-600 dark:text-sky-400 font-bold' : 'text-amber-600 dark:text-amber-400 font-bold'}>
                {hasSnow ? `${m.snowfall.last24HoursCm}cm 24h` : `+${topBand.temperatureCelsius}°C Summit`}
              </span>
              <span class="text-slate-500 dark:text-slate-400">
                0°C @ {m.currentFreezingLevelMeters}m
              </span>
              <span class={`inline-flex items-center gap-1 px-1.5 py-0.5 rounded text-[10px] font-bold ${hasSnow ? 'bg-sky-500/15 text-sky-700 dark:text-sky-300' : 'bg-emerald-500/15 text-emerald-700 dark:text-emerald-300'}`}>
                {hasSnow ? '❄️ Snow' : '☀️ Hiking'}
              </span>
            </div>
          </div>
        );
      })}
    </div>
  )}

  <!-- CAR-SHARE PARKING: High-Density Neighbourhoods List -->
  {tool.id === 'evo-parking' && (
    <div id="main-card-parking-grid" class="space-y-1.5 text-xs text-slate-700 dark:text-slate-300">
      {initialNeighbourhoods.map((n) => {
        const evaluation = evaluateNeighbourhoodSpot(n);
        return (
          <div class="flex items-center justify-between py-1 border-b border-slate-100 dark:border-slate-800/60" data-parking-id={n.id}>
            <div class="truncate pr-2 font-medium">
              <span>{n.name}</span>
              <span class="text-[11px] text-slate-400 ml-1">(${n.residentialPermitRules.permitZoneCode})</span>
            </div>
            <div class="shrink-0 flex items-center gap-2 text-[11px] font-semibold">
              <span class="text-slate-500 dark:text-slate-400">
                ${n.id === 'ubc' ? 'Parkades Only' : 'Permit Exempt'}
              </span>
              {evaluation.clearanceStatus === 'safe' && (
                <span class="text-emerald-600 dark:text-emerald-400 flex items-center gap-1">
                  <span class="w-2 h-2 rounded-full bg-emerald-500"></span> Safe to Park
                </span>
              )}
              {evaluation.clearanceStatus === 'caution' && (
                <span class="text-amber-600 dark:text-amber-400 flex items-center gap-1">
                  <span class="w-2 h-2 rounded-full bg-amber-500"></span> Caution
                </span>
              )}
              {evaluation.clearanceStatus === 'prohibited' && (
                <span class="text-rose-600 dark:text-rose-400 flex items-center gap-1">
                  <span class="w-2 h-2 rounded-full bg-rose-500"></span> Tow Risk
                </span>
              )}
            </div>
          </div>
        );
      })}
    </div>
  )}

  <!-- ER & URGENT CARE: High-Density Hospital & UPCC List -->
  {tool.id === 'health-wait-times' && (
    <div id="main-card-health-grid" class="space-y-1.5 text-xs text-slate-700 dark:text-slate-300">
      {initialFacilities.map((f) => {
        const wait = f.triageData?.waitTimeMinutes;
        const waitStr = formatWaitTime(wait);
        const isLow = wait !== undefined && wait < 90;
        const isMod = wait !== undefined && !isLow && !(wait > 210);
        return (
          <div class="flex items-center justify-between py-1 border-b border-slate-100 dark:border-slate-800/60" data-facility-id={f.id}>
            <div class="truncate pr-2 font-medium">
              <span>{f.shortName}</span>
              <span class="text-[11px] text-slate-400 ml-1">({f.municipality})</span>
            </div>
            <div class="shrink-0 flex items-center gap-2 text-[11px] font-semibold">
              <span class="text-slate-500 dark:text-slate-400">
                {f.triageData?.patientCountWaiting !== undefined ? `${f.triageData.patientCountWaiting} waiting` : 'Triage Open'}
              </span>
              {isLow && (
                <span class="text-emerald-600 dark:text-emerald-400 flex items-center gap-1">
                  <span class="w-2 h-2 rounded-full bg-emerald-500"></span> {waitStr} Wait
                </span>
              )}
              {isMod && (
                <span class="text-amber-600 dark:text-amber-400 flex items-center gap-1">
                  <span class="w-2 h-2 rounded-full bg-amber-500"></span> {waitStr} Wait
                </span>
              )}
              {!isLow && !isMod && (
                <span class="text-rose-600 dark:text-rose-400 flex items-center gap-1">
                  <span class="w-2 h-2 rounded-full bg-rose-500"></span> {waitStr} Wait
                </span>
              )}
            </div>
          </div>
        );
      })}
    </div>
  )}

  <!-- BRIDGES & TUNNEL: High-Density Crossing List -->
  {tool.id === 'bridge-traffic' && (
    <div id="main-card-bridges-grid" class="space-y-1.5 text-xs text-slate-700 dark:text-slate-300">
      {initialCrossings.map((c) => {
        const p = c.directions.primary;
        const isFlowing = !(p.delayMinutes > 3);
        const isMod = !isFlowing && !(p.delayMinutes > 8);
        return (
          <div class="flex items-center justify-between py-1 border-b border-slate-100 dark:border-slate-800/60" data-crossing-id={c.id}>
            <div class="truncate pr-2 font-medium">
              <span>{c.shortName}</span>
              {c.counterflow.hasCounterflow && (
                <span class="text-[10px] text-amber-500 ml-1 font-bold">🔄 Counterflow</span>
              )}
            </div>
            <div class="shrink-0 flex items-center gap-2 text-[11px] font-semibold">
              <span class="text-slate-500 dark:text-slate-400">
                {p.travelTimeMinutes} mins
              </span>
              {isFlowing && (
                <span class="text-emerald-600 dark:text-emerald-400 flex items-center gap-1">
                  <span class="w-2 h-2 rounded-full bg-emerald-500"></span> Fast
                </span>
              )}
              {isMod && (
                <span class="text-amber-600 dark:text-amber-400 flex items-center gap-1">
                  <span class="w-2 h-2 rounded-full bg-amber-500"></span> +{p.delayMinutes}m delay
                </span>
              )}
              {!isFlowing && !isMod && (
                <span class="text-rose-600 dark:text-rose-400 flex items-center gap-1">
                  <span class="w-2 h-2 rounded-full bg-rose-500"></span> +{p.delayMinutes}m delay
                </span>
              )}
            </div>
          </div>
        );
      })}
    </div>
  )}

  <!-- WILDFIRE SMOKE & AQHI: High-Density Station List -->
  {tool.id === 'air-quality' && (
    <div id="main-card-air-grid" class="space-y-1.5 text-xs text-slate-700 dark:text-slate-300">
      {initialStations.map((s) => (
        <div class="flex items-center justify-between py-1 border-b border-slate-100 dark:border-slate-800/60" data-station-id={s.id}>
          <div class="truncate pr-2 font-medium">
            <span>{s.shortName}</span>
          </div>
          <div class="shrink-0 flex items-center gap-2 text-[11px] font-semibold">
            <span class="text-slate-500 dark:text-slate-400">
              {s.currentPM25} µg/m³ PM2.5
            </span>
            <span class="text-emerald-600 dark:text-emerald-400 flex items-center gap-1">
              <span class="w-2 h-2 rounded-full bg-emerald-500"></span> AQHI {s.currentAQHI} (Low)
            </span>
          </div>
        </div>
      ))}
    </div>
  )}

  <!-- CIVIC DEVELOPMENT: High-Density Rezoning & Towers List -->
  {tool.id === 'civic-development' && (
    <div id="main-card-civic-grid" class="space-y-1.5 text-xs text-slate-700 dark:text-slate-300">
      {initialProposals.map((p) => (
        <div class="flex items-center justify-between py-1 border-b border-slate-100 dark:border-slate-800/60" data-proposal-id={p.id}>
          <div class="truncate pr-2 font-medium">
            <span>{p.address}</span>
            <span class="text-[11px] text-slate-400 ml-1">({p.storeys} Storeys)</span>
          </div>
          <div class="shrink-0 flex items-center gap-2 text-[11px] font-semibold">
            <span class="text-slate-500 dark:text-slate-400">
              {p.units.totalUnits} Units
            </span>
            <span class="text-sky-600 dark:text-sky-400 font-bold">
              {p.proposedFSR} FSR
            </span>
          </div>
        </div>
      ))}
    </div>
  )}

  <!-- COMMUNITY EVENTS: High-Density Free Local Events List -->
  {tool.id === 'community-events' && (
    <div id="main-card-events-grid" class="space-y-1.5 text-xs text-slate-700 dark:text-slate-300">
      {initialEvents.map((e) => {
        const d = new Date(e.startDateTime);
        return (
          <div class="flex items-center justify-between py-1 border-b border-slate-100 dark:border-slate-800/60" data-event-id={e.id}>
            <div class="truncate pr-2 font-medium">
              <span>{e.title}</span>
            </div>
            <div class="shrink-0 flex items-center gap-2 text-[11px] font-semibold">
              <span class="text-slate-500 dark:text-slate-400">
                {d.toLocaleDateString([], { weekday: 'short', month: 'numeric', day: 'numeric' })}
              </span>
              <span class="text-emerald-600 dark:text-emerald-400 flex items-center gap-1">
                <span class="w-2 h-2 rounded-full bg-emerald-500"></span> 100% Free
              </span>
            </div>
          </div>
        );
      })}
    </div>
  )}

  <!-- SCHOOL CATCHMENT: High-Density VSB Schools List -->
  {tool.id === 'school-catchment' && (
    <div id="main-card-schools-grid" class="space-y-1.5 text-xs text-slate-700 dark:text-slate-300">
      {initialSchools.map((s) => (
        <div class="flex items-center justify-between py-1 border-b border-slate-100 dark:border-slate-800/60" data-school-id={s.id}>
          <div class="truncate pr-2 font-medium">
            <span>{s.name}</span>
          </div>
          <div class="shrink-0 flex items-center gap-2 text-[11px] font-semibold">
            <span class="text-slate-500 dark:text-slate-400">
              Grades {s.gradeSpan}
            </span>
            <span class="text-sky-600 dark:text-sky-400 font-bold">
              {s.programs.includes('early_french_immersion') ? '🇫🇷 French' : '📘 English'}
            </span>
          </div>
        </div>
      ))}
    </div>
  )}

  <!-- LOCAL NEWS: High-Density News Wire List -->
  {tool.id === 'local-news' && (
    <div id="main-card-news-grid" class="space-y-1.5 text-xs text-slate-700 dark:text-slate-300">
      {initialArticles.map((a) => {
        const timeStr = formatTimeAgo(a.publishedAt);
        return (
          <div class="flex items-center justify-between py-1 border-b border-slate-100 dark:border-slate-800/60" data-article-id={a.id}>
            <div class="truncate pr-2 font-medium">
              <span class="font-bold text-slate-900 dark:text-white mr-1">[${a.outletName}]</span>
              <span>{a.title}</span>
            </div>
            <div class="shrink-0 flex items-center gap-1.5 text-[11px] font-semibold">
              <span class="text-slate-400">
                {timeStr}
              </span>
              {a.isBreaking && (
                <span class="px-1.5 py-0.2 rounded text-[10px] font-extrabold bg-rose-500/20 text-rose-700 dark:text-rose-300">
                  Breaking
                </span>
              )}
            </div>
          </div>
        );
      })}
    </div>
  )}

  <!-- REAL ESTATE & RENTAL MARKET: High-Density Submarket List -->
  {tool.id === 'housing-market' && (
    <div id="main-card-market-grid" class="space-y-1.5 text-xs text-slate-700 dark:text-slate-300">
      {initialSubmarkets.map((s) => {
        const condoBench = s.benchmarks.find((b) => b.propertyType === 'condo') || s.benchmarks[0];
        return (
          <div class="flex items-center justify-between py-1 border-b border-slate-100 dark:border-slate-800/60" data-submarket-id={s.id}>
            <div class="truncate pr-2 font-medium">
              <span>{s.name.replace(' (Regional Composite)', '')}</span>
              <span class="text-[11px] text-slate-400 ml-1">({s.salesToActiveRatio}% SAR)</span>
            </div>
            <div class="shrink-0 flex items-center gap-2 text-[11px] font-semibold">
              <span class="text-slate-500 dark:text-slate-400">
                {formatCurrency(s.rental.medianRent1Bed)}/mo rent
              </span>
              <span class="text-sky-600 dark:text-sky-400 font-bold">
                ${Math.round(condoBench.benchmarkPrice / 1000)}k Condo
              </span>
            </div>
          </div>
        );
      })}
    </div>
  )}

  <!-- SPORTS, COURTS & REC: High-Density Sports Hubs List -->
  {tool.id === 'sports-courts' && (
    <div id="main-card-sports-grid" class="space-y-1.5 text-xs text-slate-700 dark:text-slate-300">
      {initialSportsFacilities.map((f) => (
        <div class="flex items-center justify-between py-1 border-b border-slate-100 dark:border-slate-800/60" data-facility-id={f.id}>
          <div class="truncate pr-2 font-medium">
            <span>{f.name}</span>
            {f.courtDetails?.hasLights && (
              <span class="text-[10px] text-amber-500 ml-1 font-bold">💡 Lighted</span>
            )}
          </div>
          <div class="shrink-0 flex items-center gap-2 text-[11px] font-semibold">
            <span class="text-slate-500 dark:text-slate-400">
              {f.session.currentMode.split('(')[0].trim()}
            </span>
            <span class="text-emerald-600 dark:text-emerald-400 flex items-center gap-1">
              <span class="w-2 h-2 rounded-full bg-emerald-500"></span> Open
            </span>
          </div>
