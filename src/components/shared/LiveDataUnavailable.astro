---
/**
 * Explicit failure state for a getLive<ToolData>() result with `ok: false`.
 * Never render baseline/static numbers in place of this — see issue #35.
 */
interface Props {
  toolName: string;
  variant?: 'card' | 'page';
  error?: string;
}

const { toolName, variant = 'card', error } = Astro.props;
---

{variant === 'card' ? (
  <div class="flex flex-col items-center justify-center gap-1 py-5 text-center" role="status">
    <span class="text-lg leading-none" aria-hidden="true">⚠️</span>
    <span class="text-[11px] font-semibold text-slate-500 dark:text-slate-400">
      Live data unavailable — please check back shortly
    </span>
  </div>
) : (
  <div
    class="flex flex-col items-center justify-center gap-2 py-12 px-6 text-center rounded-2xl bg-slate-50 dark:bg-slate-950/60 border border-slate-200 dark:border-slate-800"
    role="status"
  >
    <span class="text-3xl leading-none" aria-hidden="true">⚠️</span>
    <h2 class="text-sm font-bold text-slate-700 dark:text-slate-200">
      {toolName} live data unavailable
    </h2>
    <p class="text-xs text-slate-500 dark:text-slate-400 max-w-sm">
      We couldn't reach the live upstream source in time. Please check back shortly — no cached
      or estimated numbers are shown in place of live data.
    </p>
    {error && (
      <p class="text-[10px] text-slate-400 dark:text-slate-600 font-mono">{error}</p>
    )}
  </div>
)}
