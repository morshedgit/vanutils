---
import PlatformLayout from '../layouts/PlatformLayout.astro';
import ToolCard from '../components/shared/ToolCard.astro';
import JsonLd from '../components/shared/JsonLd.astro';
import BreakingAlertBanner from '../tools/local-news/components/BreakingAlertBanner.astro';
import { TOOLS_REGISTRY } from '../config/tools';
import { getLiveBreakingAlerts } from '../tools/local-news/services/newsService';

// Set Edge Cache header for sub-50ms delivery with 60s live revalidation
Astro.response.headers.set('Cache-Control', 'public, s-maxage=60, stale-while-revalidate=300');

const allTools = TOOLS_REGISTRY;
const alerts = await getLiveBreakingAlerts();

const websiteSchema = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: 'VanHeartbeat',
    alternateName: 'Vancouver Live Civic Telemetry & Vital Signs',
    url: 'https://vanheartbeat.ca',
    description: 'Ultra-fast, single-purpose live civic telemetry, vital signs, and public data for Metro Vancouver residents.',
    inLanguage: 'en-CA',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    name: 'VanHeartbeat',
    url: 'https://vanheartbeat.ca',
    logo: 'https://vanheartbeat.ca/favicon.svg',
    description: 'Real-time open civic pulse and telemetry platform for Metro Vancouver, British Columbia.',
    address: {
      '@type': 'PostalAddress',
      addressLocality: 'Vancouver',
      addressRegion: 'BC',
      addressCountry: 'CA',
    },
  },
];
---

<PlatformLayout
  title="VanHeartbeat — Metro Vancouver Live Civic Pulse & Telemetry"
  description="Metro Vancouver's live civic pulse. Sub-second beach water quality, ferry standby radar, mountain snow levels, ER wait times, and city telemetry."
  currentPath="/"
>
  <JsonLd schema={websiteSchema} />

  <div class="w-full space-y-6">
    <!-- Active Breaking News & Emergency Alerts -->
    <BreakingAlertBanner alerts={alerts} />

    <!-- SEO Primary Heading & Live Header -->
    <div class="space-y-1">
      <h1 class="text-xl sm:text-2xl font-black text-slate-900 dark:text-white tracking-tight">
        Metro Vancouver Live Civic Pulse & Telemetry
      </h1>
      <p class="text-xs sm:text-sm text-slate-500 dark:text-slate-400">
        Sub-second public data, beach water quality, ferry radar, snow levels, and emergency wait times.
      </p>
    </div>

    <!-- Dashboard Category Filter Tabs & Quick Search Bar -->
    <div class="flex flex-col sm:flex-row items-stretch sm:items-center justify-between gap-3 pb-2">

      <!-- Category Pills -->
      <div class="flex flex-wrap gap-1.5" id="home-category-filters">
        <button
          type="button"
          data-category="all"
          class="home-filter-btn px-3 py-1.5 rounded-xl text-xs font-bold bg-slate-900 dark:bg-white text-white dark:text-slate-900 shadow-xs transition-all"
        >
          All Utilities ({allTools.length})
        </button>
        <button
          type="button"
          data-category="outdoors"
          class="home-filter-btn px-3 py-1.5 rounded-xl text-xs font-semibold bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300 hover:bg-slate-200 dark:hover:bg-slate-700 transition-all flex items-center gap-1.5"
        >
          <span>🌊</span>
          <span>Outdoors & Snow</span>
        </button>
        <button
          type="button"
          data-category="transit"
          class="home-filter-btn px-3 py-1.5 rounded-xl text-xs font-semibold bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300 hover:bg-slate-200 dark:hover:bg-slate-700 transition-all flex items-center gap-1.5"
        >
          <span>⛴️</span>
          <span>Transit & Bridges</span>
        </button>
        <button
          type="button"
          data-category="daily_living"
          class="home-filter-btn px-3 py-1.5 rounded-xl text-xs font-semibold bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300 hover:bg-slate-200 dark:hover:bg-slate-700 transition-all flex items-center gap-1.5"
        >
          <span>🚗</span>
          <span>Daily & Health</span>
        </button>
        <button
          type="button"
          data-category="civic"
          class="home-filter-btn px-3 py-1.5 rounded-xl text-xs font-semibold bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300 hover:bg-slate-200 dark:hover:bg-slate-700 transition-all flex items-center gap-1.5"
        >
          <span>🏛️</span>
          <span>Civic & Wire</span>
        </button>
      </div>

      <!-- Real-time Live Status Counter -->
      <div class="flex items-center gap-2 text-xs text-slate-500 dark:text-slate-400 font-medium">
        <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
        <span>{allTools.length} Live Telemetry Feeds Active</span>
      </div>
    </div>

    <!-- Main Dashboard: 4-Column Responsive Grid on Desktop -->
    <div
      class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-4 sm:gap-5"
      id="utilities-grid"
    >
      {allTools.map((tool) => (
        <div class="tool-card-wrapper" data-category={tool.category}>
          <ToolCard tool={tool} />
        </div>
      ))}
    </div>
  </div>
</PlatformLayout>

<script>
  function setupCategoryFilters() {
    const buttons = document.querySelectorAll('.home-filter-btn');
    const cards = document.querySelectorAll('.tool-card-wrapper');

    buttons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const category = btn.getAttribute('data-category');

        // Update active tab styling
        buttons.forEach((b) => {
          b.classList.remove('bg-slate-900', 'dark:bg-white', 'text-white', 'dark:text-slate-900', 'font-bold');
          b.classList.add('bg-slate-100', 'dark:bg-slate-800', 'text-slate-600', 'dark:text-slate-300', 'font-semibold');
        });
        btn.classList.remove('bg-slate-100', 'dark:bg-slate-800', 'text-slate-600', 'dark:text-slate-300', 'font-semibold');
        btn.classList.add('bg-slate-900', 'dark:bg-white', 'text-white', 'dark:text-slate-900', 'font-bold');

        // Filter cards
        cards.forEach((card) => {
          const cardCategory = card.getAttribute('data-category');
          if (category === 'all' || cardCategory === category) {
            (card as HTMLElement).style.display = '';
          } else {
            (card as HTMLElement).style.display = 'none';
          }
        });
      });
    });
  }

  function setupWholeCardClicks() {
    document.querySelectorAll<HTMLElement>('.tool-card').forEach((card) => {
      card.addEventListener('click', (e) => {
        const target = e.target as HTMLElement;
        // If clicking a specific sub-route deep link, let it proceed
        const subLink = target.closest('a');
        if (subLink && subLink.getAttribute('href') && !subLink.classList.contains('tool-card-main-link')) {
          return;
        }
        const toolPath = card.getAttribute('data-tool-path');
        if (toolPath) {
          window.location.href = toolPath;
        }
      });
    });
  }

  setupCategoryFilters();
  setupWholeCardClicks();
  document.addEventListener('astro:page-load', () => {
    setupCategoryFilters();
    setupWholeCardClicks();
  });
</script>

