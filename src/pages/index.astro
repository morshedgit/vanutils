---
import PlatformLayout from '../layouts/PlatformLayout.astro';
import ToolCard from '../components/shared/ToolCard.astro';
import { TOOLS_REGISTRY } from '../config/tools';

const allTools = TOOLS_REGISTRY;
---

<PlatformLayout
  title="VanUtils — Vancouver Micro-Utilities Hub"
  description="Fast, single-purpose local tools for Metro Vancouver. Beach water quality, ferry radar, snow levels, and city tools."
  currentPath="/"
>
  <div class="max-w-5xl mx-auto py-2">
    <!-- Main Dashboard: One Card Per Utility -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4" id="utilities-grid">
      {allTools.map((tool) => (
        <ToolCard tool={tool} />
      ))}
    </div>
  </div>
</PlatformLayout>
