---
import PlatformLayout from '../layouts/PlatformLayout.astro';
import ToolCard from '../components/shared/ToolCard.astro';
import JsonLd from '../components/shared/JsonLd.astro';
import BreakingAlertBanner from '../tools/local-news/components/BreakingAlertBanner.astro';
import { TOOLS_REGISTRY } from '../config/tools';
import { getLiveBreakingAlerts } from '../tools/local-news/services/newsService';

// Set Edge Cache header for sub-50ms delivery with 60s live revalidation
Astro.response.headers.set('Cache-Control', 'public, s-maxage=60, stale-while-revalidate=300');

const allTools = TOOLS_REGISTRY;
const alerts = await getLiveBreakingAlerts();

const outdoorsCount = allTools.filter((t) => t.category === 'outdoors').length;
const transitCount = allTools.filter((t) => t.category === 'transit').length;
const healthCount = allTools.filter((t) => t.category === 'daily_living').length;
const civicCount = allTools.filter((t) => t.category === 'civic').length;

const websiteSchema = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: 'VanHeartbeat',
    alternateName: 'Vancouver Live Civic Telemetry & Vital Signs',
    url: 'https://vanheartbeat.ca',
    description: 'Ultra-fast, single-purpose live civic telemetry, vital signs, and public data for Metro Vancouver residents.',
    inLanguage: 'en-CA',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    name: 'VanHeartbeat',
    url: 'https://vanheartbeat.ca',
    logo: 'https://vanheartbeat.ca/favicon.svg',
    description: 'Real-time open civic pulse and telemetry platform for Metro Vancouver, British Columbia.',
    address: {
      '@type': 'PostalAddress',
      addressLocality: 'Vancouver',
      addressRegion: 'BC',
      addressCountry: 'CA',
    },
  },
];
---

<PlatformLayout
  title="VanHeartbeat — Metro Vancouver Live Civic Pulse & Telemetry"
  description="Metro Vancouver's live civic pulse. Sub-second beach water quality, ferry standby radar, mountain snow levels, ER wait times, and city telemetry."
  currentPath="/"
>
  <JsonLd schema={websiteSchema} />

  <!-- Semantic, Accessible H1 for SEO/GEO Grounding & Document Hierarchy -->
  <h1 class="sr-only">Metro Vancouver Live Civic Pulse & Real-Time Public Telemetry</h1>

  <div class="w-full space-y-2.5">
    <!-- Active Breaking News & Emergency Alerts -->
    {alerts.length > 0 && <BreakingAlertBanner alerts={alerts} />}

    <!-- Layout: Left Sidebar + Main High-Density Grid -->
    <div class="flex flex-col lg:flex-row gap-3.5 lg:gap-4 items-start w-full">
      
      <!-- Sticky Left Anchor Sidebar (Desktop) -->
      <aside class="hidden lg:flex flex-col w-44 xl:w-48 shrink-0 sticky top-14 self-start bg-white dark:bg-slate-900/80 rounded-xl border border-slate-200/80 dark:border-slate-800/80 p-2.5 shadow-xs space-y-3">
        <div class="space-y-1">
          <div class="text-[10px] font-bold uppercase tracking-wider text-slate-400 px-2">Category</div>
          <nav class="space-y-0.5" id="desktop-category-filters">
            <button
              type="button"
              data-category="all"
              class="home-filter-btn w-full flex items-center justify-between px-2.5 py-1.5 rounded-lg text-xs font-bold bg-slate-900 dark:bg-white text-white dark:text-slate-900 transition-all text-left"
            >
              <span>All Utilities</span>
              <span class="text-[10px] opacity-75 font-mono">{allTools.length}</span>
            </button>
            <button
              type="button"
              data-category="outdoors"
              class="home-filter-btn w-full flex items-center justify-between px-2.5 py-1.5 rounded-lg text-xs font-semibold text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800/60 transition-all text-left"
            >
              <span>Outdoors & Snow</span>
              <span class="text-[10px] opacity-60 font-mono">{outdoorsCount}</span>
            </button>
            <button
              type="button"
              data-category="transit"
              class="home-filter-btn w-full flex items-center justify-between px-2.5 py-1.5 rounded-lg text-xs font-semibold text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800/60 transition-all text-left"
            >
              <span>Transit & Roads</span>
              <span class="text-[10px] opacity-60 font-mono">{transitCount}</span>
            </button>
            <button
              type="button"
              data-category="daily_living"
              class="home-filter-btn w-full flex items-center justify-between px-2.5 py-1.5 rounded-lg text-xs font-semibold text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800/60 transition-all text-left"
            >
              <span>Daily & Health</span>
              <span class="text-[10px] opacity-60 font-mono">{healthCount}</span>
            </button>
            <button
              type="button"
              data-category="civic"
              class="home-filter-btn w-full flex items-center justify-between px-2.5 py-1.5 rounded-lg text-xs font-semibold text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800/60 transition-all text-left"
            >
              <span>Civic & Wire</span>
              <span class="text-[10px] opacity-60 font-mono">{civicCount}</span>
            </button>
          </nav>
        </div>

        <!-- Telemetry Status Feed Badge -->
        <div class="pt-2 border-t border-slate-100 dark:border-slate-800/60 flex items-center gap-1.5 px-2 text-[10px] text-slate-500 dark:text-slate-400 font-medium">
          <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
          <span>{allTools.length} Live Feeds Active</span>
        </div>
      </aside>

      <!-- Main High-Density Grid Area -->
      <section class="flex-1 w-full space-y-2.5">
        <!-- Mobile/Tablet Category Scroll Strip (Zero Icons, Compact) -->
        <div class="lg:hidden flex items-center gap-1.5 overflow-x-auto pb-1.5 no-scrollbar scroll-smooth" id="mobile-category-filters">
          <button
            type="button"
            data-category="all"
            class="home-filter-btn shrink-0 px-3 py-1.5 rounded-lg text-xs font-bold bg-slate-900 dark:bg-white text-white dark:text-slate-900 transition-all"
          >
            All ({allTools.length})
          </button>
          <button
            type="button"
            data-category="outdoors"
            class="home-filter-btn shrink-0 px-3 py-1.5 rounded-lg text-xs font-semibold bg-white dark:bg-slate-900 text-slate-600 dark:text-slate-300 border border-slate-200 dark:border-slate-800 transition-all"
          >
            Outdoors ({outdoorsCount})
          </button>
          <button
            type="button"
            data-category="transit"
            class="home-filter-btn shrink-0 px-3 py-1.5 rounded-lg text-xs font-semibold bg-white dark:bg-slate-900 text-slate-600 dark:text-slate-300 border border-slate-200 dark:border-slate-800 transition-all"
          >
            Transit ({transitCount})
          </button>
          <button
            type="button"
            data-category="daily_living"
            class="home-filter-btn shrink-0 px-3 py-1.5 rounded-lg text-xs font-semibold bg-white dark:bg-slate-900 text-slate-600 dark:text-slate-300 border border-slate-200 dark:border-slate-800 transition-all"
          >
            Daily ({healthCount})
          </button>
          <button
            type="button"
            data-category="civic"
            class="home-filter-btn shrink-0 px-3 py-1.5 rounded-lg text-xs font-semibold bg-white dark:bg-slate-900 text-slate-600 dark:text-slate-300 border border-slate-200 dark:border-slate-800 transition-all"
          >
            Civic ({civicCount})
          </button>
        </div>

        <!-- 3/4-Column High-Density Grid (Starts immediately at Top) -->
        <div
          class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-3 2xl:grid-cols-4 gap-3 sm:gap-3.5"
          id="utilities-grid"
        >
          {allTools.map((tool) => (
            <div class="tool-card-wrapper" data-category={tool.category}>
              <ToolCard tool={tool} />
            </div>
          ))}
        </div>
      </section>
    </div>
  </div>
</PlatformLayout>

<script>
  function setupCategoryFilters() {
    const allButtons = document.querySelectorAll('.home-filter-btn');
    const cards = document.querySelectorAll('.tool-card-wrapper');

    allButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const category = btn.getAttribute('data-category');

        // Update all desktop and mobile buttons matching this category
        allButtons.forEach((b) => {
          const isMatch = b.getAttribute('data-category') === category;
          if (isMatch) {
            b.classList.remove('text-slate-600', 'dark:text-slate-300', 'font-semibold', 'bg-white', 'dark:bg-slate-900');
            b.classList.add('bg-slate-900', 'dark:bg-white', 'text-white', 'dark:text-slate-900', 'font-bold');
          } else {
            b.classList.remove('bg-slate-900', 'dark:bg-white', 'text-white', 'dark:text-slate-900', 'font-bold');
            b.classList.add('text-slate-600', 'dark:text-slate-300', 'font-semibold');
          }
        });

        // Filter cards
        cards.forEach((card) => {
          const cardCategory = card.getAttribute('data-category');
          if (category === 'all' || cardCategory === category) {
            (card as HTMLElement).style.display = '';
          } else {
            (card as HTMLElement).style.display = 'none';
          }
        });
      });
    });
  }

  function setupWholeCardClicks() {
    const cards = document.querySelectorAll('.tool-card-wrapper');
    cards.forEach((card) => {
      card.addEventListener('click', (e) => {
        const target = e.target as HTMLElement;
        if (target.closest('a') || target.closest('button')) {
          return;
        }
        const primaryLink = card.querySelector('a') as HTMLAnchorElement | null;
        if (primaryLink && primaryLink.href) {
          window.location.href = primaryLink.href;
        }
      });
    });
  }

  setupCategoryFilters();
  setupWholeCardClicks();

  document.addEventListener('astro:page-load', () => {
    setupCategoryFilters();
    setupWholeCardClicks();
  });
</script>
