---
import ToolLayout from '../../layouts/ToolLayout.astro';
import BeachCard from '../../tools/can-i-swim/components/BeachCard.astro';
import FilterBar from '../../tools/can-i-swim/components/FilterBar.astro';
import { getAllBeaches, getBeachStats } from '../../tools/can-i-swim/services/vchScraper';

const beaches = getAllBeaches();
const stats = getBeachStats(beaches);
---

<ToolLayout
  toolId="can-i-swim"
  title="Can I Swim Today?"
  description="Real-time Metro Vancouver beach water quality and safety status based on Vancouver Coastal Health & Fraser Health surveillance."
  currentPath="/swim"
  badgeText="Live Water Radar"
  status="active"
>
  <div class="space-y-6">
    <!-- Big, Calm Status Hero -->
    <section class="rounded-2xl bg-slate-900 text-white p-6 sm:p-7 border border-slate-800 shadow-md flex flex-col sm:flex-row items-start sm:items-center justify-between gap-5">
      <div class="space-y-1.5">
        <div class="inline-flex items-center gap-2 px-2.5 py-1 rounded-full bg-emerald-500/20 text-emerald-300 text-xs font-semibold">
          <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
          <span>{stats.safe} of {stats.total} Beaches Safe ({stats.cleanPercentage}%)</span>
        </div>
        <h2 class="text-xl sm:text-2xl font-bold tracking-tight text-white">
          Vancouver Beach Water Quality
        </h2>
        <p class="text-xs sm:text-sm text-slate-300">
          Nearest safe beach: <strong id="nearest-beach-name" class="text-white">Kitsilano Beach</strong> (<span id="nearest-beach-dist">1.4 km</span>)
        </p>
      </div>

      <a
        id="nearest-beach-link"
        href="/swim/kitsilano-beach"
        class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl bg-sky-500 hover:bg-sky-400 text-white text-xs font-semibold transition-all shrink-0 active:scale-95"
      >
        <span>View Nearest Beach →</span>
      </a>
    </section>

    <!-- Minimal Filter & Search Bar -->
    <FilterBar />

    <!-- Beach Cards Section -->
    <section class="space-y-3">
      <div class="flex items-center justify-between px-1">
        <span id="beach-count-display" class="text-xs font-semibold text-slate-500 dark:text-slate-400">
          Showing {beaches.length} beaches
        </span>
        <span class="text-xs text-slate-400">
          Tap any beach for full report
        </span>
      </div>

      <!-- Clean Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4" id="beaches-grid">
        {beaches.map((beach) => (
          <BeachCard beach={beach} />
        ))}
      </div>

      <!-- Empty State -->
      <div id="no-beaches-empty-state" class="hidden rounded-2xl border border-dashed border-slate-300 dark:border-slate-800 p-8 text-center space-y-2">
        <span class="text-3xl">🏖️</span>
        <h3 class="text-sm font-bold text-slate-900 dark:text-white">No beaches found</h3>
        <p class="text-xs text-slate-500 dark:text-slate-400">
          Try changing your search terms or clearing the region filter.
        </p>
      </div>
    </section>

    <!-- Simple, Clean Safety Guidelines Pill -->
    <footer class="p-4 rounded-xl bg-slate-50 dark:bg-slate-900/60 border border-slate-200/60 dark:border-slate-800 flex flex-wrap items-center justify-between gap-3 text-xs text-slate-500 dark:text-slate-400">
      <div class="flex items-center gap-4">
        <span class="inline-flex items-center gap-1.5"><span class="w-2.5 h-2.5 rounded-full bg-emerald-500"></span> Safe (&le;200 CFU)</span>
        <span class="inline-flex items-center gap-1.5"><span class="w-2.5 h-2.5 rounded-full bg-amber-500"></span> Caution (235–400 CFU)</span>
        <span class="inline-flex items-center gap-1.5"><span class="w-2.5 h-2.5 rounded-full bg-rose-500"></span> Advisory (&gt;200 Geo / &gt;400 Single)</span>
      </div>
      <a href="https://www.vch.ca/en/service/public-beach-water-quality" target="_blank" rel="noopener noreferrer" class="text-sky-600 dark:text-sky-400 hover:underline">
        Official VCH Data ↗
      </a>
    </footer>
  </div>
</ToolLayout>

<script>
  import { calculateDistanceKm, formatDistance } from '../../services/shared/geo';

  function updateDistances() {
    const saved = localStorage.getItem('vanutils_user_location');
    let userLat = 49.2827; // Default Downtown Vancouver
    let userLng = -123.1207;

    if (saved) {
      try {
        const parsed = JSON.parse(saved);
        userLat = parsed.lat;
        userLng = parsed.lng;
      } catch (e) {}
    }

    const cards = Array.from(document.querySelectorAll('.beach-card')) as HTMLElement[];
    let nearestBeach: { name: string; id: string; dist: number } | null = null;

    cards.forEach((card) => {
      const bLat = parseFloat(card.dataset.beachLat || '0');
      const bLng = parseFloat(card.dataset.beachLng || '0');
      if (bLat && bLng) {
        const d = calculateDistanceKm(
          { latitude: userLat, longitude: userLng },
          { latitude: bLat, longitude: bLng }
        );
        card.dataset.distanceKm = d.toString();
        const distEl = card.querySelector('.distance-text');
        if (distEl) distEl.textContent = formatDistance(d);

        if (card.dataset.beachStatus === 'safe') {
          if (!nearestBeach || d < (nearestBeach as { dist: number }).dist) {
            nearestBeach = {
              name: card.dataset.beachName || '',
              id: card.dataset.beachId || '',
              dist: d,
            };
          }
        }
      }
    });

    if (nearestBeach) {
      const nearest = nearestBeach as { name: string; id: string; dist: number };
      const nearestName = document.getElementById('nearest-beach-name');
      const nearestDist = document.getElementById('nearest-beach-dist');
      const nearestLink = document.getElementById('nearest-beach-link') as HTMLAnchorElement | null;
      if (nearestName) nearestName.textContent = nearest.name;
      if (nearestDist) nearestDist.textContent = formatDistance(nearest.dist);
      if (nearestLink) nearestLink.href = `/swim/${nearest.id}`;
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', updateDistances);
  } else {
    updateDistances();
  }

  window.addEventListener('vanutils:location-changed', updateDistances);
</script>
