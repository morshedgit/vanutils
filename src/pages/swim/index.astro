---
import ToolLayout from '../../layouts/ToolLayout.astro';
import JsonLd from '../../components/shared/JsonLd.astro';
import BeachCard from '../../tools/can-i-swim/components/BeachCard.astro';
import FilterBar from '../../tools/can-i-swim/components/FilterBar.astro';
import { getLiveBeaches } from '../../tools/can-i-swim/services/vchScraper';

// Set Edge Cache header: 10 min max age, 30 min background revalidation
Astro.response.headers.set('Cache-Control', 'public, s-maxage=600, stale-while-revalidate=1800');

const beaches = await getLiveBeaches();

const swimSchema = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    name: 'Can I Swim Today? Vancouver Beach Water Quality — VanHeartbeat',
    description: 'Real-time Metro Vancouver beach water quality and safety status based on Vancouver Coastal Health & Fraser Health surveillance.',
    url: 'https://vanheartbeat.ca/swim',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'VanHeartbeat', item: 'https://vanheartbeat.ca' },
      { '@type': 'ListItem', position: 2, name: 'Can I Swim Water Radar', item: 'https://vanheartbeat.ca/swim' },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: [
      {
        '@type': 'Question',
        name: 'What is the safe E. coli limit for swimming in Vancouver beaches?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'Vancouver Coastal Health (VCH) sets the safe recreational swimming standard at a 30-day geometric mean under 200 E. coli per 100mL of water. A single sample exceeding 400 E. coli per 100mL or geometric mean above 200 triggers an official swimming advisory.',
        },
      },
      {
        '@type': 'Question',
        name: 'How often is beach water quality tested in Metro Vancouver?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'Water samples are collected weekly throughout the primary recreational season (May through September) by Vancouver Coastal Health and Fraser Health across 31 Metro Vancouver saltwater and freshwater beach sites.',
        },
      },
      {
        '@type': 'Question',
        name: 'What causes swimming advisories at Vancouver beaches?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'Elevated bacterial levels are typically caused by stormwater runoff following heavy rainfall, agricultural/urban drainage, tidal stagnation during heatwaves, or high concentrations of waterfowl and domestic animals.',
        },
      },
    ],
  },
];
---

<ToolLayout
  toolId="can-i-swim"
  title="Can I Swim Today?"
  description="Real-time Metro Vancouver beach water quality and safety status based on Vancouver Coastal Health & Fraser Health surveillance."
  currentPath="/swim"
  badgeText="Live Water Radar"
  status="active"
>
  <JsonLd schema={swimSchema} />

  <div class="space-y-4 max-w-4xl mx-auto">
    <!-- Pinned Main Beaches Quick Bar (Customizable for Home Card) -->
    <div id="pinned-beaches-section" class="p-3 sm:p-3.5 rounded-xl bg-slate-50 dark:bg-slate-900 border border-slate-200/80 dark:border-slate-800 space-y-2">
      <div class="flex items-center justify-between text-xs">
        <span class="font-bold text-slate-800 dark:text-slate-200 flex items-center gap-1.5">
          <span class="text-amber-500">⭐</span> Main Beaches (Shown on Home Dashboard)
        </span>
        <span class="text-[11px] text-slate-400">
          Click ⭐ on any beach to add/remove
        </span>
      </div>

      <div id="pinned-chips-container" class="flex flex-wrap gap-1.5">
        <!-- Dynamically populated via client script -->
      </div>
    </div>

    <!-- Filter & Search Controls -->
    <FilterBar />

    <!-- Beaches List Grid -->
    <div class="space-y-2">
      <div class="flex items-center justify-between px-1 text-xs text-slate-500 dark:text-slate-400 font-medium">
        <span id="beach-count-display">All Metro Beaches ({beaches.length})</span>
        <span>Tap any beach for historical chart</span>
      </div>

      <!-- High Density 2-Column Grid -->
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-2.5" id="beaches-grid">
        {beaches.map((beach) => (
          <BeachCard beach={beach} />
        ))}
      </div>

      <!-- Empty State -->
      <div id="no-beaches-empty-state" class="hidden rounded-xl border border-dashed border-slate-300 dark:border-slate-800 p-8 text-center space-y-1">
        <span class="text-2xl">🏖️</span>
        <h3 class="text-xs font-bold text-slate-900 dark:text-white">No matching beaches</h3>
        <p class="text-[11px] text-slate-400">Try changing your search query or region filter.</p>
      </div>
    </div>
  </div>
</ToolLayout>

<script>
  import { calculateDistanceKm, formatDistance } from '../../services/shared/geo';

  const DEFAULT_PINNED = ['english-bay-beach', 'kitsilano-beach', 'sunset-beach', 'jericho-beach', 'ambleside-beach'];

  function getPinnedSlugs(): string[] {
    const saved = localStorage.getItem('vanutils_pinned_beaches');
    return saved ? JSON.parse(saved) : DEFAULT_PINNED;
  }

  function setPinnedSlugs(slugs: string[]) {
    localStorage.setItem('vanutils_pinned_beaches', JSON.stringify(slugs));
    window.dispatchEvent(new CustomEvent('vanutils:pinned-beaches-changed'));
    renderPinnedSection();
    updatePinButtonStates();
  }

  function togglePin(beachId: string) {
    let current = getPinnedSlugs();
    if (current.includes(beachId)) {
      current = current.filter(id => id !== beachId);
    } else {
      current = [...current, beachId];
    }
    setPinnedSlugs(current);
  }

  function updatePinButtonStates() {
    const pinned = getPinnedSlugs();
    const pinBtns = document.querySelectorAll('.pin-beach-toggle') as NodeListOf<HTMLButtonElement>;

    pinBtns.forEach(btn => {
      const id = btn.dataset.beachId || '';
      const isPinned = pinned.includes(id);
      btn.classList.toggle('text-amber-500', isPinned);
      btn.classList.toggle('text-slate-300', !isPinned);
      btn.classList.toggle('dark:text-slate-600', !isPinned);
      btn.title = isPinned ? 'Remove from Main Dashboard' : 'Pin to Main Dashboard';
    });
  }

  function renderPinnedSection() {
    const container = document.getElementById('pinned-chips-container');
    if (!container) return;

    const pinned = getPinnedSlugs();
    const cards = Array.from(document.querySelectorAll('.beach-card')) as HTMLElement[];

    if (pinned.length === 0) {
      container.innerHTML = `<span class="text-xs text-slate-400 italic">No beaches pinned. Click ⭐ on any beach to show it on your dashboard.</span>`;
      return;
    }

    container.innerHTML = pinned.map(id => {
      const match = cards.find(c => c.dataset.beachId === id);
      const name = match ? (match.dataset.beachName || id).replace(/ \(.*\)/, '') : id;
      const status = match ? match.dataset.beachStatus : 'safe';
      const statusColor = status === 'safe' ? 'bg-emerald-500' : status === 'caution' ? 'bg-amber-500' : 'bg-rose-500';

      return `
        <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-xs font-semibold bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 shadow-2xs">
          <span class="w-2 h-2 rounded-full ${statusColor}"></span>
          <a href="/swim/${id}" class="hover:text-sky-500">${name}</a>
          <button type="button" class="unpin-chip-btn ml-1 text-slate-400 hover:text-rose-500 font-bold" data-id="${id}" title="Remove from main">×</button>
        </span>
      `;
    }).join('');

    container.querySelectorAll('.unpin-chip-btn').forEach(btn => {
      btn.addEventListener('click', (e) => {
        e.stopPropagation();
        const id = (btn as HTMLElement).dataset.id;
        if (id) togglePin(id);
      });
    });
  }

  function setupSwimPage() {
    updatePinButtonStates();
    renderPinnedSection();

    document.querySelectorAll('.pin-beach-toggle').forEach(btn => {
      btn.addEventListener('click', (e) => {
        e.preventDefault();
        e.stopPropagation();
        const id = (btn as HTMLElement).dataset.beachId;
        if (id) togglePin(id);
      });
    });

    // Update GPS distances
    const savedLoc = localStorage.getItem('vanutils_user_location');
    let userLat = 49.2827; // Downtown Vancouver default
    let userLng = -123.1207;

    if (savedLoc) {
      try {
        const parsed = JSON.parse(savedLoc);
        userLat = parsed.lat;
        userLng = parsed.lng;
      } catch (e) {}
    }

    const cards = Array.from(document.querySelectorAll('.beach-card')) as HTMLElement[];
    cards.forEach((card) => {
      const bLat = parseFloat(card.dataset.beachLat || '0');
      const bLng = parseFloat(card.dataset.beachLng || '0');
      if (bLat && bLng) {
        const d = calculateDistanceKm(
          { latitude: userLat, longitude: userLng },
          { latitude: bLat, longitude: bLng }
        );
        card.dataset.distanceKm = d.toString();
        const distEl = card.querySelector('.distance-text');
        if (distEl) distEl.textContent = formatDistance(d);
      }
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupSwimPage);
  } else {
    setupSwimPage();
  }

  window.addEventListener('vanutils:location-changed', setupSwimPage);
  window.addEventListener('vanutils:pinned-beaches-changed', () => {
    updatePinButtonStates();
    renderPinnedSection();
  });
</script>
