---
import ToolLayout from '../../layouts/ToolLayout.astro';
import JsonLd from '../../components/shared/JsonLd.astro';
import RelatedTelemetry, { type RelatedItem } from '../../components/shared/RelatedTelemetry.astro';
import ElevationVisualizer from '../../tools/mountain-snow/components/ElevationVisualizer.astro';
import RoadStatusCard from '../../tools/mountain-snow/components/RoadStatusCard.astro';
import SnowfallBar from '../../tools/mountain-snow/components/SnowfallBar.astro';
import WebcamMatrix from '../../tools/mountain-snow/components/WebcamMatrix.astro';
import LiveDataUnavailable from '../../components/shared/LiveDataUnavailable.astro';
import { getLiveMountains, getMountainById, getAvalancheMeta, BASELINE_MOUNTAINS } from '../../tools/mountain-snow/services/snowService';

// Set Edge Cache header: 5 min max age, 10 min background revalidation
Astro.response.headers.set('Cache-Control', 'public, s-maxage=300, stale-while-revalidate=600');

const { mountain: mountainId } = Astro.params;

// Baseline lookup is metadata-only (name/region) so an unknown id still 404s
// even when the live upstream is down; it is never used for telemetry values.
const mountainMeta = getMountainById(mountainId || '', BASELINE_MOUNTAINS);
if (!mountainMeta) {
  return Astro.redirect('/snow');
}

const mountainsResult = await getLiveMountains();
const mountain = mountainsResult.ok ? getMountainById(mountainId || '', mountainsResult.data) : undefined;
const avAlpine = mountain ? getAvalancheMeta(mountain.avalancheRating.alpine) : null;
const avTreeline = mountain ? getAvalancheMeta(mountain.avalancheRating.treeline) : null;
const avBelow = mountain ? getAvalancheMeta(mountain.avalancheRating.belowTreeline) : null;

const wikidataMap: Record<string, string[]> = {
  whistler: ['https://en.wikipedia.org/wiki/Whistler_Blackcomb', 'https://www.wikidata.org/wiki/Q1429986'],
  grouse: ['https://en.wikipedia.org/wiki/Grouse_Mountain', 'https://www.wikidata.org/wiki/Q1547844'],
  cypress: ['https://en.wikipedia.org/wiki/Cypress_Mountain_Ski_Area', 'https://www.wikidata.org/wiki/Q1148421'],
  seymour: ['https://en.wikipedia.org/wiki/Mount_Seymour', 'https://www.wikidata.org/wiki/Q1950711'],
};

const mountainSchema = [
  {
    '@context': 'https://schema.org',
    '@type': 'SkiResort',
    name: mountainMeta.name,
    description: `Real-time coastal freezing level, snow conditions, road status, and live webcams for ${mountainMeta.name}.`,
    url: `https://vanheartbeat.ca/snow/${mountainMeta.id}`,
    sameAs: wikidataMap[mountainMeta.id] || [],
    address: {
      '@type': 'PostalAddress',
      addressLocality: mountainMeta.region === 'north_shore' ? 'North Vancouver' : 'Whistler',
      addressRegion: 'BC',
      addressCountry: 'CA',
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'VanHeartbeat', item: 'https://vanheartbeat.ca' },
      { '@type': 'ListItem', position: 2, name: 'Mountain Snow Line', item: 'https://vanheartbeat.ca/snow' },
      { '@type': 'ListItem', position: 3, name: mountainMeta.name, item: `https://vanheartbeat.ca/snow/${mountainMeta.id}` },
    ],
  },
];

const relatedItems: RelatedItem[] = [
  {
    title: 'North Shore Weather Radar',
    subtitle: 'Doppler precipitation & wind soundings',
    href: '/weather',
    badge: 'Live Radar',
    icon: '🌦️',
  },
  {
    title: 'Lions Gate & Second Narrows',
    subtitle: 'Bridge counterflow & Highway 1 traffic',
    href: '/bridges',
    badge: 'DriveBC',
    icon: '🌉',
  },
  {
    title: 'Horseshoe Bay Ferry Radar',
    subtitle: 'Departure deck space & standby capacity',
    href: '/ferries',
    badge: 'BC Ferries',
    icon: '⛴️',
  },
];
---

<ToolLayout
  toolId="mountain-snow"
  title={mountain ? `${mountain.name} — Snow Line & Elevation Matrix` : `${mountainMeta.name} — Live Data Unavailable`}
  description={mountain ? `Real-time coastal freezing level, snow conditions, road status, and live webcams for ${mountain.name}.` : 'Live mountain snow data is temporarily unavailable.'}
  currentPath={`/snow/${mountainMeta.id}`}
  badgeText={mountainMeta.region === 'north_shore' ? 'North Shore' : 'Sea-to-Sky'}
  status="active"
>
  <JsonLd schema={mountainSchema} />

  <div class="space-y-6 max-w-4xl mx-auto">
    <!-- 3-Tier Visual Breadcrumb -->
    <nav aria-label="Breadcrumb" class="flex items-center gap-2 text-xs font-semibold text-slate-500 dark:text-slate-400">
      <a href="/" class="hover:text-sky-600 dark:hover:text-sky-400 transition-colors">VanHeartbeat</a>
      <span>/</span>
      <a href="/snow" class="hover:text-sky-600 dark:hover:text-sky-400 transition-colors">Snow Line</a>
      <span>/</span>
      <span class="text-slate-900 dark:text-white truncate">{mountainMeta.name}</span>
    </nav>

    {!mountain && (
      <LiveDataUnavailable toolName={`${mountainMeta.name} Snow Report`} variant="page" error={!mountainsResult.ok ? mountainsResult.error : undefined} />
    )}

    <!-- Header Card -->
    {mountain && avAlpine && avTreeline && avBelow && (
    <>
    <section class="p-5 sm:p-6 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200/80 dark:border-slate-800 shadow-sm space-y-4">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3">
        <div>
          <span class="text-xs font-bold text-slate-400 uppercase tracking-wider block mb-1">
            {mountain.region === 'north_shore' ? '🌲 North Shore Mountains' : '🏔️ Sea-to-Sky Corridor'}
          </span>
          <h1 class="text-2xl font-black text-slate-900 dark:text-white tracking-tight">
            {mountain.name}
          </h1>
        </div>

        <a
          href={mountain.officialSourceUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-slate-100 dark:bg-slate-800 hover:bg-slate-200 dark:hover:bg-slate-700 text-xs font-bold text-slate-700 dark:text-slate-200 transition-all shrink-0"
        >
          <span>Official Resort Report ↗</span>
        </a>
      </div>

      <!-- Snowfall Metrics -->
      <SnowfallBar snowfall={mountain.snowfall} />
    </section>

    <!-- Elevation Bands & Freezing Level -->
    <section>
      <ElevationVisualizer
        elevationBands={mountain.elevationBands}
        freezingLevelMeters={mountain.currentFreezingLevelMeters}
      />
    </section>

    <!-- Road Access & DriveBC Telemetry -->
    <section>
      <RoadStatusCard road={mountain.accessRoad} />
    </section>

    <!-- Avalanche Canada Danger Bulletin -->
    <section class="p-4 sm:p-5 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200/80 dark:border-slate-800 space-y-3">
      <div class="flex items-center justify-between">
        <h2 class="text-sm font-bold text-slate-900 dark:text-white flex items-center gap-1.5">
          <span>⚠️</span> Avalanche Canada Danger Rating
        </h2>
        <a
          href={mountain.avalancheRating.bulletinUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="text-xs text-sky-600 dark:text-sky-400 hover:underline"
        >
          Official Bulletin ↗
        </a>
      </div>

      <div class="grid grid-cols-3 gap-2 text-center text-xs">
        <div class="p-2.5 rounded-xl bg-slate-50 dark:bg-slate-800/60 border border-slate-100 dark:border-slate-800">
          <span class="text-[10px] text-slate-400 block uppercase font-bold">Alpine</span>
          <span class={`inline-block px-2 py-0.5 mt-1 rounded text-xs font-bold ${avAlpine.color}`}>
            {avAlpine.label}
          </span>
        </div>
        <div class="p-2.5 rounded-xl bg-slate-50 dark:bg-slate-800/60 border border-slate-100 dark:border-slate-800">
          <span class="text-[10px] text-slate-400 block uppercase font-bold">Treeline</span>
          <span class={`inline-block px-2 py-0.5 mt-1 rounded text-xs font-bold ${avTreeline.color}`}>
            {avTreeline.label}
          </span>
        </div>
        <div class="p-2.5 rounded-xl bg-slate-50 dark:bg-slate-800/60 border border-slate-100 dark:border-slate-800">
          <span class="text-[10px] text-slate-400 block uppercase font-bold">Below Treeline</span>
          <span class={`inline-block px-2 py-0.5 mt-1 rounded text-xs font-bold ${avBelow.color}`}>
            {avBelow.label}
          </span>
        </div>
      </div>
    </section>

    <!-- Webcams -->
    {mountain.webcams.length > 0 && (
      <section class="p-4 sm:p-5 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200/80 dark:border-slate-800 space-y-3">
        <WebcamMatrix webcams={mountain.webcams} mountainName={mountain.name} />
      </section>
    )}
    </>
    )}

    <!-- Connected Cross-Utility Telemetry -->
    <RelatedTelemetry items={relatedItems} />

    <!-- Back Navigation -->
    <div class="pt-2">
      <a
        href="/snow"
        class="inline-flex items-center gap-2 text-xs font-bold text-sky-600 dark:text-sky-400 hover:underline"
      >
        ← Back to All Mountains
      </a>
    </div>
  </div>
</ToolLayout>
