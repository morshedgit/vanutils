---
import ToolLayout from '../../layouts/ToolLayout.astro';
---

<ToolLayout
  toolId="mountain-snow"
  title="North Shore Mountain Snow Line"
  description="Real-time freezing level elevation, Cypress, Seymour & Grouse conditions, road chain advisories, and synchronized summit webcams."
  currentPath="/snow"
  badgeText="Roadmap v1.2"
  status="planned"
>
  <!-- Header Aside Widget -->
  <div slot="header-aside" class="flex items-center gap-3 bg-white/80 dark:bg-slate-900/80 p-4 rounded-2xl border border-slate-200/80 dark:border-slate-800 shadow-xs">
    <div class="w-12 h-12 rounded-xl bg-sky-500/10 text-sky-600 dark:text-sky-400 flex items-center justify-center font-black text-lg border border-sky-500/20">
      1,100m
    </div>
    <div>
      <div class="text-xs font-extrabold text-slate-900 dark:text-white">
        Freezing Level Today
      </div>
      <div class="text-[11px] text-slate-500 dark:text-slate-400">
        Snow line above Cypress base
      </div>
    </div>
  </div>

  <div class="space-y-8">
    <!-- Roadmap Banner -->
    <div class="p-6 rounded-3xl bg-sky-500/10 border border-sky-500/20 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
      <div class="flex items-center gap-3">
        <span class="text-2xl">❄️</span>
        <div>
          <h3 class="text-sm font-bold text-slate-900 dark:text-white">Tool In Active Development (Release v1.2)</h3>
          <p class="text-xs text-slate-600 dark:text-slate-400">
            Unified snow matrix and tire chain requirements for North Shore mountains and the Sea to Sky corridor.
          </p>
        </div>
      </div>
      <a
        href="/swim"
        class="inline-flex items-center gap-1.5 px-4 py-2 rounded-xl bg-sky-600 hover:bg-sky-500 text-white text-xs font-bold transition-all shrink-0"
      >
        Try Live Swim Tool →
      </a>
    </div>

    <!-- 3 North Shore Mountains Matrix Grid -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      <!-- Cypress Mountain -->
      <div class="p-6 rounded-3xl bg-white dark:bg-slate-900/90 border border-slate-200/80 dark:border-slate-800 shadow-sm space-y-4">
        <div class="flex items-center justify-between">
          <span class="text-xs font-bold uppercase tracking-wider text-slate-400">West Vancouver</span>
          <span class="text-xs font-bold px-2 py-0.5 rounded-full bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border border-emerald-500/20">Winter Tires M+S</span>
        </div>
        <h3 class="text-xl font-black text-slate-900 dark:text-white">Cypress Mountain</h3>
        <div class="space-y-2 text-xs">
          <div class="flex justify-between p-2 rounded-xl bg-slate-50 dark:bg-slate-800/50">
            <span class="text-slate-500">Base Elevation:</span>
            <span class="font-bold text-slate-800 dark:text-slate-200">910 m (3,000 ft)</span>
          </div>
          <div class="flex justify-between p-2 rounded-xl bg-slate-50 dark:bg-slate-800/50">
            <span class="text-slate-500">Peak Elevation:</span>
            <span class="font-bold text-slate-800 dark:text-slate-200">1,440 m (4,720 ft)</span>
          </div>
          <div class="flex justify-between p-2 rounded-xl bg-slate-50 dark:bg-slate-800/50">
            <span class="text-slate-500">Road Status:</span>
            <span class="font-bold text-emerald-600 dark:text-emerald-400">Bare & Dry to High View</span>
          </div>
        </div>
      </div>

      <!-- Grouse Mountain -->
      <div class="p-6 rounded-3xl bg-white dark:bg-slate-900/90 border border-slate-200/80 dark:border-slate-800 shadow-sm space-y-4">
        <div class="flex items-center justify-between">
          <span class="text-xs font-bold uppercase tracking-wider text-slate-400">North Vancouver</span>
          <span class="text-xs font-bold px-2 py-0.5 rounded-full bg-sky-500/10 text-sky-600 dark:text-sky-400 border border-sky-500/20">Skyride Open</span>
        </div>
        <h3 class="text-xl font-black text-slate-900 dark:text-white">Grouse Mountain</h3>
        <div class="space-y-2 text-xs">
          <div class="flex justify-between p-2 rounded-xl bg-slate-50 dark:bg-slate-800/50">
            <span class="text-slate-500">Chalet Elevation:</span>
            <span class="font-bold text-slate-800 dark:text-slate-200">1,127 m (3,700 ft)</span>
          </div>
          <div class="flex justify-between p-2 rounded-xl bg-slate-50 dark:bg-slate-800/50">
            <span class="text-slate-500">Peak Elevation:</span>
            <span class="font-bold text-slate-800 dark:text-slate-200">1,231 m (4,039 ft)</span>
          </div>
          <div class="flex justify-between p-2 rounded-xl bg-slate-50 dark:bg-slate-800/50">
            <span class="text-slate-500">Grouse Grind:</span>
            <span class="font-bold text-emerald-600 dark:text-emerald-400">Open (Seasonal)</span>
          </div>
        </div>
      </div>

      <!-- Mount Seymour -->
      <div class="p-6 rounded-3xl bg-white dark:bg-slate-900/90 border border-slate-200/80 dark:border-slate-800 shadow-sm space-y-4">
        <div class="flex items-center justify-between">
          <span class="text-xs font-bold uppercase tracking-wider text-slate-400">North Vancouver</span>
          <span class="text-xs font-bold px-2 py-0.5 rounded-full bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border border-emerald-500/20">Winter Tires M+S</span>
        </div>
        <h3 class="text-xl font-black text-slate-900 dark:text-white">Mount Seymour</h3>
        <div class="space-y-2 text-xs">
          <div class="flex justify-between p-2 rounded-xl bg-slate-50 dark:bg-slate-800/50">
            <span class="text-slate-500">Base Elevation:</span>
            <span class="font-bold text-slate-800 dark:text-slate-200">1,020 m (3,350 ft)</span>
          </div>
          <div class="flex justify-between p-2 rounded-xl bg-slate-50 dark:bg-slate-800/50">
            <span class="text-slate-500">Peak Elevation:</span>
            <span class="font-bold text-slate-800 dark:text-slate-200">1,449 m (4,754 ft)</span>
          </div>
          <div class="flex justify-between p-2 rounded-xl bg-slate-50 dark:bg-slate-800/50">
            <span class="text-slate-500">Road Status:</span>
            <span class="font-bold text-emerald-600 dark:text-emerald-400">Clear to P1 Lot</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</ToolLayout>
