---
import ToolLayout from '../../layouts/ToolLayout.astro';
import FilterTabs from '../../tools/mountain-snow/components/FilterTabs.astro';
import MountainCard from '../../tools/mountain-snow/components/MountainCard.astro';
import WebcamMatrix from '../../tools/mountain-snow/components/WebcamMatrix.astro';
import { getAllMountains, getSnowOverviewStats } from '../../tools/mountain-snow/services/snowService';

const mountains = getAllMountains();
const stats = getSnowOverviewStats(mountains);
const allWebcams = mountains.flatMap((m) => m.webcams);
---

<ToolLayout
  toolId="mountain-snow"
  title="Mountain Snow Line & Elevation Matrix"
  description="Real-time coastal rain/snow line, freezing level elevation matrix, DriveBC road conditions, and live webcams for Cypress, Grouse, Seymour, and Whistler."
  currentPath="/snow"
  badgeText="Live Snow Radar"
  status="active"
>
  <div class="space-y-5 max-w-5xl mx-auto">
    <!-- Freezing Level & Snow Hero -->
    <section class="rounded-2xl bg-slate-900 text-white p-4 sm:p-5 border border-slate-800 shadow-sm flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
      <div class="space-y-1">
        <div class="inline-flex items-center gap-2 px-2.5 py-0.5 rounded-full bg-sky-500/20 text-sky-300 text-xs font-semibold">
          <span class="w-2 h-2 rounded-full bg-sky-400 animate-pulse"></span>
          <span>Coastal 0°C Freezing Level: {stats.avgFreezingLevel}m</span>
        </div>
        <h2 class="text-base sm:text-lg font-bold tracking-tight text-white">
          Vancouver Mountain Snow Line Matrix
        </h2>
        <p class="text-xs text-slate-300">
          Average {stats.avgFresh24hCm}cm fresh snow in last 24h • {stats.totalOpenLifts}/{stats.totalLifts} Lifts Operating
        </p>
      </div>

      <div class="flex items-center gap-2 shrink-0">
        <span class="px-3 py-1.5 rounded-xl bg-slate-800 text-slate-200 text-xs font-semibold border border-slate-700">
          ❄️ Powder at Mid/Peak
        </span>
      </div>
    </section>

    <!-- Pinned Mountains Bar (Mirrors Home Dashboard Card) -->
    <div id="pinned-snow-section" class="p-3 sm:p-3.5 rounded-xl bg-slate-50 dark:bg-slate-900 border border-slate-200/80 dark:border-slate-800 space-y-2">
      <div class="flex items-center justify-between text-xs">
        <span class="font-bold text-slate-800 dark:text-slate-200 flex items-center gap-1.5">
          <span class="text-amber-500">⭐</span> My Mountains (Shown on Home Dashboard)
        </span>
        <span class="text-[11px] text-slate-400">
          Click ⭐ on any mountain to customize
        </span>
      </div>

      <div id="pinned-snow-container" class="flex flex-wrap gap-1.5">
        <!-- Dynamically populated via client script -->
      </div>
    </div>

    <!-- Filter & Search Controls -->
    <FilterTabs />

    <!-- Mountain Cards Grid -->
    <div class="space-y-2">
      <div class="flex items-center justify-between px-1 text-xs text-slate-500 dark:text-slate-400 font-medium">
        <span id="mountain-count-display">Showing all {mountains.length} mountain resorts</span>
        <span>Tap any mountain for full report</span>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-4" id="mountains-grid">
        {mountains.map((mountain) => (
          <MountainCard mountain={mountain} />
        ))}
      </div>
    </div>

    <!-- Live Multi-Mountain Webcam Matrix -->
    <section class="p-4 sm:p-5 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200/80 dark:border-slate-800 space-y-3 shadow-xs">
      <WebcamMatrix webcams={allWebcams.slice(0, 4)} mountainName="All Mountains" />
    </section>
  </div>
</ToolLayout>

<script>
  const DEFAULT_PINNED_SNOW = ['cypress', 'grouse', 'seymour', 'whistler'];

  function getPinnedSnowIds(): string[] {
    const saved = localStorage.getItem('vanutils_pinned_snow');
    return saved ? JSON.parse(saved) : DEFAULT_PINNED_SNOW;
  }

  function setPinnedSnowIds(ids: string[]) {
    localStorage.setItem('vanutils_pinned_snow', JSON.stringify(ids));
    window.dispatchEvent(new CustomEvent('vanutils:pinned-snow-changed'));
    renderPinnedSnow();
    updateSnowPinButtonStates();
  }

  function toggleSnowPin(mountainId: string) {
    let current = getPinnedSnowIds();
    if (current.includes(mountainId)) {
      current = current.filter(id => id !== mountainId);
    } else {
      current = [...current, mountainId];
    }
    setPinnedSnowIds(current);
  }

  function updateSnowPinButtonStates() {
    const pinned = getPinnedSnowIds();
    const pinBtns = document.querySelectorAll('.pin-snow-toggle') as NodeListOf<HTMLButtonElement>;

    pinBtns.forEach(btn => {
      const id = btn.dataset.mountainId || '';
      const isPinned = pinned.includes(id);
      btn.classList.toggle('text-amber-500', isPinned);
      btn.classList.toggle('text-slate-300', !isPinned);
      btn.classList.toggle('dark:text-slate-600', !isPinned);
      btn.title = isPinned ? 'Remove from Main Dashboard' : 'Pin to Main Dashboard';
    });
  }

  function renderPinnedSnow() {
    const container = document.getElementById('pinned-snow-container');
    if (!container) return;

    const pinned = getPinnedSnowIds();
    const cards = Array.from(document.querySelectorAll('.mountain-card')) as HTMLElement[];

    if (pinned.length === 0) {
      container.innerHTML = `<span class="text-xs text-slate-400 italic">No mountains pinned. Click ⭐ on any mountain below to show it on your dashboard.</span>`;
      return;
    }

    container.innerHTML = pinned.map(id => {
      const match = cards.find(c => c.dataset.mountainId === id);
      const name = match ? match.dataset.mountainName || id : id;

      return `
        <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-xs font-semibold bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 shadow-2xs">
          <span class="w-2 h-2 rounded-full bg-sky-500"></span>
          <a href="/snow/${id}" class="hover:text-sky-500">${name}</a>
          <button type="button" class="unpin-snow-btn ml-1 text-slate-400 hover:text-rose-500 font-bold" data-id="${id}" title="Remove from main">×</button>
        </span>
      `;
    }).join('');

    container.querySelectorAll('.unpin-snow-btn').forEach(btn => {
      btn.addEventListener('click', (e) => {
        e.stopPropagation();
        const id = (btn as HTMLElement).dataset.id;
        if (id) toggleSnowPin(id);
      });
    });
  }

  function setupSnowDashboard() {
    updateSnowPinButtonStates();
    renderPinnedSnow();

    document.querySelectorAll('.pin-snow-toggle').forEach(btn => {
      btn.addEventListener('click', (e) => {
        e.preventDefault();
        e.stopPropagation();
        const id = (btn as HTMLElement).dataset.mountainId;
        if (id) toggleSnowPin(id);
      });
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupSnowDashboard);
  } else {
    setupSnowDashboard();
  }

  window.addEventListener('vanutils:pinned-snow-changed', () => {
    updateSnowPinButtonStates();
    renderPinnedSnow();
  });
</script>
