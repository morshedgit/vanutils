---
import ToolLayout from '../../layouts/ToolLayout.astro';
import JsonLd from '../../components/shared/JsonLd.astro';
import RelatedTelemetry, { type RelatedItem } from '../../components/shared/RelatedTelemetry.astro';
import WaitTimeBadge from '../../tools/health-wait-times/components/WaitTimeBadge.astro';
import EmergencyDisclaimer from '../../tools/health-wait-times/components/EmergencyDisclaimer.astro';
import LiveDataUnavailable from '../../components/shared/LiveDataUnavailable.astro';
import { getLiveFacilities, getFacilityById, formatWaitTime, computeIsCurrentlyOpen, BASELINE_FACILITIES } from '../../tools/health-wait-times/services/healthService';

// Set Edge Cache header: 5 min max age, 10 min background revalidation
Astro.response.headers.set('Cache-Control', 'public, s-maxage=300, stale-while-revalidate=600');

const { facility: facilityId } = Astro.params;

// Baseline lookup is metadata-only (name/address) so an unknown id still 404s
// even when the live upstream is down; it is never used for telemetry values.
const facilityMeta = getFacilityById(facilityId || '', BASELINE_FACILITIES);
if (!facilityMeta) {
  return Astro.redirect('/health');
}

const facilitiesResult = await getLiveFacilities();
const facility = facilitiesResult.ok ? getFacilityById(facilityId || '', facilitiesResult.data) : undefined;
const waitMins = facility?.triageData?.waitTimeMinutes;
const isOpen = facility ? computeIsCurrentlyOpen(facility) : undefined;

const facilitySchema = [
  {
    '@context': 'https://schema.org',
    '@type': facilityMeta.facilityType === 'emergency_department' ? 'Hospital' : 'MedicalClinic',
    name: facilityMeta.name,
    description: `Real-time wait times and urgent medical care for ${facilityMeta.name} in ${facilityMeta.municipality}, BC.`,
    url: `https://vanheartbeat.ca/health/${facilityMeta.id}`,
    address: {
      '@type': 'PostalAddress',
      streetAddress: facilityMeta.address,
      addressLocality: facilityMeta.municipality,
      addressRegion: 'BC',
      addressCountry: 'CA',
    },
    geo: {
      '@type': 'GeoCoordinates',
      latitude: facilityMeta.latitude,
      longitude: facilityMeta.longitude,
    },
    isEmergencyService: facilityMeta.facilityType === 'emergency_department',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'VanHeartbeat', item: 'https://vanheartbeat.ca' },
      { '@type': 'ListItem', position: 2, name: 'Health Wait Times', item: 'https://vanheartbeat.ca/health' },
      { '@type': 'ListItem', position: 3, name: facilityMeta.name, item: `https://vanheartbeat.ca/health/${facilityMeta.id}` },
    ],
  },
];

const relatedItems: RelatedItem[] = [
  {
    title: 'Hospital & Clinic Car-Share Parking',
    subtitle: 'Permit exemptions and emergency stall rules',
    href: '/parking',
    badge: 'Parking',
    icon: '🚗',
  },
  {
    title: 'TransLink & Public Health News',
    subtitle: 'Hospital access routes & health alerts',
    href: '/news',
    badge: 'Wire',
    icon: '📰',
  },
  {
    title: 'Hyper-Local Weather Radar',
    subtitle: 'Precipitation, UV and air temperatures',
    href: '/weather',
    badge: 'Doppler',
    icon: '🌦️',
  },
];
---

<ToolLayout
  toolId="health-wait-times"
  title={facility ? `${facility.name} — Live Wait Time` : `${facilityMeta.name} — Live Data Unavailable`}
  description={facility ? `Real-time emergency department triage wait times, patients waiting, diagnostic imaging services, and directions for ${facility.name}.` : 'Live ER wait time data is temporarily unavailable.'}
  currentPath={`/health/${facilityMeta.id}`}
  badgeText={facilityMeta.healthAuthority === 'fraser_health' ? 'Fraser Health' : 'Vancouver Coastal'}
  status="active"
>
  <JsonLd schema={facilitySchema} />

  <div class="space-y-6 max-w-5xl mx-auto">
    <!-- 3-Tier Visual Breadcrumb Navigation -->
    <nav aria-label="Breadcrumb" class="flex items-center justify-between">
      <div class="flex items-center gap-2 text-xs font-semibold text-slate-500 dark:text-slate-400">
        <a href="/" class="hover:text-sky-600 dark:hover:text-sky-400 transition-colors">VanHeartbeat</a>
        <span>/</span>
        <a href="/health" class="hover:text-sky-600 dark:hover:text-sky-400 transition-colors">ER &amp; Urgent Care</a>
        <span>/</span>
        <span class="text-slate-900 dark:text-white truncate">{facilityMeta.shortName}</span>
      </div>
      <span class="text-xs text-slate-400">
        {facilityMeta.municipality} • {facilityMeta.facilityType === 'emergency_department' ? 'Emergency Department' : 'Urgent & Primary Care'}
      </span>
    </nav>

    <!-- Mandatory Medical Emergency Notice -->
    <EmergencyDisclaimer />

    {!facility && (
      <LiveDataUnavailable toolName={`${facilityMeta.name}`} variant="page" error={!facilitiesResult.ok ? facilitiesResult.error : undefined} />
    )}

    <!-- Facility Hero Header -->
    {facility && (
    <>
    <section class="rounded-2xl bg-slate-900 text-white p-5 sm:p-6 border border-slate-800 shadow-sm flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
      <div class="space-y-1.5">
        <div class="flex items-center gap-2">
          <h2 class="text-xl sm:text-2xl font-black tracking-tight text-white">
            {facility.name}
          </h2>
        </div>
        <p class="text-xs text-slate-300">
          📍 {facility.address} • 📞 {facility.phone}
        </p>
      </div>

      <div class="flex items-center gap-3 shrink-0">
        <WaitTimeBadge waitTimeMinutes={waitMins} isOpen={isOpen} size="lg" />
        <button
          type="button"
          class="star-btn px-3 py-2 rounded-xl bg-slate-800 text-slate-300 hover:text-amber-400 text-xs font-bold border border-slate-700 transition-colors flex items-center gap-1.5"
          data-facility-star-id={facility.id}
        >
          <span>⭐</span>
          <span>Pin</span>
        </button>
      </div>
    </section>

    <!-- Triage & Capacity Detail Cards -->
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
      <div class="p-4 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 shadow-xs">
        <span class="text-xs text-slate-500 dark:text-slate-400 block mb-1">Estimated Wait to Doctor</span>
        <div class="text-2xl font-black text-slate-900 dark:text-white">
          {formatWaitTime(waitMins)}
        </div>
        <span class="text-[11px] text-slate-400">Triage registration to physician</span>
      </div>

      <div class="p-4 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 shadow-xs">
        <span class="text-xs text-slate-500 dark:text-slate-400 block mb-1">Patients in Department</span>
        <div class="text-2xl font-black text-slate-900 dark:text-white">
          {facility.triageData?.patientCountWaiting !== undefined ? `${facility.triageData.patientCountWaiting} waiting` : 'Active'}
        </div>
        <span class="text-[11px] text-slate-400">
          {facility.triageData?.patientCountTreating ? `${facility.triageData.patientCountTreating} currently in treatment` : 'Normal intake'}
        </span>
      </div>

      <div class="p-4 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 shadow-xs">
        <span class="text-xs text-slate-500 dark:text-slate-400 block mb-1">Operating Hours</span>
        <div class="text-lg sm:text-xl font-bold text-slate-900 dark:text-white">
          {facility.hours.isOpen24_7 ? 'Open 24/7' : `${facility.hours.openTime} – ${facility.hours.closeTime}`}
        </div>
        <span class="text-[11px] text-emerald-600 dark:text-emerald-400 font-semibold">
          {facility.hours.acceptingWalkIns ? '✓ Accepting Same-Day Walk-ins' : 'Capacity Full'}
        </span>
      </div>
    </div>

    <!-- On-Site Diagnostics & Clinical Services -->
    <section class="p-5 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 shadow-xs space-y-3">
      <h3 class="text-base font-bold text-slate-900 dark:text-white flex items-center gap-2">
        <span>🩺</span>
        <span>Diagnostic & Clinical Capabilities</span>
      </h3>
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-2">
        {facility.servicesAvailable.map((svc) => (
          <div class="p-2.5 rounded-xl bg-slate-50 dark:bg-slate-800/60 border border-slate-100 dark:border-slate-700/60 text-xs font-semibold text-slate-700 dark:text-slate-300 flex items-center gap-1.5">
            <span class="text-emerald-600 dark:text-emerald-400 font-bold">✓</span>
            <span>{svc}</span>
          </div>
        ))}
      </div>
    </section>

    <!-- Location, Transit & Parking Instructions -->
    <section class="grid grid-cols-1 md:grid-cols-2 gap-4">
      <div class="p-4 sm:p-5 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 shadow-xs space-y-2 text-xs">
        <div class="flex items-center gap-2 font-bold text-slate-900 dark:text-white text-sm">
          <span>🚇</span>
          <span>Transit & Access</span>
        </div>
        <p class="text-slate-600 dark:text-slate-300 leading-relaxed">
          {facility.transitAccess}
        </p>
      </div>

      <div class="p-4 sm:p-5 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 shadow-xs space-y-2 text-xs">
        <div class="flex items-center gap-2 font-bold text-slate-900 dark:text-white text-sm">
          <span>🅿️</span>
          <span>Parking Details</span>
        </div>
        <p class="text-slate-600 dark:text-slate-300 leading-relaxed">
          {facility.parkingInfo}
        </p>
      </div>
    </section>
    </>
    )}

    <!-- Connected Cross-Utility Telemetry -->
    <RelatedTelemetry items={relatedItems} />

    <!-- 1-Tap Navigation & Official Portal Links -->
    <div class="flex flex-col sm:flex-row gap-3 pt-2">
      <a
        href={`https://maps.google.com/?q=${facilityMeta.latitude},${facilityMeta.longitude}`}
        target="_blank"
        rel="noopener noreferrer"
        class="flex-1 inline-flex items-center justify-center gap-2 py-3 px-4 rounded-xl bg-sky-500 hover:bg-sky-600 text-white font-bold text-xs sm:text-sm shadow-sm transition-colors"
      >
        <span>📍 Open Google Maps Navigation</span>
      </a>
      <a
        href={facilityMeta.officialPortalUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center justify-center gap-2 py-3 px-4 rounded-xl bg-slate-100 dark:bg-slate-800 hover:bg-slate-200 dark:hover:bg-slate-700 text-slate-700 dark:text-slate-200 font-bold text-xs sm:text-sm transition-colors"
      >
        <span>🏛️ Official Health Authority Page</span>
      </a>
    </div>
  </div>
</ToolLayout>
