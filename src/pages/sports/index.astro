---
import ToolLayout from '../../layouts/ToolLayout.astro';
import JsonLd from '../../components/shared/JsonLd.astro';
import FilterTabs from '../../tools/sports-facilities/components/FilterTabs.astro';
import FacilityCard from '../../tools/sports-facilities/components/FacilityCard.astro';
import { getLiveSportsFacilities, getSportsOverviewStats } from '../../tools/sports-facilities/services/sportsService';

// Tiered Edge Cache: 30-minute edge TTL, 2-hour background revalidation
Astro.response.headers.set('Cache-Control', 'public, s-maxage=1800, stale-while-revalidate=7200');

const facilities = await getLiveSportsFacilities();
const stats = getSportsOverviewStats(facilities);

const sportsSchema = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    name: 'Metro Vancouver Public Sports, Courts & Rec Radar — VanHeartbeat',
    description: 'Sub-second recreation radar for public tennis courts, lighted pickleball, length swimming schedules, and ice rink drop-ins.',
    url: 'https://vanheartbeat.ca/sports',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'VanHeartbeat', item: 'https://vanheartbeat.ca' },
      { '@type': 'ListItem', position: 2, name: 'Sports Courts & Rec Radar', item: 'https://vanheartbeat.ca/sports' },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: [
      {
        '@type': 'Question',
        name: 'Where are public tennis and pickleball courts with night lighting located in Vancouver?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'Lighted public court facilities operating until 10:00 PM include Kitsilano Beach Park, Queen Elizabeth Park, and Stanley Park Tennis Courts.',
        },
      },
      {
        '@type': 'Question',
        name: 'Are public tennis and pickleball courts in Vancouver free to use?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'Yes. All Vancouver Park Board public tennis and outdoor pickleball courts are 100% free on a first-come, first-served basis, with a standard 30-minute rotation rule when players are waiting.',
        },
      },
      {
        '@type': 'Question',
        name: 'How do public indoor swimming and rink drop-in schedules work in Vancouver?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'Public community pools (like Hillcrest and Vancouver Aquatic Centre) and ice rinks (like Trout Lake and Sunset) operate specific designated sessions for public swim/skate, length swimming, and sensory-friendly times via the Vancouver Park Board Flexipass system.',
        },
      },
    ],
  },
];
---

<ToolLayout
  toolId="sports-courts"
  title="Metro Vancouver Public Sports, Courts & Rec Radar"
  description="Sub-second recreation radar for public tennis courts, lighted pickleball, length swimming schedules, and ice rink drop-ins."
  currentPath="/sports"
  badgeText="Park Board ActiveNet"
  status="active"
>
  <JsonLd schema={sportsSchema} />

  <div class="space-y-5 max-w-5xl mx-auto">
    <!-- Hero Header with Geolocation Distance Sorter -->
    <section class="rounded-2xl bg-slate-900 text-white p-4 sm:p-5 border border-slate-800 shadow-sm flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
      <div class="space-y-1">
        <div class="inline-flex items-center gap-2 px-2.5 py-0.5 rounded-full bg-emerald-500/20 text-emerald-300 text-xs font-semibold">
          <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
          <span>Vancouver Park Board Drop-in Hubs • {stats.totalFacilities} Locations</span>
        </div>
        <h2 class="text-base sm:text-lg font-bold tracking-tight text-white">
          Public Tennis, Lighted Pickleball, Aquatic Pools & Ice Rinks
        </h2>
        <p class="text-xs text-slate-300">
          Tracking {stats.courtCount} public courts, {stats.lightedHubs} floodlit nighttime hubs, {stats.poolCount} indoor/outdoor pools, and real-time session modes.
        </p>
      </div>

      <!-- 1-Tap Geolocation Sorter -->
      <button
        type="button"
        id="geo-sort-sports-btn"
        class="inline-flex items-center justify-center gap-2 px-4 py-2.5 rounded-xl bg-sky-500 hover:bg-sky-400 text-white font-bold text-xs sm:text-sm shadow-md hover:shadow-lg transition-all shrink-0"
      >
        <span>📍</span>
        <span id="geo-sports-label">Find Closest Sports Hub</span>
      </button>
    </section>

    <!-- Pinned Sports Section (Mirrors Home Dashboard Card) -->
    <div id="pinned-sports-section" class="p-3 sm:p-3.5 rounded-xl bg-slate-50 dark:bg-slate-900 border border-slate-200/80 dark:border-slate-800 space-y-2">
      <div class="flex items-center justify-between">
        <span class="text-xs font-bold text-slate-700 dark:text-slate-300 flex items-center gap-1.5">
          <span>⭐</span>
          <span>Pinned Facilities (Shown on Main Dashboard)</span>
        </span>
        <span class="text-[11px] text-slate-400">Click star on any facility below to customize</span>
      </div>
      <div id="pinned-sports-grid" class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-2">
        <!-- Dynamically populated via client JS -->
      </div>
    </div>

    <!-- Filter Tabs -->
    <FilterTabs activeTab="all" />

    <!-- Facilities Grid -->
    <div id="facilities-grid" class="grid grid-cols-1 md:grid-cols-2 gap-4">
      {facilities.map((facility) => (
        <FacilityCard facility={facility} />
      ))}
    </div>

    <!-- FAQ Accordion for SEO & GEO -->
    <div class="p-6 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 shadow-xs space-y-4">
      <div class="flex items-center gap-2">
        <span class="text-xl">💬</span>
        <h2 class="text-base font-black text-slate-900 dark:text-white tracking-tight">
          Public Sports, Courts &amp; Rinks: Frequently Asked Questions
        </h2>
      </div>

      <div class="space-y-3 text-xs leading-relaxed text-slate-600 dark:text-slate-400">
        <div class="p-3.5 rounded-xl bg-slate-50 dark:bg-slate-950/60 border border-slate-200/80 dark:border-slate-800 space-y-1">
          <h3 class="font-bold text-slate-900 dark:text-white text-xs">
            Where are public tennis and pickleball courts with night lighting located in Vancouver?
          </h3>
          <p>
            Lighted public court facilities operating until 10:00 PM include Kitsilano Beach Park, Queen Elizabeth Park, and Stanley Park Tennis Courts.
          </p>
        </div>

        <div class="p-3.5 rounded-xl bg-slate-50 dark:bg-slate-950/60 border border-slate-200/80 dark:border-slate-800 space-y-1">
          <h3 class="font-bold text-slate-900 dark:text-white text-xs">
            Are public tennis and pickleball courts in Vancouver free to use?
          </h3>
          <p>
            Yes. All Vancouver Park Board public tennis and outdoor pickleball courts are 100% free on a first-come, first-served basis, with a standard 30-minute rotation rule when players are waiting.
          </p>
        </div>

        <div class="p-3.5 rounded-xl bg-slate-50 dark:bg-slate-950/60 border border-slate-200/80 dark:border-slate-800 space-y-1">
          <h3 class="font-bold text-slate-900 dark:text-white text-xs">
            How do public indoor swimming and rink drop-in schedules work in Vancouver?
          </h3>
          <p>
            Public community pools (like Hillcrest and Vancouver Aquatic Centre) and ice rinks (like Trout Lake and Sunset) operate specific designated sessions for public swim/skate, length swimming, and sensory-friendly times via the Vancouver Park Board Flexipass system.
          </p>
        </div>
      </div>
    </div>
  </div>
</ToolLayout>

<script is:inline define:vars={{ facilitiesJson: JSON.stringify(facilities) }}>
  // Pinned Facilities Management
  const STORAGE_KEY = 'vanutils_pinned_sports-facilities';
  const DEFAULT_PINNED = [
    'kitsilano-beach-tennis',
    'hillcrest-aquatic-centre',
    'trout-lake-ice-rink',
    'queen-elizabeth-pickleball',
    'vancouver-aquatic-centre',
    'andy-livingstone-park-turf'
  ];

  function getPinnedIds() {
    try {
      const saved = localStorage.getItem(STORAGE_KEY);
      if (saved) return JSON.parse(saved);
    } catch (e) {}
    return DEFAULT_PINNED;
  }

  function savePinnedIds(ids) {
    localStorage.setItem(STORAGE_KEY, JSON.stringify(ids));
    window.dispatchEvent(new CustomEvent('vanutils:pinned-sports-changed', { detail: ids }));
  }

  function renderPinnedGrid() {
    const grid = document.getElementById('pinned-sports-grid');
    if (!grid) return;

    const pinnedIds = getPinnedIds();
    const allFacilities = JSON.parse(facilitiesJson || '[]');
    const pinned = allFacilities.filter((f) => pinnedIds.includes(f.id));

    if (pinned.length === 0) {
      grid.innerHTML = '<p class="text-xs text-slate-400 py-1">No pinned sports hubs. Star any facility below to add!</p>';
      return;
    }

    grid.innerHTML = pinned.map((f) => `
      <div class="flex items-center justify-between p-2 rounded-lg bg-white dark:bg-slate-800/80 border border-slate-200/80 dark:border-slate-700/60 text-xs">
        <div class="truncate pr-2 font-bold text-slate-900 dark:text-white">
          <a href="/sports/${f.id}" class="hover:text-sky-500">${f.name}</a>
          <span class="text-[10px] text-slate-400 block">${f.session.currentMode}</span>
        </div>
        <span class="shrink-0 font-bold text-[11px] text-sky-600 dark:text-sky-400">
          ${f.courtDetails?.hasLights ? '💡 Lighted' : (f.poolDetails ? `${f.poolDetails.poolLengthMeters}m Pool` : '🟢 Open')}
        </span>
      </div>
    `).join('');
  }

  function updateStarButtons() {
    const pinnedIds = getPinnedIds();
    document.querySelectorAll('.star-btn[data-facility-star-id]').forEach((btn) => {
      const id = btn.getAttribute('data-facility-star-id');
      if (pinnedIds.includes(id)) {
        btn.classList.add('text-amber-400', 'dark:text-amber-400');
        btn.classList.remove('text-slate-300', 'dark:text-slate-600');
      } else {
        btn.classList.remove('text-amber-400', 'dark:text-amber-400');
        btn.classList.add('text-slate-300', 'dark:text-slate-600');
      }
    });
  }

  function setupStarClicks() {
    document.querySelectorAll('.star-btn[data-facility-star-id]').forEach((btn) => {
      btn.addEventListener('click', (e) => {
        e.preventDefault();
        e.stopPropagation();
        const id = btn.getAttribute('data-facility-star-id');
        let pinned = getPinnedIds();
        if (pinned.includes(id)) {
          pinned = pinned.filter((p) => p !== id);
        } else {
          pinned.push(id);
        }
        savePinnedIds(pinned);
        updateStarButtons();
        renderPinnedGrid();
      });
    });
  }

  // Haversine Distance
  function haversineKm(lat1, lon1, lat2, lon2) {
    const R = 6371;
    const dLat = (lat2 - lat1) * Math.PI / 180;
    const dLon = (lon2 - lon1) * Math.PI / 180;
    const a = Math.sin(dLat / 2) * Math.sin(dLat / 2) +
              Math.cos(lat1 * Math.PI / 180) * Math.cos(lat2 * Math.PI / 180) *
              Math.sin(dLon / 2) * Math.sin(dLon / 2);
    const c = 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1 - a));
    return R * c;
  }

  function setupGeoSort() {
    const btn = document.getElementById('geo-sort-sports-btn');
    const label = document.getElementById('geo-sports-label');
    const grid = document.getElementById('facilities-grid');

    if (!btn) return;

    btn.addEventListener('click', () => {
      if (!navigator.geolocation) {
        alert('Geolocation is not supported by your browser.');
        return;
      }

      label.textContent = 'Locating Closest Sports Hubs...';
      navigator.geolocation.getCurrentPosition(
        (pos) => {
          const userLat = pos.coords.latitude;
          const userLng = pos.coords.longitude;
          label.textContent = 'Sorted by Proximity ✅';

          const cards = Array.from(document.querySelectorAll('.facility-card'));
          cards.forEach((card) => {
            const lat = parseFloat(card.getAttribute('data-lat') || '0');
            const lng = parseFloat(card.getAttribute('data-lng') || '0');
            const km = haversineKm(userLat, userLng, lat, lng);
            card.setAttribute('data-distance', km.toFixed(2));
            const distLabel = card.querySelector('.facility-distance-label');
            if (distLabel) distLabel.textContent = `📍 ${km < 1 ? Math.round(km * 1000) + 'm away' : km.toFixed(1) + ' km away'}`;
          });

          cards.sort((a, b) => {
            const distA = parseFloat(a.getAttribute('data-distance') || '0');
            const distB = parseFloat(b.getAttribute('data-distance') || '0');
            return distA - distB;
          });

          if (grid) {
            cards.forEach((card) => grid.appendChild(card));
          }
        },
        () => {
          label.textContent = 'Location Access Denied';
        }
      );
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', () => {
      renderPinnedGrid();
      updateStarButtons();
      setupStarClicks();
      setupGeoSort();
    });
  } else {
    renderPinnedGrid();
    updateStarButtons();
    setupStarClicks();
    setupGeoSort();
  }
</script>
