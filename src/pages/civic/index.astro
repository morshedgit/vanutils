---
import ToolLayout from '../../layouts/ToolLayout.astro';
import JsonLd from '../../components/shared/JsonLd.astro';
import PublicHearingBanner from '../../tools/civic-development/components/PublicHearingBanner.astro';
import FilterTabs from '../../tools/civic-development/components/FilterTabs.astro';
import ProposalCard from '../../tools/civic-development/components/ProposalCard.astro';
import { getLiveProposals, getCivicOverviewStats } from '../../tools/civic-development/services/civicService';

// Tiered Edge Cache: 1 hour edge TTL, 24 hour background revalidation
Astro.response.headers.set('Cache-Control', 'public, s-maxage=3600, stale-while-revalidate=86400');

const proposals = await getLiveProposals();
const stats = getCivicOverviewStats(proposals);

const civicSchema = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    name: 'Vancouver Development & Rezoning Radar — VanHeartbeat',
    description: 'Sub-second visibility into proposed towers, rezoning applications, below-market housing, and public hearing schedules across Vancouver.',
    url: 'https://vanheartbeat.ca/civic',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'VanHeartbeat', item: 'https://vanheartbeat.ca' },
      { '@type': 'ListItem', position: 2, name: 'Development & Rezoning Radar', item: 'https://vanheartbeat.ca/civic' },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: [
      {
        '@type': 'Question',
        name: 'What is the Broadway Plan in Vancouver and how does it affect rezoning?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'The Broadway Plan is a 30-year civic framework guiding rapid transit-oriented development along the Broadway Subway corridor (from Clark Drive to Vine Street), enabling high-density residential towers up to 30–40 storeys with secured rental and below-market housing requirements.',
        },
      },
      {
        '@type': 'Question',
        name: 'How can Vancouver residents participate in public hearings for rezoning applications?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'Residents can register to speak in person at City Hall or via telephone, or submit written comments directly to Mayor and Council through the City of Vancouver public hearing portal.',
        },
      },
      {
        '@type': 'Question',
        name: 'What does Floor Space Ratio (FSR) mean in Vancouver development proposals?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'Floor Space Ratio (FSR) is the ratio of total allowable building floor area to the site area. For example, an FSR of 10.0 on a 10,000 sq ft lot permits up to 100,000 sq ft of total interior building space.',
        },
      },
    ],
  },
];
---

<ToolLayout
  toolId="civic-development"
  title="Vancouver Development & Rezoning Radar"
  description="Sub-second visibility into proposed towers, rezoning applications, below-market housing, and public hearing schedules across Vancouver."
  currentPath="/civic"
  badgeText="Active Proposals"
  status="active"
>
  <JsonLd schema={civicSchema} />

  <div class="space-y-5 max-w-5xl mx-auto">
    <!-- Active Public Hearings Notice -->
    <PublicHearingBanner proposals={proposals} />

    <!-- Hero Stats & 1-Tap Geolocation Sorter -->
    <section class="rounded-2xl bg-slate-900 text-white p-4 sm:p-5 border border-slate-800 shadow-sm flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
      <div class="space-y-1">
        <div class="inline-flex items-center gap-2 px-2.5 py-0.5 rounded-full bg-emerald-500/20 text-emerald-300 text-xs font-semibold">
          <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
          <span>City of Vancouver Open Data • {stats.totalProposals} Active Applications</span>
        </div>
        <h2 class="text-base sm:text-lg font-bold tracking-tight text-white">
          Rezoning, Broadway Plan & Transit-Oriented Development Radar
        </h2>
        <p class="text-xs text-slate-300">
          Tracking {stats.totalUnits.toLocaleString()} proposed homes ({stats.belowMarketUnits.toLocaleString()} secured below-market/social units). Max height: {stats.highestStoreys} storeys.
        </p>
      </div>

      <!-- 1-Tap Geolocation Sorter -->
      <button
        type="button"
        id="geo-sort-civic-btn"
        class="inline-flex items-center justify-center gap-2 px-4 py-2.5 rounded-xl bg-sky-500 hover:bg-sky-400 text-white font-bold text-xs sm:text-sm shadow-md hover:shadow-lg transition-all shrink-0"
      >
        <span>📍</span>
        <span id="geo-civic-label">Find Developments Near Me</span>
      </button>
    </section>

    <!-- Pinned Proposals Section (Mirrors Home Dashboard Card) -->
    <div id="pinned-civic-section" class="p-3 sm:p-3.5 rounded-xl bg-slate-50 dark:bg-slate-900 border border-slate-200/80 dark:border-slate-800 space-y-2">
      <div class="flex items-center justify-between">
        <span class="text-xs font-bold text-slate-700 dark:text-slate-300 flex items-center gap-1.5">
          <span>⭐</span>
          <span>Pinned Corridors & Watchlist (Shown on Main Dashboard)</span>
        </span>
        <span class="text-[11px] text-slate-400">Click star on any proposal to customize</span>
      </div>
      <div id="pinned-civic-grid" class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-2">
        <!-- Dynamically populated via client JS -->
      </div>
    </div>

    <!-- Filter Tabs -->
    <FilterTabs activeTab="all" />

    <!-- Proposals Grid -->
    <div id="proposals-grid" class="grid grid-cols-1 md:grid-cols-2 gap-4">
      {proposals.map((proposal) => (
        <ProposalCard proposal={proposal} />
      ))}
    </div>

    <!-- FAQ Accordion for SEO & GEO -->
    <div class="p-6 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 shadow-xs space-y-4">
      <div class="flex items-center gap-2">
        <span class="text-xl">💬</span>
        <h2 class="text-base font-black text-slate-900 dark:text-white tracking-tight">
          Vancouver Development &amp; Rezoning: Frequently Asked Questions
        </h2>
      </div>

      <div class="space-y-3 text-xs leading-relaxed text-slate-600 dark:text-slate-400">
        <div class="p-3.5 rounded-xl bg-slate-50 dark:bg-slate-950/60 border border-slate-200/80 dark:border-slate-800 space-y-1">
          <h3 class="font-bold text-slate-900 dark:text-white text-xs">
            What is the Broadway Plan in Vancouver and how does it affect rezoning?
          </h3>
          <p>
            The Broadway Plan is a 30-year civic framework guiding rapid transit-oriented development along the Broadway Subway corridor (from Clark Drive to Vine Street), enabling high-density residential towers up to 30–40 storeys with secured rental and below-market housing requirements.
          </p>
        </div>

        <div class="p-3.5 rounded-xl bg-slate-50 dark:bg-slate-950/60 border border-slate-200/80 dark:border-slate-800 space-y-1">
          <h3 class="font-bold text-slate-900 dark:text-white text-xs">
            How can Vancouver residents participate in public hearings for rezoning applications?
          </h3>
          <p>
            Residents can register to speak in person at City Hall or via telephone, or submit written comments directly to Mayor and Council through the City of Vancouver public hearing portal.
          </p>
        </div>

        <div class="p-3.5 rounded-xl bg-slate-50 dark:bg-slate-950/60 border border-slate-200/80 dark:border-slate-800 space-y-1">
          <h3 class="font-bold text-slate-900 dark:text-white text-xs">
            What does Floor Space Ratio (FSR) mean in Vancouver development proposals?
          </h3>
          <p>
            Floor Space Ratio (FSR) is the ratio of total allowable building floor area to the site area. For example, an FSR of 10.0 on a 10,000 sq ft lot permits up to 100,000 sq ft of total interior building space.
          </p>
        </div>
      </div>
    </div>
  </div>
</ToolLayout>

<script is:inline define:vars={{ proposalsJson: JSON.stringify(proposals) }}>
  // Pinned Proposals Management
  const STORAGE_KEY = 'vanutils_pinned_civic-development';
  const DEFAULT_PINNED = ['RZ-2026-00018', 'RZ-2026-00042', 'RZ-2025-00109', 'RZ-2026-00029', 'DP-2025-00412', 'RZ-2026-00063'];

  function getPinnedIds() {
    try {
      const saved = localStorage.getItem(STORAGE_KEY);
      if (saved) return JSON.parse(saved);
    } catch (e) {}
    return DEFAULT_PINNED;
  }

  function savePinnedIds(ids) {
    localStorage.setItem(STORAGE_KEY, JSON.stringify(ids));
    window.dispatchEvent(new CustomEvent('vanutils:pinned-civic-changed', { detail: ids }));
  }

  function renderPinnedGrid() {
    const grid = document.getElementById('pinned-civic-grid');
    if (!grid) return;

    const pinnedIds = getPinnedIds();
    const allProposals = JSON.parse(proposalsJson || '[]');
    const pinned = allProposals.filter((p) => pinnedIds.includes(p.id));

    if (pinned.length === 0) {
      grid.innerHTML = '<p class="text-xs text-slate-400 py-1">No pinned proposals. Star any proposal below to add!</p>';
      return;
    }

    grid.innerHTML = pinned.map((p) => `
      <div class="flex items-center justify-between p-2 rounded-lg bg-white dark:bg-slate-800/80 border border-slate-200/80 dark:border-slate-700/60 text-xs">
        <div class="truncate pr-2 font-bold text-slate-900 dark:text-white">
          <a href="/civic/${p.id}" class="hover:text-sky-500">${p.address}</a>
          <span class="text-[10px] text-slate-400 block">${p.storeys} Storeys • ${p.units.totalUnits} Units</span>
        </div>
        <span class="shrink-0 font-bold text-[11px] text-sky-600 dark:text-sky-400">
          ${p.proposedFSR} FSR
        </span>
      </div>
    `).join('');
  }

  function updateStarButtons() {
    const pinnedIds = getPinnedIds();
    document.querySelectorAll('.star-btn[data-proposal-star-id]').forEach((btn) => {
      const id = btn.getAttribute('data-proposal-star-id');
      if (pinnedIds.includes(id)) {
        btn.classList.add('text-amber-400', 'dark:text-amber-400');
        btn.classList.remove('text-slate-300', 'dark:text-slate-600');
      } else {
        btn.classList.remove('text-amber-400', 'dark:text-amber-400');
        btn.classList.add('text-slate-300', 'dark:text-slate-600');
      }
    });
  }

  function setupStarClicks() {
    document.querySelectorAll('.star-btn[data-proposal-star-id]').forEach((btn) => {
      btn.addEventListener('click', (e) => {
        e.preventDefault();
        e.stopPropagation();
        const id = btn.getAttribute('data-proposal-star-id');
        let pinned = getPinnedIds();
        if (pinned.includes(id)) {
          pinned = pinned.filter((p) => p !== id);
        } else {
          pinned.push(id);
        }
        savePinnedIds(pinned);
        updateStarButtons();
        renderPinnedGrid();
      });
    });
  }

  // Haversine Distance
  function haversineKm(lat1, lon1, lat2, lon2) {
    const R = 6371;
    const dLat = (lat2 - lat1) * Math.PI / 180;
    const dLon = (lon2 - lon1) * Math.PI / 180;
    const a = Math.sin(dLat / 2) * Math.sin(dLat / 2) +
              Math.cos(lat1 * Math.PI / 180) * Math.cos(lat2 * Math.PI / 180) *
              Math.sin(dLon / 2) * Math.sin(dLon / 2);
    const c = 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1 - a));
    return R * c;
  }

  function setupGeoSort() {
    const btn = document.getElementById('geo-sort-civic-btn');
    const label = document.getElementById('geo-civic-label');
    const grid = document.getElementById('proposals-grid');

    if (!btn) return;

    btn.addEventListener('click', () => {
      if (!navigator.geolocation) {
        alert('Geolocation is not supported by your browser.');
        return;
      }

      label.textContent = 'Locating Closest Proposals...';
      navigator.geolocation.getCurrentPosition(
        (pos) => {
          const userLat = pos.coords.latitude;
          const userLng = pos.coords.longitude;
          label.textContent = 'Sorted by Proximity ✅';

          const cards = Array.from(document.querySelectorAll('.proposal-card'));
          cards.forEach((card) => {
            const lat = parseFloat(card.getAttribute('data-lat') || '0');
            const lng = parseFloat(card.getAttribute('data-lng') || '0');
            const km = haversineKm(userLat, userLng, lat, lng);
            card.setAttribute('data-distance', km.toFixed(2));
            const distLabel = card.querySelector('.proposal-distance-label');
            if (distLabel) distLabel.textContent = `📍 ${km < 1 ? Math.round(km * 1000) + 'm away' : km.toFixed(1) + ' km away'}`;
          });

          cards.sort((a, b) => {
            const distA = parseFloat(a.getAttribute('data-distance') || '0');
            const distB = parseFloat(b.getAttribute('data-distance') || '0');
            return distA - distB;
          });

          if (grid) {
            cards.forEach((card) => grid.appendChild(card));
          }
        },
        () => {
          label.textContent = 'Location Access Denied';
        }
      );
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', () => {
      renderPinnedGrid();
      updateStarButtons();
      setupStarClicks();
      setupGeoSort();
    });
  } else {
    renderPinnedGrid();
    updateStarButtons();
    setupStarClicks();
    setupGeoSort();
  }
</script>
