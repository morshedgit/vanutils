---
import ToolLayout from '../../layouts/ToolLayout.astro';
import JsonLd from '../../components/shared/JsonLd.astro';
import { getLiveProposals, getProposalById, getStatusMeta } from '../../tools/civic-development/services/civicService';

// Tiered Edge Cache: 1 hour edge TTL, 24 hour background revalidation
Astro.response.headers.set('Cache-Control', 'public, s-maxage=3600, stale-while-revalidate=86400');

const { id } = Astro.params;
const allProposals = await getLiveProposals();
const proposal = getProposalById(id || '', allProposals);

if (!proposal) {
  return Astro.redirect('/civic');
}

const statusMeta = getStatusMeta(proposal.status);

const proposalSchema = [
  {
    '@context': 'https://schema.org',
    '@type': 'GovernmentPermit',
    name: `Rezoning Application: ${proposal.address}`,
    description: `Proposal details, storeys, FSR density, unit mix, and public hearing schedule for ${proposal.address}.`,
    url: `https://vanheartbeat.ca/civic/${proposal.id}`,
    permitAudience: {
      '@type': 'AdministrativeArea',
      name: proposal.neighbourhood,
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'VanHeartbeat', item: 'https://vanheartbeat.ca' },
      { '@type': 'ListItem', position: 2, name: 'Development & Rezoning', item: 'https://vanheartbeat.ca/civic' },
      { '@type': 'ListItem', position: 3, name: proposal.address, item: `https://vanheartbeat.ca/civic/${proposal.id}` },
    ],
  },
];
---

<ToolLayout
  toolId="civic-development"
  title={`${proposal.address} — Development & Rezoning`}
  description={`Proposal details, storeys, FSR density, unit mix, and public hearing schedule for ${proposal.address}.`}
  currentPath={`/civic/${proposal.id}`}
  badgeText={`${proposal.storeys} Storeys`}
  status="active"
>
  <JsonLd schema={proposalSchema} />

  <div class="space-y-6 max-w-4xl mx-auto">
    <!-- 3-Tier Visual Breadcrumb Navigation -->
    <nav aria-label="Breadcrumb" class="flex items-center justify-between">
      <div class="flex items-center gap-2 text-xs font-semibold text-slate-500 dark:text-slate-400">
        <a href="/" class="hover:text-sky-600 dark:hover:text-sky-400 transition-colors">VanHeartbeat</a>
        <span>/</span>
        <a href="/civic" class="hover:text-sky-600 dark:hover:text-sky-400 transition-colors">Development Radar</a>
        <span>/</span>
        <span class="text-slate-900 dark:text-white truncate">{proposal.address}</span>
      </div>
      <span class="text-xs text-slate-400 font-mono">
        Application ID: {proposal.id}
      </span>
    </nav>

    <!-- Application Hero Header -->
    <section class="rounded-2xl bg-slate-900 text-white p-5 sm:p-6 border border-slate-800 shadow-sm flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
      <div class="space-y-1.5">
        <div class="flex items-center gap-2">
          <span class={`inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-xs font-bold border ${statusMeta.badgeBg}`}>
            <span class={`w-1.5 h-1.5 rounded-full ${statusMeta.dotColor}`}></span>
            <span>{statusMeta.label}</span>
          </span>
          <span class="text-xs text-slate-400">📍 {proposal.neighbourhood}</span>
        </div>
        <h2 class="text-xl sm:text-2xl font-black tracking-tight text-white">
          {proposal.address}
        </h2>
        <p class="text-xs text-slate-300">
          Applicant: {proposal.applicantName} • Type: {proposal.type.toUpperCase()}
        </p>
      </div>

      <div class="flex items-center gap-2 shrink-0">
        <button
          type="button"
          class="star-btn px-3 py-2 rounded-xl bg-slate-800 text-slate-300 hover:text-amber-400 text-xs font-bold border border-slate-700 transition-colors flex items-center gap-1.5"
          data-proposal-star-id={proposal.id}
        >
          <span>⭐</span>
          <span>Pin to Home</span>
        </button>
      </div>
    </section>

    <!-- Public Hearing Alert & Comment Submission (If Scheduled) -->
    {proposal.publicHearing?.submitCommentUrl && (
      <section class="p-4 sm:p-5 rounded-2xl bg-amber-500/10 dark:bg-amber-950/40 border-2 border-amber-500/40 space-y-3">
        <div class="flex items-start justify-between gap-2">
          <div class="space-y-1">
            <h3 class="font-bold text-amber-800 dark:text-amber-300 text-sm flex items-center gap-2">
              <span>🗳️</span>
              <span>City Council Public Hearing & Public Feedback</span>
            </h3>
            <p class="text-xs text-slate-700 dark:text-slate-300 leading-relaxed font-medium">
              {proposal.publicHearing.hearingDate ? (
                `Scheduled for ${new Date(proposal.publicHearing.hearingDate).toLocaleString([], { weekday: 'long', month: 'long', day: 'numeric', hour: '2-digit', minute: '2-digit' })}. Any resident or property owner may submit official written comments to Council or register to speak.`
              ) : (
                'Public comments and feedback can be submitted directly to Council via the City of Vancouver public portal.'
              )}
            </p>
          </div>
          <a
            href={proposal.publicHearing.submitCommentUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="px-4 py-2 rounded-xl bg-amber-600 hover:bg-amber-500 text-white font-bold text-xs shadow-sm hover:shadow-md transition-all shrink-0"
          >
            Submit Comment →
          </a>
        </div>
      </section>
    )}

    <!-- Building Scale & Metrics Grid -->
    <div class="grid grid-cols-2 sm:grid-cols-4 gap-3">
      <div class="p-4 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 shadow-xs">
        <span class="text-xs text-slate-500 dark:text-slate-400 block mb-1">Building Height</span>
        <div class="text-xl font-black text-slate-900 dark:text-white">
          {proposal.storeys} Storeys
        </div>
        <span class="text-[11px] text-slate-400">{proposal.heightMeters} meters</span>
      </div>

      <div class="p-4 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 shadow-xs">
        <span class="text-xs text-slate-500 dark:text-slate-400 block mb-1">Density / FSR</span>
        <div class="text-xl font-black text-slate-900 dark:text-white">
          {proposal.proposedFSR} FSR
        </div>
        <span class="text-[11px] text-slate-400">Existing: {proposal.existingFSR || 'N/A'}</span>
      </div>

      <div class="p-4 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 shadow-xs">
        <span class="text-xs text-slate-500 dark:text-slate-400 block mb-1">Total Homes</span>
        <div class="text-xl font-black text-emerald-600 dark:text-emerald-400">
          {proposal.units.totalUnits} Units
        </div>
        <span class="text-[11px] text-slate-400">Residential</span>
      </div>

      <div class="p-4 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 shadow-xs">
        <span class="text-xs text-slate-500 dark:text-slate-400 block mb-1">Commercial Space</span>
        <div class="text-xl font-black text-slate-900 dark:text-white">
          {proposal.commercialAreaSqFt.toLocaleString()} sq ft
        </div>
        <span class="text-[11px] text-slate-400">Ground Floor Retail</span>
      </div>
    </div>

    <!-- Unit Mix Breakdown -->
    <section class="p-5 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 shadow-xs space-y-4">
      <div class="border-b border-slate-100 dark:border-slate-800 pb-2">
        <h3 class="text-base font-bold text-slate-900 dark:text-white flex items-center gap-2">
          <span>🏠</span>
          <span>Proposed Housing Tenure & Affordability Mix</span>
        </h3>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
        <div class="p-3.5 rounded-xl bg-slate-50 dark:bg-slate-800/60 border border-slate-100 dark:border-slate-700/60">
          <span class="text-slate-500 dark:text-slate-400 block text-xs">Market Rental Housing</span>
          <span class="text-2xl font-black text-slate-900 dark:text-white">{proposal.units.marketRental}</span>
          <span class="text-[11px] text-slate-400 block mt-0.5">Secured long-term rental</span>
        </div>

        <div class="p-3.5 rounded-xl bg-emerald-500/10 dark:bg-emerald-950/30 border border-emerald-500/30">
          <span class="text-emerald-700 dark:text-emerald-300 block text-xs font-bold">Below-Market Rental (Secured)</span>
          <span class="text-2xl font-black text-emerald-600 dark:text-emerald-400">{proposal.units.belowMarketRental}</span>
          <span class="text-[11px] text-emerald-700/80 dark:text-emerald-300/80 block mt-0.5">20% below CMHC average rent</span>
        </div>

        <div class="p-3.5 rounded-xl bg-slate-50 dark:bg-slate-800/60 border border-slate-100 dark:border-slate-700/60">
          <span class="text-slate-500 dark:text-slate-400 block text-xs">Strata Ownership Condos</span>
          <span class="text-2xl font-black text-slate-900 dark:text-white">{proposal.units.strataCondo}</span>
          <span class="text-[11px] text-slate-400 block mt-0.5">Ownership units</span>
        </div>
      </div>
    </section>

    <!-- Official Documents & Architectural Plans -->
    <section class="p-5 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 shadow-xs space-y-3">
      <h3 class="text-sm font-bold text-slate-900 dark:text-white flex items-center gap-2">
        <span>📐</span>
        <span>Official Municipal Plans & Architectural Renderings</span>
      </h3>
      <div class="flex flex-wrap items-center gap-3">
        <a
          href={proposal.architecturalDrawingsUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="px-3.5 py-2 rounded-xl bg-slate-100 dark:bg-slate-800 hover:bg-sky-500 hover:text-white text-xs font-bold transition-colors"
        >
          View Shape Your City Presentation →
        </a>
        <a
          href={proposal.officialCityUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="px-3.5 py-2 rounded-xl bg-slate-100 dark:bg-slate-800 hover:bg-sky-500 hover:text-white text-xs font-bold transition-colors"
        >
          City of Vancouver Application Portal →
        </a>
      </div>
    </section>
  </div>
</ToolLayout>
