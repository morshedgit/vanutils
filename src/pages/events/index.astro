---
import ToolLayout from '../../layouts/ToolLayout.astro';
import FilterTabs from '../../tools/community-events/components/FilterTabs.astro';
import EventCard from '../../tools/community-events/components/EventCard.astro';
import { getLiveEvents, getEventsOverviewStats } from '../../tools/community-events/services/eventService';

// Tiered Edge Cache: 30-minute edge TTL, 2-hour background revalidation
Astro.response.headers.set('Cache-Control', 'public, s-maxage=1800, stale-while-revalidate=7200');

const events = await getLiveEvents();
const stats = getEventsOverviewStats(events);
---

<ToolLayout
  toolId="community-events"
  title="Free & Local Community Events Radar"
  description="Sub-second radar for 100% free, all-ages, and family-friendly local street festivals, outdoor movies, and community events across Metro Vancouver."
  currentPath="/events"
  badgeText="100% Free Events"
  status="active"
>
  <div class="space-y-5 max-w-5xl mx-auto">
    <!-- Hero Stats & 1-Tap Geolocation Sorter -->
    <section class="rounded-2xl bg-slate-900 text-white p-4 sm:p-5 border border-slate-800 shadow-sm flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
      <div class="space-y-1">
        <div class="inline-flex items-center gap-2 px-2.5 py-0.5 rounded-full bg-emerald-500/20 text-emerald-300 text-xs font-semibold">
          <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
          <span>Verified Non-Commercial • {stats.totalEvents} Free Events</span>
        </div>
        <h2 class="text-base sm:text-lg font-bold tracking-tight text-white">
          Free Local Festivals, Park Movies & Community Happenings
        </h2>
        <p class="text-xs text-slate-300">
          Filtered from Vancouver Park Board, VPL, and Special Events permits. No paywalls, no ads.
        </p>
      </div>

      <!-- 1-Tap Geolocation Sorter -->
      <button
        type="button"
        id="geo-sort-events-btn"
        class="inline-flex items-center justify-center gap-2 px-4 py-2.5 rounded-xl bg-sky-500 hover:bg-sky-400 text-white font-bold text-xs sm:text-sm shadow-md hover:shadow-lg transition-all shrink-0"
      >
        <span>📍</span>
        <span id="geo-events-label">Find Events Near Me</span>
      </button>
    </section>

    <!-- Pinned Events Section (Mirrors Home Dashboard Card) -->
    <div id="pinned-events-section" class="p-3 sm:p-3.5 rounded-xl bg-slate-50 dark:bg-slate-900 border border-slate-200/80 dark:border-slate-800 space-y-2">
      <div class="flex items-center justify-between">
        <span class="text-xs font-bold text-slate-700 dark:text-slate-300 flex items-center gap-1.5">
          <span>⭐</span>
          <span>Pinned Events (Shown on Main Dashboard)</span>
        </span>
        <span class="text-[11px] text-slate-400">Click star on any event to customize</span>
      </div>
      <div id="pinned-events-grid" class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-2">
        <!-- Dynamically populated via client JS -->
      </div>
    </div>

    <!-- Filter Tabs -->
    <FilterTabs activeTab="all" />

    <!-- Events Grid -->
    <div id="events-grid" class="grid grid-cols-1 md:grid-cols-2 gap-4">
      {events.map((event) => (
        <EventCard event={event} />
      ))}
    </div>
  </div>
</ToolLayout>

<script is:inline define:vars={{ eventsJson: JSON.stringify(events) }}>
  // Pinned Events Management
  const STORAGE_KEY = 'vanutils_pinned_community-events';
  const DEFAULT_PINNED = [
    'car-free-day-commercial-drive',
    'stanley-park-summer-cinema',
    'kitsilano-farmers-market',
    'vpl-author-talk-central',
    'greek-day-on-broadway',
    'trout-lake-free-community-skate'
  ];

  function getPinnedIds() {
    try {
      const saved = localStorage.getItem(STORAGE_KEY);
      if (saved) return JSON.parse(saved);
    } catch (e) {}
    return DEFAULT_PINNED;
  }

  function savePinnedIds(ids) {
    localStorage.setItem(STORAGE_KEY, JSON.stringify(ids));
    window.dispatchEvent(new CustomEvent('vanutils:pinned-events-changed', { detail: ids }));
  }

  function renderPinnedGrid() {
    const grid = document.getElementById('pinned-events-grid');
    if (!grid) return;

    const pinnedIds = getPinnedIds();
    const allEvents = JSON.parse(eventsJson || '[]');
    const pinned = allEvents.filter((e) => pinnedIds.includes(e.id));

    if (pinned.length === 0) {
      grid.innerHTML = '<p class="text-xs text-slate-400 py-1">No pinned events. Star any event below to add!</p>';
      return;
    }

    grid.innerHTML = pinned.map((e) => {
      const d = new Date(e.startDateTime);
      return `
        <div class="flex items-center justify-between p-2 rounded-lg bg-white dark:bg-slate-800/80 border border-slate-200/80 dark:border-slate-700/60 text-xs">
          <div class="truncate pr-2 font-bold text-slate-900 dark:text-white">
            <a href="/events/${e.id}" class="hover:text-sky-500">${e.title}</a>
            <span class="text-[10px] text-slate-400 block">${e.neighbourhood}</span>
          </div>
          <span class="shrink-0 font-bold text-[11px] text-emerald-600 dark:text-emerald-400">
            ${d.toLocaleDateString([], { weekday: 'short', month: 'numeric', day: 'numeric' })}
          </span>
        </div>
      `;
    }).join('');
  }

  function updateStarButtons() {
    const pinnedIds = getPinnedIds();
    document.querySelectorAll('.star-btn[data-event-star-id]').forEach((btn) => {
      const id = btn.getAttribute('data-event-star-id');
      if (pinnedIds.includes(id)) {
        btn.classList.add('text-amber-400', 'dark:text-amber-400');
        btn.classList.remove('text-slate-300', 'dark:text-slate-600');
      } else {
        btn.classList.remove('text-amber-400', 'dark:text-amber-400');
        btn.classList.add('text-slate-300', 'dark:text-slate-600');
      }
    });
  }

  function setupStarClicks() {
    document.querySelectorAll('.star-btn[data-event-star-id]').forEach((btn) => {
      btn.addEventListener('click', (e) => {
        e.preventDefault();
        e.stopPropagation();
        const id = btn.getAttribute('data-event-star-id');
        let pinned = getPinnedIds();
        if (pinned.includes(id)) {
          pinned = pinned.filter((p) => p !== id);
        } else {
          pinned.push(id);
        }
        savePinnedIds(pinned);
        updateStarButtons();
        renderPinnedGrid();
      });
    });
  }

  // Haversine Distance
  function haversineKm(lat1, lon1, lat2, lon2) {
    const R = 6371;
    const dLat = (lat2 - lat1) * Math.PI / 180;
    const dLon = (lon2 - lon1) * Math.PI / 180;
    const a = Math.sin(dLat / 2) * Math.sin(dLat / 2) +
              Math.cos(lat1 * Math.PI / 180) * Math.cos(lat2 * Math.PI / 180) *
              Math.sin(dLon / 2) * Math.sin(dLon / 2);
    const c = 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1 - a));
    return R * c;
  }

  function setupGeoSort() {
    const btn = document.getElementById('geo-sort-events-btn');
    const label = document.getElementById('geo-events-label');
    const grid = document.getElementById('events-grid');

    if (!btn) return;

    btn.addEventListener('click', () => {
      if (!navigator.geolocation) {
        alert('Geolocation is not supported by your browser.');
        return;
      }

      label.textContent = 'Locating Closest Events...';
      navigator.geolocation.getCurrentPosition(
        (pos) => {
          const userLat = pos.coords.latitude;
          const userLng = pos.coords.longitude;
          label.textContent = 'Sorted by Proximity ✅';

          const cards = Array.from(document.querySelectorAll('.event-card'));
          cards.forEach((card) => {
            const lat = parseFloat(card.getAttribute('data-lat') || '0');
            const lng = parseFloat(card.getAttribute('data-lng') || '0');
            const km = haversineKm(userLat, userLng, lat, lng);
            card.setAttribute('data-distance', km.toFixed(2));
            const distLabel = card.querySelector('.event-distance-label');
            if (distLabel) distLabel.textContent = `📍 ${km < 1 ? Math.round(km * 1000) + 'm away' : km.toFixed(1) + ' km away'}`;
          });

          cards.sort((a, b) => {
            const distA = parseFloat(a.getAttribute('data-distance') || '0');
            const distB = parseFloat(b.getAttribute('data-distance') || '0');
            return distA - distB;
          });

          if (grid) {
            cards.forEach((card) => grid.appendChild(card));
          }
        },
        () => {
          label.textContent = 'Location Access Denied';
        }
      );
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', () => {
      renderPinnedGrid();
      updateStarButtons();
      setupStarClicks();
      setupGeoSort();
    });
  } else {
    renderPinnedGrid();
    updateStarButtons();
    setupStarClicks();
    setupGeoSort();
  }
</script>
