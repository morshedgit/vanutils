---
import ToolLayout from '../../layouts/ToolLayout.astro';
import JsonLd from '../../components/shared/JsonLd.astro';
import LiveDataUnavailable from '../../components/shared/LiveDataUnavailable.astro';
import { getLiveEvents, getEventById, getCategoryMeta, BASELINE_EVENTS } from '../../tools/community-events/services/eventService';

// Tiered Edge Cache: 30-minute edge TTL, 2-hour background revalidation
Astro.response.headers.set('Cache-Control', 'public, s-maxage=1800, stale-while-revalidate=7200');

const { event: eventId } = Astro.params;

// Baseline lookup is metadata-only (title/venue) so an unknown id still 404s
// even when the live upstream is down; it is never used for telemetry values.
const eventMeta = getEventById(eventId || '', BASELINE_EVENTS);
if (!eventMeta) {
  return Astro.redirect('/events');
}

const eventsResult = await getLiveEvents();
const event = eventsResult.ok ? getEventById(eventId || '', eventsResult.data) : undefined;
const catMeta = event ? getCategoryMeta(event.category) : null;
const startDate = event ? new Date(event.startDateTime) : null;
const endDate = event ? new Date(event.endDateTime) : null;

const eventSchema = [
  {
    '@context': 'https://schema.org',
    '@type': 'Event',
    name: eventMeta.title,
    description: eventMeta.shortDescription,
    startDate: eventMeta.startDateTime,
    endDate: eventMeta.endDateTime,
    isAccessibleForFree: true,
    location: {
      '@type': 'Place',
      name: eventMeta.venueName,
      address: {
        '@type': 'PostalAddress',
        streetAddress: eventMeta.address,
        addressLocality: eventMeta.neighbourhood,
        addressRegion: 'BC',
        addressCountry: 'CA',
      },
    },
    organizer: {
      '@type': 'Organization',
      name: eventMeta.organization,
    },
    url: `https://vanheartbeat.ca/events/${eventMeta.id}`,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'VanHeartbeat', item: 'https://vanheartbeat.ca' },
      { '@type': 'ListItem', position: 2, name: 'Community Events', item: 'https://vanheartbeat.ca/events' },
      { '@type': 'ListItem', position: 3, name: eventMeta.title, item: `https://vanheartbeat.ca/events/${eventMeta.id}` },
    ],
  },
];
---

<ToolLayout
  toolId="community-events"
  title={`${eventMeta.title} — Free Community Event`}
  description={`Schedule, venue location, transit directions, and admission details for ${eventMeta.title}.`}
  currentPath={`/events/${eventMeta.id}`}
  badgeText={event ? '100% Free Admission' : 'Live Data Unavailable'}
  status="active"
>
  <JsonLd schema={eventSchema} />

  <div class="space-y-6 max-w-4xl mx-auto">
    <!-- 3-Tier Visual Breadcrumb Navigation -->
    <nav aria-label="Breadcrumb" class="flex items-center justify-between">
      <div class="flex items-center gap-2 text-xs font-semibold text-slate-500 dark:text-slate-400">
        <a href="/" class="hover:text-sky-600 dark:hover:text-sky-400 transition-colors">VanHeartbeat</a>
        <span>/</span>
        <a href="/events" class="hover:text-sky-600 dark:hover:text-sky-400 transition-colors">Events Radar</a>
        <span>/</span>
        <span class="text-slate-900 dark:text-white truncate">{eventMeta.title}</span>
      </div>
      <span class="text-xs text-slate-400">
        Hosted by {eventMeta.organization}
      </span>
    </nav>

    {!event && (
      <LiveDataUnavailable toolName={`${eventMeta.title}`} variant="page" error={!eventsResult.ok ? eventsResult.error : undefined} />
    )}

    <!-- Event Hero Header -->
    {event && catMeta && startDate && endDate && (
    <>
    <section class="rounded-2xl bg-slate-900 text-white p-5 sm:p-6 border border-slate-800 shadow-sm flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
      <div class="space-y-1.5">
        <div class="flex items-center gap-2">
          <span class={`inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-xs font-bold border ${catMeta.badgeBg}`}>
            <span>{catMeta.icon}</span>
            <span>{catMeta.label}</span>
          </span>
          <span class="px-2.5 py-0.5 rounded-full text-xs font-bold bg-emerald-500/20 text-emerald-300 border border-emerald-500/30">
            ✓ 100% Free
          </span>
          {event.isAllAges && (
            <span class="text-xs text-slate-400">👨‍👩‍👧 All Ages / Family</span>
          )}
        </div>
        <h2 class="text-xl sm:text-2xl font-black tracking-tight text-white">
          {event.title}
        </h2>
        <p class="text-xs text-slate-300">
          📍 {event.venueName} • {event.neighbourhood}
        </p>
      </div>

      <div class="flex items-center gap-2 shrink-0">
        <button
          type="button"
          class="star-btn px-3 py-2 rounded-xl bg-slate-800 text-slate-300 hover:text-amber-400 text-xs font-bold border border-slate-700 transition-colors flex items-center gap-1.5"
          data-event-star-id={event.id}
        >
          <span>⭐</span>
          <span>Pin to Home</span>
        </button>
      </div>
    </section>

    <!-- Schedule & Weather Banner -->
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
      <div class="p-4 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 shadow-xs">
        <span class="text-xs text-slate-500 dark:text-slate-400 block mb-1">Date & Time</span>
        <div class="text-base font-bold text-slate-900 dark:text-white">
          {startDate.toLocaleDateString([], { weekday: 'short', month: 'short', day: 'numeric', timeZone: 'America/Vancouver' })}
        </div>
        <span class="text-xs text-slate-500 dark:text-slate-400">
          {startDate.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit', timeZone: 'America/Vancouver' })} – {endDate.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit', timeZone: 'America/Vancouver' })}
        </span>
      </div>

      <div class="p-4 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 shadow-xs">
        <span class="text-xs text-slate-500 dark:text-slate-400 block mb-1">Weather Policy</span>
        <div class="text-base font-bold text-sky-600 dark:text-sky-400">
          {event.rainOrShine ? '☔ Rain or Shine' : '☀️ Weather Permitting'}
        </div>
        <span class="text-xs text-slate-500 dark:text-slate-400">
          {event.isOutdoor ? 'Outdoor Venue' : 'Indoor Venue'}
        </span>
      </div>

      <div class="p-4 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 shadow-xs">
        <span class="text-xs text-slate-500 dark:text-slate-400 block mb-1">Admission</span>
        <div class="text-base font-bold text-emerald-600 dark:text-emerald-400">
          Free Public Admission
        </div>
        <span class="text-xs text-slate-500 dark:text-slate-400">
          No registration or tickets required
        </span>
      </div>
    </div>

    <!-- Description & Overview -->
    <section class="p-5 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 shadow-xs space-y-3">
      <h3 class="text-sm font-bold text-slate-900 dark:text-white flex items-center gap-2">
        <span>📖</span>
        <span>About this Event</span>
      </h3>
      <p class="text-sm text-slate-700 dark:text-slate-300 leading-relaxed">
        {event.shortDescription}
      </p>
    </section>

    <!-- Transit & Active Transportation -->
    <section class="p-5 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 shadow-xs space-y-3">
      <h3 class="text-sm font-bold text-slate-900 dark:text-white flex items-center gap-2">
        <span>🚇</span>
        <span>Getting There & Public Transit</span>
      </h3>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 text-xs">
        <div class="p-3 rounded-xl bg-slate-50 dark:bg-slate-800/60 border border-slate-100 dark:border-slate-700/60">
          <span class="text-slate-500 dark:text-slate-400 block text-[11px] mb-1">SkyTrain & Rapid Transit:</span>
          <span class="font-bold text-slate-900 dark:text-white">{event.transitAccess.nearestSkyTrainStation || 'Transit Corridor'}</span>
        </div>
        <div class="p-3 rounded-xl bg-slate-50 dark:bg-slate-800/60 border border-slate-100 dark:border-slate-700/60">
          <span class="text-slate-500 dark:text-slate-400 block text-[11px] mb-1">TransLink Bus Connections:</span>
          <span class="font-bold text-slate-900 dark:text-white">{event.transitAccess.busRoutes.join(', ')}</span>
        </div>
      </div>
    </section>

    <!-- Official Links & Navigation -->
    <div class="flex flex-wrap items-center gap-3 pt-2">
      <a
        href={`https://maps.google.com/?q=${event.latitude},${event.longitude}`}
        target="_blank"
        rel="noopener noreferrer"
        class="px-4 py-2 rounded-xl bg-sky-500 hover:bg-sky-400 text-white font-bold text-xs shadow-sm transition-colors"
      >
        Open in Google Maps →
      </a>
      <a
        href={event.officialSourceUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="px-4 py-2 rounded-xl bg-slate-100 dark:bg-slate-800 hover:bg-slate-200 dark:hover:bg-slate-700 text-slate-700 dark:text-slate-300 font-bold text-xs transition-colors"
      >
        Official Host Page ({event.organization}) →
      </a>
    </div>
    </>
    )}
  </div>
</ToolLayout>
