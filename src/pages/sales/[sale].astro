---
import PlatformLayout from '../../layouts/PlatformLayout.astro';
import { getSalesEventBySlug } from '../../tools/sales-events/services/salesService';
import LineupAdvisor from '../../tools/sales-events/components/LineupAdvisor.astro';
import ScheduleTable from '../../tools/sales-events/components/ScheduleTable.astro';
import CalendarButton from '../../tools/sales-events/components/CalendarButton.astro';

// Edge SSR caching policy
Astro.response.headers.set('Cache-Control', 'public, s-maxage=1800, stale-while-revalidate=7200');

const { sale: saleSlug } = Astro.params;

if (!saleSlug) {
  return Astro.redirect('/sales');
}

const sale = await getSalesEventBySlug(saleSlug);

if (!sale) {
  return Astro.redirect('/sales');
}

const saleSchema = [
  {
    '@context': 'https://schema.org',
    '@type': 'SaleEvent',
    name: sale.name,
    description: `${sale.name} featuring ${sale.discountRange} on ${sale.brand} at ${sale.venueName}.`,
    startDate: sale.startDate,
    endDate: sale.endDate,
    eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode',
    eventStatus: 'https://schema.org/EventScheduled',
    location: {
      '@type': 'Place',
      name: sale.venueName,
      address: {
        '@type': 'PostalAddress',
        streetAddress: sale.venueAddress,
        addressLocality: sale.municipality,
        addressRegion: 'BC',
        addressCountry: 'CA',
      },
      geo: {
        '@type': 'GeoCoordinates',
        latitude: sale.latitude,
        longitude: sale.longitude,
      },
    },
    organizer: {
      '@type': 'Organization',
      name: sale.brand,
      url: sale.officialSourceUrl,
    },
    offers: {
      '@type': 'Offer',
      price: '0',
      priceCurrency: 'CAD',
      availability: 'https://schema.org/InStock',
      url: sale.ticketUrl || sale.officialSourceUrl,
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'VanHeartbeat', item: 'https://vanheartbeat.ca' },
      { '@type': 'ListItem', position: 2, name: 'Warehouse Sales', item: 'https://vanheartbeat.ca/sales' },
      { '@type': 'ListItem', position: 3, name: sale.name, item: `https://vanheartbeat.ca/sales/${sale.id}` },
    ],
  },
];
---

<PlatformLayout
  title={`${sale.name} (${sale.startDate}–${sale.endDate}) | VanHeartbeat`}
  description={`Dates, lineup advice, bag policy, discounts & parking for ${sale.name} at ${sale.venueName}.`}
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(saleSchema)} />

  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-6 sm:py-8 space-y-6">
    <!-- Breadcrumb Navigation -->
    <nav class="flex items-center gap-2 text-xs text-slate-500 dark:text-slate-400">
      <a href="/" class="hover:text-sky-500 transition-colors">VanHeartbeat</a>
      <span>/</span>
      <a href="/sales" class="hover:text-sky-500 transition-colors">Sales Radar</a>
      <span>/</span>
      <span class="text-slate-800 dark:text-slate-200 font-semibold truncate">{sale.name}</span>
    </nav>

    <!-- Header Banner Card -->
    <div class="p-5 sm:p-6 rounded-2xl sm:rounded-3xl bg-white dark:bg-slate-900/90 border border-slate-200/90 dark:border-slate-800 shadow-xs space-y-4">
      <div class="flex flex-col sm:flex-row sm:items-start justify-between gap-4">
        <div>
          <div class="flex items-center gap-2 mb-1.5">
            <span class="px-2.5 py-0.5 rounded-full text-xs font-extrabold bg-sky-500/10 text-sky-700 dark:text-sky-300 border border-sky-500/20">
              {sale.brand}
            </span>
            <span class="px-2.5 py-0.5 rounded-full text-xs font-extrabold bg-rose-500/10 text-rose-700 dark:text-rose-300 border border-rose-500/20">
              {sale.discountRange}
            </span>
          </div>

          <h1 class="text-2xl sm:text-3xl font-black text-slate-900 dark:text-white tracking-tight">
            {sale.name}
          </h1>

          <p class="text-sm text-slate-600 dark:text-slate-400 mt-1">
            📍 {sale.venueName} • {sale.venueAddress}
          </p>
        </div>

        <!-- 1-Tap Calendar Export -->
        <CalendarButton sale={sale} />
      </div>

      <!-- Quick Metrics Strip -->
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 pt-3 border-t border-slate-100 dark:border-slate-800/80 text-xs">
        <div>
          <span class="text-[10px] text-slate-400 font-bold uppercase block">Dates</span>
          <span class="font-bold text-slate-900 dark:text-white">{sale.startDate} – {sale.endDate}</span>
        </div>
        <div>
          <span class="text-[10px] text-slate-400 font-bold uppercase block">Entry Requirement</span>
          <span class="font-bold text-slate-900 dark:text-white capitalize">{sale.entryType.replace('_', ' ')}</span>
        </div>
        <div>
          <span class="text-[10px] text-slate-400 font-bold uppercase block">Payment Accepted</span>
          <span class="font-bold text-slate-900 dark:text-white">
            {sale.paymentPolicy === 'credit_debit_only' ? 'Cards Only (No Cash)' : 'Cash & Cards'}
          </span>
        </div>
        <div>
          <span class="text-[10px] text-slate-400 font-bold uppercase block">Transit Proximity</span>
          <span class="font-bold text-sky-600 dark:text-sky-400">SkyTrain / Bus</span>
        </div>
      </div>
    </div>

    <!-- Lineup Dynamics & Venue Guidelines -->
    <LineupAdvisor sale={sale} />

    <!-- Operating Hours Breakdown -->
    <ScheduleTable schedule={sale.schedule} />

    <!-- Featured Product Focus -->
    <div class="p-4 sm:p-5 rounded-2xl bg-white dark:bg-slate-900/90 border border-slate-200/90 dark:border-slate-800 space-y-3">
      <div class="flex items-center gap-2">
        <span class="text-lg">🛍️</span>
        <h3 class="text-sm sm:text-base font-bold text-slate-900 dark:text-white">
          Featured Product Lines &amp; Inventory Focus
        </h3>
      </div>
      <div class="flex flex-wrap gap-2">
        {sale.featuredItems.map((item) => (
          <span class="px-3 py-1.5 rounded-xl bg-slate-100 dark:bg-slate-800/80 border border-slate-200/60 dark:border-slate-700/60 text-xs font-semibold text-slate-800 dark:text-slate-200">
            {item}
          </span>
        ))}
      </div>
    </div>

    <!-- Venue Location & Transit Guide -->
    <div class="p-4 sm:p-5 rounded-2xl bg-white dark:bg-slate-900/90 border border-slate-200/90 dark:border-slate-800 space-y-3">
      <div class="flex items-center justify-between">
        <div class="flex items-center gap-2">
          <span class="text-lg">🗺️</span>
          <h3 class="text-sm sm:text-base font-bold text-slate-900 dark:text-white">
            Location, Transit &amp; Parking
          </h3>
        </div>
        <a
          href={`https://maps.google.com/?q=${sale.latitude},${sale.longitude}`}
          target="_blank"
          rel="noopener noreferrer"
          class="text-xs font-bold text-sky-600 dark:text-sky-400 hover:underline flex items-center gap-1"
        >
          <span>Open Google Maps</span>
          <span>↗</span>
        </a>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 text-xs">
        <div class="p-3 rounded-xl bg-slate-50 dark:bg-slate-950/60 border border-slate-100 dark:border-slate-800/80 space-y-1">
          <span class="font-bold text-slate-700 dark:text-slate-300 block">🚇 Public Transit Access</span>
          <p class="text-slate-600 dark:text-slate-400">{sale.transitAccess}</p>
        </div>
        <div class="p-3 rounded-xl bg-slate-50 dark:bg-slate-950/60 border border-slate-100 dark:border-slate-800/80 space-y-1">
          <span class="font-bold text-slate-700 dark:text-slate-300 block">🅿️ Parking Options</span>
          <p class="text-slate-600 dark:text-slate-400">{sale.parkingInfo}</p>
        </div>
      </div>
    </div>

    <!-- Official Source Verification Link -->
    <div class="p-4 rounded-2xl bg-slate-100 dark:bg-slate-800/60 flex items-center justify-between text-xs text-slate-600 dark:text-slate-400">
      <span>Verified against official venue bookings and brand event notices.</span>
      <a
        href={sale.officialSourceUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="font-bold text-slate-900 dark:text-white hover:text-sky-500 transition-colors flex items-center gap-1"
      >
        <span>Official Source</span>
        <span>↗</span>
      </a>
    </div>
  </div>
</PlatformLayout>
