---
import PlatformLayout from '../../layouts/PlatformLayout.astro';
import JsonLd from '../../components/shared/JsonLd.astro';
import RelatedTelemetry, { type RelatedItem } from '../../components/shared/RelatedTelemetry.astro';
import { getTeamById, getLiveSportsTeams } from '../../tools/sports-teams/services/sportsTeamsService';
import FormBadge from '../../tools/sports-teams/components/FormBadge.astro';
import TransitGuide from '../../tools/sports-teams/components/TransitGuide.astro';

const { team: teamId } = Astro.params;
const { teams } = await getLiveSportsTeams();
const team = getTeamById(teamId || '', teams);

if (!team) {
  return Astro.redirect('/sports-teams');
}

// Edge cache for 1 minute
Astro.response.headers.set('Cache-Control', 'public, s-maxage=60, stale-while-revalidate=120');

const otherTeams = teams.filter((t) => t.id !== team.id);

const wikidataTeamMap: Record<string, string[]> = {
  canucks: ['https://en.wikipedia.org/wiki/Vancouver_Canucks', 'https://www.wikidata.org/wiki/Q192525'],
  whitecaps: ['https://en.wikipedia.org/wiki/Vancouver_Whitecaps_FC', 'https://www.wikidata.org/wiki/Q639891'],
  lions: ['https://en.wikipedia.org/wiki/BC_Lions', 'https://www.wikidata.org/wiki/Q795761'],
  canadians: ['https://en.wikipedia.org/wiki/Vancouver_Canadians', 'https://www.wikidata.org/wiki/Q1474288'],
  giants: ['https://en.wikipedia.org/wiki/Vancouver_Giants', 'https://www.wikidata.org/wiki/Q1429031'],
  bandits: ['https://en.wikipedia.org/wiki/Vancouver_Bandits', 'https://www.wikidata.org/wiki/Q55075073'],
  rise: ['https://en.wikipedia.org/wiki/Vancouver_Rise_FC', 'https://www.wikidata.org/wiki/Q126284379'],
};

const teamSchema = [
  {
    '@context': 'https://schema.org',
    '@type': 'SportsTeam',
    name: team.name,
    sport: team.sport,
    memberOf: {
      '@type': 'SportsOrganization',
      name: team.leagueFullName,
    },
    sameAs: wikidataTeamMap[team.id] || [],
    homeLocation: {
      '@type': 'Place',
      name: team.venue.name,
      address: {
        '@type': 'PostalAddress',
        streetAddress: team.venue.address,
        addressLocality: 'Vancouver',
        addressRegion: 'BC',
        addressCountry: 'CA',
      },
    },
    url: `https://vanheartbeat.ca/sports-teams/${team.id}`,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'VanHeartbeat', item: 'https://vanheartbeat.ca' },
      { '@type': 'ListItem', position: 2, name: 'Sports Teams', item: 'https://vanheartbeat.ca/sports-teams' },
      { '@type': 'ListItem', position: 3, name: team.name, item: `https://vanheartbeat.ca/sports-teams/${team.id}` },
    ],
  },
];

const relatedItems: RelatedItem[] = [
  {
    title: 'Downtown Event Parking',
    subtitle: 'Car-share permit zones & rush-hour towing',
    href: '/parking',
    badge: 'Parking',
    icon: '🚗',
  },
  {
    title: 'TransLink & Civic News',
    subtitle: 'Stadium SkyTrain service alerts & updates',
    href: '/news',
    badge: 'Wire',
    icon: '📰',
  },
  {
    title: 'Free Community Events',
    subtitle: 'Pre-game festivals & Vancouver fan zones',
    href: '/events',
    badge: 'Events',
    icon: '🎉',
  },
];
---

<PlatformLayout
  title={`${team.name} Schedule, Scores & Standings — VanHeartbeat`}
  description={`Live scores, complete game schedule, standings, 5-game form, and TV/radio broadcast channels for the ${team.name} (${team.league}).`}
  currentPath={`/sports-teams/${team.id}`}
>
  <JsonLd schema={teamSchema} />

  <div class="space-y-8 max-w-5xl mx-auto py-4 sm:py-6">
    <!-- Breadcrumb Navigation -->
    <div class="flex items-center justify-between gap-4">
      <nav class="flex items-center gap-2 text-xs font-semibold text-slate-500 dark:text-slate-400">
        <a href="/" class="hover:text-sky-600 dark:hover:text-sky-400 transition-colors">VanHeartbeat</a>
        <span>/</span>
        <a href="/sports-teams" class="hover:text-sky-600 dark:hover:text-sky-400 transition-colors">Sports Teams</a>
        <span>/</span>
        <span class="text-slate-900 dark:text-white truncate">{team.name}</span>
      </nav>

      <a
        href="/sports-teams"
        class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full text-xs font-semibold bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 text-slate-700 dark:text-slate-300 hover:bg-slate-50 dark:hover:bg-slate-800 transition-all shadow-xs"
      >
        <span>← All Teams</span>
      </a>
    </div>

    <!-- Team Hero Card -->
    <div class="relative overflow-hidden rounded-3xl bg-gradient-to-br from-white via-sky-50/40 to-slate-50 dark:from-slate-900 dark:via-sky-950/20 dark:to-slate-900 border border-slate-200/80 dark:border-slate-800 p-4 sm:p-6 lg:p-8 shadow-xs">
      <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-6 relative z-10">
        <div class="flex items-start gap-4">
          <span class="text-5xl sm:text-6xl drop-shadow-md shrink-0">{team.emoji}</span>
          <div class="space-y-1.5">
            <div class="flex items-center gap-2">
              <span class="px-2.5 py-0.5 rounded text-[10px] font-black uppercase tracking-wider bg-slate-900 text-white dark:bg-white dark:text-slate-900">
                {team.league}
              </span>
              <span class="text-xs text-slate-500 font-bold">{team.seasonYear} Season</span>
            </div>
            <h1 class="text-2xl sm:text-4xl font-black text-slate-900 dark:text-white tracking-tight">
              {team.name}
            </h1>
            <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-400">
              {team.standings.divisionOrConf} • <span class="font-bold text-slate-900 dark:text-white">{team.standings.record}</span> ({team.standings.points} pts)
            </p>
          </div>
        </div>

        <div class="flex flex-col items-start sm:items-end gap-2 bg-white/80 dark:bg-slate-950/60 p-4 rounded-2xl border border-slate-200/80 dark:border-slate-800 shrink-0">
          <div class="text-xs font-bold text-slate-500 uppercase">Recent Form</div>
          <div class="flex items-center gap-1.5">
            {team.standings.formLast5.map((res) => (
              <FormBadge result={res} size="md" />
            ))}
          </div>
          <div class="text-[11px] text-emerald-600 dark:text-emerald-400 font-bold">
            Streak: {team.standings.streak}
          </div>
        </div>
      </div>
    </div>

    <!-- Next Game Marquee Card -->
    {team.nextGame ? (
      <div class="p-6 rounded-2xl bg-gradient-to-r from-sky-900 via-indigo-950 to-slate-900 text-white border border-sky-700/40 shadow-sm space-y-4">
        <div class="flex items-center justify-between">
          <div class="flex items-center gap-2">
            <span class="text-xl">⚡</span>
            <h2 class="text-sm font-black uppercase tracking-wider text-sky-400">
              Next Scheduled Matchup
            </h2>
            {team.nextGame.rivalryMatchup && (
              <span class="px-2 py-0.5 rounded bg-amber-500/20 text-amber-300 text-[10px] font-bold">RIVALRY</span>
            )}
          </div>
          <span class="text-xs font-mono bg-sky-500/20 px-2.5 py-1 rounded text-sky-300">
            {team.nextGame.startTimePST}
          </span>
        </div>

        <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 border-y border-white/10 py-4">
          <div>
            <div class="text-xs text-slate-400">Opponent</div>
            <div class="text-xl font-black text-white flex items-center gap-2">
              <span>vs {team.nextGame.opponent.name}</span>
              {team.nextGame.opponent.record && (
                <span class="text-sm font-normal text-slate-300">({team.nextGame.opponent.record})</span>
              )}
            </div>
            <div class="text-xs text-sky-200 mt-1">
              📍 {team.nextGame.venueName} • {team.nextGame.isHome ? 'Home Game' : 'Away Game'}
            </div>
          </div>

          <div class="space-y-1 text-xs text-right w-full sm:w-auto">
            <div class="font-bold text-sky-300">📺 TV: {team.nextGame.broadcast.tv}</div>
            <div class="text-slate-300">📻 Radio: {team.nextGame.broadcast.radio}</div>
          </div>
        </div>

        {team.nextGame.ticketLink && (
          <div class="flex items-center justify-between text-xs">
            <span class="text-slate-300">Looking to attend in person?</span>
            <a
              href={team.nextGame.ticketLink}
              target="_blank"
              rel="noopener noreferrer"
              class="px-3.5 py-1.5 rounded-xl font-bold bg-sky-500 hover:bg-sky-400 text-white transition-colors"
            >
              Official Tickets →
            </a>
          </div>
        )}
      </div>
    ) : (
      <div class="p-6 rounded-2xl bg-slate-100 dark:bg-slate-900 border border-slate-200 dark:border-slate-800 text-center">
        <span class="text-sm font-semibold text-slate-400">No confirmed upcoming fixture available for {team.name} yet.</span>
      </div>
    )}

    <!-- 2-Column: Upcoming Fixtures & Team Leaders -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <!-- Upcoming Schedule -->
      <div class="p-6 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 shadow-xs space-y-4">
        <h3 class="text-sm font-black text-slate-900 dark:text-white uppercase tracking-wider flex items-center gap-2">
          <span>📅</span>
          <span>Upcoming Fixtures</span>
        </h3>

        <div class="divide-y divide-slate-100 dark:divide-slate-800">
          {team.upcomingSchedule.length === 0 && (
            <p class="py-3 text-xs font-semibold text-slate-400">No confirmed fixtures available yet.</p>
          )}
          {team.upcomingSchedule.map((game) => {
            const gameDate = new Date(game.date).toLocaleDateString([], {
              weekday: 'short',
              month: 'short',
              day: 'numeric',
            });
            return (
              <div class="py-3 flex items-center justify-between gap-3 text-xs">
                <div>
                  <div class="font-bold text-slate-900 dark:text-white flex items-center gap-1.5">
                    <span>{game.isHome ? 'vs' : '@'}</span>
                    <span>{game.opponent.name}</span>
                  </div>
                  <div class="text-[11px] text-slate-500 dark:text-slate-400">
                    {gameDate} • {game.startTimePST}
                  </div>
                </div>

                <div class="text-right">
                  <span class="font-bold text-sky-600 dark:text-sky-400 text-[11px]">
                    {game.broadcast.tv}
                  </span>
                  <div class="text-[10px] text-slate-400">{game.venueName}</div>
                </div>
              </div>
            );
          })}
        </div>
      </div>

      <!-- Team Stat Leaders -->
      <div class="p-6 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 shadow-xs space-y-4">
        <h3 class="text-sm font-black text-slate-900 dark:text-white uppercase tracking-wider flex items-center gap-2">
          <span>⭐</span>
          <span>Team Leaders &amp; Key Stats</span>
        </h3>

        <div class="space-y-3">
          {team.leaders.map((leader) => (
            <div class="p-3.5 rounded-xl bg-slate-50 dark:bg-slate-950/60 border border-slate-200/80 dark:border-slate-800 flex items-center justify-between text-xs">
              <div>
                <span class="text-[10px] uppercase font-bold text-slate-400">{leader.category}</span>
                <div class="font-black text-slate-900 dark:text-white text-sm">
                  {leader.playerName}
                </div>
              </div>
              <span class="font-bold text-sky-600 dark:text-sky-400 bg-sky-50 dark:bg-sky-950/40 px-2.5 py-1 rounded-lg border border-sky-500/20">
                {leader.statValue}
              </span>
            </div>
          ))}
        </div>
      </div>
    </div>

    <!-- Stadium & Transit Wayfinding -->
    <TransitGuide venue={team.venue} teamName={team.name} />

    <!-- Connected Cross-Utility Telemetry -->
    <RelatedTelemetry items={relatedItems} />

    <!-- Other Vancouver Sports Teams Carousel / Grid -->
    <div class="space-y-4 pt-4 border-t border-slate-200 dark:border-slate-800">
      <h3 class="text-sm font-black text-slate-900 dark:text-white uppercase tracking-wider">
        Other Vancouver Pro Sports Teams
      </h3>
      <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-6 gap-3">
        {otherTeams.map((other) => (
          <a
            href={`/sports-teams/${other.id}`}
            class="p-3 rounded-xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 hover:border-sky-500/50 text-center transition-all shadow-xs group"
          >
            <span class="text-2xl block mb-1">{other.emoji}</span>
            <div class="font-bold text-xs text-slate-900 dark:text-white group-hover:text-sky-500 transition-colors truncate">
              {other.shortName}
            </div>
            <span class="text-[10px] text-slate-400">{other.league}</span>
          </a>
        ))}
      </div>
    </div>
  </div>
</PlatformLayout>
