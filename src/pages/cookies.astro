---
import PlatformLayout from '../layouts/PlatformLayout.astro';
import JsonLd from '../components/shared/JsonLd.astro';

const cookieSchema = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    name: 'Cookie Policy | VanHeartbeat',
    url: 'https://vanheartbeat.ca/cookies',
    description: 'Cookie policy and local browser storage disclosure for VanHeartbeat civic telemetry.',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'VanHeartbeat', item: 'https://vanheartbeat.ca' },
      { '@type': 'ListItem', position: 2, name: 'Cookie Policy', item: 'https://vanheartbeat.ca/cookies' },
    ],
  },
];
---

<PlatformLayout
  title="Cookie Policy | VanHeartbeat"
  description="Cookie policy for VanHeartbeat. Learn how we use client-side local storage and web performance cookies."
  currentPath="/cookies"
>
  <JsonLd schema={cookieSchema} />

  <div class="max-w-4xl mx-auto py-4 sm:py-8 space-y-8">
    <!-- Header Section -->
    <div class="space-y-3 border-b border-slate-200 dark:border-slate-800 pb-6">
      <div class="inline-flex items-center gap-2 px-2.5 py-1 rounded-md bg-sky-500/10 text-sky-700 dark:text-sky-400 border border-sky-500/20 text-xs font-bold uppercase tracking-wider">
        <span>🍪</span>
        <span>Storage &amp; Cookie Disclosure</span>
      </div>
      <h1 class="text-2xl sm:text-3xl font-black text-slate-900 dark:text-white tracking-tight">
        Cookie Policy
      </h1>
      <p class="text-sm text-slate-600 dark:text-slate-400">
        Effective Date: August 18, 2026 • Last Reviewed: August 2026
      </p>
    </div>

    <!-- Quick Summary Box -->
    <div class="p-5 rounded-2xl bg-sky-500/10 dark:bg-sky-950/30 border border-sky-500/30 text-sky-900 dark:text-sky-200 space-y-2">
      <div class="flex items-center gap-2 font-bold text-sm sm:text-base">
        <span class="text-lg">⚡</span>
        <span>TRANSPARENCY: PRIVACY-FIRST STORAGE</span>
      </div>
      <p class="text-xs sm:text-sm leading-relaxed text-sky-800 dark:text-sky-300">
        VanHeartbeat does not use invasive advertising cookies or cross-site behavioral tracking networks. We primarily rely on your browser's lightweight <strong>Local Storage</strong> to save your pinned tools, preferred color scheme, and alert dismissals entirely on your own device.
      </p>
    </div>

    <!-- Content Sections -->
    <div class="space-y-8 text-sm sm:text-base text-slate-700 dark:text-slate-300 leading-relaxed">

      <!-- Section 1 -->
      <section class="space-y-3">
        <h2 class="text-lg sm:text-xl font-bold text-slate-900 dark:text-white tracking-tight flex items-center gap-2">
          <span class="text-sky-500">1.</span> What Are Cookies and Web Storage?
        </h2>
        <p>
          Cookies are small text files placed on your computer or mobile device when you visit a website. Web Storage (including <code class="text-xs bg-slate-100 dark:bg-slate-800 px-1 py-0.5 rounded">localStorage</code> and <code class="text-xs bg-slate-100 dark:bg-slate-800 px-1 py-0.5 rounded">sessionStorage</code>) is a modern web standard that allows websites to store key-value data directly within your web browser without transmitting it back and forth to servers on every network request.
        </p>
      </section>

      <!-- Section 2: Storage Types -->
      <section class="space-y-4">
        <h2 class="text-lg sm:text-xl font-bold text-slate-900 dark:text-white tracking-tight flex items-center gap-2">
          <span class="text-sky-500">2.</span> How VanHeartbeat Uses Storage &amp; Cookies
        </h2>

        <div class="space-y-3">
          <!-- Type A: Essential Functional LocalStorage -->
          <div class="p-4 rounded-xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 space-y-2">
            <div class="flex items-center justify-between">
              <span class="font-bold text-slate-900 dark:text-white text-sm sm:text-base flex items-center gap-2">
                <span>🔧</span> Essential Functional State (Local Storage)
              </span>
              <span class="text-[10px] uppercase font-bold px-2 py-0.5 rounded bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border border-emerald-500/20">
                100% Client-Side
              </span>
            </div>
            <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-400 leading-relaxed">
              These storage items are strictly necessary to remember your customization choices across page reloads and browser sessions without requiring account creation:
            </p>
            <div class="overflow-x-auto text-xs">
              <table class="w-full text-left border-collapse">
                <thead>
                  <tr class="border-b border-slate-200 dark:border-slate-800 text-slate-500">
                    <th class="py-1.5 pr-4 font-semibold">Key</th>
                    <th class="py-1.5 pr-4 font-semibold">Purpose</th>
                    <th class="py-1.5 font-semibold">Duration</th>
                  </tr>
                </thead>
                <tbody class="divide-y divide-slate-100 dark:divide-slate-800/60 font-mono text-[11px]">
                  <tr>
                    <td class="py-1.5 pr-4 text-sky-600 dark:text-sky-400">vanutils_pinned_*</td>
                    <td class="py-1.5 pr-4 font-sans text-slate-600 dark:text-slate-400">Stores IDs of pinned beaches, ferry routes, or mountains for your dashboard card</td>
                    <td class="py-1.5 font-sans text-slate-500">Persistent (until cleared)</td>
                  </tr>
                  <tr>
                    <td class="py-1.5 pr-4 text-sky-600 dark:text-sky-400">theme</td>
                    <td class="py-1.5 pr-4 font-sans text-slate-600 dark:text-slate-400">Saves your preferred UI appearance ('light' or 'dark')</td>
                    <td class="py-1.5 font-sans text-slate-500">Persistent</td>
                  </tr>
                  <tr>
                    <td class="py-1.5 pr-4 text-sky-600 dark:text-sky-400">vanutils_dismissed_alert_*</td>
                    <td class="py-1.5 pr-4 font-sans text-slate-600 dark:text-slate-400">Prevents dismissed breaking emergency alert banners from reappearing</td>
                    <td class="py-1.5 font-sans text-slate-500">Persistent</td>
                  </tr>
                </tbody>
              </table>
            </div>
          </div>

          <!-- Type B: Performance & Analytics -->
          <div class="p-4 rounded-xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 space-y-2">
            <div class="flex items-center justify-between">
              <span class="font-bold text-slate-900 dark:text-white text-sm sm:text-base flex items-center gap-2">
                <span>📊</span> Performance &amp; Web Analytics (Cookies)
              </span>
              <span class="text-[10px] uppercase font-bold px-2 py-0.5 rounded bg-sky-500/10 text-sky-600 dark:text-sky-400 border border-sky-500/20">
                Aggregated Only
              </span>
            </div>
            <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-400 leading-relaxed">
              We may utilize analytics services like Cloudflare Analytics to understand aggregate platform traffic, discover which telemetry feeds are most heavily utilized by Metro Vancouver residents, and troubleshoot edge rendering performance.
            </p>
          </div>
        </div>
      </section>

      <!-- Section 3: Third-Party & Advertising -->
      <section class="space-y-3">
        <h2 class="text-lg sm:text-xl font-bold text-slate-900 dark:text-white tracking-tight flex items-center gap-2">
          <span class="text-sky-500">3.</span> Zero Commercial Advertising Cookies
        </h2>
        <p>
          VanHeartbeat has a strict zero-ad policy. We do not place advertising cookies, conversion tracking pixels, retargeting beacons, or data broker scripts on our platform.
        </p>
      </section>

      <!-- Section 4: How to Manage -->
      <section class="space-y-3">
        <h2 class="text-lg sm:text-xl font-bold text-slate-900 dark:text-white tracking-tight flex items-center gap-2">
          <span class="text-sky-500">4.</span> How to Control or Delete Cookies &amp; Storage
        </h2>
        <p>
          You have full control over your cookies and local storage. You can configure your browser to block cookies, notify you when cookies are set, or clear all stored site data at any time:
        </p>
        <ul class="list-disc pl-5 space-y-1.5 text-xs sm:text-sm text-slate-600 dark:text-slate-400">
          <li><strong>Google Chrome:</strong> Settings ➔ Privacy and Security ➔ Cookies and other site data.</li>
          <li><strong>Apple Safari (macOS &amp; iOS):</strong> Preferences / Settings ➔ Privacy ➔ Manage Website Data.</li>
          <li><strong>Mozilla Firefox:</strong> Settings ➔ Privacy &amp; Security ➔ Cookies and Site Data.</li>
          <li><strong>Microsoft Edge:</strong> Settings ➔ Cookies and site permissions ➔ Manage and delete cookies.</li>
        </ul>
        <p class="text-xs text-slate-500 dark:text-slate-400">
          Please note that if you clear your browser's local storage, your pinned tool favorites and dark mode selection will revert to defaults.
        </p>
      </section>

      <!-- Section 5: Updates -->
      <section class="space-y-3">
        <h2 class="text-lg sm:text-xl font-bold text-slate-900 dark:text-white tracking-tight flex items-center gap-2">
          <span class="text-sky-500">5.</span> Updates to This Policy
        </h2>
        <p>
          Any adjustments to our storage or analytics practices will be reflected on this page. For any questions, please consult our <a href="/privacy" class="text-sky-600 dark:text-sky-400 hover:underline">Privacy Policy</a> or reach out through our <a href="/contact" class="text-sky-600 dark:text-sky-400 hover:underline">Contact page</a>.
        </p>
      </section>

    </div>
  </div>
</PlatformLayout>
