---
import ToolLayout from '../../layouts/ToolLayout.astro';
import JsonLd from '../../components/shared/JsonLd.astro';
import FilterTabs from '../../tools/school-catchment/components/FilterTabs.astro';
import SchoolCard from '../../tools/school-catchment/components/SchoolCard.astro';
import ChildcareList from '../../tools/school-catchment/components/ChildcareList.astro';
import LiveDataUnavailable from '../../components/shared/LiveDataUnavailable.astro';
import { getLiveSchools, getAllChildcares, getSchoolsOverviewStats } from '../../tools/school-catchment/services/catchmentService';

// Tiered Edge Cache: 24-hour edge TTL, 7-day background revalidation
Astro.response.headers.set('Cache-Control', 'public, s-maxage=86400, stale-while-revalidate=604800');

const schoolsResult = await getLiveSchools();
const schools = schoolsResult.ok ? schoolsResult.data : [];
const childcares = getAllChildcares();
const stats = schoolsResult.ok ? getSchoolsOverviewStats(schools, childcares) : null;

const schoolsSchema = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    name: 'VSB School Catchment & Licensed Childcare Navigator — VanHeartbeat',
    description: 'Sub-50ms lookup for Vancouver School District (SD39) Elementary, Annex, and Secondary school catchments, French Immersion feeder tracks, and licensed daycares.',
    url: 'https://vanheartbeat.ca/schools',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'VanHeartbeat', item: 'https://vanheartbeat.ca' },
      { '@type': 'ListItem', position: 2, name: 'School Catchments & Childcare', item: 'https://vanheartbeat.ca/schools' },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: [
      {
        '@type': 'Question',
        name: 'How do Vancouver School Board (SD39) catchments determine student registration?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'Every residential address in Vancouver belongs to a designated elementary and secondary school catchment. In-catchment students receive priority placement, followed by cross-boundary applicants subject to school capacity.',
        },
      },
      {
        '@type': 'Question',
        name: 'How does French Immersion kindergarten registration work in Vancouver?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'Early French Immersion (Kindergarten to Grade 7) operates via a centralized district-wide lottery application window open in January through the Vancouver School Board website.',
        },
      },
      {
        '@type': 'Question',
        name: 'Where can I find licensed $10-a-day childcare centres in Vancouver?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'Vancouver Coastal Health (VCH) regularly inspects licensed daycares. Participating $10-a-day child care sites and school-age childcare spaces located on VSB school grounds are tracked in our live directory.',
        },
      },
    ],
  },
];
---

<ToolLayout
  toolId="school-catchment"
  title="VSB School Catchment & Licensed Childcare Navigator"
  description="Sub-50ms lookup for Vancouver School District (SD39) Elementary, Annex, and Secondary school catchments, French Immersion feeder tracks, and licensed daycares."
  currentPath="/schools"
  badgeText="VSB SD39 Catchments"
  status="active"
>
  <JsonLd schema={schoolsSchema} />

  <div class="space-y-5 max-w-5xl mx-auto">
    {schoolsResult.ok && stats ? (
      <>
        <!-- Hero Stats & 1-Tap Geolocation Sorter -->
        <section class="rounded-2xl bg-slate-900 text-white p-4 sm:p-5 border border-slate-800 shadow-sm flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
          <div class="space-y-1">
            <div class="inline-flex items-center gap-2 px-2.5 py-0.5 rounded-full bg-emerald-500/20 text-emerald-300 text-xs font-semibold">
              <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
              <span>Vancouver School Board (SD39) • {stats.totalSchools} Catchment Schools</span>
            </div>
            <h2 class="text-base sm:text-lg font-bold tracking-tight text-white">
              School Catchment Boundaries & Licensed Childcare Locator
            </h2>
            <p class="text-xs text-slate-300">
              Tracking {stats.secondaryCount} Secondary High Schools, {stats.elementaryCount} Elementary Schools, and {stats.childcaresCount} VCH-inspected childcare facilities.
            </p>
          </div>

          <!-- 1-Tap Geolocation Sorter -->
          <button
            type="button"
            id="geo-sort-schools-btn"
            class="inline-flex items-center justify-center gap-2 px-4 py-2.5 rounded-xl bg-sky-500 hover:bg-sky-400 text-white font-bold text-xs sm:text-sm shadow-md hover:shadow-lg transition-all shrink-0"
          >
            <span>📍</span>
            <span id="geo-schools-label">Find Designated Catchment</span>
          </button>
        </section>

        <!-- Pinned Schools Section (Mirrors Home Dashboard Card) -->
        <div id="pinned-schools-section" class="p-3 sm:p-3.5 rounded-xl bg-slate-50 dark:bg-slate-900 border border-slate-200/80 dark:border-slate-800 space-y-2">
          <div class="flex items-center justify-between">
            <span class="text-xs font-bold text-slate-700 dark:text-slate-300 flex items-center gap-1.5">
              <span>⭐</span>
              <span>Pinned Schools & Childcares (Shown on Main Dashboard)</span>
            </span>
            <span class="text-[11px] text-slate-400">Click star on any school to customize</span>
          </div>
          <div id="pinned-schools-grid" class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-2">
            <!-- Dynamically populated via client JS -->
          </div>
        </div>

        <!-- Filter Tabs -->
        <FilterTabs activeTab="all" />

        <!-- Schools Grid -->
        <div id="schools-grid" class="grid grid-cols-1 md:grid-cols-2 gap-4">
          {schools.map((school) => (
            <SchoolCard school={school} />
          ))}
        </div>
      </>
    ) : (
      <LiveDataUnavailable toolName="School Catchment Navigator" variant="page" error={!schoolsResult.ok ? schoolsResult.error : undefined} />
    )}

    <!-- Licensed Childcare Directory -->
    <ChildcareList childcares={childcares} />

    <!-- FAQ Accordion for SEO & GEO -->
    <div class="p-6 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 shadow-xs space-y-4">
      <div class="flex items-center gap-2">
        <span class="text-xl">💬</span>
        <h2 class="text-base font-black text-slate-900 dark:text-white tracking-tight">
          Vancouver Schools &amp; Childcare: Frequently Asked Questions
        </h2>
      </div>

      <div class="space-y-3 text-xs leading-relaxed text-slate-600 dark:text-slate-400">
        <div class="p-3.5 rounded-xl bg-slate-50 dark:bg-slate-950/60 border border-slate-200/80 dark:border-slate-800 space-y-1">
          <h3 class="font-bold text-slate-900 dark:text-white text-xs">
            How do Vancouver School Board (SD39) catchments determine student registration?
          </h3>
          <p>
            Every residential address in Vancouver belongs to a designated elementary and secondary school catchment. In-catchment students receive priority placement, followed by cross-boundary applicants subject to school capacity.
          </p>
        </div>

        <div class="p-3.5 rounded-xl bg-slate-50 dark:bg-slate-950/60 border border-slate-200/80 dark:border-slate-800 space-y-1">
          <h3 class="font-bold text-slate-900 dark:text-white text-xs">
            How does French Immersion kindergarten registration work in Vancouver?
          </h3>
          <p>
            Early French Immersion (Kindergarten to Grade 7) operates via a centralized district-wide lottery application window open in January through the Vancouver School Board website.
          </p>
        </div>

        <div class="p-3.5 rounded-xl bg-slate-50 dark:bg-slate-950/60 border border-slate-200/80 dark:border-slate-800 space-y-1">
          <h3 class="font-bold text-slate-900 dark:text-white text-xs">
            Where can I find licensed $10-a-day childcare centres in Vancouver?
          </h3>
          <p>
            Vancouver Coastal Health (VCH) regularly inspects licensed daycares. Participating $10-a-day child care sites and school-age childcare spaces located on VSB school grounds are tracked in our live directory.
          </p>
        </div>
      </div>
    </div>
  </div>
</ToolLayout>

<script is:inline define:vars={{ schoolsJson: JSON.stringify(schools) }}>
  // Pinned Schools Management
  const STORAGE_KEY = 'vanutils_pinned_school-catchment';
  const DEFAULT_PINNED = [
    'kitsilano-secondary',
    'lord-byng-secondary',
    'eric-hamber-secondary',
    'sir-winston-churchill-secondary',
    'general-gordon-elementary',
    'lord-tennyson-elementary'
  ];

  function getPinnedIds() {
    try {
      const saved = localStorage.getItem(STORAGE_KEY);
      if (saved) return JSON.parse(saved);
    } catch (e) {}
    return DEFAULT_PINNED;
  }

  function savePinnedIds(ids) {
    localStorage.setItem(STORAGE_KEY, JSON.stringify(ids));
    window.dispatchEvent(new CustomEvent('vanutils:pinned-schools-changed', { detail: ids }));
  }

  function renderPinnedGrid() {
    const grid = document.getElementById('pinned-schools-grid');
    if (!grid) return;

    const pinnedIds = getPinnedIds();
    const allSchools = JSON.parse(schoolsJson || '[]');
    const pinned = allSchools.filter((s) => pinnedIds.includes(s.id));

    if (pinned.length === 0) {
      grid.innerHTML = '<p class="text-xs text-slate-400 py-1">No pinned schools. Star any school below to add!</p>';
      return;
    }

    grid.innerHTML = pinned.map((s) => `
      <div class="flex items-center justify-between p-2 rounded-lg bg-white dark:bg-slate-800/80 border border-slate-200/80 dark:border-slate-700/60 text-xs">
        <div class="truncate pr-2 font-bold text-slate-900 dark:text-white">
          <a href="/schools/${s.id}" class="hover:text-sky-500">${s.name}</a>
          <span class="text-[10px] text-slate-400 block">Grades ${s.gradeSpan} • ${s.neighbourhood}</span>
        </div>
        <span class="shrink-0 font-bold text-[11px] text-sky-600 dark:text-sky-400">
          ${s.programs.includes('early_french_immersion') ? '🇫🇷 French' : '📘 English'}
        </span>
      </div>
    `).join('');
  }

  function updateStarButtons() {
    const pinnedIds = getPinnedIds();
    document.querySelectorAll('.star-btn[data-school-star-id]').forEach((btn) => {
      const id = btn.getAttribute('data-school-star-id');
      if (pinnedIds.includes(id)) {
        btn.classList.add('text-amber-400', 'dark:text-amber-400');
        btn.classList.remove('text-slate-300', 'dark:text-slate-600');
      } else {
        btn.classList.remove('text-amber-400', 'dark:text-amber-400');
        btn.classList.add('text-slate-300', 'dark:text-slate-600');
      }
    });
  }

  function setupStarClicks() {
    document.querySelectorAll('.star-btn[data-school-star-id]').forEach((btn) => {
      btn.addEventListener('click', (e) => {
        e.preventDefault();
        e.stopPropagation();
        const id = btn.getAttribute('data-school-star-id');
        let pinned = getPinnedIds();
        if (pinned.includes(id)) {
          pinned = pinned.filter((p) => p !== id);
        } else {
          pinned.push(id);
        }
        savePinnedIds(pinned);
        updateStarButtons();
        renderPinnedGrid();
      });
    });
  }

  // Haversine Distance
  function haversineKm(lat1, lon1, lat2, lon2) {
    const R = 6371;
    const dLat = (lat2 - lat1) * Math.PI / 180;
    const dLon = (lon2 - lon1) * Math.PI / 180;
    const a = Math.sin(dLat / 2) * Math.sin(dLat / 2) +
              Math.cos(lat1 * Math.PI / 180) * Math.cos(lat2 * Math.PI / 180) *
              Math.sin(dLon / 2) * Math.sin(dLon / 2);
    const c = 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1 - a));
    return R * c;
  }

  function setupGeoSort() {
    const btn = document.getElementById('geo-sort-schools-btn');
    const label = document.getElementById('geo-schools-label');
    const grid = document.getElementById('schools-grid');

    if (!btn) return;

    btn.addEventListener('click', () => {
      if (!navigator.geolocation) {
        alert('Geolocation is not supported by your browser.');
        return;
      }

      label.textContent = 'Locating Closest Catchments...';
      navigator.geolocation.getCurrentPosition(
        (pos) => {
          const userLat = pos.coords.latitude;
          const userLng = pos.coords.longitude;
          label.textContent = 'Sorted by Catchment Proximity ✅';

          const cards = Array.from(document.querySelectorAll('.school-card'));
          cards.forEach((card) => {
            const lat = parseFloat(card.getAttribute('data-lat') || '0');
            const lng = parseFloat(card.getAttribute('data-lng') || '0');
            const km = haversineKm(userLat, userLng, lat, lng);
            card.setAttribute('data-distance', km.toFixed(2));
            const distLabel = card.querySelector('.school-distance-label');
            if (distLabel) distLabel.textContent = `📍 ${km < 1 ? Math.round(km * 1000) + 'm away' : km.toFixed(1) + ' km away'}`;
          });

          cards.sort((a, b) => {
            const distA = parseFloat(a.getAttribute('data-distance') || '0');
            const distB = parseFloat(b.getAttribute('data-distance') || '0');
            return distA - distB;
          });

          if (grid) {
            cards.forEach((card) => grid.appendChild(card));
          }
        },
        () => {
          label.textContent = 'Location Access Denied';
        }
      );
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', () => {
      renderPinnedGrid();
      updateStarButtons();
      setupStarClicks();
      setupGeoSort();
    });
  } else {
    renderPinnedGrid();
    updateStarButtons();
    setupStarClicks();
    setupGeoSort();
  }
</script>
