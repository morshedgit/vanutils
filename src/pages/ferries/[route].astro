---
import ToolLayout from '../../layouts/ToolLayout.astro';
import JsonLd from '../../components/shared/JsonLd.astro';
import RelatedTelemetry, { type RelatedItem } from '../../components/shared/RelatedTelemetry.astro';
import StandbyGauge from '../../tools/bc-ferries/components/StandbyGauge.astro';
import WebcamGrid from '../../tools/bc-ferries/components/WebcamGrid.astro';
import LiveDataUnavailable from '../../components/shared/LiveDataUnavailable.astro';
import { getLiveRoutes, getRouteById, BASELINE_ROUTES } from '../../tools/bc-ferries/services/ferryService';
import { getStandbyMeta } from '../../tools/bc-ferries/services/standbyCalc';

// Set Edge Cache header: 60s max age, 300s background revalidation
Astro.response.headers.set('Cache-Control', 'public, s-maxage=60, stale-while-revalidate=300');

const { route: routeId } = Astro.params;

// Baseline lookup is metadata-only (name/terminals) so an unknown id still
// 404s even when the live upstream is down; it is never used for telemetry values.
const routeMeta = getRouteById(routeId || '', BASELINE_ROUTES);
if (!routeMeta) {
  return Astro.redirect('/ferries');
}

const routesResult = await getLiveRoutes();
const route = routesResult.ok ? getRouteById(routeId || '', routesResult.data) : undefined;
const reverseRoute = route?.reverseRouteId && routesResult.ok ? getRouteById(route.reverseRouteId, routesResult.data) : undefined;
const nextSailing = route?.nextSailings[0];
const standbyMeta = nextSailing ? getStandbyMeta(nextSailing.standbyRisk) : undefined;

const routeSchema = [
  {
    '@context': 'https://schema.org',
    '@type': 'TouristInformationCenter',
    name: `${routeMeta.name} Marine Route`,
    description: `Real-time vehicle deck space, standby odds, sailing status, and DriveBC approach webcams for ${routeMeta.name}.`,
    url: `https://vanheartbeat.ca/ferries/${routeMeta.id}`,
    sameAs: [
      'https://en.wikipedia.org/wiki/BC_Ferries',
      'https://www.wikidata.org/wiki/Q795724',
    ],
    address: {
      '@type': 'PostalAddress',
      addressLocality: routeMeta.originTerminal,
      addressRegion: 'BC',
      addressCountry: 'CA',
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'VanHeartbeat', item: 'https://vanheartbeat.ca' },
      { '@type': 'ListItem', position: 2, name: 'Ferry Standby Radar', item: 'https://vanheartbeat.ca/ferries' },
      { '@type': 'ListItem', position: 3, name: routeMeta.name, item: `https://vanheartbeat.ca/ferries/${routeMeta.id}` },
    ],
  },
];

const relatedItems: RelatedItem[] = [
  {
    title: 'Bridge & Highway Traffic',
    subtitle: 'DriveBC approach delays & incident radar',
    href: '/bridges',
    badge: 'DriveBC',
    icon: '🌉',
  },
  {
    title: 'Coastal Weather & Gale Radar',
    subtitle: 'Marine wind soundings & precipitation',
    href: '/weather',
    badge: 'Doppler',
    icon: '🌦️',
  },
  {
    title: 'Air Quality & Haze Index',
    subtitle: 'Terminal airshed BAM-1020 sensors',
    href: '/air',
    badge: 'AQHI',
    icon: '💨',
  },
];
---

<ToolLayout
  toolId="bc-ferries"
  title={route ? `${route.name} — Live Marine Radar` : `${routeMeta.name} — Live Data Unavailable`}
  description={route ? `Real-time vehicle deck space, standby odds, sailing status, and DriveBC approach webcams for ${route.name}.` : 'Live marine transit data is temporarily unavailable.'}
  currentPath={`/ferries/${routeMeta.id}`}
  badgeText={route ? (route.provider === 'bc-ferries' ? 'BC Ferries' : route.provider.toUpperCase()) : 'Live Data Unavailable'}
  status="active"
>
  <JsonLd schema={routeSchema} />

  <div class="space-y-6 max-w-4xl mx-auto">
    <!-- 3-Tier Visual Breadcrumb -->
    <nav aria-label="Breadcrumb" class="flex items-center gap-2 text-xs font-semibold text-slate-500 dark:text-slate-400">
      <a href="/" class="hover:text-sky-600 dark:hover:text-sky-400 transition-colors">VanHeartbeat</a>
      <span>/</span>
      <a href="/ferries" class="hover:text-sky-600 dark:hover:text-sky-400 transition-colors">Ferry Standby</a>
      <span>/</span>
      <span class="text-slate-900 dark:text-white truncate">{routeMeta.name}</span>
    </nav>

    {!route && (
      <LiveDataUnavailable toolName={`${routeMeta.name} Marine Route`} variant="page" error={!routesResult.ok ? routesResult.error : undefined} />
    )}

    <!-- Header Route Card -->
    {route && (
    <>
    <section class="p-5 sm:p-6 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200/80 dark:border-slate-800 shadow-sm space-y-4">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3">
        <div>
          <div class="flex items-center gap-2 text-xs font-bold text-slate-400 uppercase tracking-wide mb-1">
            <span>{route.originTerminal}</span>
            <span>➔</span>
            <span>{route.destinationTerminal}</span>
          </div>
          <h1 class="text-2xl font-black text-slate-900 dark:text-white tracking-tight">
            {route.name}
          </h1>
        </div>

        {reverseRoute && (
          <a
            href={`/ferries/${reverseRoute.id}`}
            class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-slate-100 dark:bg-slate-800 hover:bg-slate-200 dark:hover:bg-slate-700 text-xs font-bold text-slate-700 dark:text-slate-200 transition-all shrink-0"
          >
            <span>⇄ Reverse Direction</span>
          </a>
        )}
      </div>

      <!-- Quick Metrics Bar -->
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 pt-3 border-t border-slate-100 dark:border-slate-800 text-xs">
        <div>
          <span class="text-slate-400 block text-[11px]">Crossing Duration</span>
          <span class="font-bold text-slate-900 dark:text-white">⏱️ {route.crossingDurationMinutes} mins</span>
        </div>
        <div>
          <span class="text-slate-400 block text-[11px]">Service Type</span>
          <span class="font-bold text-slate-900 dark:text-white">
            {route.vesselType === 'vehicle_and_passenger' ? '🚗 Vehicle + Foot' : '🚶 Passenger Only'}
          </span>
        </div>
        <div>
          <span class="text-slate-400 block text-[11px]">Next Departure</span>
          <span class="font-bold text-slate-900 dark:text-white">
            {nextSailing ? nextSailing.departureTime : 'See timetable'}
          </span>
        </div>
        <div>
          <span class="text-slate-400 block text-[11px]">Next Deck Space</span>
          <span class="font-bold text-slate-900 dark:text-white">
            {nextSailing && nextSailing.deckSpacePercent !== undefined ? `${nextSailing.deckSpacePercent}% Free` : 'Walk-on'}
          </span>
        </div>
      </div>
    </section>

    <!-- Standby Recommendation Box (for vehicle ferries) -->
    {standbyMeta && route.vesselType === 'vehicle_and_passenger' && (
      <section class={`p-4 sm:p-5 rounded-2xl border ${standbyMeta.badgeBg} ${standbyMeta.badgeBorder} space-y-1.5`}>
        <div class="flex items-center gap-2">
          <span class={`w-2.5 h-2.5 rounded-full ${standbyMeta.dotColor}`}></span>
          <h3 class={`text-sm font-bold ${standbyMeta.badgeText}`}>
            Standby Risk: {standbyMeta.label}
          </h3>
        </div>
        <p class="text-xs text-slate-700 dark:text-slate-300">
          {standbyMeta.recommendation}
        </p>
      </section>
    )}

    <!-- Departures Table -->
    <section class="space-y-3">
      <div class="flex items-center justify-between">
        <h2 class="text-base font-bold text-slate-900 dark:text-white">
          Upcoming Sailings Today
        </h2>
        <span class="text-xs text-slate-400">
          Updated live • Edge synced
        </span>
      </div>

      <div class="overflow-hidden rounded-2xl bg-white dark:bg-slate-900 border border-slate-200/80 dark:border-slate-800 shadow-xs">
        <div class="overflow-x-auto">
          <table class="w-full text-left text-xs text-slate-600 dark:text-slate-300">
            <thead class="bg-slate-50 dark:bg-slate-800/80 text-slate-400 uppercase text-[10px] font-bold tracking-wider border-b border-slate-200 dark:border-slate-700">
              <tr>
                <th class="p-3.5">Departure</th>
                <th class="p-3.5">Arrival</th>
                <th class="p-3.5">Vessel Name</th>
                <th class="p-3.5">Vehicle Deck</th>
                <th class="p-3.5">Status</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-100 dark:divide-slate-800">
              {route.nextSailings.map((sailing) => (
                <tr class="hover:bg-slate-50/50 dark:hover:bg-slate-800/40">
                  <td class="p-3.5 font-black text-slate-900 dark:text-white text-sm">
                    {sailing.departureTime}
                  </td>
                  <td class="p-3.5">
                    {sailing.arrivalTime}
                  </td>
                  <td class="p-3.5 font-medium">
                    {sailing.vesselName}
                  </td>
                  <td class="p-3.5">
                    <StandbyGauge
                      percent={sailing.deckSpacePercent}
                      standbyRisk={sailing.standbyRisk}
                      size="sm"
                    />
                  </td>
                  <td class="p-3.5">
                    <span class="inline-flex items-center gap-1 font-semibold text-emerald-600 dark:text-emerald-400">
                      {sailing.statusText || 'On Time'}
                    </span>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- DriveBC Approach Cameras -->
    {route.highwayCameras.length > 0 && (
      <section class="space-y-3">
        <WebcamGrid cameras={route.highwayCameras} />
      </section>
    )}
    </>
    )}

    <!-- Connected Cross-Utility Telemetry -->
    <RelatedTelemetry items={relatedItems} />

    <!-- Back Navigation -->
    <div class="pt-2">
      <a
        href="/ferries"
        class="inline-flex items-center gap-2 text-xs font-bold text-sky-600 dark:text-sky-400 hover:underline"
      >
        ← Back to All Marine Routes
      </a>
    </div>
  </div>
</ToolLayout>
