---
import ToolLayout from '../../layouts/ToolLayout.astro';
import DisruptionBanner from '../../tools/bc-ferries/components/DisruptionBanner.astro';
import SeaBusPulse from '../../tools/bc-ferries/components/SeaBusPulse.astro';
import FilterTabs from '../../tools/bc-ferries/components/FilterTabs.astro';
import RouteCard from '../../tools/bc-ferries/components/RouteCard.astro';
import { getLiveRoutes } from '../../tools/bc-ferries/services/ferryService';

// Set Edge Cache header: 60s max age, 300s background revalidation
Astro.response.headers.set('Cache-Control', 'public, s-maxage=60, stale-while-revalidate=300');

const routes = await getLiveRoutes();
---

<ToolLayout
  toolId="bc-ferries"
  title="Ferry & Marine Transit Radar"
  description="Real-time multi-provider marine transit radar. BC Ferries vehicle deck space, standby odds, Hullo fast catamarans, SeaBus, and DriveBC approach cameras."
  currentPath="/ferries"
  badgeText="Live Marine Radar"
  status="active"
>
  <div class="space-y-5 max-w-5xl mx-auto">
    <!-- Consolidated Disruption & Marine Weather Header -->
    <DisruptionBanner />

    <!-- Pinned Marine Routes Section (Mirrors Home Dashboard Card) -->
    <div id="pinned-ferries-section" class="p-3 sm:p-3.5 rounded-xl bg-slate-50 dark:bg-slate-900 border border-slate-200/80 dark:border-slate-800 space-y-2">
      <div class="flex items-center justify-between text-xs">
        <span class="font-bold text-slate-800 dark:text-slate-200 flex items-center gap-1.5">
          <span class="text-amber-500">⭐</span> My Pinned Routes (Shown on Home Dashboard)
        </span>
        <span class="text-[11px] text-slate-400">
          Click ⭐ on any route to customize
        </span>
      </div>

      <div id="pinned-ferries-container" class="flex flex-wrap gap-1.5">
        <!-- Dynamically populated via client script -->
      </div>
    </div>

    <!-- TransLink SeaBus Live Pulse Banner -->
    <SeaBusPulse />

    <!-- Filter & Search Controls -->
    <FilterTabs />

    <!-- Routes Grid Section -->
    <div class="space-y-2">
      <div class="flex items-center justify-between px-1 text-xs text-slate-500 dark:text-slate-400 font-medium">
        <span id="ferry-count-display">Showing all {routes.length} marine routes</span>
        <span>Tap any route for full timetable & cams</span>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-3.5" id="ferries-grid">
        {routes.map((route) => (
          <RouteCard route={route} />
        ))}
      </div>
    </div>
  </div>
</ToolLayout>

<script>
  const DEFAULT_PINNED_FERRIES = ['TSA-SWB', 'HSB-NAN', 'HSB-LNG', 'HULLO-VAN-NAN', 'TL-SEABUS'];

  function getPinnedFerryIds(): string[] {
    const saved = localStorage.getItem('vanutils_pinned_ferries');
    return saved ? JSON.parse(saved) : DEFAULT_PINNED_FERRIES;
  }

  function setPinnedFerryIds(ids: string[]) {
    localStorage.setItem('vanutils_pinned_ferries', JSON.stringify(ids));
    window.dispatchEvent(new CustomEvent('vanutils:pinned-ferries-changed'));
    renderPinnedFerries();
    updateFerryPinButtonStates();
  }

  function toggleFerryPin(routeId: string) {
    let current = getPinnedFerryIds();
    if (current.includes(routeId)) {
      current = current.filter(id => id !== routeId);
    } else {
      current = [...current, routeId];
    }
    setPinnedFerryIds(current);
  }

  function updateFerryPinButtonStates() {
    const pinned = getPinnedFerryIds();
    const pinBtns = document.querySelectorAll('.pin-ferry-toggle') as NodeListOf<HTMLButtonElement>;

    pinBtns.forEach(btn => {
      const id = btn.dataset.routeId || '';
      const isPinned = pinned.includes(id);
      btn.classList.toggle('text-amber-500', isPinned);
      btn.classList.toggle('text-slate-300', !isPinned);
      btn.classList.toggle('dark:text-slate-600', !isPinned);
      btn.title = isPinned ? 'Remove from Main Dashboard' : 'Pin to Main Dashboard';
    });
  }

  function renderPinnedFerries() {
    const container = document.getElementById('pinned-ferries-container');
    if (!container) return;

    const pinned = getPinnedFerryIds();
    const cards = Array.from(document.querySelectorAll('.ferry-route-card')) as HTMLElement[];

    if (pinned.length === 0) {
      container.innerHTML = `<span class="text-xs text-slate-400 italic">No routes pinned. Click ⭐ on any route below to show it on your dashboard.</span>`;
      return;
    }

    container.innerHTML = pinned.map(id => {
      const match = cards.find(c => c.dataset.routeId === id);
      const name = match ? (match.dataset.routeName || id).replace(/ \(.*\)/, '') : id;

      return `
        <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-xs font-semibold bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 shadow-2xs">
          <span class="w-2 h-2 rounded-full bg-sky-500"></span>
          <a href="/ferries/${id}" class="hover:text-sky-500 truncate max-w-[180px]">${name}</a>
          <button type="button" class="unpin-ferry-btn ml-1 text-slate-400 hover:text-rose-500 font-bold" data-id="${id}" title="Remove from main">×</button>
        </span>
      `;
    }).join('');

    container.querySelectorAll('.unpin-ferry-btn').forEach(btn => {
      btn.addEventListener('click', (e) => {
        e.stopPropagation();
        const id = (btn as HTMLElement).dataset.id;
        if (id) toggleFerryPin(id);
      });
    });
  }

  function setupFerryDashboard() {
    updateFerryPinButtonStates();
    renderPinnedFerries();

    document.querySelectorAll('.pin-ferry-toggle').forEach(btn => {
      btn.addEventListener('click', (e) => {
        e.preventDefault();
        e.stopPropagation();
        const id = (btn as HTMLElement).dataset.routeId;
        if (id) toggleFerryPin(id);
      });
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupFerryDashboard);
  } else {
    setupFerryDashboard();
  }

  window.addEventListener('vanutils:pinned-ferries-changed', () => {
    updateFerryPinButtonStates();
    renderPinnedFerries();
  });
</script>
