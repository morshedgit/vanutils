---
import PlatformLayout from '../layouts/PlatformLayout.astro';
import JsonLd from '../components/shared/JsonLd.astro';

// Cache for 1 hour with 24 hour background revalidation
Astro.response.headers.set('Cache-Control', 'public, s-maxage=3600, stale-while-revalidate=86400');

const contactSchema = {
  '@context': 'https://schema.org',
  '@type': 'ContactPage',
  name: 'Contact & Feedback — VanUtils',
  description: 'Submit feedback, feature requests, or municipal data corrections to the VanUtils platform team.',
  url: 'https://vanutils.ca/contact',
  inLanguage: 'en-CA',
  mainEntity: {
    '@type': 'Organization',
    name: 'VanUtils',
    url: 'https://vanutils.ca',
    email: 'contact@vanutils.ca',
    contactPoint: {
      '@type': 'ContactPoint',
      contactType: 'technical support',
      email: 'contact@vanutils.ca',
      areaServed: 'CA-BC',
      availableLanguage: ['English'],
    },
  },
};
---

<PlatformLayout
  title="Contact Us & Data Feedback — VanUtils"
  description="Report a data discrepancy, suggest a new Metro Vancouver micro-utility, or reach out to the VanUtils team. Corrections reviewed within 2 hours."
  currentPath="/contact"
>
  <JsonLd schema={contactSchema} />

  <div class="max-w-4xl mx-auto space-y-10 py-4 sm:py-8">
    <!-- Header -->
    <div class="space-y-3 text-center sm:text-left border-b border-slate-200 dark:border-slate-800 pb-6">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-sky-500/10 text-sky-600 dark:text-sky-400 border border-sky-500/20 text-xs font-bold">
        <span>📬</span>
        <span>Community Feedback &amp; Corrections</span>
      </div>
      <h1 class="text-3xl sm:text-4xl font-black text-slate-900 dark:text-white tracking-tight leading-tight">
        Get in Touch with the VanUtils Team
      </h1>
      <p class="text-sm sm:text-base text-slate-600 dark:text-slate-300 max-w-2xl leading-relaxed">
        VanUtils is dedicated to maintaining 100% verified, real-time public telemetry for Metro Vancouver. If you spot a discrepancy, have a partnership inquiry, or want to suggest a new tool, let us know below.
      </p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
      <!-- Contact Form -->
      <div class="lg:col-span-2 p-6 sm:p-8 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 shadow-xs space-y-6">
        <div id="contact-form-success" class="hidden p-4 rounded-xl bg-emerald-500/10 border border-emerald-500/20 text-emerald-700 dark:text-emerald-300 text-xs leading-relaxed">
          <strong class="font-bold">✓ Thank you for your feedback!</strong> Your report has been submitted to the engineering team. Data corrections are reviewed promptly.
        </div>

        <form id="contact-form" class="space-y-4">
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div class="space-y-1.5">
              <label for="contact-name" class="block text-xs font-bold text-slate-700 dark:text-slate-300">
                Your Name
              </label>
              <input
                type="text"
                id="contact-name"
                name="name"
                required
                placeholder="e.g. Alex Henderson"
                class="w-full px-3.5 py-2.5 rounded-xl text-xs bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-800 text-slate-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-sky-500 transition-all"
              />
            </div>

            <div class="space-y-1.5">
              <label for="contact-email" class="block text-xs font-bold text-slate-700 dark:text-slate-300">
                Email Address
              </label>
              <input
                type="email"
                id="contact-email"
                name="email"
                required
                placeholder="you@domain.ca"
                class="w-full px-3.5 py-2.5 rounded-xl text-xs bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-800 text-slate-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-sky-500 transition-all"
              />
            </div>
          </div>

          <div class="space-y-1.5">
            <label for="contact-category" class="block text-xs font-bold text-slate-700 dark:text-slate-300">
              Inquiry Category
            </label>
            <select
              id="contact-category"
              name="category"
              class="w-full px-3.5 py-2.5 rounded-xl text-xs bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-800 text-slate-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-sky-500 transition-all"
            >
              <option value="data_correction">🚨 Data Discrepancy / Correction</option>
              <option value="feature_request">💡 New Micro-Utility Suggestion</option>
              <option value="agency_inquiry">🏛️ Municipal / Health Agency Inquiry</option>
              <option value="bug_report">🐞 Technical Bug Report</option>
              <option value="general">💬 General Inquiries</option>
            </select>
          </div>

          <div class="space-y-1.5">
            <label for="contact-message" class="block text-xs font-bold text-slate-700 dark:text-slate-300">
              Message / Details
            </label>
            <textarea
              id="contact-message"
              name="message"
              rows="5"
              required
              placeholder="Please describe the issue or suggestion, including the specific beach, crossing, or facility if applicable..."
              class="w-full px-3.5 py-2.5 rounded-xl text-xs bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-800 text-slate-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-sky-500 transition-all resize-y"
            ></textarea>
          </div>

          <button
            type="submit"
            id="contact-submit-btn"
            class="w-full sm:w-auto px-6 py-3 rounded-xl text-xs font-bold bg-sky-600 hover:bg-sky-500 text-white transition-all shadow-xs flex items-center justify-center gap-2"
          >
            <span>Submit Feedback</span>
            <span>→</span>
          </button>
        </form>
      </div>

      <!-- Trust & SLA Sidebar -->
      <div class="space-y-6">
        <div class="p-6 rounded-2xl bg-slate-50 dark:bg-slate-900/60 border border-slate-200 dark:border-slate-800 space-y-4">
          <div class="flex items-center gap-2 text-xs font-bold text-slate-900 dark:text-white">
            <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
            <span>Response SLA</span>
          </div>
          <p class="text-xs text-slate-600 dark:text-slate-400 leading-relaxed">
            Data accuracy corrections for beach closures, emergency wait times, and road events are prioritized and reviewed within <strong>2 hours</strong>.
          </p>
          <div class="pt-2 border-t border-slate-200 dark:border-slate-800 text-xs space-y-1 text-slate-500 dark:text-slate-400">
            <div>Direct Email:</div>
            <a href="mailto:contact@vanutils.ca" class="font-bold text-sky-600 dark:text-sky-400 hover:underline">
              contact@vanutils.ca
            </a>
          </div>
        </div>

        <div class="p-6 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 space-y-3">
          <h3 class="text-xs font-bold text-slate-900 dark:text-white uppercase tracking-wider">Agency Submissions</h3>
          <p class="text-xs text-slate-600 dark:text-slate-400 leading-relaxed">
            If you represent a municipal department, health authority, or regional transit agency interested in connecting an official GTFS-RT or Open Data feed, please select <strong>Agency Inquiry</strong>.
          </p>
        </div>
      </div>
    </div>
  </div>
</PlatformLayout>

<script>
  function setupContactForm() {
    const form = document.getElementById('contact-form') as HTMLFormElement | null;
    const successMsg = document.getElementById('contact-form-success');
    if (!form || !successMsg) return;

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      // Handle client-side confirmation feedback
      form.reset();
      form.style.display = 'none';
      successMsg.classList.remove('hidden');
    });
  }

  setupContactForm();
  document.addEventListener('astro:page-load', setupContactForm);
</script>
