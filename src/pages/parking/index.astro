---
import ToolLayout from '../../layouts/ToolLayout.astro';
---

<ToolLayout
  toolId="evo-parking"
  title="Evo & Street Sweeping Radar"
  description="Vancouver drop-zone parking rules, permit-only zone radar, upcoming street-sweeping tow bans, and meter time limits."
  currentPath="/parking"
  badgeText="Roadmap v1.3"
  status="planned"
>
  <!-- Header Aside Widget -->
  <div slot="header-aside" class="flex items-center gap-3 bg-white/80 dark:bg-slate-900/80 p-4 rounded-2xl border border-slate-200/80 dark:border-slate-800 shadow-xs">
    <div class="w-12 h-12 rounded-xl bg-amber-500/10 text-amber-600 dark:text-amber-400 flex items-center justify-center font-black text-xl border border-amber-500/20">
      🚗
    </div>
    <div>
      <div class="text-xs font-extrabold text-slate-900 dark:text-white">
        Evo HomeZone
      </div>
      <div class="text-[11px] text-slate-500 dark:text-slate-400">
        Vancouver, Burnaby, North Van
      </div>
    </div>
  </div>

  <div class="space-y-8">
    <!-- Roadmap Banner -->
    <div class="p-6 rounded-3xl bg-amber-500/10 border border-amber-500/20 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
      <div class="flex items-center gap-3">
        <span class="text-2xl">🚗</span>
        <div>
          <h3 class="text-sm font-bold text-slate-900 dark:text-white">Tool In Planned Pipeline (Release v1.3)</h3>
          <p class="text-xs text-slate-600 dark:text-slate-400">
            Never get an unexpected Evo parking ticket or tow-away notice in Vancouver again.
          </p>
        </div>
      </div>
      <a
        href="/swim"
        class="inline-flex items-center gap-1.5 px-4 py-2 rounded-xl bg-sky-600 hover:bg-sky-500 text-white text-xs font-bold transition-all shrink-0"
      >
        Try Live Swim Tool →
      </a>
    </div>

    <!-- Features Overview -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      <div class="p-6 rounded-3xl bg-white dark:bg-slate-900 border border-slate-200/80 dark:border-slate-800 space-y-3">
        <div class="w-10 h-10 rounded-xl bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 flex items-center justify-center text-xl">
          🧹
        </div>
        <h3 class="text-base font-bold text-slate-900 dark:text-white">Street Sweeping Radar</h3>
        <p class="text-xs text-slate-600 dark:text-slate-400 leading-relaxed">
          Syncs directly with City of Vancouver seasonal cleaning schedules to warn you before parking on tomorrow's sweep block.
        </p>
      </div>

      <div class="p-6 rounded-3xl bg-white dark:bg-slate-900 border border-slate-200/80 dark:border-slate-800 space-y-3">
        <div class="w-10 h-10 rounded-xl bg-sky-500/10 text-sky-600 dark:text-sky-400 flex items-center justify-center text-xl">
          🅿️
        </div>
        <h3 class="text-base font-bold text-slate-900 dark:text-white">Permit & Meter Rules</h3>
        <p class="text-xs text-slate-600 dark:text-slate-400 leading-relaxed">
          Instant breakdown of Resident Only vs Permit Excepted spots where Evo drop-offs are 100% legal without fines.
        </p>
      </div>

      <div class="p-6 rounded-3xl bg-white dark:bg-slate-900 border border-slate-200/80 dark:border-slate-800 space-y-3">
        <div class="w-10 h-10 rounded-xl bg-amber-500/10 text-amber-600 dark:text-amber-400 flex items-center justify-center text-xl">
          ⏰
        </div>
        <h3 class="text-base font-bold text-slate-900 dark:text-white">Rush Hour Tow Clocks</h3>
        <p class="text-xs text-slate-600 dark:text-slate-400 leading-relaxed">
          Highlights morning (7–9:30 AM) and afternoon (3–6 PM) commuter tow-away zones across Georgia, Burrard, and Broadway.
        </p>
      </div>
    </div>
  </div>
</ToolLayout>
