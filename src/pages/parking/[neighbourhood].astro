---
import ToolLayout from '../../layouts/ToolLayout.astro';
import JsonLd from '../../components/shared/JsonLd.astro';
import RelatedTelemetry, { type RelatedItem } from '../../components/shared/RelatedTelemetry.astro';
import ClearanceBadge from '../../tools/carshare-parking/components/ClearanceBadge.astro';
import SweepingCountdown from '../../tools/carshare-parking/components/SweepingCountdown.astro';
import RushHourNotice from '../../tools/carshare-parking/components/RushHourNotice.astro';
import SatelliteHubCard from '../../tools/carshare-parking/components/SatelliteHubCard.astro';
import { getNeighbourhoodBySlug, evaluateNeighbourhoodSpot } from '../../tools/carshare-parking/services/parkingEvaluator';
import { getSatelliteLotById } from '../../tools/carshare-parking/services/satelliteService';

// Set Edge Cache header: 1 hour max age, 24h background revalidation
Astro.response.headers.set('Cache-Control', 'public, s-maxage=3600, stale-while-revalidate=86400');

const { neighbourhood: slug } = Astro.params;
const neighbourhood = getNeighbourhoodBySlug(slug || '');

if (!neighbourhood) {
  return Astro.redirect('/parking');
}

const evaluation = evaluateNeighbourhoodSpot(neighbourhood);
const nearbyLots = neighbourhood.satelliteLotsNearby.map((id) => getSatelliteLotById(id)).filter(Boolean);

const parkingSchema = [
  {
    '@context': 'https://schema.org',
    '@type': 'ParkingFacility',
    name: `${neighbourhood.name} Car-Share Parking Zone`,
    description: `Live parking clearance, residential permit exemption rules, street sweeping schedule, and rush-hour tow lanes for ${neighbourhood.name}, ${neighbourhood.municipality}.`,
    url: `https://vanheartbeat.ca/parking/${neighbourhood.slug}`,
    address: {
      '@type': 'PostalAddress',
      addressLocality: neighbourhood.name,
      addressRegion: 'BC',
      addressCountry: 'CA',
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'VanHeartbeat', item: 'https://vanheartbeat.ca' },
      { '@type': 'ListItem', position: 2, name: 'Car-Share Parking Radar', item: 'https://vanheartbeat.ca/parking' },
      { '@type': 'ListItem', position: 3, name: neighbourhood.name, item: `https://vanheartbeat.ca/parking/${neighbourhood.slug}` },
    ],
  },
];

const relatedItems: RelatedItem[] = [
  {
    title: 'TransLink & Traffic News',
    subtitle: 'Street closures, transit reroutes & civic alerts',
    href: '/news',
    badge: 'Wire',
    icon: '📰',
  },
  {
    title: 'Vancouver Sports Teams Schedule',
    subtitle: 'Game day stadium transit & event parking',
    href: '/sports-teams',
    badge: 'Sports',
    icon: '🏒',
  },
];
---

<ToolLayout
  toolId="evo-parking"
  title={`${neighbourhood.name} Car-Share Parking & Sweeping Radar`}
  description={`Live parking clearance, residential permit exemption rules, street sweeping schedule, and rush-hour tow lanes for ${neighbourhood.name}, ${neighbourhood.municipality}.`}
  currentPath={`/parking/${neighbourhood.slug}`}
  badgeText="Neighbourhood Radar"
  status="active"
>
  <JsonLd schema={parkingSchema} />

  <div class="space-y-6 max-w-5xl mx-auto">
    <!-- 3-Tier Visual Breadcrumb Navigation -->
    <nav aria-label="Breadcrumb" class="flex items-center justify-between">
      <div class="flex items-center gap-2 text-xs font-semibold text-slate-500 dark:text-slate-400">
        <a href="/" class="hover:text-sky-600 dark:hover:text-sky-400 transition-colors">VanHeartbeat</a>
        <span>/</span>
        <a href="/parking" class="hover:text-sky-600 dark:hover:text-sky-400 transition-colors">Parking Radar</a>
        <span>/</span>
        <span class="text-slate-900 dark:text-white truncate">{neighbourhood.name}</span>
      </div>
      <span class="text-xs text-slate-400">
        {neighbourhood.municipality} • {neighbourhood.insideHomeZone ? '🚗 In Home Zone' : '❌ Out of Zone'}
      </span>
    </nav>

    <!-- Hero Clearance Card -->
    <section class="rounded-2xl bg-slate-900 text-white p-5 sm:p-6 border border-slate-800 shadow-sm flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
      <div class="space-y-1.5">
        <div class="flex items-center gap-2">
          <h2 class="text-xl sm:text-2xl font-black tracking-tight text-white">
            {neighbourhood.name}
          </h2>
          <ClearanceBadge status={evaluation.clearanceStatus} size="sm" />
        </div>
        <p class="text-xs text-slate-300">
          {evaluation.primaryReason}
        </p>
      </div>

      <div class="flex items-center gap-2 shrink-0">
        <button
          type="button"
          class="star-btn px-3 py-2 rounded-xl bg-slate-800 text-slate-300 hover:text-amber-400 text-xs font-bold border border-slate-700 transition-colors flex items-center gap-1.5"
          data-parking-id={neighbourhood.id}
        >
          <span>⭐</span>
          <span>Pin to Dashboard</span>
        </button>
      </div>
    </section>

    <!-- Core Rules & Schedules Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      <!-- Street Sweeping Radar -->
      <SweepingCountdown schedule={evaluation.streetSweeping} neighbourhoodName={neighbourhood.name} />

      <!-- Rush Hour No-Stopping Notice -->
      <RushHourNotice rushHour={evaluation.rushHour} />
    </div>

    <!-- Municipal Parking Regulations Matrix -->
    <section class="p-5 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 shadow-xs space-y-4">
      <h3 class="text-base font-bold text-slate-900 dark:text-white flex items-center gap-2">
        <span>🏛️</span>
        <span>Official Municipal Parking By-laws & Exemptions</span>
      </h3>

      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-3 text-xs">
        <div class="p-3 rounded-xl bg-slate-50 dark:bg-slate-800/60 border border-slate-100 dark:border-slate-700/60">
          <span class="text-slate-500 dark:text-slate-400 font-semibold block mb-1">Residential Permit Exemption:</span>
          <span class="font-bold text-slate-900 dark:text-white block mb-0.5">
            {neighbourhood.residentialPermitRules.evoExempt ? '✅ 100% Exempt (Evo & Modo)' : '❌ Not Exempt'}
          </span>
          <p class="text-slate-600 dark:text-slate-300 text-[11px] leading-relaxed">
            {neighbourhood.residentialPermitRules.description}
          </p>
        </div>

        <div class="p-3 rounded-xl bg-slate-50 dark:bg-slate-800/60 border border-slate-100 dark:border-slate-700/60">
          <span class="text-slate-500 dark:text-slate-400 font-semibold block mb-1">Overnight Meter Parking:</span>
          <span class="font-bold text-emerald-600 dark:text-emerald-400 block mb-0.5">
            Free {neighbourhood.meterRules.freeOvernightHours}
          </span>
          <p class="text-slate-600 dark:text-slate-300 text-[11px] leading-relaxed">
            Daytime rate: {neighbourhood.meterRules.daytimeRateRange}. Limit: {neighbourhood.meterRules.maxTimeLimit}.
          </p>
        </div>

        <div class="p-3 rounded-xl bg-slate-50 dark:bg-slate-800/60 border border-slate-100 dark:border-slate-700/60">
          <span class="text-slate-500 dark:text-slate-400 font-semibold block mb-1">Street Cleaning Cadence:</span>
          <span class="font-bold text-slate-900 dark:text-white block mb-0.5">
            {neighbourhood.sweepingSchedule.frequency}
          </span>
          <p class="text-slate-600 dark:text-slate-300 text-[11px] leading-relaxed">
            Sweep hours: {neighbourhood.sweepingSchedule.sweepHours}. Towing enforced during sweep.
          </p>
        </div>
      </div>
    </section>

    <!-- Nearby Dedicated Satellite Lots (If any) -->
    {nearbyLots.length > 0 && (
      <section class="space-y-3">
        <div class="border-b border-slate-200 dark:border-slate-800 pb-2">
          <h3 class="text-base font-bold text-slate-900 dark:text-white flex items-center gap-2">
            <span>🅿️</span>
            <span>Dedicated Satellite Parking Hubs in this Area</span>
          </h3>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          {nearbyLots.map((lot) => (
            lot && <SatelliteHubCard lot={lot} />
          ))}
        </div>
      </section>
    )}

    <!-- Popular Destinations in Area -->
    <section class="p-4 rounded-xl bg-slate-50 dark:bg-slate-800/40 border border-slate-200 dark:border-slate-700/50 text-xs">
      <span class="font-bold text-slate-700 dark:text-slate-300 block mb-2">Popular Destinations in {neighbourhood.name}:</span>
      <div class="flex flex-wrap gap-1.5">
        {neighbourhood.popularDestinations.map((dest) => (
          <span class="px-2.5 py-1 rounded-lg bg-white dark:bg-slate-800 text-slate-700 dark:text-slate-300 border border-slate-200 dark:border-slate-700 font-medium">
            📍 {dest}
          </span>
        ))}
      </div>
    </section>
    <!-- Connected Cross-Utility Telemetry -->
    <RelatedTelemetry items={relatedItems} />
  </div>
</ToolLayout>
