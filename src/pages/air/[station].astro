---
import ToolLayout from '../../layouts/ToolLayout.astro';
import AQHIBadge from '../../tools/air-quality/components/AQHIBadge.astro';
import AdvisoryBanner from '../../tools/air-quality/components/AdvisoryBanner.astro';
import CleanAirShelters from '../../tools/air-quality/components/CleanAirShelters.astro';
import { getLiveStations, getStationById, getAllShelters } from '../../tools/air-quality/services/airQualityService';

// Set Edge Cache header: 10 min max age, 30 min background revalidation
Astro.response.headers.set('Cache-Control', 'public, s-maxage=600, stale-while-revalidate=1800');

const { station: stationId } = Astro.params;
const allStations = await getLiveStations();
const station = getStationById(stationId || '', allStations);
const shelters = getAllShelters();

if (!station) {
  return Astro.redirect('/air');
}
---

<ToolLayout
  toolId="air-quality"
  title={`${station.name} — Live Air Quality & Smoke`}
  description={`Real-time PM2.5 particulate levels, AQHI rating, 24h historical trends, and health advice for ${station.name}.`}
  currentPath={`/air/${station.id}`}
  badgeText={`AQHI ${station.currentAQHI}`}
  status="active"
>
  <div class="space-y-6 max-w-5xl mx-auto">
    <!-- Breadcrumb & Back Link -->
    <div class="flex items-center justify-between">
      <a
        href="/air"
        class="inline-flex items-center gap-1.5 text-xs font-semibold text-slate-500 hover:text-sky-500 transition-colors"
      >
        <span>←</span>
        <span>Back to Air Quality Radar</span>
      </a>
      <span class="text-xs text-slate-400">
        BAM-1020 Continuous Sensor • Metro Vancouver
      </span>
    </div>

    <!-- Active Advisory Banner -->
    <AdvisoryBanner hasAdvisory={false} />

    <!-- Station Hero Header -->
    <section class="rounded-2xl bg-slate-900 text-white p-5 sm:p-6 border border-slate-800 shadow-sm flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
      <div class="space-y-1.5">
        <div class="flex items-center gap-2">
          <h2 class="text-xl sm:text-2xl font-black tracking-tight text-white">
            {station.name}
          </h2>
        </div>
        <p class="text-xs text-slate-300">
          📍 Lat: {station.latitude.toFixed(4)}, Lng: {station.longitude.toFixed(4)} • Primary Index Pollutant: {station.primaryPollutant}
        </p>
      </div>

      <div class="flex items-center gap-3 shrink-0">
        <AQHIBadge aqhi={station.currentAQHI} size="lg" />
        <button
          type="button"
          class="star-btn px-3 py-2 rounded-xl bg-slate-800 text-slate-300 hover:text-amber-400 text-xs font-bold border border-slate-700 transition-colors flex items-center gap-1.5"
          data-station-star-id={station.id}
        >
          <span>⭐</span>
          <span>Pin</span>
        </button>
      </div>
    </section>

    <!-- Key Metrics Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
      <div class="p-4 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 shadow-xs">
        <span class="text-xs text-slate-500 dark:text-slate-400 block mb-1">Fine Particles (PM2.5)</span>
        <div class="text-2xl font-black text-slate-900 dark:text-white">
          {station.currentPM25} µg/m³
        </div>
        <span class="text-[11px] text-emerald-600 dark:text-emerald-400 font-semibold">
          {station.currentPM25 <= 12 ? '✓ Within Clean Air Standard' : 'Elevated Smoke Particulates'}
        </span>
      </div>

      <div class="p-4 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 shadow-xs">
        <span class="text-xs text-slate-500 dark:text-slate-400 block mb-1">Health Risk Index (AQHI)</span>
        <div class="text-2xl font-black text-slate-900 dark:text-white">
          {station.currentAQHI} / 10+
        </div>
        <span class="text-[11px] text-slate-400">Environment Canada Scale</span>
      </div>

      <div class="p-4 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 shadow-xs">
        <span class="text-xs text-slate-500 dark:text-slate-400 block mb-1">Active Pollutant Sensors</span>
        <div class="text-lg font-bold text-slate-900 dark:text-white">
          {station.pollutants.length} Gas & Aerosol Channels
        </div>
        <span class="text-[11px] text-slate-400">{station.pollutants.map((p) => p.pollutantCode).join(', ')}</span>
      </div>
    </div>

    <!-- 24-Hour Historical Particulate Trajectory -->
    <section class="p-5 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 shadow-xs space-y-3">
      <div class="flex items-center justify-between border-b border-slate-100 dark:border-slate-800 pb-2">
        <h3 class="text-sm font-bold text-slate-900 dark:text-white flex items-center gap-2">
          <span>📈</span>
          <span>24-Hour PM2.5 Particulate Trajectory</span>
        </h3>
        <span class="text-[11px] text-slate-400">Continuous Rolling 4h Intervals</span>
      </div>

      <div class="grid grid-cols-5 gap-2 text-center text-xs font-mono">
        {station.historical24h.map((h) => (
          <div class="p-2.5 rounded-xl bg-slate-50 dark:bg-slate-800/60 border border-slate-100 dark:border-slate-700/60">
            <span class="text-[10px] text-slate-400 block mb-1">
              {new Date(h.timestamp).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' })}
            </span>
            <span class="font-black text-slate-900 dark:text-white block text-sm">
              {h.pm25Value}
            </span>
            <span class="text-[10px] text-emerald-600 dark:text-emerald-400 font-bold block">
              AQHI {h.aqhiValue}
            </span>
          </div>
        ))}
      </div>
    </section>

    <!-- Clinical Health Guidance -->
    <section class="grid grid-cols-1 md:grid-cols-2 gap-4">
      <div class="p-4 sm:p-5 rounded-2xl bg-emerald-500/10 dark:bg-emerald-950/30 border border-emerald-500/20 space-y-2 text-xs">
        <div class="font-bold text-emerald-700 dark:text-emerald-300 text-sm flex items-center gap-1.5">
          <span>🏃 For the General Population:</span>
        </div>
        <p class="text-slate-700 dark:text-slate-300 leading-relaxed font-medium">
          {station.healthAdvice.generalPopulation}
        </p>
      </div>

      <div class="p-4 sm:p-5 rounded-2xl bg-sky-500/10 dark:bg-sky-950/30 border border-sky-500/20 space-y-2 text-xs">
        <div class="font-bold text-sky-700 dark:text-sky-300 text-sm flex items-center gap-1.5">
          <span>👶 For At-Risk Groups (Asthma, Seniors, Infants):</span>
        </div>
        <p class="text-slate-700 dark:text-slate-300 leading-relaxed font-medium">
          {station.healthAdvice.atRiskPopulation}
        </p>
      </div>
    </section>

    <!-- Clean-Air Shelters in Metro Vancouver -->
    <CleanAirShelters shelters={shelters.slice(0, 4)} />

    <!-- Official Citation Link -->
    <div class="pt-2">
      <a
        href="https://www.airmap.ca/"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-1.5 text-xs font-bold text-sky-600 dark:text-sky-400 hover:underline"
      >
        <span>🏛️ View Metro Vancouver AirMap Portal</span>
        <span>→</span>
      </a>
    </div>
  </div>
</ToolLayout>
