---
import ToolLayout from '../../layouts/ToolLayout.astro';
import JsonLd from '../../components/shared/JsonLd.astro';
import IncidentsBanner from '../../tools/bridge-traffic/components/IncidentsBanner.astro';
import FilterTabs from '../../tools/bridge-traffic/components/FilterTabs.astro';
import CrossingCard from '../../tools/bridge-traffic/components/CrossingCard.astro';
import { getLiveCrossings, getBridgeOverviewStats } from '../../tools/bridge-traffic/services/bridgeService';

// Set Edge Cache header: 60s max age, 120s background revalidation
Astro.response.headers.set('Cache-Control', 'public, s-maxage=60, stale-while-revalidate=120');

const crossings = await getLiveCrossings();
const stats = getBridgeOverviewStats(crossings);
const allIncidents = crossings.flatMap((c) => c.activeIncidents);

const bridgesSchema = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    name: 'Vancouver Bridges & Tunnel Bottleneck Radar — VanHeartbeat',
    description: 'Live crossing delays, dynamic counterflow lane directions (Lions Gate, Massey Tunnel, Alex Fraser), and synchronized DriveBC approach webcams.',
    url: 'https://vanheartbeat.ca/bridges',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'VanHeartbeat', item: 'https://vanheartbeat.ca' },
      { '@type': 'ListItem', position: 2, name: 'Bridges & Tunnels Radar', item: 'https://vanheartbeat.ca/bridges' },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: [
      {
        '@type': 'Question',
        name: 'When does the Lions Gate Bridge counterflow lane switch directions?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'The Lions Gate Bridge center lane direction is dynamically controlled by the BC Ministry of Transportation based on real-time traffic volume. It generally prioritizes Southbound into Downtown during the morning commute (6:00 AM – 9:30 AM) and Northbound into West/North Vancouver during the afternoon rush (3:00 PM – 7:00 PM).',
        },
      },
      {
        '@type': 'Question',
        name: 'How are bridge crossing delays measured in Metro Vancouver?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'Crossing travel times and delays are calculated continuously using DriveBC Open511 telemetry, automated speed sensors, and approach corridor transit data across the 10 primary Metro Vancouver crossings.',
        },
      },
    ],
  },
];
---

<ToolLayout
  toolId="bridge-traffic"
  title="Vancouver Bridges & Tunnel Bottleneck Radar"
  description="Live crossing delays, dynamic counterflow lane directions (Lions Gate, Massey Tunnel, Alex Fraser), and synchronized DriveBC approach webcams."
  currentPath="/bridges"
  badgeText="Live Crossing Radar"
  status="active"
>
  <JsonLd schema={bridgesSchema} />

  <div class="space-y-5 max-w-5xl mx-auto">
    <!-- Active Incidents / Stalls Alert -->
    <IncidentsBanner incidents={allIncidents} />

    <!-- Hero Counterflow & Delay Snapshot -->
    <section class="rounded-2xl bg-slate-900 text-white p-4 sm:p-5 border border-slate-800 shadow-sm flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
      <div class="space-y-1">
        <div class="inline-flex items-center gap-2 px-2.5 py-0.5 rounded-full bg-amber-500/20 text-amber-300 text-xs font-semibold">
          <span class="w-2 h-2 rounded-full bg-amber-400 animate-pulse"></span>
          <span>{stats.activeCounterflowsCount} Dynamic Counterflows Active • Peak Crossing: {stats.highestDelayCrossingName} (+{stats.highestDelayMinutes}m)</span>
        </div>
        <h2 class="text-base sm:text-lg font-bold tracking-tight text-white">
          Real-Time Metro Vancouver Bridge Telemetry
        </h2>
        <p class="text-xs text-slate-300">
          Tracking 10 major marine connectors across Burrard Inlet, False Creek, and Fraser River.
        </p>
      </div>

      <a
        href="/bridges/lions-gate"
        class="inline-flex items-center justify-center gap-2 px-4 py-2.5 rounded-xl bg-sky-500 hover:bg-sky-400 text-white font-bold text-xs sm:text-sm shadow-md hover:shadow-lg transition-all shrink-0"
      >
        <span>🔄</span>
        <span>Lions Gate Counterflow Cam</span>
      </a>
    </section>

    <!-- Pinned Crossings Section (Mirrors Home Dashboard Card) -->
    <div id="pinned-bridges-section" class="p-3 sm:p-3.5 rounded-xl bg-slate-50 dark:bg-slate-900 border border-slate-200/80 dark:border-slate-800 space-y-2">
      <div class="flex items-center justify-between">
        <span class="text-xs font-bold text-slate-700 dark:text-slate-300 flex items-center gap-1.5">
          <span>⭐</span>
          <span>Pinned Crossings (Shown on Main Dashboard)</span>
        </span>
        <span class="text-[11px] text-slate-400">Click star on any bridge to customize</span>
      </div>
      <div id="pinned-bridges-grid" class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-2">
        <!-- Dynamically populated via client JS -->
      </div>
    </div>

    <!-- Filter Tabs -->
    <FilterTabs activeTab="all" />

    <!-- Crossings Directory Grid -->
    <div id="crossings-grid" class="grid grid-cols-1 md:grid-cols-2 gap-4">
      {crossings.map((crossing) => (
        <CrossingCard crossing={crossing} />
      ))}
    </div>
  </div>
</ToolLayout>

<script is:inline define:vars={{ crossingsJson: JSON.stringify(crossings) }}>
  // Pinned Crossings Management
  const STORAGE_KEY = 'vanutils_pinned_bridges';
  const DEFAULT_PINNED = ['lions-gate', 'ironworkers', 'massey-tunnel', 'oak-street', 'alex-fraser', 'port-mann'];

  function getPinnedIds() {
    try {
      const saved = localStorage.getItem(STORAGE_KEY);
      if (saved) return JSON.parse(saved);
    } catch (e) {}
    return DEFAULT_PINNED;
  }

  function savePinnedIds(ids) {
    localStorage.setItem(STORAGE_KEY, JSON.stringify(ids));
    window.dispatchEvent(new CustomEvent('vanutils:pinned-bridges-changed', { detail: ids }));
  }

  function renderPinnedGrid() {
    const grid = document.getElementById('pinned-bridges-grid');
    if (!grid) return;

    const pinnedIds = getPinnedIds();
    const allCrossings = JSON.parse(crossingsJson || '[]');
    const pinnedCrossings = allCrossings.filter((c) => pinnedIds.includes(c.id));

    if (pinnedCrossings.length === 0) {
      grid.innerHTML = '<p class="text-xs text-slate-400 py-1">No pinned crossings yet. Star any bridge below!</p>';
      return;
    }

    grid.innerHTML = pinnedCrossings.map((c) => {
      const p = c.directions.primary;
      const delayText = p.delayMinutes > 0 ? `+${p.delayMinutes}m delay` : 'Flowing';
      const delayClass = p.delayMinutes > 5 ? 'text-amber-600 dark:text-amber-400' : 'text-emerald-600 dark:text-emerald-400';

      return `
        <div class="flex items-center justify-between p-2 rounded-lg bg-white dark:bg-slate-800/80 border border-slate-200/80 dark:border-slate-700/60 text-xs">
          <div class="truncate pr-2 font-bold text-slate-900 dark:text-white">
            <a href="/bridges/${c.id}" class="hover:text-sky-500">${c.shortName}</a>
          </div>
          <span class="shrink-0 flex items-center gap-1 font-semibold text-[11px] ${delayClass}">
            <span class="w-1.5 h-1.5 rounded-full bg-current"></span> ${p.travelTimeMinutes}m (${delayText})
          </span>
        </div>
      `;
    }).join('');
  }

  function updateStarButtons() {
    const pinnedIds = getPinnedIds();
    document.querySelectorAll('.star-btn[data-crossing-star-id]').forEach((btn) => {
      const id = btn.getAttribute('data-crossing-star-id');
      if (pinnedIds.includes(id)) {
        btn.classList.add('text-amber-400', 'dark:text-amber-400');
        btn.classList.remove('text-slate-300', 'dark:text-slate-600');
      } else {
        btn.classList.remove('text-amber-400', 'dark:text-amber-400');
        btn.classList.add('text-slate-300', 'dark:text-slate-600');
      }
    });
  }

  function setupStarClicks() {
    document.querySelectorAll('.star-btn[data-crossing-star-id]').forEach((btn) => {
      btn.addEventListener('click', (e) => {
        e.preventDefault();
        e.stopPropagation();
        const id = btn.getAttribute('data-crossing-star-id');
        let pinned = getPinnedIds();
        if (pinned.includes(id)) {
          pinned = pinned.filter((p) => p !== id);
        } else {
          pinned.push(id);
        }
        savePinnedIds(pinned);
        updateStarButtons();
        renderPinnedGrid();
      });
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', () => {
      renderPinnedGrid();
      updateStarButtons();
      setupStarClicks();
    });
  } else {
    renderPinnedGrid();
    updateStarButtons();
    setupStarClicks();
  }
</script>
