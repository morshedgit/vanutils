---
import ToolLayout from '../../layouts/ToolLayout.astro';
import JsonLd from '../../components/shared/JsonLd.astro';
import RelatedTelemetry, { type RelatedItem } from '../../components/shared/RelatedTelemetry.astro';
import CounterflowDiagram from '../../tools/bridge-traffic/components/CounterflowDiagram.astro';
import WebcamGrid from '../../tools/bridge-traffic/components/WebcamGrid.astro';
import IncidentsBanner from '../../tools/bridge-traffic/components/IncidentsBanner.astro';
import LiveDataUnavailable from '../../components/shared/LiveDataUnavailable.astro';
import { getLiveCrossings, getCrossingById, getStatusMeta, BASELINE_CROSSINGS } from '../../tools/bridge-traffic/services/bridgeService';

// Set Edge Cache header: 60s max age, 120s background revalidation
Astro.response.headers.set('Cache-Control', 'public, s-maxage=60, stale-while-revalidate=120');

const { crossing: crossingId } = Astro.params;

// Baseline lookup is metadata-only (name/region) so an unknown id still 404s
// even when the live upstream is down; it is never used for telemetry values.
const crossingMeta = getCrossingById(crossingId || '', BASELINE_CROSSINGS);
if (!crossingMeta) {
  return Astro.redirect('/bridges');
}

const crossingsResult = await getLiveCrossings();
const crossing = crossingsResult.ok ? getCrossingById(crossingId || '', crossingsResult.data) : undefined;
const p = crossing?.directions.primary;
const r = crossing?.directions.reverse;
const pMeta = p ? getStatusMeta(p.status) : null;
const rMeta = r ? getStatusMeta(r.status) : null;

const wikidataMap: Record<string, string[]> = {
  'lions-gate': ['https://en.wikipedia.org/wiki/Lions_Gate_Bridge', 'https://www.wikidata.org/wiki/Q1048892'],
  'ironworkers': ['https://en.wikipedia.org/wiki/Ironworkers_Memorial_Second_Narrows_Crossing', 'https://www.wikidata.org/wiki/Q1673147'],
  'massey-tunnel': ['https://en.wikipedia.org/wiki/George_Massey_Tunnel', 'https://www.wikidata.org/wiki/Q5542217'],
  'alex-fraser': ['https://en.wikipedia.org/wiki/Alex_Fraser_Bridge', 'https://www.wikidata.org/wiki/Q4717015'],
  'port-mann': ['https://en.wikipedia.org/wiki/Port_Mann_Bridge', 'https://www.wikidata.org/wiki/Q2104768'],
  'pattullo': ['https://en.wikipedia.org/wiki/Pattullo_Bridge', 'https://www.wikidata.org/wiki/Q7148564'],
  'knight-street': ['https://en.wikipedia.org/wiki/Knight_Street_Bridge', 'https://www.wikidata.org/wiki/Q6422268'],
  'oak-street': ['https://en.wikipedia.org/wiki/Oak_Street_Bridge', 'https://www.wikidata.org/wiki/Q7073740'],
  'arthur-laing': ['https://en.wikipedia.org/wiki/Arthur_Laing_Bridge', 'https://www.wikidata.org/wiki/Q4799480'],
  'burrard': ['https://en.wikipedia.org/wiki/Burrard_Street_Bridge', 'https://www.wikidata.org/wiki/Q1016408'],
  'granville': ['https://en.wikipedia.org/wiki/Granville_Street_Bridge', 'https://www.wikidata.org/wiki/Q5596951'],
};

const crossingSchema = [
  {
    '@context': 'https://schema.org',
    '@type': 'CivicStructure',
    name: crossingMeta.name,
    description: `Real-time travel times, delay deltas, active counterflow lane directions, and DriveBC webcams for ${crossingMeta.name}.`,
    url: `https://vanheartbeat.ca/bridges/${crossingMeta.id}`,
    sameAs: wikidataMap[crossingMeta.id] || [],
    address: {
      '@type': 'PostalAddress',
      addressLocality: 'Metro Vancouver',
      addressRegion: 'BC',
      addressCountry: 'CA',
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'VanHeartbeat', item: 'https://vanheartbeat.ca' },
      { '@type': 'ListItem', position: 2, name: 'Bridges & Tunnels Radar', item: 'https://vanheartbeat.ca/bridges' },
      { '@type': 'ListItem', position: 3, name: crossingMeta.name, item: `https://vanheartbeat.ca/bridges/${crossingMeta.id}` },
    ],
  },
];

const relatedItems: RelatedItem[] = [
  {
    title: 'BC Ferries Standby Radar',
    subtitle: 'Terminal deck space & sailing status',
    href: '/ferries',
    badge: 'BC Ferries',
    icon: '⛴️',
  },
  {
    title: 'Microclimate Weather Radar',
    subtitle: 'Wind gusts, fog & road temperatures',
    href: '/weather',
    badge: 'Live Radar',
    icon: '🌦️',
  },
  {
    title: 'Metro Vancouver Air Quality',
    subtitle: 'Highway corridor BAM-1020 sensors',
    href: '/air',
    badge: 'AQHI',
    icon: '💨',
  },
];
---

<ToolLayout
  toolId="bridge-traffic"
  title={crossing ? `${crossing.name} — Live Delays & Cameras` : `${crossingMeta.name} — Live Data Unavailable`}
  description={crossing ? `Real-time travel times, delay deltas, active counterflow lane directions, and DriveBC webcams for ${crossing.name}.` : 'Live bridge traffic data is temporarily unavailable.'}
  currentPath={`/bridges/${crossingMeta.id}`}
  badgeText={crossing ? (crossing.highwayNumber || 'Metro Crossing') : 'Live Data Unavailable'}
  status="active"
>
  <JsonLd schema={crossingSchema} />

  <div class="space-y-6 max-w-5xl mx-auto">
    <!-- 3-Tier Visual Breadcrumb Navigation -->
    <nav aria-label="Breadcrumb" class="flex items-center justify-between">
      <div class="flex items-center gap-2 text-xs font-semibold text-slate-500 dark:text-slate-400">
        <a href="/" class="hover:text-sky-600 dark:hover:text-sky-400 transition-colors">VanHeartbeat</a>
        <span>/</span>
        <a href="/bridges" class="hover:text-sky-600 dark:hover:text-sky-400 transition-colors">Bridges Radar</a>
        <span>/</span>
        <span class="text-slate-900 dark:text-white truncate">{crossingMeta.name}</span>
      </div>
      <span class="text-xs text-slate-400">
        {crossingMeta.region === 'burrard_inlet' && 'Burrard Inlet (North Shore)'}
        {crossingMeta.region === 'false_creek' && 'False Creek (Downtown)'}
        {crossingMeta.region === 'fraser_river' && 'Fraser River'}
      </span>
    </nav>

    {!crossing && (
      <LiveDataUnavailable toolName={`${crossingMeta.name} Crossing`} variant="page" error={!crossingsResult.ok ? crossingsResult.error : undefined} />
    )}

    {crossing && p && r && pMeta && rMeta && (
    <>
    <!-- Active Incidents if present -->
    <IncidentsBanner incidents={crossing.activeIncidents} />

    <!-- Hero Crossing Summary -->
    <section class="rounded-2xl bg-slate-900 text-white p-5 sm:p-6 border border-slate-800 shadow-sm flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
      <div class="space-y-1.5">
        <div class="flex items-center gap-2">
          <h2 class="text-xl sm:text-2xl font-black tracking-tight text-white">
            {crossing.name}
          </h2>
          {crossing.highwayNumber && (
            <span class="px-2.5 py-0.5 rounded-md bg-slate-800 text-xs font-extrabold text-amber-400 border border-slate-700">
              {crossing.highwayNumber}
            </span>
          )}
        </div>
        <p class="text-xs text-slate-300">
          Official DriveBC Open511 & MOTI loop sensors telemetry.
        </p>
      </div>

      <div class="flex items-center gap-2 shrink-0">
        <button
          type="button"
          class="star-btn px-3 py-2 rounded-xl bg-slate-800 text-slate-300 hover:text-amber-400 text-xs font-bold border border-slate-700 transition-colors flex items-center gap-1.5"
          data-crossing-star-id={crossing.id}
        >
          <span>⭐</span>
          <span>Pin to Dashboard</span>
        </button>
      </div>
    </section>

    <!-- Bidirectional Travel Times Matrix -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      <!-- Primary Direction -->
      <div class={`p-5 rounded-2xl border ${pMeta.badgeBg} flex flex-col justify-between space-y-3`}>
        <div class="flex items-center justify-between">
          <span class="text-xs font-bold uppercase tracking-wider">{p.directionName}</span>
          <span class={`w-2.5 h-2.5 rounded-full ${pMeta.dotColor} animate-pulse`}></span>
        </div>
        <div>
          <div class="text-3xl font-black">{p.travelTimeMinutes} mins</div>
          <div class="text-xs font-semibold mt-1">
            {p.delayMinutes > 0 ? `+${p.delayMinutes}m delay vs normal (${p.normalTimeMinutes}m)` : `Flowing normally (${p.normalTimeMinutes}m)`}
          </div>
        </div>
        <div class="text-xs font-bold pt-2 border-t border-current/20 flex items-center justify-between">
          <span>Average Velocity:</span>
          <span>{p.averageSpeedKmh} km/h</span>
        </div>
      </div>

      <!-- Reverse Direction -->
      <div class={`p-5 rounded-2xl border ${rMeta.badgeBg} flex flex-col justify-between space-y-3`}>
        <div class="flex items-center justify-between">
          <span class="text-xs font-bold uppercase tracking-wider">{r.directionName}</span>
          <span class={`w-2.5 h-2.5 rounded-full ${rMeta.dotColor} animate-pulse`}></span>
        </div>
        <div>
          <div class="text-3xl font-black">{r.travelTimeMinutes} mins</div>
          <div class="text-xs font-semibold mt-1">
            {r.delayMinutes > 0 ? `+${r.delayMinutes}m delay vs normal (${r.normalTimeMinutes}m)` : `Flowing normally (${r.normalTimeMinutes}m)`}
          </div>
        </div>
        <div class="text-xs font-bold pt-2 border-t border-current/20 flex items-center justify-between">
          <span>Average Velocity:</span>
          <span>{r.averageSpeedKmh} km/h</span>
        </div>
      </div>
    </div>

    <!-- Dynamic Counterflow Diagram (If applicable) -->
    <CounterflowDiagram counterflow={crossing.counterflow} crossingName={crossing.name} />

    <!-- Synchronized Approach Webcams -->
    {crossing.webcams.length > 0 && (
      <WebcamGrid webcams={crossing.webcams} crossingName={crossing.name} />
    )}
    </>
    )}

    <!-- Connected Cross-Utility Telemetry -->
    <RelatedTelemetry items={relatedItems} />

    <!-- Official Portal Citation -->
    <div class="pt-2">
      <a
        href={crossingMeta.officialSourceUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-1.5 text-xs font-bold text-sky-600 dark:text-sky-400 hover:underline"
      >
        <span>🏛️ View DriveBC Live Highway Cam Portal</span>
        <span>→</span>
      </a>
    </div>
  </div>
</ToolLayout>
