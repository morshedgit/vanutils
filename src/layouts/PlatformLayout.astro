---
import Header from '../components/shared/Header.astro';
import Footer from '../components/shared/Footer.astro';

interface Props {
  title?: string;
  description?: string;
  currentPath?: string;
  ogImage?: string;
  canonicalUrl?: string;
  type?: 'website' | 'article';
}

const {
  title = 'VanHeartbeat — Metro Vancouver Live Civic Pulse & Telemetry',
  description = 'Ultra-lightweight, sub-second hyper-local civic telemetry for Metro Vancouver residents. Beach water quality, ferry standby, mountain snow lines, ER wait times and more.',
  currentPath = '/',
  ogImage = 'https://vanheartbeat.ca/og-banner.svg',
  canonicalUrl,
  type = 'website',
} = Astro.props;

const fullTitle = title.includes('VanHeartbeat') ? title : `${title} | VanHeartbeat`;
const resolvedCanonical = canonicalUrl || (currentPath === '/' ? 'https://vanheartbeat.ca' : `https://vanheartbeat.ca${currentPath.replace(/\/$/, '')}`);
---

<!doctype html>
<html lang="en-CA" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="alternate" type="text/plain" href="/llms.txt" title="LLMs.txt Manifest" />
    <link rel="canonical" href={resolvedCanonical} />
    <link rel="alternate" href={resolvedCanonical} hreflang="en-CA" />
    <meta name="theme-color" content="#0284c7" />

    <!-- Search Engine & Robot Indexing Directives -->
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />

    <!-- Local Geographic Grounding (Vancouver / BC / Canada) -->
    <meta name="geo.region" content="CA-BC" />
    <meta name="geo.placename" content="Vancouver" />
    <meta name="geo.position" content="49.2827;-123.1207" />
    <meta name="ICBM" content="49.2827, -123.1207" />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content="VanHeartbeat" />
    <meta property="og:locale" content="en_CA" />
    <meta property="og:url" content={resolvedCanonical} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="VanHeartbeat — Metro Vancouver Live Civic Pulse" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content="VanHeartbeat — Metro Vancouver Live Civic Pulse" />


    <!-- Self-Hosted Inter Variable Font (Zero External CDN Latency) -->
    <link
      rel="preload"
      href="/fonts/inter-latin-variable.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    <!-- Zero-Flicker Dark Mode Script -->
    <script is:inline>
      (function () {
        try {
          const stored = localStorage.getItem('vanutils_theme');
          const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
          if (stored === 'dark' || (!stored && prefersDark)) {
            document.documentElement.classList.add('dark');
          } else {
            document.documentElement.classList.remove('dark');
          }
        } catch (e) {}
      })();
    </script>

    <!-- Global CSS & Self-Hosted Typography -->
    <style is:global>
      @font-face {
        font-family: 'Inter';
        font-style: normal;
        font-weight: 100 900;
        font-display: swap;
        src: url('/fonts/inter-latin-variable.woff2') format('woff2-variations');
        unicode-range: U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD;
      }
      @font-face {
        font-family: 'Inter';
        font-style: normal;
        font-weight: 100 900;
        font-display: swap;
        src: url('/fonts/inter-latin-ext-variable.woff2') format('woff2-variations');
        unicode-range: U+0100-02BA,U+02BD-02C5,U+02C7-02CC,U+02CE-02D7,U+02DD-02FF,U+0304,U+0308,U+0329,U+1D00-1DBF,U+1E00-1E9F,U+1EF2-1EFF,U+2020,U+20A0-20AB,U+20AD-20C0,U+2113,U+2C60-2C7F,U+A720-A7FF;
      }
      .no-scrollbar::-webkit-scrollbar {
        display: none;
      }
      .no-scrollbar {
        -ms-overflow-style: none;
        scrollbar-width: none;
      }
    </style>
  </head>
  <body class="min-h-screen bg-slate-50/50 dark:bg-slate-950 text-slate-900 dark:text-slate-100 antialiased font-sans flex flex-col selection:bg-sky-500 selection:text-white transition-colors duration-150">
    <!-- Keyboard Bypass / Skip Link (WCAG 2.4.1) -->
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-50 focus:px-4 focus:py-2 focus:bg-sky-600 focus:text-white focus:font-bold focus:rounded-xl focus:shadow-lg focus:outline-none focus:ring-2 focus:ring-sky-400"
    >
      Skip to main content
    </a>

    <!-- Platform Header -->
    <Header currentPath={currentPath} />

    <!-- Main Page Content -->
    <main id="main-content" class="flex-1 max-w-[1600px] w-full mx-auto px-3 sm:px-6 lg:px-8 pt-2.5 pb-6 sm:pt-3.5 sm:pb-8">
      <slot />
    </main>

    <!-- Platform Footer -->
    <Footer />
  </body>
</html>
